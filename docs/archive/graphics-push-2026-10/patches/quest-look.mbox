+#pragma once
+
+#include "CoreMinimal.h"
+#include "Session/SpellVfx.h"
+
+class UInstancedStaticMeshComponent;
+class UMaterialInterface;
+class USceneComponent;
+struct FArenaLayout;
+
+/**
+ * The graphics push's spell VFX (docs/concepts/GRAPHICS-PUSH-2026-10-28.md, Phase 2), shared by the quest and epic looks
+ * (every look but flat). Quest-viable: alpha-blended cards and opaque unlit cores, no post pass needed for the shape
+ * (bloom only adds the halo where MobileHDR is on).
+ *
+ * The threat colour language holds: every glow and core is tinted by the threat's own colour (Greybox::Tint writes
+ * Color), so hue never comes from a texture. Only a warm colour (red channel well over blue: Fire, a brazier) gains a
+ * white-gold heart at a card's or core's brightest pixels; a cool one gains a lighter tone of itself. The unblockable's
+ * rim (the SoftGlow cell) never takes a heart, and its black core stays black (the core multiplies its colour).
+ *
+ * Assets under /Game/Look/Spells, built by Look/CreateQuestSpellAssetsCommandlet from apps/vr/art/look/spells (made by
+ * apps/vr/tools/look/prep_spell_textures.py from the studio stills):
+ *   M_Q_SpellGlow  replaces M_SpellGlow for every puff (same T63 cell layout and custom data), with a painted fireball and
+ *                  water splash in the shell cells and an HDR heart;
+ *   M_Q_BoltCore   the core of a glowing bolt: unlit, a moving fire pattern in the threat colour, brighter facing the eye;
+ *   M_Q_Ward       the raised ward: a turquoise water wave on a ring of cards round the palm, panning.
+ */
+namespace QuestSpells
+{
+/** True on every look but flat. */
+bool IsActive();
+
+inline constexpr const TCHAR* Folder = TEXT("/Game/Look/Spells");
+
+/** M_Q_SpellGlow, or null when it is not built (the caller keeps M_SpellGlow). */
+UMaterialInterface* GlowMaterial();
+/** M_Q_BoltCore, or null. */
+UMaterialInterface* BoltCoreMaterial();
+
+/**
+ * Brennic's cast tell: a small fire shell at each of Mesh's hands (the bones named hand, not a finger), FireFlame cells
+ * flickering at TimeS. The caller draws them in his glow colour, so they are his element and nothing else.
+ */
+void HandFlamePuffs(const class USkeletalMeshComponent& Mesh, double TimeS, TArray<struct SpellVfx::FPuff>& Out);
+
+/** Cards round the palm that the ward's water wave is drawn on: an instanced plane attached to Parent, or null. */
+UInstancedStaticMeshComponent* MakeWardCards(USceneComponent& Parent);
+/** Poses the ward cards in Parent's space: the arc of Layout's ward round Palm, opening along Normal. */
+void PoseWardCards(UInstancedStaticMeshComponent& Cards, const FArenaLayout& Layout, const FVector& Palm, const FVector& Normal, const FVector& Right, const FVector& Up);
+}
