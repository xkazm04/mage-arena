+int32 QuestLook::ApplyHands(UWorld& World)
+{
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	UMaterialInterface* Material = Cached.Get();
+	if (!Material)
+	{
+		Material = LoadObject<UMaterialInterface>(nullptr, *ObjectPath(TEXT("M_Q_Hands")), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		if (!Material)
+		{
+			return 0;
+		}
+		Cached = Material;
+	}
+	int32 Changed = 0;
+	for (TObjectIterator<UPoseableMeshComponent> It; It; ++It)
+	{
+		UPoseableMeshComponent* Component = *It;
+		const USkeletalMesh* Mesh = Component->GetWorld() == &World ? Cast<USkeletalMesh>(Component->GetSkinnedAsset()) : nullptr;
+		if (!Mesh || Mesh->GetName() != TEXT("SK_PlayerHands"))
+		{
+			continue;
+		}
+		for (int32 Slot = 0; Slot < Component->GetNumMaterials() && Slot < Mesh->GetMaterials().Num(); ++Slot)
+		{
+			// The skin only; Tier B's dark sleeve keeps its own material.
+			if (!Mesh->GetMaterials()[Slot].MaterialSlotName.ToString().Contains(TEXT("Sleeve")) && Component->GetMaterial(Slot) != Material)
+			{
+				Component->SetMaterial(Slot, Material);
+				++Changed;
+			}
+		}
+	}
+	return Changed;
+}
