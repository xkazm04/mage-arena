+bool BuildEnvFire(UTexture2D* Flame)
+{
+	const TCHAR* Name = TEXT("M_Q_EnvFire");
+	FGraph G{NewMaterial(Name, BLEND_Additive)};
+	UMaterial* Material = G.Material;
+	Material->TwoSided = true;
+	Material->bUsedWithInstancedStaticMeshes = true;
+	UMaterialExpression* Time = G.Make<UMaterialExpressionTime>();
+	UMaterialExpression* Phase = G.Data(0, 0.f);
+	UMaterialExpression* Uv = G.Custom(TEXT("Lick"), CMOT_Float2, EnvFireUvCode, {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("T"), Time}, {TEXT("D0"), Phase}});
+	UMaterialExpressionTextureSample* Paint = G.Sample(Flame, SAMPLERTYPE_Color, Uv);
+	UMaterialExpression* Emissive = G.Custom(TEXT("Fire"), CMOT_Float3, EnvFireCode,
+	    {{TEXT("Rgb"), Paint}, {TEXT("C"), G.Colour()}, {TEXT("Amount"), Param(G, TEXT("TintAmount"), 0.f)}, {TEXT("Gain"), Param(G, TEXT("FireGain"), 1.5f)}, {TEXT("T"), Time}, {TEXT("D0"), Phase}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	return Finish(Material, Name);
+}
+
+// A soft additive halo (no texture): the glow round a bolt, a fire or a rune, in Color. Bloom does this on desktop; on
+// Quest with MobileHDR off this card is the only glow there is.
+bool BuildHalo()
+{
+	const TCHAR* Name = TEXT("M_Q_SpellHalo");
+	FGraph G{NewMaterial(Name, BLEND_Additive)};
+	UMaterial* Material = G.Material;
+	Material->TwoSided = true;
+	Material->bUsedWithInstancedStaticMeshes = true;
+	UMaterialExpression* Emissive = G.Custom(TEXT("Halo"), CMOT_Float3, TEXT("float d = saturate(1.0 - length(Uv - 0.5) * 2.0);\nreturn C * pow(d, 2.2) * Gain;"),
+	    {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("C"), G.Colour()}, {TEXT("Gain"), Param(G, TEXT("HaloGain"), 0.45f)}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	return Finish(Material, Name);
+}
