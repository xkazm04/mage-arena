diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreateCrowdPaintedCommandlet.cpp b/apps/vr/Game/Source/MageArenaVR/Tools/CreateCrowdPaintedCommandlet.cpp
new file mode 100644
index 0000000..21af830
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreateCrowdPaintedCommandlet.cpp
@@ -0,0 +1,104 @@
+#include "Tools/CreateCrowdPaintedCommandlet.h"
+
+#include "Greybox/ArenaStands.h"
+#include "Look/CrowdLook.h"
+#include "MageArenaVR.h"
+#include "Misc/Paths.h"
+#include "Tools/MaterialGraph.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionMultiply.h"
+#include "Materials/MaterialExpressionPerInstanceCustomData.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureObjectParameter.h"
+#include "ShaderCompiler.h"
+#endif
+
+UCreateCrowdPaintedCommandlet::UCreateCrowdPaintedCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UCreateCrowdPaintedCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	FString Source = FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/crowd-painted"));
+	FParse::Value(*Params, TEXT("source="), Source);
+	Source = FPaths::ConvertRelativePathToFull(Source);
+	const FString Folder = CrowdLook::Folder();
+	UTexture2D* Atlas = ImportTexture(Source / TEXT("T_CrowdPainted.png"), Folder, TEXT("T_CrowdPainted"), false, TC_Default);
+	if (!Atlas)
+	{
+		return 1;
+	}
+	UMaterial* Material = NewMaterial(Folder, TEXT("M_CrowdPainted"));
+	Material->BlendMode = BLEND_Masked;
+	Material->OpacityMaskClipValue = 0.5f;
+	Material->SetShadingModel(MSM_DefaultLit);
+	Material->TwoSided = false;
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Material, -500, 0);
+	Custom->Description = TEXT("CrowdPainted");
+	Custom->OutputType = CMOT_Float4;
+	Custom->Inputs.Reset();
+	for (int32 Index = 0; Index < ArenaCrowd::CustomDataFloats; ++Index)
+	{
+		UMaterialExpressionPerInstanceCustomData* Data = Add<UMaterialExpressionPerInstanceCustomData>(*Material, -1100, -300 + Index * 90);
+		Data->DataIndex = Index;
+		Data->ConstDefaultValue = (Index < 2 || Index == ArenaCrowd::FlatFloatIndex) ? 0.f : 1.f;
+		Input(*Custom, *FString::Printf(TEXT("D%d"), Index), Data);
+	}
+	Input(*Custom, TEXT("UV"), Add<UMaterialExpressionTextureCoordinate>(*Material, -1100, 500));
+	UMaterialExpressionTextureObjectParameter* Tex = Add<UMaterialExpressionTextureObjectParameter>(*Material, -1100, 600);
+	Tex->ParameterName = TEXT("Atlas");
+	Tex->Texture = Atlas;
+	Input(*Custom, TEXT("Tex"), Tex);
+	Custom->Code = TEXT(
+	    "float2 uv = lerp(float2(D0, D1), float2(D2, D3), UV);\n"
+	    "float4 c = Texture2DSample(Tex, TexSampler, uv);\n"
+	    "float flat = D7;\n"
+	    "return float4(lerp(c.rgb, float3(D4, D5, D6), flat), lerp(c.a, 1.0, flat));\n");
+	UMaterialExpressionComponentMask* Rgb = Add<UMaterialExpressionComponentMask>(*Material, -200, 0);
+	Rgb->Input.Connect(0, Custom);
+	Rgb->R = Rgb->G = Rgb->B = true;
+	Rgb->A = false;
+	UMaterialExpressionComponentMask* Alpha = Add<UMaterialExpressionComponentMask>(*Material, -200, 150);
+	Alpha->Input.Connect(0, Custom);
+	Alpha->R = Alpha->G = Alpha->B = false;
+	Alpha->A = true;
+	UMaterialExpressionMultiply* Glow = Add<UMaterialExpressionMultiply>(*Material, 0, 250);
+	Glow->A.Connect(0, Rgb);
+	Glow->B.Connect(0, Scalar(*Material, TEXT("SelfLight"), 0.12, 300));
+	UMaterialEditorOnlyData* Editor = Material->GetEditorOnlyData();
+	Editor->BaseColor.Connect(0, Rgb);
+	Editor->OpacityMask.Connect(0, Alpha);
+	Editor->EmissiveColor.Connect(0, Glow);
+	Editor->Roughness.Connect(0, Scalar(*Material, TEXT("Roughness"), 0.9, 400));
+	Editor->Specular.Connect(0, Scalar(*Material, TEXT("Specular"), 0.2, 500));
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+	Material->ForceRecompileForRendering();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done crowd saved=%d from %s"), Saved, *Source);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
