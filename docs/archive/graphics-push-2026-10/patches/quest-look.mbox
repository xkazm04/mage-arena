diff --git a/apps/vr/tools/look/create-quest-spell-assets.ps1 b/apps/vr/tools/look/create-quest-spell-assets.ps1
new file mode 100644
index 0000000..0e10ac6
--- /dev/null
+++ b/apps/vr/tools/look/create-quest-spell-assets.ps1
@@ -0,0 +1,32 @@
+# Builds the push's spell VFX assets under /Game/Look/Spells (Look/CreateQuestSpellAssetsCommandlet.h) from the PNGs in
+# apps/vr/art/look/spells (written by prep_spell_textures.py from the studio stills). One headless editor process.
+# Success is exit 0 and "MAGEVR_SPELL_ASSETS done" in the log; anything else exits 1.
+param([string]$Run = "push/quest")
+
+$ErrorActionPreference = "Stop"
+$ToolsDir = Split-Path -Parent $PSScriptRoot
+$VrDir = Split-Path -Parent $ToolsDir
+$Repo = Split-Path -Parent (Split-Path -Parent $VrDir)
+$Editor = "C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe"
+$Project = Join-Path $VrDir "Game\MageArenaVR.uproject"
+$RunDir = Join-Path $Repo "runs\$Run"
+$LogPath = Join-Path $RunDir "create-quest-spell-assets.log"
+
+foreach ($Png in Get-ChildItem (Join-Path $VrDir "art\look\spells\*.png")) {
+	$Bytes = [System.IO.File]::ReadAllBytes($Png.FullName)
+	if ($Bytes.Length -lt 8 -or $Bytes[1] -ne 0x50 -or $Bytes[2] -ne 0x4E -or $Bytes[3] -ne 0x47) {
+		Write-Host "create-quest-spell-assets: $($Png.FullName) is not a PNG (a Git LFS pointer?). Run git lfs pull."
+		exit 1
+	}
+}
+New-Item -ItemType Directory -Force -Path $RunDir | Out-Null
+if (Test-Path $LogPath) { Remove-Item -Force $LogPath }
+& $Editor $Project -run=CreateQuestSpellAssets -unattended -nosplash -nop4 -stdout -FullStdOutLogOutput "-abslog=$LogPath" | Out-Null
+$Code = $LASTEXITCODE
+Select-String -Path $LogPath -Pattern "MAGEVR_SPELL_ASSETS|error" | ForEach-Object { Write-Host $_.Line }
+if ($Code -ne 0 -or -not (Select-String -Path $LogPath -Pattern "MAGEVR_SPELL_ASSETS done" -Quiet)) {
+	Write-Host "create-quest-spell-assets: FAIL (exit $Code)"
+	exit 1
+}
+Write-Host "create-quest-spell-assets: ok"
+exit 0
diff --git a/apps/vr/tools/look/prep_spell_textures.py b/apps/vr/tools/look/prep_spell_textures.py
new file mode 100644
index 0000000..d0e0c8c
--- /dev/null
+++ b/apps/vr/tools/look/prep_spell_textures.py
@@ -0,0 +1,100 @@
+"""Spell VFX textures for the quest and epic looks (docs/concepts/GRAPHICS-PUSH-2026-10-28.md, Phase 2).
+
+Reads the studio stills in the staging folder and the T63 atlas, writes to apps/vr/art/look/spells/:
+  T_Q_SpellFlipbook.png  1024 RGBA, the T63 cell layout (Session/SpellVfx.h ECell) kept: R = shade, A = coverage.
+                         The water shells take the studio water splash, the fire flames the studio fireball; every other
+                         cell is the T63 cell upscaled. Colour never comes from here: the material tints by the threat.
+  T_Q_WardWave.png       2048x512 RGBA, the studio wave and its mirror side by side (so it pans without a seam),
+                         colour unpremultiplied from the black background, alpha from its brightness.
+  T_Q_CoreNoise.png      256 grey, the fireball's luma: the bolt core's moving fire pattern.
+Run: python apps/vr/tools/look/prep_spell_textures.py <staging textures dir> <T63 atlas png> <out dir>
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+SRC = Path(sys.argv[1])
+ATLAS = Path(sys.argv[2])
+OUT = Path(sys.argv[3])
+OUT.mkdir(parents=True, exist_ok=True)
+GRID = 4
+CELL = 256
+
+
+def rgb(name):
+    return np.asarray(Image.open(SRC / name).convert("RGB"), dtype=np.float32) / 255.0
+
+
+def coverage(img, floor=0.05, span=0.3):
+    peak = img.max(axis=-1)
+    return np.clip((peak - floor) / span, 0.0, 1.0)
+
+
+def sprite_cell(img, rotate=0, mirror=False):
+    """A studio sprite on black as one cell: cropped to its content, fitted inside 0.9 of the cell, R shade + A cover."""
+    a = coverage(img)
+    ys, xs = np.nonzero(a > 0.02)
+    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1
+    side = max(y1 - y0, x1 - x0)
+    cy, cx = (y0 + y1) // 2, (x0 + x1) // 2
+    pad = np.zeros((side, side, 3), dtype=np.float32)
+    sy0, sx0 = max(cy - side // 2, 0), max(cx - side // 2, 0)
+    crop = img[sy0:sy0 + side, sx0:sx0 + side]
+    pad[: crop.shape[0], : crop.shape[1]] = crop
+    luma = pad[..., 0] * 0.2126 + pad[..., 1] * 0.7152 + pad[..., 2] * 0.0722
+    shade = np.clip(luma / max(np.percentile(luma, 99.5), 1e-3), 0.0, 1.0)
+    cover = coverage(pad)
+    inner = int(CELL * 0.9)
+    cell = np.zeros((CELL, CELL, 4), dtype=np.uint8)
+    rgba = np.dstack([shade, shade, shade, cover])
+    im = Image.fromarray((rgba * 255).astype(np.uint8), "RGBA").resize((inner, inner), Image.LANCZOS)
+    if mirror:
+        im = im.transpose(Image.FLIP_LEFT_RIGHT)
+    if rotate:
+        im = im.rotate(rotate)
+    o = (CELL - inner) // 2
+    cell[o:o + inner, o:o + inner] = np.asarray(im)
+    return cell
+
+
+old = Image.open(ATLAS).convert("RGBA").resize((CELL * GRID, CELL * GRID), Image.LANCZOS)
+atlas = np.asarray(old).copy()
+fire = rgb("fireball-01.png")
+water = rgb("watersplash-01.png")
+# ECell order, row by row: Water ShellA ShellB Spray Crown / Fire FlameA FlameB Embers Crown / Air ... / shared.
+replace = {
+    (0, 0): sprite_cell(water),
+    (0, 1): sprite_cell(water, rotate=140, mirror=True),
+    (1, 0): sprite_cell(fire),
+    (1, 1): sprite_cell(fire, rotate=110, mirror=True),
+}
+for (row, col), cell in replace.items():
+    atlas[row * CELL:(row + 1) * CELL, col * CELL:(col + 1) * CELL] = cell
+Image.fromarray(atlas, "RGBA").save(OUT / "T_Q_SpellFlipbook.png")
+print("T_Q_SpellFlipbook.png", atlas.shape)
+
+wave = rgb("wardwave-01.png")
+# The wave's band only (the still's top spray to where its body fades), so the cards carry no dark empty border.
+h = wave.shape[0]
+wave = wave[int(h * 0.1): int(h * 0.68)]
+rows = np.linspace(0.0, 1.0, wave.shape[0])
+fade = np.clip((0.92 - rows) / 0.32, 0.0, 1.0) ** 2
+alpha = coverage(wave, 0.12, 0.3) * fade[:, None]
+colour = np.clip(wave / np.maximum(wave.max(axis=-1, keepdims=True), 0.04), 0.0, 1.0)
+colour = colour * np.clip(wave.max(axis=-1, keepdims=True) * 1.3, 0.35, 1.0)
+rgba = np.dstack([colour, alpha])
+img = Image.fromarray((rgba * 255).astype(np.uint8), "RGBA").resize((1024, 512), Image.LANCZOS)
+both = Image.new("RGBA", (2048, 512))
+both.paste(img, (0, 0))
+both.paste(img.transpose(Image.FLIP_LEFT_RIGHT), (1024, 0))
+both.save(OUT / "T_Q_WardWave.png")
+print("T_Q_WardWave.png", both.size)
+
+luma = fire[..., 0] * 0.2126 + fire[..., 1] * 0.7152 + fire[..., 2] * 0.0722
+h, w = luma.shape
+core = luma[h // 4: 3 * h // 4, w // 4: 3 * w // 4]
+core = (core - core.min()) / max(core.max() - core.min(), 1e-3)
+Image.fromarray((core * 255).astype(np.uint8), "L").resize((256, 256), Image.LANCZOS).save(OUT / "T_Q_CoreNoise.png")
+print("T_Q_CoreNoise.png")
-- 
