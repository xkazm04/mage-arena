+// S1's pylons: on the first tread in front of the crowd, two either side of the seat's forward view (wall segments).
+int32 PylonSegment(const FArenaLayout& Layout, int32 Index)
+{
+	const int32 Segments = FMath::Max(Layout.WallSegments, 3);
+	const int32 Picks[] = {2, Segments - 3, 6, Segments - 7};
+	return Picks[Index];
+}
+constexpr int32 PylonCount = 4;
+
+double PylonTopM(const FArenaLayout& Layout)
+{
+	return ArenaStands::TierTopM(Layout, FMath::Min(Layout.StandTiers - 1, 2)) + 0.6;
+}
+
+FVector PylonBaseM(const FArenaLayout& Layout, int32 Index)
+{
+	const ArenaStands::FStandBox Box = ArenaStands::StandBox(Layout, PylonSegment(Layout, Index), 0);
+	return Box.MidM - Box.Outward * (Box.DepthM * 0.5 - 0.6);
+}
+
+/** Where each pylon's fire burns, a little above its bowl (metres). */
+TArray<FVector> PylonFireCentresM(const FArenaLayout& Layout)
+{
+	TArray<FVector> Out;
+	if (Layout.StandTiers <= 0)
+	{
+		return Out;
+	}
+	for (int32 Index = 0; Index < PylonCount; ++Index)
+	{
+		const FVector Base = PylonBaseM(Layout, Index);
+		Out.Add(FVector(Base.X, Base.Y, PylonTopM(Layout) + 0.9));
+	}
+	return Out;
+}
