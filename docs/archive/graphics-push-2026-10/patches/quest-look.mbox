+++ b/apps/vr/tools/look/prep_quest_textures.py
@@ -0,0 +1,88 @@
+"""Quest look textures from the studio stills (docs/concepts/GRAPHICS-PUSH-2026-10-28.md, Tier A).
+
+Reads the stills in the staging folder and writes the game's source PNGs to apps/vr/art/look/quest/:
+  T_Q_<Name>_D.png  base colour (sRGB), tileable, 1024 or less
+  T_Q_<Name>_N.png  tangent-space normal (linear), derived from the luma as a height field (blurred, Sobel)
+The sky keeps its colour only; the banner gains an alpha (the white notch is cut out).
+Run: python apps/vr/tools/look/prep_quest_textures.py <staging textures dir> <out dir>
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageFilter
+
+SRC = Path(sys.argv[1])
+OUT = Path(sys.argv[2])
+OUT.mkdir(parents=True, exist_ok=True)
+
+
+def seamless(img: np.ndarray, band: int) -> np.ndarray:
+    """Cross-fades each wrap edge with the image rolled by half, over Band pixels, so the edges meet."""
+    h, w, _ = img.shape
+    rolled = np.roll(np.roll(img, h // 2, axis=0), w // 2, axis=1)
+    y = np.arange(h)[:, None]
+    x = np.arange(w)[None, :]
+    dy = np.minimum(y, h - 1 - y)
+    dx = np.minimum(x, w - 1 - x)
+    weight = np.clip(np.minimum(dx, dy) / band, 0.0, 1.0)
+    weight = weight * weight * (3 - 2 * weight)
+    return img * weight[..., None] + rolled * (1 - weight[..., None])
+
+
+def normal_from(rgb: np.ndarray, strength: float, blur: float) -> np.ndarray:
+    luma = (rgb[..., 0] * 0.2126 + rgb[..., 1] * 0.7152 + rgb[..., 2] * 0.0722) / 255.0
+    height = np.asarray(Image.fromarray((luma * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(blur)), dtype=np.float32) / 255.0
+    # Wrap-around gradients so the normal tiles with the colour.
+    gx = (np.roll(height, -1, axis=1) - np.roll(height, 1, axis=1)) * 0.5
+    gy = (np.roll(height, -1, axis=0) - np.roll(height, 1, axis=0)) * 0.5
+    n = np.stack([-gx * strength, gy * strength, np.ones_like(height)], axis=-1)
+    n /= np.linalg.norm(n, axis=-1, keepdims=True)
+    return ((n * 0.5 + 0.5) * 255).clip(0, 255).astype(np.uint8)
+
+
+def save(arr: np.ndarray, name: str, size=None):
+    img = Image.fromarray(arr.clip(0, 255).astype(np.uint8))
+    if size:
+        img = img.resize(size, Image.LANCZOS)
+    img.save(OUT / name)
+    print(name, img.size, img.mode)
+
+
+def load(name: str) -> np.ndarray:
+    return np.asarray(Image.open(SRC / name).convert("RGB"), dtype=np.float32)
+
+
+# Stone: the still's rows do not wrap vertically. Crop between two mortar joints (y 104 and 865, five courses), then
+# stretch to 1024 square; the material tiles V over 761/1024 of U so the blocks keep their shape.
+stone = load("stone-blocks-01.png")[104:865]
+stone = np.asarray(Image.fromarray(stone.astype(np.uint8)).resize((1024, 1024), Image.LANCZOS), dtype=np.float32)
+# The crop already wraps (seam difference 4.3 against 4.6 inside); a cross-fade would ghost the joints.
+save(stone, "T_Q_Stone_D.png")
+save(normal_from(stone, 6.0, 1.5), "T_Q_Stone_N.png")
+
+sand = seamless(load("sand-01.png"), 64)
+save(sand, "T_Q_Sand_D.png")
+save(normal_from(sand, 5.0, 1.2), "T_Q_Sand_N.png")
+
+flag = seamless(load("flagstone-01.png"), 24)
+save(flag, "T_Q_Flagstone_D.png")
+save(normal_from(flag, 6.0, 1.5), "T_Q_Flagstone_N.png")
+
+sky = load("sky-01.png")
+save(sky, "T_Q_Sky_D.png", (2048, 1024))
+
+banner = load("banner-01.png")
+white = (banner.min(axis=-1) > 235).astype(np.uint8) * 255
+# Only the notch: white pixels connected to the bottom edge, found by a fill from below (no scipy: march upward).
+mask = np.zeros(white.shape, dtype=bool)
+mask[-1] = white[-1] > 0
+for y in range(white.shape[0] - 2, -1, -1):
+    row = (white[y] > 0) & (mask[y + 1] | np.roll(mask[y + 1], 1) | np.roll(mask[y + 1], -1))
+    mask[y] = row
+alpha = np.where(mask, 0, 255).astype(np.uint8)
+alpha = np.asarray(Image.fromarray(alpha).filter(ImageFilter.MinFilter(3)))
+rgba = np.dstack([banner.astype(np.uint8), alpha])
+img = Image.fromarray(rgba, "RGBA").resize((512, 1024), Image.LANCZOS)
+img.save(OUT / "T_Q_Banner_D.png")
+print("T_Q_Banner_D.png", img.size, img.mode, "cut", int(mask.sum()))
diff --git a/apps/vr/tools/look/seam_check.py b/apps/vr/tools/look/seam_check.py
new file mode 100644
index 0000000..fc4fd70
--- /dev/null
+++ b/apps/vr/tools/look/seam_check.py
@@ -0,0 +1,13 @@
+"""Reports how far a texture is from tiling: mean abs difference across the wrap seam vs. across an interior line."""
+import sys
+import numpy as np
+from PIL import Image
+
+for path in sys.argv[1:]:
+    a = np.asarray(Image.open(path).convert("RGB"), dtype=np.float32)
+    h, w, _ = a.shape
+    seam_x = np.abs(a[:, 0] - a[:, -1]).mean()
+    seam_y = np.abs(a[0] - a[-1]).mean()
+    in_x = np.abs(a[:, w // 2] - a[:, w // 2 - 1]).mean()
+    in_y = np.abs(a[h // 2] - a[h // 2 - 1]).mean()
+    print(f"{path}: seamX={seam_x:.1f} seamY={seam_y:.1f} interiorX={in_x:.1f} interiorY={in_y:.1f}")
