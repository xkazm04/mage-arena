+// The environment fire (braziers, pylons) and the Wardstone's rune flame: the painted flame, additive, licking (its UV
+// sways more toward the tips, per card phase d0) and flickering. TintAmount 0 keeps the painting's own fire colours (a
+// prop, never a threat); 1 recolours its brightness with Color (the Wardstone's Tithe violet).
+const TCHAR* EnvFireUvCode = TEXT("float lick = (1.0 - Uv.y);\n"
+                                  "float sway = sin(Uv.y * 8.0 - T * 5.5 + D0 * 6.0) * 0.045 + sin(Uv.y * 15.0 - T * 9.0 + D0) * 0.02;\n"
+                                  "return float2(Uv.x + sway * lick * lick, Uv.y + sin(T * 3.0 + D0 * 4.0) * 0.015 * lick);");
+const TCHAR* EnvFireCode = TEXT("float flick = 1.0 + 0.16 * sin(T * 11.0 + D0 * 7.0) + 0.08 * sin(T * 23.0 + D0 * 3.0);\n"
+                                "float luma = dot(Rgb, float3(0.3, 0.55, 0.15));\n"
+                                "return lerp(Rgb, luma * C * 2.4, Amount) * Gain * flick;");
+
+UMaterialExpressionScalarParameter* Param(FGraph& G, const TCHAR* Name, float Value)
+{
+	UMaterialExpressionScalarParameter* Node = G.Make<UMaterialExpressionScalarParameter>();
+	Node->ParameterName = Name;
+	Node->DefaultValue = Value;
+	return Node;
+}
