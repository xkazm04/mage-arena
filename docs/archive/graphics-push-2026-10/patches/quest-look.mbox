+int32 QuestLook::ApplyBrennic(UWorld& World)
+{
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	UMaterialInterface* Material = Cached.Get();
+	if (!Material)
+	{
+		Material = LoadObject<UMaterialInterface>(nullptr, *ObjectPath(TEXT("M_Q_Brennic")), nullptr, LOAD_NoWarn | LOAD_Quiet);
