diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreateCuffStyledCommandlet.cpp b/apps/vr/Game/Source/MageArenaVR/Tools/CreateCuffStyledCommandlet.cpp
new file mode 100644
index 0000000..3da39f4
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreateCuffStyledCommandlet.cpp
@@ -0,0 +1,108 @@
+#include "Tools/CreateCuffStyledCommandlet.h"
+
+#include "Look/CuffLook.h"
+#include "MageArenaVR.h"
+#include "Tools/MaterialGraph.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureObjectParameter.h"
+#include "ShaderCompiler.h"
+#endif
+
+UCreateCuffStyledCommandlet::UCreateCuffStyledCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UCreateCuffStyledCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	const FString Folder = CuffLook::Folder();
+
+	UMaterial* Panel = NewMaterial(Folder, TEXT("M_CuffStyled"));
+	Panel->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Panel->SetShadingModel(MSM_Unlit);
+	Panel->BlendMode = BLEND_Translucent;
+	Panel->TwoSided = true;
+	{
+		UMaterialExpressionTextureObjectParameter* Mask = Add<UMaterialExpressionTextureObjectParameter>(*Panel, -1000, 0);
+		Mask->ParameterName = TEXT("Mask");
+		Mask->Texture = LoadObject<UTexture2D>(nullptr, TEXT("/Engine/EngineResources/WhiteSquareTexture.WhiteSquareTexture"));
+		UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Panel, -500, 0);
+		Custom->Description = TEXT("CuffPanel");
+		Custom->OutputType = CMOT_Float4;
+		Custom->Inputs.Reset();
+		Input(*Custom, TEXT("Tex"), Mask);
+		Input(*Custom, TEXT("UV"), Add<UMaterialExpressionTextureCoordinate>(*Panel, -1000, 200));
+		Input(*Custom, TEXT("Cover"), Scalar(*Panel, TEXT("Cover"), 0.6, 300));
+		// The plane is 0.24 x 0.06 of a metre: the frame is a fixed ~3 mm band in each direction.
+		Custom->Code = TEXT(
+		    "float4 c = Texture2DSample(Tex, TexSampler, UV);\n"
+		    "float3 warm = lerp(c.rgb, dot(c.rgb, float3(0.3, 0.59, 0.11)).xxx, 0.25) * float3(1.0, 0.9, 0.74);\n"
+		    "float2 e = min(UV, 1.0 - UV) / float2(0.0125, 0.05);\n"
+		    "float edge = 1.0 - smoothstep(0.6, 1.0, min(e.x, e.y));\n"
+		    "float3 bronze = float3(0.42, 0.26, 0.11) * (0.8 + 0.4 * (1.0 - UV.y));\n"
+		    "float3 rgb = lerp(warm, bronze, edge);\n"
+		    "float a = max(c.a * Cover, edge * 0.92);\n"
+		    "return float4(rgb, a);\n");
+		UMaterialExpressionComponentMask* Rgb = Add<UMaterialExpressionComponentMask>(*Panel, -200, 0);
+		Rgb->Input.Connect(0, Custom);
+		Rgb->R = Rgb->G = Rgb->B = true;
+		Rgb->A = false;
+		UMaterialExpressionComponentMask* Alpha = Add<UMaterialExpressionComponentMask>(*Panel, -200, 150);
+		Alpha->Input.Connect(0, Custom);
+		Alpha->R = Alpha->G = Alpha->B = false;
+		Alpha->A = true;
+		Panel->GetEditorOnlyData()->EmissiveColor.Connect(0, Rgb);
+		Panel->GetEditorOnlyData()->Opacity.Connect(0, Alpha);
+	}
+	Panel->PreEditChange(nullptr);
+	Panel->PostEditChange();
+	Panel->MarkPackageDirty();
+
+	UMaterial* Rune = NewMaterial(Folder, TEXT("M_CuffRune"));
+	Rune->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Rune->SetShadingModel(MSM_Unlit);
+	{
+		UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Rune, -500, 0);
+		Custom->Description = TEXT("CuffRune");
+		Custom->OutputType = CMOT_Float3;
+		Custom->Inputs.Reset();
+		Input(*Custom, TEXT("C"), Vector(*Rune, TEXT("Color"), FLinearColor(0.6f, 0.5f, 0.3f), 0));
+		Input(*Custom, TEXT("UV"), Add<UMaterialExpressionTextureCoordinate>(*Rune, -1000, 200));
+		Input(*Custom, TEXT("Gain"), Scalar(*Rune, TEXT("Gain"), 1.6, 300));
+		Custom->Code = TEXT(
+		    "float mid = 1.0 - abs(UV.y - 0.5) * 2.0;\n"
+		    "return C * (0.55 + 0.75 * mid * mid) * Gain;\n");
+		Rune->GetEditorOnlyData()->EmissiveColor.Connect(0, Custom);
+	}
+	Rune->PreEditChange(nullptr);
+	Rune->PostEditChange();
+	Rune->MarkPackageDirty();
+
+	Panel->ForceRecompileForRendering();
+	Rune->ForceRecompileForRendering();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done cuff saved=%d"), Saved);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
