@@ -0,0 +1,29 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Commandlets/Commandlet.h"
+#include "CreateQuestLookAssetsCommandlet.generated.h"
+
+/**
+ * The quest look's assets under /Game/Look/Quest (Look/QuestLook.h), built headless so they are reproducible from the
+ * PNGs in apps/vr/art/look/quest (made by apps/vr/tools/look/prep_quest_textures.py from the studio stills):
+ *   T_Q_*_D (sRGB colour) and T_Q_*_N (normal maps), at most 2048 px, mips, the World texture groups;
+ *   M_Q_Surface  default lit, opaque: world-aligned mapping (top faces in X/Y, side faces along the face), the normal
+ *                map turned into world space along the same axes, contact darkening at the wall base and at the sand's
+ *                rim, and a macro variation (the colour map sampled at a large scale) against visible tiling;
+ *   MI_Q_<surface> one instance a surface (QuestLook::ESurface), the textures, tiling and tint;
+ *   M_Q_Sky      unlit sky (bIsSky), the panorama on the view direction, mirrored at +/-90 degrees of yaw;
+ *   M_Q_Banner   default lit, masked, two-sided cloth from the banner still (UV0).
+ * Every node is mobile-safe (no scene textures, no derivatives beyond texture sampling). Run through
+ * apps/vr/tools/look/create-quest-look-assets.ps1 (UnrealEditor-Cmd <uproject> -run=CreateQuestLookAssets). Always
+ * rebuilds everything (a dozen small assets). Editor builds only.
+ */
+UCLASS()
+class MAGEARENAVR_API UCreateQuestLookAssetsCommandlet : public UCommandlet
+{
+	GENERATED_BODY()
+
+public:
+	UCreateQuestLookAssetsCommandlet();
+	virtual int32 Main(const FString& Params) override;
+};
