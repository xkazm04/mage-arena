diff --git a/apps/vr/art/characters/brennic/epic/bake_epic.py b/apps/vr/art/characters/brennic/epic/bake_epic.py
new file mode 100644
index 0000000..ac9007d
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/bake_epic.py
@@ -0,0 +1,356 @@
+"""Brennic's epic-look texture set, baked onto the in-game mesh's own UVs (no geometry change, so SK_Brennic and its four
+clips stay exactly as committed in ad38b9b and the flat look is untouched).
+
+blender -b -P bake_epic.py -- <Brennic.fbx> <T_Brennic_BaseColor.png> <face_overlay.png> <outdir> [res]
+
+Writes into <outdir>:
+  T_BrennicEpic_BaseColor.png  sRGB albedo: the TRELLIS bake, regraded per region toward the concept palette
+                               (brick-red tunic, dark iron collar, bronze brooch), the face accents of face_overlay.py
+                               projected from the front, a light AO multiply, and the UV gutters dilated.
+  T_BrennicEpic_Normal.png     tangent-space normal, DirectX green (UE): hair curls, wool weave, the albedo's own folds.
+  T_BrennicEpic_ORM.png        R ambient occlusion, G roughness, B metallic, A subsurface (skin) mask. Linear.
+  masks.png                    region debug view.
+
+Steps: (1) Cycles EMIT bakes of object-space position and normal (the region masks need 3D position: the brooch, the
+head, the hair); (2) an AO bake; (3) an EMIT bake of the albedo with the face overlay projected along +X onto the
+front-facing head texels (the overlay is drawn in head_ortho.py's frame: centre z 1.62 m, 0.40 m square, image x = +Y);
+(4) numpy: masks, regrade, height -> normal, roughness/metal/subsurface; (5) gutter dilation.
+"""
+import math
+import os
+import sys
+
+import bpy
+import numpy as np
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+FBX, ALBEDO, OVERLAY, OUT = argv[0], argv[1], argv[2], argv[3]
+RES = int(argv[4]) if len(argv) > 4 else 2048
+HEAD_CZ, HEAD_SIZE = 1.62, 0.40
+os.makedirs(OUT, exist_ok=True)
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=FBX)
+mesh = None
+for o in bpy.data.objects:
+    if o.type == 'ARMATURE':
+        if o.animation_data:
+            o.animation_data.action = None
+            for t in o.animation_data.nla_tracks:
+                t.mute = True
+        o.data.pose_position = 'REST'
+    if o.type == 'MESH':
+        mesh = o
+assert mesh is not None
+bpy.context.view_layer.objects.active = mesh
+for o in bpy.data.objects:
+    o.select_set(o == mesh)
+
+scn = bpy.context.scene
+scn.render.engine = 'CYCLES'
+scn.cycles.device = 'CPU'
+scn.cycles.samples = 1
+scn.render.bake.margin = 0
+scn.render.bake.use_clear = True
+
+albedo_img = bpy.data.images.load(ALBEDO)
+overlay_img = bpy.data.images.load(OVERLAY)
+
+
+def new_target(name, is_float):
+    img = bpy.data.images.new(name, RES, RES, alpha=True, float_buffer=is_float)
+    img.colorspace_settings.name = 'Non-Color' if is_float else 'sRGB'
+    img.generated_color = (0, 0, 0, 0)
+    return img
+
+
+def bake_emit(build, target, kind='EMIT'):
+    """build(nt, out_socket_target) wires an emission colour; target is the image to bake into."""
+    mat = bpy.data.materials.new("Bake_" + target.name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for n in list(nt.nodes):
+        nt.nodes.remove(n)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    em.inputs["Strength"].default_value = 1.0
+    nt.links.new(em.outputs[0], out.inputs[0])
+    if kind == 'AO':
+        bsdf = nt.nodes.new("ShaderNodeBsdfDiffuse")
+        nt.links.new(bsdf.outputs[0], out.inputs[0])
+    else:
+        build(nt, em.inputs["Color"])
+    tex = nt.nodes.new("ShaderNodeTexImage")
+    tex.image = target
+    nt.nodes.active = tex
+    mesh.data.materials.clear()
+    mesh.data.materials.append(mat)
+    bpy.ops.object.bake(type=kind, margin=4, use_clear=True)  # margin: edge texels the coverage counts must hold values
+    px = np.empty(RES * RES * 4, dtype=np.float32)
+    target.pixels.foreach_get(px)
+    return px.reshape(RES, RES, 4)[::-1].copy()  # row 0 = top (v = 1)
+
+
+def geo_out(name):
+    def build(nt, sock):
+        g = nt.nodes.new("ShaderNodeNewGeometry")
+        if name == "Normal":
+            # map -1..1 -> 0..1 so a non-float path would survive; we read floats anyway
+            vm = nt.nodes.new("ShaderNodeVectorMath")
+            vm.operation = 'MULTIPLY_ADD'
+            vm.inputs[1].default_value = (0.5, 0.5, 0.5)
+            vm.inputs[2].default_value = (0.5, 0.5, 0.5)
+            nt.links.new(g.outputs["Normal"], vm.inputs[0])
+            nt.links.new(vm.outputs[0], sock)
+        else:
+            nt.links.new(g.outputs["Position"], sock)
+    return build
+
+
+pos = bake_emit(geo_out("Position"), new_target("pos", True))
+nrm = bake_emit(geo_out("Normal"), new_target("nrm", True))
+
+
+def uv_cover():
+    """Rasterises the UV triangles: True inside an island (a bake writes every texel, so its alpha cannot tell)."""
+    me = mesh.data
+    me.calc_loop_triangles()
+    uvl = me.uv_layers[0].data
+    mask = np.zeros((RES, RES), bool)
+    for tri in me.loop_triangles:
+        pts = np.array([uvl[li].uv[:] for li in tri.loops]) * RES
+        pts[:, 1] = RES - pts[:, 1]  # row 0 = top
+        x0, y0 = np.floor(pts.min(0)).astype(int)
+        x1, y1 = np.ceil(pts.max(0)).astype(int)
+        x0, y0 = max(x0, 0), max(y0, 0)
+        x1, y1 = min(x1, RES - 1), min(y1, RES - 1)
+        if x1 < x0 or y1 < y0:
+            continue
+        xs, ys = np.meshgrid(np.arange(x0, x1 + 1) + 0.5, np.arange(y0, y1 + 1) + 0.5)
+        (ax, ay), (bx, by), (cx, cy) = pts
+        d = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy)
+        if abs(d) < 1e-12:
+            continue
+        l1 = ((by - cy) * (xs - cx) + (cx - bx) * (ys - cy)) / d
+        l2 = ((cy - ay) * (xs - cx) + (ax - cx) * (ys - cy)) / d
+        l3 = 1 - l1 - l2
+        e = -0.6 / max(abs(d), 1.0) ** 0.5  # a hair of conservative growth
+        inside = (l1 >= e) & (l2 >= e) & (l3 >= e)
+        mask[y0:y1 + 1, x0:x1 + 1] |= inside
+    return mask
+
+
+cover = uv_cover()
+P = pos[..., :3]
+N = nrm[..., :3] * 2.0 - 1.0
+print("BAKE coverage %.3f" % cover.mean())
+
+scn.cycles.samples = 96
+scn.world = bpy.data.worlds.new("W")
+scn.world.use_nodes = True
+scn.world.node_tree.nodes["Background"].inputs[0].default_value = (1, 1, 1, 1)
+scn.world.light_settings.distance = 0.25
+ao = bake_emit(None, new_target("ao", True), kind='AO')[..., 0]
+scn.cycles.samples = 1
+
+
+def build_face(nt, sock):
+    tex = nt.nodes.new("ShaderNodeTexImage")
+    tex.image = albedo_img
+    uv = nt.nodes.new("ShaderNodeUVMap")
+    uv.uv_map = mesh.data.uv_layers[0].name
+    nt.links.new(uv.outputs[0], tex.inputs[0])
+    g = nt.nodes.new("ShaderNodeNewGeometry")
+    sep = nt.nodes.new("ShaderNodeSeparateXYZ")
+    nt.links.new(g.outputs["Position"], sep.inputs[0])
+    u = nt.nodes.new("ShaderNodeMath"); u.operation = 'MULTIPLY_ADD'
+    u.inputs[1].default_value = 1.0 / HEAD_SIZE; u.inputs[2].default_value = 0.5
+    nt.links.new(sep.outputs["Y"], u.inputs[0])
+    v = nt.nodes.new("ShaderNodeMath"); v.operation = 'MULTIPLY_ADD'
+    v.inputs[1].default_value = 1.0 / HEAD_SIZE; v.inputs[2].default_value = 0.5 - HEAD_CZ / HEAD_SIZE
+    nt.links.new(sep.outputs["Z"], v.inputs[0])
+    comb = nt.nodes.new("ShaderNodeCombineXYZ")
+    nt.links.new(u.outputs[0], comb.inputs[0]); nt.links.new(v.outputs[0], comb.inputs[1])
+    ov = nt.nodes.new("ShaderNodeTexImage"); ov.image = overlay_img; ov.extension = 'CLIP'
+    nt.links.new(comb.outputs[0], ov.inputs[0])
+    sepn = nt.nodes.new("ShaderNodeSeparateXYZ")
+    nt.links.new(g.outputs["Normal"], sepn.inputs[0])
+    face = nt.nodes.new("ShaderNodeMapRange")
+    face.inputs["From Min"].default_value = 0.15; face.inputs["From Max"].default_value = 0.45
+    nt.links.new(sepn.outputs["X"], face.inputs["Value"])
+    fac = nt.nodes.new("ShaderNodeMath"); fac.operation = 'MULTIPLY'
+    nt.links.new(ov.outputs["Alpha"], fac.inputs[0]); nt.links.new(face.outputs[0], fac.inputs[1])
+    mix = nt.nodes.new("ShaderNodeMix"); mix.data_type = 'RGBA'
+    nt.links.new(fac.outputs[0], mix.inputs["Factor"])
+    nt.links.new(tex.outputs["Color"], mix.inputs[6])
+    nt.links.new(ov.outputs["Color"], mix.inputs[7])
+    nt.links.new(mix.outputs[2], sock)
+
+
+face_bake = bake_emit(build_face, new_target("face", True))
+col = np.clip(face_bake[..., :3], 0, 1)  # linear
+
+# ---------------------------------------------------------------- masks (on the sRGB-encoded colour, like the eye)
+srgb = np.where(col <= 0.0031308, col * 12.92, 1.055 * np.power(col, 1 / 2.4) - 0.055)
+r, g, b = srgb[..., 0], srgb[..., 1], srgb[..., 2]
+mx = srgb.max(-1); mn = srgb.min(-1); dl = mx - mn
+sat = np.where(mx > 1e-4, dl / np.maximum(mx, 1e-4), 0)
+hue = np.zeros_like(mx)
+m = dl > 1e-4
+rr = (mx == r) & m; gg = (mx == g) & m & ~rr; bb = m & ~rr & ~gg
+hue[rr] = np.mod((g - b)[rr] / dl[rr], 6)
+hue[gg] = (b - r)[gg] / dl[gg] + 2
+hue[bb] = (r - g)[bb] / dl[bb] + 4
+hue *= 60
+X, Y, Z = P[..., 0], P[..., 1], P[..., 2]
+
+
+def smooth(e0, e1, x):
+    t = np.clip((x - e0) / (e1 - e0), 0, 1)
+    return t * t * (3 - 2 * t)
+
+
+redhue = np.maximum(smooth(13, 8, hue), smooth(335, 350, hue))
+tunic = redhue * smooth(0.38, 0.5, sat) * smooth(0.12, 0.2, mx) * smooth(0.55, 0.47, mx) * cover
+skin = smooth(4.0, 9.0, hue) * smooth(40, 28, hue) * smooth(0.22, 0.32, sat) * smooth(0.66, 0.56, sat) * smooth(0.40, 0.50, mx) * cover
+# The collar: head_ortho shows it from 1.49 to 1.58 m, a ring around the neck (radius under about 0.12 m), in a
+# near-neutral grey (about 70,68,67 sRGB) where skin, beard and cloak are all clearly warm.
+neck_r = np.hypot(X + 0.02, Y)
+band = smooth(1.46, 1.48, Z) * smooth(1.61, 1.59, Z) * smooth(0.15, 0.12, neck_r)
+grey = smooth(0.24, 0.14, sat) * smooth(0.12, 0.18, mx)
+iron = np.clip(band * grey, 0, 1) * cover
+brooch = smooth(0.045, 0.03, np.sqrt((Y + 0.007) ** 2 + (Z - 1.449) ** 2)) * (X > 0.0) * cover
+hairz = smooth(1.60, 1.66, Z)
+dark = smooth(0.36, 0.26, mx)
+hair = dark * np.maximum(hairz, smooth(1.52, 1.56, Z) * smooth(1.0, 0.95, mx)) * (1 - iron) * cover
+hair = np.clip(hair * (1 - skin), 0, 1)
+leather = smooth(14, 22, hue) * smooth(45, 36, hue) * smooth(0.35, 0.45, sat) * smooth(0.14, 0.2, mx) * smooth(0.5, 0.42, mx) * smooth(1.40, 1.30, Z) * cover
+leather *= (1 - skin) * (1 - tunic)
+cloak = np.clip(cover - tunic - skin - iron - hair - leather - brooch, 0, 1)
+
+# ---------------------------------------------------------------- gutter dilation (16 passes, 4-neighbour mean)
+
+
+def dilate(img, mask, passes=24):
+    img = img.copy()
+    mk = mask.astype(np.float32)
+    for _ in range(passes):
+        acc = np.zeros_like(img)
+        cnt = np.zeros(mk.shape, np.float32)
+        for sh, ax in ((1, 0), (-1, 0), (1, 1), (-1, 1)):
+            m2 = np.roll(mk, sh, ax)
+            acc += np.roll(img * mk[..., None], sh, ax)
+            cnt += m2
+        grow = (mk == 0) & (cnt > 0)
+        img[grow] = acc[grow] / cnt[grow][..., None]
+        mk = np.where(grow, 1.0, mk)
+    return img
+
+
+def fill(img, mask):
+    """Dilates the islands, then gives every texel still empty the islands' mean, so low mips do not bleed black."""
+    img = dilate(np.where(mask[..., None], img, 0), mask)
+    empty = (img.sum(-1) == 0) & ~mask
+    img[empty] = img[mask].mean(0)
+    return img
+
+
+# ---------------------------------------------------------------- regrade (linear space)
+lum = (col * np.array([0.2126, 0.7152, 0.0722])).sum(-1)
+
+
+def regrade(base, mask, target_srgb, keep=0.65):
+    """Moves a region's mean to target while keeping its own variation (luminance ratio)."""
+    t = (np.array(target_srgb) / 255.0) ** 2.2
+    w = mask[..., None]
+    sel = mask > 0.5
+    mean_l = lum[sel].mean() if sel.any() else 1.0
+    ratio = (lum / max(mean_l, 1e-4))[..., None]
+    graded = t * (keep * ratio + (1 - keep))
+    return base * (1 - w) + graded * w
+
+
+print("REGION means (sRGB):")
+for name, mk in [("tunic", tunic), ("skin", skin), ("iron", iron), ("hair", hair), ("leather", leather), ("cloak", cloak), ("brooch", brooch)]:
+    sel = mk > 0.5
+    print("  %-8s %6.3f  %s" % (name, sel.mean(), (srgb[sel].mean(0) * 255).astype(int) if sel.any() else "-"))
+
+out = col.copy()
+out = regrade(out, tunic, (128, 40, 34), keep=0.6)        # S1's deep crimson under the warm key
+out = regrade(out, iron, (74, 76, 82), keep=0.5)          # dark iron
+out = regrade(out, brooch, (138, 94, 46), keep=0.4)       # bronze
+out = regrade(out, cloak, (58, 46, 40), keep=0.85)        # charcoal brown
+out = regrade(out, leather, (112, 70, 42), keep=0.8)      # mid brown leather
+skin_t = np.array([1.06, 0.98, 0.92])
+out = out * (1 - skin[..., None] * 0.6) + out * skin_t * skin[..., None] * 0.6  # a touch warmer, less grey
+out *= (0.65 + 0.35 * ao)[..., None]                      # light AO in the albedo for the far read
+
+# ---------------------------------------------------------------- height -> normal
+rng = np.random.default_rng(3801)
+
+
+def blur(a, k):
+    # separable box blur x2 (approx gaussian), wraps; fine at island interiors
+    for _ in range(2):
+        a = sum(np.roll(a, s, 0) for s in range(-k, k + 1)) / (2 * k + 1)
+        a = sum(np.roll(a, s, 1) for s in range(-k, k + 1)) / (2 * k + 1)
+    return a
+
+
+uu, vv = np.meshgrid(np.arange(RES), np.arange(RES))
+weave = 0.5 + 0.25 * (np.sin(uu * 2 * math.pi / 3.0) + np.sin(vv * 2 * math.pi / 3.0))
+noise = rng.random((RES, RES)).astype(np.float32)
+curls = blur(noise, 2)
+curls = (curls - curls.mean()) / (curls.std() + 1e-6)
+lum_f = fill(np.repeat(lum[..., None], 3, -1), cover)[..., 0]  # gutters filled, so an island edge is no height step
+folds = lum_f - blur(lum_f, 8)  # the albedo's own high-pass: painted folds and strands
+height = (folds / (np.abs(folds).std() + 1e-6)) * 0.35
+height += curls * 0.9 * hair
+height += (weave - 0.5) * 0.6 * (tunic + cloak * 0.7)
+height += curls * 0.25 * leather
+# no "* cover": a step at the island border would print a dark crack along every UV seam
+strength = 2.2 / 255.0 * 40
+dx = (np.roll(height, -1, 1) - np.roll(height, 1, 1)) * 0.5
+dy = (np.roll(height, -1, 0) - np.roll(height, 1, 0)) * 0.5  # +row = -v
+inner = cover & np.roll(cover, 1, 0) & np.roll(cover, -1, 0) & np.roll(cover, 1, 1) & np.roll(cover, -1, 1)
+dx = np.clip(np.where(inner, dx, 0), -0.6, 0.6)
+dy = np.clip(np.where(inner, dy, 0), -0.6, 0.6)
+nx = -dx * strength
+ny_gl = dy * strength            # OpenGL: n.y = -dh/dv = +dh/drow
+nz = np.ones_like(nx)
+ln = np.sqrt(nx * nx + ny_gl * ny_gl + nz * nz)
+normal_dx = np.stack([nx / ln, -ny_gl / ln, nz / ln], -1)  # DirectX (UE): green flipped
+normal_rgb = normal_dx * 0.5 + 0.5
+
+# ---------------------------------------------------------------- ORM
+rough = 0.82 * cloak + 0.78 * tunic + 0.52 * skin + 0.42 * iron + 0.38 * brooch + 0.62 * hair + 0.58 * leather
+rough = np.where(cover, np.clip(rough / np.maximum(cloak + tunic + skin + iron + brooch + hair + leather, 1e-3), 0.3, 0.95), 0.8)
+metal = np.clip(0.75 * iron + 0.9 * brooch, 0, 1)
+orm = np.stack([ao, rough, metal, np.clip(skin, 0, 1)], -1)
+
+out = fill(out, cover)
+normal_rgb = fill(normal_rgb, cover)
+orm = fill(orm, cover)
+
+
+def save(name, arr, srgb_encode):
+    a = np.clip(arr, 0, 1)
+    if srgb_encode:
+        a = np.where(a <= 0.0031308, a * 12.92, 1.055 * np.power(a, 1 / 2.4) - 0.055)
+    if a.shape[-1] == 3:
+        a = np.concatenate([a, np.ones(a.shape[:2] + (1,), np.float32)], -1)
+    img = bpy.data.images.new(name, RES, RES, alpha=True)
+    # Before the pixels: changing the colour space afterwards regenerates the buffer (black).
+    img.colorspace_settings.name = 'Non-Color'  # values are already encoded as wanted
+    img.pixels.foreach_set(a[::-1].astype(np.float32).ravel())
+    img.filepath_raw = os.path.join(OUT, name)
+    img.file_format = 'PNG'
+    img.save()
+    print("SAVED", img.filepath_raw)
+
+
+save("T_BrennicEpic_BaseColor.png", out, True)
+save("T_BrennicEpic_Normal.png", normal_rgb, False)
+save("T_BrennicEpic_ORM.png", orm, False)
+dbg = np.stack([tunic + brooch, skin + leather * 0.5 + brooch, iron + hair * 0.6], -1)
+save("masks.png", dbg, False)
diff --git a/apps/vr/art/characters/brennic/epic/face_overlay.py b/apps/vr/art/characters/brennic/epic/face_overlay.py
new file mode 100644
index 0000000..99ff2ee
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/face_overlay.py
@@ -0,0 +1,102 @@
+"""Paints Brennic's face accents in the front-orthographic head space of head_ortho.py (1024 px, 0.40 m, centre z 1.62).
+
+Landmarks were read off head_ortho.png of the in-game albedo (2026-10-28): eyes at (430,368) and (595,368), brows at
+y 325, nose tip (512,470), mouth at y 540, the pale chin "U" at (510,560). The overlay is RGBA; bake_epic.py projects it
+onto the head's front-facing texels. Usage: python face_overlay.py <out.png>
+"""
+import random
+import sys
+from PIL import Image, ImageDraw, ImageFilter
+
+S = 4  # supersample
+W = 1024 * S
+
+
+def P(x, y):
+    return (x * S, y * S)
+
+
+def ellipse(d, cx, cy, rx, ry, fill):
+    d.ellipse([P(cx - rx, cy - ry), P(cx + rx, cy + ry)], fill=fill)
+
+
+def poly(d, pts, fill):
+    d.polygon([P(x, y) for x, y in pts], fill=fill)
+
+
+def line(d, pts, fill, width):
+    d.line([P(x, y) for x, y in pts], fill=fill, width=int(width * S), joint="curve")
+
+
+def eye(d, cx, cy, side):
+    # side -1 = image-left eye (his right), +1 = image-right. Scowl: the upper lid sits low and slopes down to the nose.
+    inner = cx - side * 34
+    outer = cx + side * 34
+    # socket shadow, soft
+    ellipse(d, cx, cy - 6, 46, 26, (92, 52, 38, 110))
+    # sclera almond, upper edge flattened by the low lid
+    poly(d, [(outer, cy + 2), (cx + side * 16, cy - 9), (cx - side * 12, cy - 11), (inner, cy + 1),
+             (cx - side * 12, cy + 11), (cx + side * 14, cy + 11)], (226, 214, 198, 255))
+    # iris and pupil, looking straight ahead
+    ellipse(d, cx, cy + 1, 12, 12, (78, 50, 32, 255))
+    ellipse(d, cx, cy + 1, 6, 6, (18, 12, 10, 255))
+    ellipse(d, cx - 4, cy - 3, 3, 3, (250, 245, 235, 255))  # catch light
+    # upper lid: thick dark lash line, lowered toward the nose (scowl)
+    line(d, [(outer + side * 4, cy + 2), (cx + side * 16, cy - 11), (cx - side * 12, cy - 12), (inner - side * 2, cy - 2)], (36, 22, 17, 255), 6)
+    # lid crease above
+    line(d, [(outer, cy - 8), (cx + side * 12, cy - 20), (cx - side * 14, cy - 19), (inner, cy - 9)], (110, 62, 46, 150), 4)
+    # lower lid line, softer
+    line(d, [(outer, cy + 4), (cx + side * 14, cy + 12), (cx - side * 12, cy + 12), (inner, cy + 3)], (120, 70, 55, 170), 3)
+
+
+def brow_hairs(d, x0, y0, x1, y1, seed):
+    rng = random.Random(seed)
+    for _ in range(160):
+        t = rng.random()
+        x = x0 + (x1 - x0) * t
+        y = y0 + (y1 - y0) * t + rng.uniform(-10, 10)
+        c = rng.choice([(30, 20, 15), (58, 38, 27), (40, 26, 19)])
+        line(d, [(x, y), (x + rng.uniform(6, 12) * (1 if x1 > x0 else -1), y - rng.uniform(1, 4))], c + (220,), 2)
+
+
+def brow(d, x0, y0, x1, y1, inner_is_x1):
+    # A thick tapered wedge; the inner end (toward the nose) is lower and heavier: the scowl.
+    thick_in, thick_out = 26, 14
+    if inner_is_x1:
+        poly(d, [(x0, y0 - thick_out / 2), (x1, y1 - thick_in / 2), (x1 + 4, y1 + thick_in / 2), (x0, y0 + thick_out / 2)], (44, 28, 20, 245))
+    else:
+        poly(d, [(x0 - 4, y0 - thick_in / 2), (x1, y1 - thick_out / 2), (x1, y1 + thick_out / 2), (x0 - 4, y0 + thick_in / 2)], (44, 28, 20, 245))
+
+
+def main(out):
+    img = Image.new("RGBA", (W, W), (0, 0, 0, 0))
+    d = ImageDraw.Draw(img, "RGBA")
+    # frown crease and brow-ridge shadow between the brows
+    line(d, [(506, 340), (503, 368)], (100, 54, 40, 150), 3)
+    line(d, [(518, 340), (521, 368)], (100, 54, 40, 150), 3)
+    brow(d, 368, 312, 492, 342, True)
+    brow(d, 532, 342, 656, 312, False)
+    brow_hairs(d, 372, 314, 490, 340, 1)
+    brow_hairs(d, 652, 314, 534, 340, 2)
+    eye(d, 430, 370, -1)
+    eye(d, 595, 370, +1)
+    # nose: nostrils and the shadow under the tip
+    ellipse(d, 492, 482, 9, 6, (70, 36, 28, 230))
+    ellipse(d, 532, 482, 9, 6, (70, 36, 28, 230))
+    ellipse(d, 512, 492, 30, 7, (110, 60, 45, 120))
+    # mouth: cover the pale chin U with beard, then a lower lip and a hard, down-turned mouth line
+    rng = random.Random(3801)
+    for _ in range(900):
+        # beard strands over the pale chin U, in the beard's own browns
+        x = rng.uniform(440, 585)
+        y = rng.uniform(535, 618)
+        c = rng.choice([(62, 38, 26), (74, 46, 32), (52, 32, 22), (86, 54, 36)])
+        line(d, [(x, y), (x + rng.uniform(-5, 5), y + rng.uniform(8, 16))], c + (230,), 3)
+    ellipse(d, 512, 553, 30, 8, (132, 72, 58, 255))
+    line(d, [(470, 551), (488, 544), (512, 542), (536, 544), (554, 551)], (34, 18, 14, 255), 7)
+    img = img.filter(ImageFilter.GaussianBlur(1.2 * S)).resize((1024, 1024), Image.LANCZOS)
+    img.save(out)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/apps/vr/art/characters/brennic/epic/head_ortho.py b/apps/vr/art/characters/brennic/epic/head_ortho.py
new file mode 100644
index 0000000..b263b0d
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/head_ortho.py
@@ -0,0 +1,33 @@
+# Blender: front orthographic render of Brennic's head in the bind pose (unlit albedo), for placing face landmarks.
+# blender -b -P head_ortho.py -- <fbx> <albedo.png> <out.png> [centre_z] [ortho_m] [res]
+import bpy, sys, math
+argv = sys.argv[sys.argv.index("--") + 1:]
+fbx, albedo, out = argv[0], argv[1], argv[2]
+cz = float(argv[3]) if len(argv) > 3 else 1.62
+size = float(argv[4]) if len(argv) > 4 else 0.40
+res = int(argv[5]) if len(argv) > 5 else 1024
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=fbx)
+for o in bpy.data.objects:
+    if o.type == 'ARMATURE' and o.animation_data:
+        o.animation_data.action = None
+        for t in o.animation_data.nla_tracks: t.mute = True
+    if o.type == 'ARMATURE':
+        o.data.pose_position = 'REST'
+img = bpy.data.images.load(albedo)
+mat = bpy.data.materials.new("M"); mat.use_nodes = True; nt = mat.node_tree
+for n in list(nt.nodes): nt.nodes.remove(n)
+tex = nt.nodes.new("ShaderNodeTexImage"); tex.image = img
+em = nt.nodes.new("ShaderNodeEmission"); outn = nt.nodes.new("ShaderNodeOutputMaterial")
+nt.links.new(tex.outputs[0], em.inputs[0]); nt.links.new(em.outputs[0], outn.inputs[0])
+for o in bpy.data.objects:
+    if o.type == 'MESH':
+        o.data.materials.clear(); o.data.materials.append(mat)
+scn = bpy.context.scene
+scn.render.engine = 'CYCLES'; scn.cycles.samples = 4; scn.cycles.device = 'CPU'
+scn.view_settings.view_transform = 'Standard'
+scn.render.resolution_x = res; scn.render.resolution_y = res
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam")); scn.collection.objects.link(cam); scn.camera = cam
+cam.data.type = 'ORTHO'; cam.data.ortho_scale = size
+cam.location = (3.0, 0.0, cz); cam.rotation_euler = (math.radians(90), 0, math.radians(90))
+scn.render.filepath = out; bpy.ops.render.render(write_still=True)
diff --git a/apps/vr/art/characters/brennic/epic/inspect.py b/apps/vr/art/characters/brennic/epic/inspect.py
new file mode 100644
index 0000000..d15fbdf
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/inspect.py
@@ -0,0 +1,64 @@
+# Blender: import the in-game Brennic FBX + albedo, print mesh/UV/material facts, render front, 3/4 and face close-ups.
+# blender -b -P inspect.py -- <fbx> <albedo.png> <outdir> [normal.png] [orm.png]
+import bpy, sys, os, math, mathutils
+argv = sys.argv[sys.argv.index("--") + 1:]
+fbx, albedo, out = argv[0], argv[1], argv[2]
+normal = argv[3] if len(argv) > 3 and argv[3] != "-" else None
+os.makedirs(out, exist_ok=True)
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=fbx)
+meshes = [o for o in bpy.data.objects if o.type == 'MESH']
+arm = [o for o in bpy.data.objects if o.type == 'ARMATURE']
+for o in meshes:
+    me = o.data
+    print("MESH", o.name, len(me.vertices), len(me.polygons), "uvs", [u.name for u in me.uv_layers], "mats", [m.name if m else None for m in me.materials])
+    print("  dims", tuple(round(d, 3) for d in o.dimensions), "scale", tuple(o.scale), "parent", o.parent.name if o.parent else None)
+for a in arm:
+    print("ARM", a.name, len(a.data.bones), [b.name for b in a.data.bones][:30], "scale", tuple(a.scale))
+    print("  actions", [ac.name for ac in bpy.data.actions])
+    if a.animation_data:
+        a.animation_data.action = None
+        for t in a.animation_data.nla_tracks:
+            t.mute = True
+img = bpy.data.images.load(albedo)
+nimg = bpy.data.images.load(normal) if normal else None
+if nimg: nimg.colorspace_settings.name = 'Non-Color'
+mat = bpy.data.materials.new("M_Look")
+mat.use_nodes = True
+nt = mat.node_tree
+bsdf = nt.nodes["Principled BSDF"]
+tex = nt.nodes.new("ShaderNodeTexImage"); tex.image = img
+nt.links.new(tex.outputs["Color"], bsdf.inputs["Base Color"])
+bsdf.inputs["Roughness"].default_value = 0.7
+if nimg:
+    nt2 = nt.nodes.new("ShaderNodeTexImage"); nt2.image = nimg
+    nm = nt.nodes.new("ShaderNodeNormalMap")
+    nt.links.new(nt2.outputs["Color"], nm.inputs["Color"]); nt.links.new(nm.outputs["Normal"], bsdf.inputs["Normal"])
+for o in meshes:
+    o.data.materials.clear(); o.data.materials.append(mat)
+# bounds
+bb = [m.matrix_world @ mathutils.Vector(c) for m in meshes for c in m.bound_box]
+zmin = min(v.z for v in bb); zmax = max(v.z for v in bb)
+print("ZRANGE", zmin, zmax)
+H = zmax - zmin
+scn = bpy.context.scene
+scn.render.engine = 'BLENDER_EEVEE' if 'BLENDER_EEVEE' in [e.identifier for e in bpy.types.RenderSettings.bl_rna.properties['engine'].enum_items] else 'BLENDER_EEVEE_NEXT'
+scn.render.resolution_x = 768; scn.render.resolution_y = 1024
+scn.world = bpy.data.worlds.new("W"); scn.world.use_nodes = True
+scn.world.node_tree.nodes["Background"].inputs[0].default_value = (0.45, 0.45, 0.47, 1); scn.world.node_tree.nodes["Background"].inputs[1].default_value = 0.6
+sun = bpy.data.objects.new("Sun", bpy.data.lights.new("Sun", 'SUN')); scn.collection.objects.link(sun)
+sun.data.energy = 3.0; sun.rotation_euler = (math.radians(50), 0, math.radians(-120))
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam")); scn.collection.objects.link(cam); scn.camera = cam
+def shoot(name, target, dist, yaw_deg, lens):
+    yaw = math.radians(yaw_deg)
+    # +X forward per handoff
+    pos = mathutils.Vector(target) + mathutils.Vector((math.cos(yaw) * dist, math.sin(yaw) * dist, 0))
+    cam.location = pos; cam.data.lens = lens
+    d = mathutils.Vector(target) - pos
+    cam.rotation_euler = d.to_track_quat('-Z', 'Y').to_euler()
+    scn.render.filepath = os.path.join(out, name); bpy.ops.render.render(write_still=True)
+fwd = float(os.environ.get("BR_FWD_DEG", "0"))
+shoot("full_front.png", (0, 0, zmin + H * 0.5), 4.5, fwd, 50)
+shoot("full_34.png", (0, 0, zmin + H * 0.5), 4.5, fwd + 35, 50)
+shoot("face_front.png", (0, 0, zmin + H * 0.90), 1.0, fwd, 60)
+shoot("face_34.png", (0, 0, zmin + H * 0.90), 1.0, fwd + 35, 60)
