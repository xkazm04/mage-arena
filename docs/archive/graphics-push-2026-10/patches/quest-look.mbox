+TArray<FVector> QuestLook::BuildPylons(AActor& Owner, const FArenaLayout& Layout, bool bFloorFires)
+{
+	UStaticMesh* Cube = Greybox::LoadShape(TEXT("Cube"));
+	// S1's stone pylons with fire bowls, standing on the first tread in front of the crowd, two either side of the
+	// seat's forward view. Their bowls are the brazier's own pieces and flames (BrazierFire), lifted to the pylon top.
+	UMaterialInterface* PylonMaterial = Surface(ESurface::Pylon);
+	UMaterialInterface* IronMaterial = Surface(ESurface::Iron);
+	UStaticMesh* Cylinder = Greybox::LoadShape(TEXT("Cylinder"));
+	TArray<FVector> FireCentresCm;
+	if (Cube && Cylinder && PylonMaterial && IronMaterial && Layout.StandTiers > 0)
+	{
+		UInstancedStaticMeshComponent* Stone = Greybox::MakeInstances(&Owner, Cube, PylonMaterial);
+		UInstancedStaticMeshComponent* Bowls = Greybox::MakeInstances(&Owner, Cylinder, IronMaterial);
+		Stone->SetCastShadow(true);
+		// D-G4 headroom (r6): the bowls, the ledge and the wall cloth throw no shadow worth a shadow-depth draw each.
+		Bowls->SetCastShadow(false);
+		FArenaLayout Fires = Layout;
+		Fires.Braziers.Reset();
+		const double TopM = PylonTopM(Layout);
+		for (int32 Index = 0; Index < PylonCount; ++Index)
+		{
+			const ArenaStands::FStandBox Box = ArenaStands::StandBox(Layout, PylonSegment(Layout, Index), 0);
+			const FVector Base = PylonBaseM(Layout, Index);
+			const FQuat Turn = FRotationMatrix::MakeFromXZ(Box.Along, FVector::UpVector).ToQuat();
+			Greybox::AddSized(Stone, ToCm(FVector(Base.X, Base.Y, TopM * 0.5)), Turn, ToCm(FVector(1.1, 1.1, TopM)));
+			Greybox::AddSized(Stone, ToCm(FVector(Base.X, Base.Y, TopM - 0.12)), Turn, ToCm(FVector(1.35, 1.35, 0.24)));
+			FArenaProp Fire;
+			Fire.PositionM = FVector(Base.X, Base.Y, 0.0);
+			Fire.StandHeightM = TopM;
+			Fire.BowlRadiusM = 0.72;
+			Fire.BowlHeightM = 0.36;
+			Fire.FlameRadiusM = 0.62;
+			TArray<BrazierFire::FPiece> Pieces;
+			BrazierFire::BowlPieces(Fire, Pieces);
+			for (const BrazierFire::FPiece& Piece : Pieces)
+			{
+				// The foot and the stem stay inside the pylon; only the bowl's rings above its top show.
+				if (Piece.CentreM.Z > TopM - 0.2)
+				{
+					Greybox::AddSized(Bowls, ToCm(Piece.CentreM), FQuat::Identity, ToCm(Piece.SizeM));
+				}
+			}
+			Fires.Braziers.Add(Fire);
+			FireCentresCm.Add(ToCm(FVector(Base.X, Base.Y, TopM + Fire.BowlHeightM + 0.3)));
+		}
+		// The epic look burns its own floor-brazier flames; it takes only the pylon fires here.
+		FArenaLayout FloorFires = Layout;
+		if (!bFloorFires)
+		{
+			FloorFires.Braziers.Reset();
+		}
+		BuildFireCards(Owner, FloorFires, Fires);
+	}
+	return FireCentresCm;
+}
