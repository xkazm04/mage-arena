diff --git a/apps/vr/Game/Source/MageArenaVR/Session/SessionPresentation.cpp b/apps/vr/Game/Source/MageArenaVR/Session/SessionPresentation.cpp
index 2db5597..5c0d33b 100644
--- a/apps/vr/Game/Source/MageArenaVR/Session/SessionPresentation.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Session/SessionPresentation.cpp
@@ -1799,6 +1799,14 @@ void ASessionPresentation::Sync(const FArenaSession& Session, bool bPaused)
 					QuestSpells::TrailFlamePuffs(At, Flight.GetSafeNormal(), Core, Now, Projectile.Id, Puffs);
 				}
 				HaloFrame.FindOrAdd(Shot.Glow.GetValue()).Add(QuestSpells::FacingCard(At, GlowFrame.EyeCm, Core * 5.0));
+				// Judge round 2: a warm bolt (Fire) gets a white-gold hot heart, an HDR additive card just in front of its core,
+				// brightest at the centre; cool elements keep their own colour (the threat language).
+				const FLinearColor& Glow = Shot.Glow.GetValue();
+				if (Glow.R - Glow.B > 0.3f)
+				{
+					const FVector EyeSide = (GlowFrame.EyeCm - At).GetSafeNormal();
+					HaloFrame.FindOrAdd(QuestSpells::HotHeartColour).Add(QuestSpells::FacingCard(At + EyeSide * Core * 0.6, GlowFrame.EyeCm, Core * 1.7));
+				}
 				// Steam and spray where an enemy bolt nears the raised ward: the ward's own water, in the player's colour.
 				const UGameInstance* Instance = GetGameInstance();
 				const UHandInputSubsystem* Hands = Instance ? Instance->GetSubsystem<UHandInputSubsystem>() : nullptr;
-- 
