+#if WITH_EDITOR
+namespace
+{
+FString PackagePath(const TCHAR* Name)
+{
+	return FString::Printf(TEXT("%s/%s"), QuestLook::Folder, Name);
+}
+
+bool Save(UObject* Asset, const TCHAR* Name)
+{
+	UPackage* Package = Asset->GetOutermost();
+	const FString File = FPackageName::LongPackageNameToFilename(Package->GetName(), FPackageName::GetAssetPackageExtension());
+	FSavePackageArgs SaveArgs;
+	SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;
+	SaveArgs.SaveFlags = SAVE_NoError;
+	if (!UPackage::SavePackage(Package, Asset, *File, SaveArgs))
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_QUEST_ASSETS fail %s save %s"), Name, *File);
+		return false;
+	}
+	return true;
+}
+
+enum class ETextureKind : uint8
+{
+	Colour,
+	Normal,
+	Sky,
+	Cloth
+};
+
+UTexture2D* ImportTexture(const TCHAR* Name, ETextureKind Kind)
+{
+	const FString Png = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/look/quest"), FString(Name) + TEXT(".png")));
+	if (!FPaths::FileExists(Png))
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_QUEST_ASSETS fail %s missing %s"), Name, *Png);
+		return nullptr;
+	}
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>("AssetTools").Get();
+	UAssetImportTask* Task = NewObject<UAssetImportTask>();
+	Task->Filename = Png;
+	Task->DestinationPath = QuestLook::Folder;
+	Task->DestinationName = Name;
+	Task->bReplaceExisting = true;
+	Task->bReplaceExistingSettings = true;
+	Task->bAutomated = true;
+	Task->bSave = false;
+	AssetTools.ImportAssetTasks({Task});
+	UTexture2D* Texture = nullptr;
+	for (UObject* Object : Task->GetObjects())
+	{
+		Texture = Texture ? Texture : Cast<UTexture2D>(Object);
+	}
+	if (!Texture)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_QUEST_ASSETS fail %s import %s"), Name, *Png);
+		return nullptr;
+	}
+	Texture->MipGenSettings = TMGS_FromTextureGroup;
+	switch (Kind)
+	{
+	case ETextureKind::Normal:
+		Texture->SRGB = false;
+		Texture->CompressionSettings = TC_Normalmap;
+		Texture->LODGroup = TEXTUREGROUP_WorldNormalMap;
+		break;
+	case ETextureKind::Sky:
+		Texture->SRGB = true;
+		Texture->CompressionSettings = TC_Default;
+		Texture->LODGroup = TEXTUREGROUP_Skybox;
+		Texture->AddressY = TA_Clamp;
+		break;
+	default:
+		Texture->SRGB = true;
+		Texture->CompressionSettings = TC_Default;
+		Texture->LODGroup = TEXTUREGROUP_World;
+		break;
+	}
+	if (Kind == ETextureKind::Cloth)
+	{
+		Texture->AddressX = TA_Clamp;
+		Texture->AddressY = TA_Clamp;
+	}
+	Texture->PostEditChange();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (!Save(Texture, Name))
+	{
+		return nullptr;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS %s %dx%d srgb=%d kind=%d"), Name, Texture->Source.GetSizeX(), Texture->Source.GetSizeY(), Texture->SRGB ? 1 : 0, static_cast<int32>(Kind));
+	return Texture;
+}
+
+/** A material under construction: its expressions are added to its graph as they are made. */
+struct FGraph
+{
+	UMaterial* Material = nullptr;
+	int32 Next = 0;
+
+	template <typename T>
+	T* Make()
+	{
+		T* Expression = NewObject<T>(Material);
+		Expression->MaterialExpressionEditorX = -300 * (1 + Next % 4);
+		Expression->MaterialExpressionEditorY = 120 * Next;
+		++Next;
+		Material->GetExpressionCollection().AddExpression(Expression);
+		return Expression;
+	}
+
+	UMaterialExpression* Scalar(const TCHAR* Name, float Value)
+	{
+		UMaterialExpressionScalarParameter* Parameter = Make<UMaterialExpressionScalarParameter>();
+		Parameter->ParameterName = Name;
+		Parameter->DefaultValue = Value;
+		return Parameter;
+	}
+
+	UMaterialExpression* Vector(const TCHAR* Name, const FLinearColor& Value)
+	{
+		UMaterialExpressionVectorParameter* Parameter = Make<UMaterialExpressionVectorParameter>();
+		Parameter->ParameterName = Name;
+		Parameter->DefaultValue = Value;
+		return Parameter;
+	}
+
+	UMaterialExpressionTextureSampleParameter2D* Texture(const TCHAR* Name, UTexture2D* Default, EMaterialSamplerType Sampler, UMaterialExpression* Uv)
+	{
+		UMaterialExpressionTextureSampleParameter2D* Sample = Make<UMaterialExpressionTextureSampleParameter2D>();
+		Sample->ParameterName = Name;
+		Sample->Texture = Default;
+		Sample->SamplerType = Sampler;
+		Sample->Coordinates.Expression = Uv;
+		return Sample;
+	}
+
+	struct FIn
+	{
+		const TCHAR* Name;
+		UMaterialExpression* Expression;
+		int32 Output = 0;
+	};
+
+	UMaterialExpression* Custom(const TCHAR* Description, ECustomMaterialOutputType Type, const TCHAR* Code, std::initializer_list<FIn> Inputs)
+	{
+		UMaterialExpressionCustom* Node = Make<UMaterialExpressionCustom>();
+		Node->Description = Description;
+		Node->OutputType = Type;
+		Node->Code = Code;
+		Node->Inputs.Reset();
+		for (const FIn& In : Inputs)
+		{
+			FCustomInput& Input = Node->Inputs.AddDefaulted_GetRef();
+			Input.InputName = In.Name;
+			Input.Input.Connect(In.Output, In.Expression);
+		}
+		return Node;
+	}
+};
+
+UMaterial* NewMaterial(const TCHAR* Name)
+{
+	UPackage* Package = CreatePackage(*PackagePath(Name));
+	UMaterial* Material = NewObject<UMaterial>(Package, Name, RF_Public | RF_Standalone | RF_Transactional);
+	Material->MaterialDomain = MD_Surface;
+	return Material;
+}
+
+bool Finish(UMaterial* Material, const TCHAR* Name)
+{
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	if (!Save(Material, Name))
+	{
+		return false;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS %s built"), Name);
+	return true;
+}
+
+// World-aligned UV in centimetres over Tile: a face that points up (or down) maps X/Y, a side face maps along the face
+// (its horizontal tangent) and down the height, so the boxes' blocks stand upright on every wall segment.
+const TCHAR* UvCode = TEXT(
+    "float top = saturate((abs(N.z) - 0.6) * 10.0);\n"
+    "float2 side = float2(dot(P.xy, float2(-N.y, N.x)), -P.z);\n"
+    "float2 flat = float2(P.x, P.y);\n"
+    "return lerp(side, flat, top) / max(Tile.xy, 1.0);");
+
+// The tangent-space sample (green down, as prep_quest_textures.py writes it) into world space along the UV's axes.
+const TCHAR* NormalCode = TEXT(
+    "float top = saturate((abs(N.z) - 0.6) * 10.0);\n"
+    "float3 T = lerp(float3(-N.y, N.x, 0.0), float3(1.0, 0.0, 0.0), top);\n"
+    "float3 B = lerp(float3(0.0, 0.0, 1.0), float3(0.0, -1.0, 0.0), top);\n"
+    "float3 n = float3(Nt.xy * Strength, max(Nt.z, 0.05));\n"
+    "return normalize(T * n.x + B * n.y + N * n.z);");
+
+// Baked-style contact darkening, no SSAO: a ramp up from the sand (z = 0) on anything that stands on it, and a rim of
+// shade on the sand where it meets the ellipse wall; a large-scale sample of the colour map breaks up the tiling.
+const TCHAR* ShadeCode = TEXT(
+    "float base = lerp(ContactDark, 1.0, saturate(P.z / max(ContactHeight, 1.0)));\n"
+    "float r = length(P.xy / max(Ellipse.xy, 1.0));\n"
+    "float rim = lerp(1.0, EllipseDark, saturate((r - 0.84) / 0.16));\n"
+    "float luma = dot(Macro.rgb, float3(0.2126, 0.7152, 0.0722));\n"
+    "float macro = lerp(1.0, saturate(luma / 0.45), MacroStrength);\n"
+    "return base * rim * macro;");
+
+UMaterial* BuildSurface(UTexture2D* Colour, UTexture2D* Normal)
+{
+	const TCHAR* Name = TEXT("M_Q_Surface");
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Opaque;
+	Material->SetShadingModel(MSM_DefaultLit);
+	Material->bTangentSpaceNormal = false;
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	Material->SetUsageByFlag(MATUSAGE_StaticLighting, true);
+
+	UMaterialExpressionWorldPosition* Position = G.Make<UMaterialExpressionWorldPosition>();
+	UMaterialExpressionVertexNormalWS* VertexNormal = G.Make<UMaterialExpressionVertexNormalWS>();
+	UMaterialExpression* Tile = G.Vector(TEXT("Tile"), FLinearColor(300.f, 300.f, 0.f, 0.f));
+	UMaterialExpression* Uv = G.Custom(TEXT("WorldUv"), CMOT_Float2, UvCode, {{TEXT("P"), Position}, {TEXT("N"), VertexNormal}, {TEXT("Tile"), Tile}});
+	UMaterialExpressionTextureSampleParameter2D* Base = G.Texture(TEXT("BaseTex"), Colour, SAMPLERTYPE_Color, Uv);
+	UMaterialExpressionTextureSampleParameter2D* Bump = G.Texture(TEXT("NormalTex"), Normal, SAMPLERTYPE_Normal, Uv);
+	UMaterialExpression* MacroScale = G.Scalar(TEXT("MacroScale"), 0.11f);
+	UMaterialExpressionMultiply* MacroUv = G.Make<UMaterialExpressionMultiply>();
+	MacroUv->A.Expression = Uv;
+	MacroUv->B.Expression = MacroScale;
+	UMaterialExpressionTextureSampleParameter2D* Macro = G.Texture(TEXT("MacroTex"), Colour, SAMPLERTYPE_Color, MacroUv);
+	UMaterialExpression* Shade = G.Custom(TEXT("ContactShade"), CMOT_Float1, ShadeCode,
+	    {{TEXT("P"), Position}, {TEXT("ContactHeight"), G.Scalar(TEXT("ContactHeight"), 1.f)}, {TEXT("ContactDark"), G.Scalar(TEXT("ContactDark"), 1.f)},
+	        {TEXT("Ellipse"), G.Vector(TEXT("Ellipse"), FLinearColor(1.0e6f, 1.0e6f, 0.f, 0.f))}, {TEXT("EllipseDark"), G.Scalar(TEXT("EllipseDark"), 1.f)}, {TEXT("Macro"), Macro},
+	        {TEXT("MacroStrength"), G.Scalar(TEXT("MacroStrength"), 0.f)}});
+	UMaterialExpressionMultiply* Tinted = G.Make<UMaterialExpressionMultiply>();
+	Tinted->A.Connect(0, Base);
+	Tinted->B.Expression = G.Vector(TEXT("Tint"), FLinearColor::White);
+	UMaterialExpressionMultiply* Shaded = G.Make<UMaterialExpressionMultiply>();
+	Shaded->A.Expression = Tinted;
+	Shaded->B.Expression = Shade;
+	UMaterialExpression* WorldNormal = G.Custom(TEXT("WorldNormal"), CMOT_Float3, NormalCode,
+	    {{TEXT("Nt"), Bump}, {TEXT("N"), VertexNormal}, {TEXT("Strength"), G.Scalar(TEXT("NormalStrength"), 1.f)}});
+
+	Material->GetEditorOnlyData()->BaseColor.Expression = Shaded;
+	Material->GetEditorOnlyData()->Normal.Expression = WorldNormal;
+	Material->GetEditorOnlyData()->Roughness.Expression = G.Scalar(TEXT("Roughness"), 0.85f);
+	Material->GetEditorOnlyData()->Specular.Expression = G.Scalar(TEXT("Specular"), 0.3f);
+	Material->GetEditorOnlyData()->Metallic.Expression = G.Scalar(TEXT("Metallic"), 0.f);
+	Material->GetEditorOnlyData()->AmbientOcclusion.Expression = Shade;
+	return Finish(Material, Name) ? Material : nullptr;
+}
+
+// The panorama on the view direction: yaw 0 (+X, down the arena from the dais) is the still's centre and +/-90 degrees its
+// edges, mirrored beyond (the seated yaw limit is 100); the still's bottom (the hills) sits at Low and its top at High.
+const TCHAR* SkyUvCode = TEXT(
+    "float3 d = -V;\n"
+    "float t = atan2(d.y, d.x) / 3.14159265;\n"
+    "float f = 0.5 - abs(abs(t) - 0.5);\n"
+    "float u = 0.5 + sign(t) * f;\n"
+    "float v = 1.0 - saturate((d.z - Low) / max(High - Low, 0.01));\n"
+    "return float2(u, v);");
+
+UMaterial* BuildSky(UTexture2D* Panorama)
+{
+	const TCHAR* Name = TEXT("M_Q_Sky");
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Opaque;
+	Material->SetShadingModel(MSM_Unlit);
+	Material->TwoSided = true;
+	Material->bIsSky = true;
+	UMaterialExpressionCameraVectorWS* View = G.Make<UMaterialExpressionCameraVectorWS>();
+	UMaterialExpression* Uv = G.Custom(TEXT("SkyUv"), CMOT_Float2, SkyUvCode,
+	    {{TEXT("V"), View}, {TEXT("Low"), G.Scalar(TEXT("LowSin"), 0.12f)}, {TEXT("High"), G.Scalar(TEXT("HighSin"), 0.85f)}});
+	UMaterialExpressionTextureSampleParameter2D* Sample = G.Texture(TEXT("SkyTex"), Panorama, SAMPLERTYPE_Color, Uv);
+	UMaterialExpressionMultiply* Lit = G.Make<UMaterialExpressionMultiply>();
+	Lit->A.Connect(0, Sample);
+	Lit->B.Expression = G.Vector(TEXT("SkyTint"), FLinearColor(1.f, 1.f, 1.f, 1.f));
+	UMaterialExpressionMultiply* Bright = G.Make<UMaterialExpressionMultiply>();
+	Bright->A.Expression = Lit;
+	Bright->B.Expression = G.Scalar(TEXT("SkyBrightness"), 1.f);
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Bright;
+	return Finish(Material, Name) ? Material : nullptr;
+}
+
+UMaterial* BuildBanner(UTexture2D* Cloth)
+{
+	const TCHAR* Name = TEXT("M_Q_Banner");
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Masked;
+	Material->OpacityMaskClipValue = 0.5f;
+	Material->SetShadingModel(MSM_DefaultLit);
+	Material->TwoSided = true;
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	UMaterialExpressionTextureCoordinate* Uv = G.Make<UMaterialExpressionTextureCoordinate>();
+	UMaterialExpressionTextureSampleParameter2D* Sample = G.Texture(TEXT("ClothTex"), Cloth, SAMPLERTYPE_Color, Uv);
+	UMaterialExpressionMultiply* Tinted = G.Make<UMaterialExpressionMultiply>();
+	Tinted->A.Connect(0, Sample);
+	Tinted->B.Expression = G.Vector(TEXT("Tint"), FLinearColor::White);
+	Material->GetEditorOnlyData()->BaseColor.Expression = Tinted;
+	Material->GetEditorOnlyData()->OpacityMask.Connect(4, Sample);
+	Material->GetEditorOnlyData()->Roughness.Expression = G.Scalar(TEXT("Roughness"), 0.9f);
+	Material->GetEditorOnlyData()->Specular.Expression = G.Scalar(TEXT("Specular"), 0.2f);
+	return Finish(Material, Name) ? Material : nullptr;
+}
+
+struct FSurfaceSpec
+{
+	QuestLook::ESurface Surface;
+	const TCHAR* Colour;
+	const TCHAR* Normal;
+	FVector2f TileCm;
+	FLinearColor Tint;
+	float Roughness = 0.85f;
+	float NormalStrength = 1.f;
+	float ContactHeightCm = 1.f;
+	float ContactDark = 1.f;
+	float EllipseDark = 1.f;
+	float MacroStrength = 0.f;
+	float Specular = 0.3f;
+};
+
+bool BuildInstance(UMaterial* Parent, const FSurfaceSpec& Spec, const TMap<FString, UTexture2D*>& Textures, const FVector2f& EllipseCm)
+{
+	const TCHAR* Name = QuestLook::SurfaceAsset(Spec.Surface);
+	UPackage* Package = CreatePackage(*PackagePath(Name));
+	UMaterialInstanceConstant* Instance = NewObject<UMaterialInstanceConstant>(Package, Name, RF_Public | RF_Standalone | RF_Transactional);
+	Instance->SetParentEditorOnly(Parent);
+	UTexture2D* const* Colour = Textures.Find(Spec.Colour);
+	UTexture2D* const* Normal = Textures.Find(Spec.Normal);
+	if (!Colour || !Normal)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_QUEST_ASSETS fail %s textures %s %s"), Name, Spec.Colour, Spec.Normal);
+		return false;
+	}
+	Instance->SetTextureParameterValueEditorOnly(FMaterialParameterInfo(TEXT("BaseTex")), *Colour);
+	Instance->SetTextureParameterValueEditorOnly(FMaterialParameterInfo(TEXT("MacroTex")), *Colour);
+	Instance->SetTextureParameterValueEditorOnly(FMaterialParameterInfo(TEXT("NormalTex")), *Normal);
+	Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Tile")), FLinearColor(Spec.TileCm.X, Spec.TileCm.Y, 0.f, 0.f));
+	Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Tint")), Spec.Tint);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Roughness")), Spec.Roughness);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Specular")), Spec.Specular);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("NormalStrength")), Spec.NormalStrength);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("ContactHeight")), Spec.ContactHeightCm);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("ContactDark")), Spec.ContactDark);
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("EllipseDark")), Spec.EllipseDark);
+	Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Ellipse")), FLinearColor(EllipseCm.X, EllipseCm.Y, 0.f, 0.f));
+	Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("MacroStrength")), Spec.MacroStrength);
+	Instance->PostEditChange();
+	if (!Save(Instance, Name))
+	{
+		return false;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS %s tile=%.0fx%.0f cm tint=%s"), Name, Spec.TileCm.X, Spec.TileCm.Y, *Spec.Tint.ToString());
+	return true;
+}
+}
+#endif
