@@ -0,0 +1,53 @@
+#include "Look/BrennicEpicLook.h"
+
+#include "Components/SkeletalMeshComponent.h"
+#include "Engine/SkeletalMesh.h"
+#include "Engine/World.h"
+#include "MageArenaVR.h"
+#include "Materials/MaterialInterface.h"
+#include "UObject/UObjectIterator.h"
+
+FString BrennicEpicLook::Folder()
+{
+	return TEXT("/Game/Look/Epic/Brennic");
+}
+
+bool BrennicEpicLook::DrawsBrennic(const USkeletalMeshComponent& Component)
+{
+	const USkeletalMesh* Mesh = Component.GetSkeletalMeshAsset();
+	return Mesh && Mesh->GetName() == TEXT("SK_Brennic");
+}
+
+int32 BrennicEpicLook::ApplyAll(UWorld& World)
+{
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	UMaterialInterface* Material = Cached.Get();
+	if (!Material)
+	{
+		Material = LoadObject<UMaterialInterface>(nullptr, *(Folder() / TEXT("M_BrennicEpic.M_BrennicEpic")));
+		if (!Material)
+		{
+			static bool bWarned = false;
+			UE_CLOG(!bWarned, LogMageArena, Warning, TEXT("MAGEVR_LOOK epic Brennic material missing (run -run=CreateBrennicEpic)"));
+			bWarned = true;
+			return 0;
+		}
+		Cached = Material;
+	}
+	int32 Changed = 0;
+	for (TObjectIterator<USkeletalMeshComponent> It; It; ++It)
+	{
+		USkeletalMeshComponent* Component = *It;
+		if (Component->GetWorld() != &World || !DrawsBrennic(*Component) || Component->GetMaterial(0) == Material)
+		{
+			continue;
+		}
+		for (int32 Slot = 0; Slot < Component->GetNumMaterials(); ++Slot)
+		{
+			Component->SetMaterial(Slot, Material);
+		}
+		++Changed;
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK epic Brennic material on %s"), *Component->GetPathName());
+	}
+	return Changed;
+}
