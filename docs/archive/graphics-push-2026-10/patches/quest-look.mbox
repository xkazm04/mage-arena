+namespace
+{
+// The look's numbers, each overridable on the command line (-MageArenaQuest<Name>=) so a round is tuned without a build.
+struct FQuestTuning
+{
+	double SunLux = 6.0;
+	double SunPitchDeg = -36.0;
+	double SunYawDeg = 40.0;
+	FLinearColor SunColour = FLinearColor(1.0f, 0.74f, 0.5f);
+	double SkyLight = 1.0;
+	FLinearColor LowerHemisphere = FLinearColor(0.42f, 0.28f, 0.16f);
+	double ExposureBias = -0.5;
+	double Bloom = 0.35;
+	double BrazierCandela = 14.0;
+	double BrazierRadiusM = 7.0;
+	double FogDensity = 0.012;
+	double FogStartM = 14.0;
+	double ShadowDistanceM = 42.0;
+	double Vignette = 0.3;
+
+	FQuestTuning()
+	{
+		const TCHAR* Line = FCommandLine::Get();
+		FParse::Value(Line, TEXT("MageArenaQuestSunLux="), SunLux);
+		FParse::Value(Line, TEXT("MageArenaQuestSunPitch="), SunPitchDeg);
+		FParse::Value(Line, TEXT("MageArenaQuestSunYaw="), SunYawDeg);
+		FParse::Value(Line, TEXT("MageArenaQuestSkyLight="), SkyLight);
+		FParse::Value(Line, TEXT("MageArenaQuestExposure="), ExposureBias);
+		FParse::Value(Line, TEXT("MageArenaQuestBloom="), Bloom);
+		FParse::Value(Line, TEXT("MageArenaQuestBrazierCd="), BrazierCandela);
+		FParse::Value(Line, TEXT("MageArenaQuestFog="), FogDensity);
+		FParse::Value(Line, TEXT("MageArenaQuestVignette="), Vignette);
+	}
+};
+
+const FQuestTuning& Tuning()
+{
+	static const FQuestTuning Values;
+	return Values;
+}
+
+FVector ToCm(const FVector& Metres)
+{
+	return Metres * 100.0;
+}
+
+// The engine plane is 100 cm square in X/Y facing +Z, UV 0..1 along +X and +Y. Across is the cloth's horizontal axis,
+// Facing the side it shows; the texture's V runs down the cloth.
+FTransform ClothTransform(const FVector& CentreCm, const FVector& Across, const FVector& Facing, double WidthCm, double HeightCm)
+{
+	const FVector X = Across.GetSafeNormal();
+	const FVector Y = -FVector::UpVector;
+	FVector Z = FVector::CrossProduct(X, Y);
+	FMatrix Axes(X, Y, Z, FVector::ZeroVector);
+	if (FVector::DotProduct(Z, Facing) < 0.0)
+	{
+		Axes = FMatrix(-X, Y, -Z, FVector::ZeroVector);
+	}
+	FTransform Transform(Axes.ToQuat(), CentreCm, FVector(WidthCm / 100.0, HeightCm / 100.0, 1.0));
+	return Transform;
+}
+}
+
+bool QuestLook::IsActive()
+{
+	return ArenaLook::Current() == EArenaLook::Quest;
+}
+
+const TCHAR* QuestLook::SurfaceAsset(ESurface Surface)
+{
+	switch (Surface)
+	{
+	case ESurface::Wall:
+		return TEXT("MI_Q_Wall");
+	case ESurface::Stands:
+		return TEXT("MI_Q_Stands");
+	case ESurface::Sand:
+		return TEXT("MI_Q_Sand");
+	case ESurface::Dais:
+		return TEXT("MI_Q_Dais");
+	case ESurface::Pad:
+		return TEXT("MI_Q_Pad");
+	case ESurface::Seat:
+		return TEXT("MI_Q_Seat");
+	case ESurface::Ledge:
+		return TEXT("MI_Q_Ledge");
+	case ESurface::Iron:
+		return TEXT("MI_Q_Iron");
+	case ESurface::Wood:
+		return TEXT("MI_Q_Wood");
+	case ESurface::Pylon:
+		return TEXT("MI_Q_Pylon");
+	default:
+		return TEXT("MI_Q_Wall");
+	}
+}
+
+FString QuestLook::ObjectPath(const TCHAR* Name)
+{
+	return FString::Printf(TEXT("%s/%s.%s"), Folder, Name, Name);
+}
+
+namespace
+{
+UMaterialInterface* LoadQuest(const TCHAR* Name)
+{
+	UMaterialInterface* Material = LoadObject<UMaterialInterface>(nullptr, *QuestLook::ObjectPath(Name), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	if (!Material)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_QUEST_LOOK missing %s (run apps/vr/tools/look/create-quest-look-assets.ps1)"), Name);
+	}
+	return Material;
+}
+}
+
+UMaterialInterface* QuestLook::Surface(ESurface Surface)
+{
+	return LoadQuest(SurfaceAsset(Surface));
+}
+
+UMaterialInterface* QuestLook::SkyMaterial()
+{
+	return LoadQuest(TEXT("M_Q_Sky"));
+}
+
+UMaterialInterface* QuestLook::BannerMaterial()
+{
+	return LoadQuest(TEXT("M_Q_Banner"));
+}
+
+void QuestLook::ApplyCamera(UCameraComponent& Camera)
+{
+	const FQuestTuning& T = Tuning();
+	FPostProcessSettings& Post = Camera.PostProcessSettings;
+	// A fixed exposure: the frame must not breathe as a bolt's glow crosses it, and Quest's mobile path has no
+	// eye adaptation worth its cost.
+	Post.bOverride_AutoExposureMethod = true;
+	Post.AutoExposureMethod = AEM_Manual;
+	Post.bOverride_AutoExposureApplyPhysicalCameraExposure = true;
+	Post.AutoExposureApplyPhysicalCameraExposure = 0;
+	Post.bOverride_AutoExposureBias = true;
+	Post.AutoExposureBias = static_cast<float>(T.ExposureBias);
+	Post.bOverride_BloomIntensity = true;
+	Post.BloomIntensity = static_cast<float>(T.Bloom);
+	Post.bOverride_BloomThreshold = true;
+	Post.BloomThreshold = 1.0f;
+	Post.bOverride_VignetteIntensity = true;
+	Post.VignetteIntensity = static_cast<float>(T.Vignette);
+	Post.bOverride_LocalExposureHighlightContrastScale = true;
+	Post.LocalExposureHighlightContrastScale = 1.f;
+	Post.bOverride_LocalExposureShadowContrastScale = true;
+	Post.LocalExposureShadowContrastScale = 1.f;
+	// S1's grade: warm highlights, a little teal held in the shadows.
+	Post.bOverride_ColorSaturation = true;
+	Post.ColorSaturation = FVector4(1.0, 1.0, 1.0, 1.0);
+	Post.bOverride_ColorGainShadows = true;
+	Post.ColorGainShadows = FVector4(0.94, 1.0, 1.06, 1.0);
+	Post.bOverride_ColorGainHighlights = true;
+	Post.ColorGainHighlights = FVector4(1.04, 1.0, 0.94, 1.0);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK camera exposureBias=%.2f bloom=%.2f vignette=%.2f"), T.ExposureBias, T.Bloom, T.Vignette);
+}
+
+void QuestLook::BuildLights(AActor& Owner, const FArenaLayout& Layout)
+{
+	UWorld* World = Owner.GetWorld();
+	if (!World)
+	{
+		return;
+	}
+	const FQuestTuning& T = Tuning();
+	FActorSpawnParameters Params;
+	Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+	// Quest draws cascaded shadow maps; the desktop proxy must too (virtual shadow maps are not the device's path).
+	if (IConsoleVariable* Virtual = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Shadow.Virtual.Enable")))
+	{
+		Virtual->Set(0, ECVF_SetByCode);
+	}
+
+	// One warm sun from behind the seat's left, 36 degrees up: Brennic and the far and right walls take the key light, the
+	// left wall's shadow sweeps across the sand. Lower than about 30 degrees, the stands behind the seat shade the whole
+	// near half of the arena (runs/push/quest/t6). Mobile forward: one shadowed directional light, two cascades.
+	if (ADirectionalLight* Sun = World->SpawnActor<ADirectionalLight>(ADirectionalLight::StaticClass(), FTransform::Identity, Params))
+	{
+		if (UDirectionalLightComponent* Light = Cast<UDirectionalLightComponent>(Sun->GetLightComponent()))
+		{
+			// Movable before the turn: a spawned light starts static and refuses to rotate (it would stay level along +X).
+			Light->SetMobility(EComponentMobility::Movable);
+			Sun->SetActorRotation(FRotator(T.SunPitchDeg, T.SunYawDeg, 0.0));
+			Light->SetIntensity(static_cast<float>(T.SunLux));
+			Light->SetLightColor(T.SunColour);
+			Light->SetCastShadows(true);
+			Light->SetLightSourceAngle(1.5f);
+			Light->SetDynamicShadowDistanceMovableLight(static_cast<float>(T.ShadowDistanceM * 100.0));
+			Light->SetDynamicShadowCascades(2);
+			Light->SetAtmosphereSunLight(false);
+		}
+	}
+
+	// The sky light sees only the painted dome (everything nearer than SkyDistanceThreshold is left out of its capture),
+	// and the sand's warm bounce comes up from the lower hemisphere.
+	if (ASkyLight* Sky = World->SpawnActor<ASkyLight>(ASkyLight::StaticClass(), FTransform::Identity, Params))
+	{
+		if (USkyLightComponent* Light = Sky->GetLightComponent())
+		{
+			Light->SetMobility(EComponentMobility::Movable);
+			Light->SourceType = ESkyLightSourceType::SLS_CapturedScene;
+			Light->SkyDistanceThreshold = 20000.f;
+			Light->SetIntensity(static_cast<float>(T.SkyLight));
+			Light->SetCastShadows(false);
+			Light->bLowerHemisphereIsBlack = false;
+			Light->SetLowerHemisphereColor(T.LowerHemisphere);
+			Light->RecaptureSky();
+		}
+	}
+	// The first capture can run before the dome's material has compiled; capture again once it has.
+	TWeakObjectPtr<UWorld> WeakWorld(World);
+	for (const float Delay : {2.f, 6.f, 15.f})
+	{
+		FTimerHandle Handle;
+		World->GetTimerManager().SetTimer(Handle, FTimerDelegate::CreateWeakLambda(&Owner, [WeakWorld]()
+		{
+			if (UWorld* Live = WeakWorld.Get())
+			{
+				QuestLook::RecaptureSky(*Live);
+			}
+		}),
+		    Delay, false);
+	}
+
+	// A light haze past the near spawn ring, so the far stands sit back and the near threats stay crisp.
+	if (AExponentialHeightFog* Fog = World->SpawnActor<AExponentialHeightFog>(AExponentialHeightFog::StaticClass(), FTransform::Identity, Params))
+	{
+		if (UExponentialHeightFogComponent* Haze = Fog->GetComponent())
+		{
+			Haze->SetFogDensity(static_cast<float>(T.FogDensity));
+			Haze->SetFogHeightFalloff(0.18f);
+			Haze->SetFogInscatteringColor(FLinearColor(0.62f, 0.44f, 0.3f));
+			Haze->SetDirectionalInscatteringColor(FLinearColor(0.8f, 0.5f, 0.25f));
+			Haze->SetDirectionalInscatteringExponent(6.f);
+			Haze->SetStartDistance(static_cast<float>(T.FogStartM * 100.0));
+			Haze->SetFogCutoffDistance(15000.f);
+		}
+	}
+
+	// The braziers light their own sand: unshadowed points, within the mobile forward limit of four movable lights.
+	for (const FArenaProp& Brazier : Layout.Braziers)
+	{
+		const FVector At = ToCm(FVector(Brazier.PositionM.X, Brazier.PositionM.Y, Brazier.StandHeightM + Brazier.BowlHeightM + 0.45));
+		if (APointLight* Point = World->SpawnActor<APointLight>(APointLight::StaticClass(), FTransform(At), Params))
+		{
+			if (UPointLightComponent* Light = Cast<UPointLightComponent>(Point->GetLightComponent()))
+			{
+				Light->SetMobility(EComponentMobility::Movable);
+				Light->SetIntensityUnits(ELightUnits::Candelas);
+				Light->SetIntensity(static_cast<float>(T.BrazierCandela));
+				Light->SetLightColor(FLinearColor(1.f, 0.52f, 0.2f));
+				Light->SetAttenuationRadius(static_cast<float>(T.BrazierRadiusM * 100.0));
+				Light->SetCastShadows(false);
+				Light->SetSourceRadius(20.f);
+			}
+		}
+	}
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK lights sun=%.1f lux pitch=%.0f yaw=%.0f sky=%.2f braziers=%d x %.0f cd fog=%.3f"), T.SunLux, T.SunPitchDeg, T.SunYawDeg, T.SkyLight,
+	    Layout.Braziers.Num(), T.BrazierCandela, T.FogDensity);
+}
+
+void QuestLook::RecaptureSky(UWorld& World)
+{
+	for (TActorIterator<ASkyLight> It(&World); It; ++It)
+	{
+		if (USkyLightComponent* Light = It->GetLightComponent())
+		{
+			Light->RecaptureSky();
+		}
+	}
+}
+
+void QuestLook::BuildSky(AActor& Owner)
+{
+	UMaterialInterface* Sky = SkyMaterial();
+	UStaticMesh* Sphere = Greybox::LoadShape(TEXT("Sphere"));
+	if (!Sky || !Sphere)
+	{
+		return;
+	}
+	// The material reads the view direction only, so the dome's size just has to hold the whole arena.
+	UStaticMeshComponent* Dome = Greybox::MakeMesh(&Owner, Sphere, Sky);
+	if (!Dome)
+	{
+		return;
+	}
+	Dome->SetCastShadow(false);
+	Dome->SetWorldLocation(FVector::ZeroVector);
+	Greybox::SetSized(Dome, FVector(60000.0));
+	Dome->bAffectDistanceFieldLighting = false;
+	Dome->SetReceivesDecals(false);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK sky dome"));
+}
+
+void QuestLook::BuildDressing(AActor& Owner, const FArenaLayout& Layout)
+{
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	UStaticMesh* Cube = Greybox::LoadShape(TEXT("Cube"));
+	UMaterialInterface* Banner = BannerMaterial();
+	int32 WallBanners = 0;
+	int32 PoleBanners = 0;
+	if (Plane && Banner)
+	{
+		UInstancedStaticMeshComponent* Cloth = Greybox::MakeInstances(&Owner, Plane, Banner);
+		Cloth->SetCastShadow(true);
+		// S1: red banners with gold trim hang from the wall's coping, evenly round the ring. Every second wall segment,
+		// none behind the seat (the dais end, 60 degrees either side of -X), where nothing faces the player.
+		const double A = Layout.FloorRadiusXM;
+		const double B = Layout.FloorRadiusYM;
+		const int32 Segments = FMath::Max(Layout.WallSegments, 3);
+		constexpr double WidthM = 1.05;
+		constexpr double HeightM = 2.1;
+		for (int32 Index = 0; Index < Segments; Index += 2)
+		{
+			const double T0 = 2.0 * PI * Index / Segments;
+			const double T1 = 2.0 * PI * (Index + 1) / Segments;
+			const double Mid = (T0 + T1) * 0.5;
+			if (FMath::Abs(FMath::UnwindRadians(Mid - PI)) < FMath::DegreesToRadians(60.0))
+			{
+				continue;
+			}
+			const FVector P0(A * FMath::Cos(T0), B * FMath::Sin(T0), 0.0);
+			const FVector P1(A * FMath::Cos(T1), B * FMath::Sin(T1), 0.0);
+			const FVector Outward = FVector(B * FMath::Cos(Mid), A * FMath::Sin(Mid), 0.0).GetSafeNormal();
+			const FVector Centre = (P0 + P1) * 0.5 - Outward * 0.03 + FVector(0.0, 0.0, Layout.WallHeightM - 0.12 - HeightM * 0.5);
+			Cloth->AddInstance(ClothTransform(ToCm(Centre), P1 - P0, -Outward, WidthM * 100.0, HeightM * 100.0), true);
+			++WallBanners;
+		}
+		// The layout's pole banners take the same cloth (BuildProps leaves their greybox box out under this look).
+		for (const FArenaProp& Prop : Layout.Banners)
+		{
+			FVector ToCentre = Layout.ArenaCentreM - Prop.PositionM;
+			ToCentre.Z = 0.0;
+			ToCentre = ToCentre.GetSafeNormal();
+			if (ToCentre.IsNearlyZero())
+			{
+				ToCentre = FVector::ForwardVector;
+			}
+			const double ClothZ = Prop.PoleHeightM - Prop.ClothSizeM.Z * 0.5 - 0.08;
+			const FVector Across = FVector::CrossProduct(FVector::UpVector, ToCentre);
+			const FVector Centre(Prop.PositionM.X, Prop.PositionM.Y, ClothZ);
+			Cloth->AddInstance(ClothTransform(ToCm(Centre + ToCentre * 0.04), Across, ToCentre, Prop.ClothSizeM.Y * 100.0, Prop.ClothSizeM.Z * 100.0), true);
+			++PoleBanners;
+		}
+	}
+
+	// The stone ledge at the bottom of S1's frame: a flagstone lip along the dais's front edge, 6 cm proud of the dais top
+	// and overhanging its face, so the edge reads as cut stone with a shadow line under it.
+	UMaterialInterface* LedgeMaterial = Surface(ESurface::Ledge);
+	if (Cube && LedgeMaterial)
+	{
+		UInstancedStaticMeshComponent* Ledge = Greybox::MakeInstances(&Owner, Cube, LedgeMaterial);
+		Ledge->SetCastShadow(true);
+		const double FrontX = Layout.DaisCentreM.X + Layout.DaisSizeM.X * 0.5;
+		const double TopZ = Layout.DaisCentreM.Z + Layout.DaisSizeM.Z * 0.5;
+		const FVector Size(0.46, Layout.DaisSizeM.Y + 0.1, 0.14);
+		const FVector Centre(FrontX - Size.X * 0.5 + 0.06, Layout.DaisCentreM.Y, TopZ + 0.06 - Size.Z * 0.5);
+		Greybox::AddSized(Ledge, ToCm(Centre), FQuat::Identity, ToCm(Size));
+	}
+	// S1's stone pylons with fire bowls, standing on the first tread in front of the crowd, two either side of the
+	// seat's forward view. Their bowls are the brazier's own pieces and flames (BrazierFire), lifted to the pylon top.
+	UMaterialInterface* PylonMaterial = Surface(ESurface::Pylon);
+	UMaterialInterface* IronMaterial = Surface(ESurface::Iron);
+	UStaticMesh* Cylinder = Greybox::LoadShape(TEXT("Cylinder"));
+	int32 Pylons = 0;
+	if (Cube && Cylinder && PylonMaterial && IronMaterial && Layout.StandTiers > 0)
+	{
+		UInstancedStaticMeshComponent* Stone = Greybox::MakeInstances(&Owner, Cube, PylonMaterial);
+		UInstancedStaticMeshComponent* Bowls = Greybox::MakeInstances(&Owner, Cylinder, IronMaterial);
+		Stone->SetCastShadow(true);
+		Bowls->SetCastShadow(true);
+		FArenaLayout Fires = Layout;
+		Fires.Braziers.Reset();
+		const double TopM = ArenaStands::TierTopM(Layout, FMath::Min(Layout.StandTiers - 1, 2)) + 0.6;
+		const int32 Segments = FMath::Max(Layout.WallSegments, 3);
+		for (const int32 Segment : {2, Segments - 3, 6, Segments - 7})
+		{
+			const ArenaStands::FStandBox Box = ArenaStands::StandBox(Layout, Segment, 0);
+			const FVector Base = Box.MidM - Box.Outward * (Box.DepthM * 0.5 - 0.6);
+			const FQuat Turn = FRotationMatrix::MakeFromXZ(Box.Along, FVector::UpVector).ToQuat();
+			Greybox::AddSized(Stone, ToCm(FVector(Base.X, Base.Y, TopM * 0.5)), Turn, ToCm(FVector(1.1, 1.1, TopM)));
+			Greybox::AddSized(Stone, ToCm(FVector(Base.X, Base.Y, TopM - 0.12)), Turn, ToCm(FVector(1.35, 1.35, 0.24)));
+			FArenaProp Fire;
+			Fire.PositionM = FVector(Base.X, Base.Y, 0.0);
+			Fire.StandHeightM = TopM;
+			Fire.BowlRadiusM = 0.62;
+			Fire.BowlHeightM = 0.34;
+			Fire.FlameRadiusM = 0.34;
+			TArray<BrazierFire::FPiece> Pieces;
+			BrazierFire::BowlPieces(Fire, Pieces);
+			for (const BrazierFire::FPiece& Piece : Pieces)
+			{
+				// The foot and the stem stay inside the pylon; only the bowl's rings above its top show.
+				if (Piece.CentreM.Z > TopM - 0.2)
+				{
+					Greybox::AddSized(Bowls, ToCm(Piece.CentreM), FQuat::Identity, ToCm(Piece.SizeM));
+				}
+			}
+			Fires.Braziers.Add(Fire);
+			++Pylons;
+		}
+		const BrazierFire::FFlameLayers Flames = BrazierFire::Build(&Owner, Fires, ActiveElementPalette(), BrazierFire::IsSwitchedOff());
+		if ((Flames.Body || Flames.Heart) && Owner.GetWorld())
+		{
+			// The pylon flames sway as the floor braziers' do (AArenaGreybox::Tick), on a timer of their own.
+			TWeakObjectPtr<UInstancedStaticMeshComponent> Body(Flames.Body);
+			TWeakObjectPtr<UInstancedStaticMeshComponent> Heart(Flames.Heart);
+			FTimerHandle Handle;
+			Owner.GetWorld()->GetTimerManager().SetTimer(Handle, FTimerDelegate::CreateWeakLambda(&Owner, [Body, Heart, Fires, &Owner]()
+			{
+				if (const UWorld* World = Owner.GetWorld())
+				{
+					BrazierFire::Animate({Body.Get(), Heart.Get()}, Fires, World->GetTimeSeconds());
+				}
+			}),
+			    1.f / 30.f, true);
+		}
+	}
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK pylons=%d"), Pylons);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK dressing wallBanners=%d poleBanners=%d ledge=%d"), WallBanners, PoleBanners, (Cube && LedgeMaterial) ? 1 : 0);
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/QuestLook.h b/apps/vr/Game/Source/MageArenaVR/Look/QuestLook.h
new file mode 100644
index 0000000..8ae7a32
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/QuestLook.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+class AActor;
+class UCameraComponent;
+class UMaterialInterface;
+class UWorld;
+struct FArenaLayout;
+
+/**
+ * Tier A of the graphics push (docs/concepts/GRAPHICS-PUSH-2026-10-28.md): the Quest-viable look, -MageArenaLook=quest.
+ * Only mobile-forward features: textured lit materials with world-aligned mapping (the greybox meshes are scaled engine
+ * shapes without usable UVs), contact darkening in the shader instead of SSAO, one shadowed low sun (two cascades at
+ * most), a few unshadowed point lights at the braziers, an unlit painted sky dome and a sky light captured from it, and
+ * the filmic tonemapper with a fixed exposure. Nothing here runs on the flat look, so the greybox stays byte for byte.
+ *
+ * The assets live under /Game/Look/Quest, built from apps/vr/art/look/quest/*.png by Look/CreateQuestLookAssetsCommandlet
+ * (apps/vr/tools/look/create-quest-look-assets.ps1). A missing asset falls back to the greybox material for that part.
+ */
+namespace QuestLook
+{
+/** True under -MageArenaLook=quest. */
+bool IsActive();
+
+/** The crowd's tunic and banner tints are multiplied by this under the quest look (ArenaCrowd::Spawn). */
+inline constexpr float CrowdTintGain = 3.0f;
+
+inline constexpr const TCHAR* Folder = TEXT("/Game/Look/Quest");
+
+/** The surfaces of the arena, each one material instance of M_Q_Surface (or a material of its own). */
+enum class ESurface : uint8
+{
+	Wall,
+	Stands,
+	Sand,
+	Dais,
+	Pad,
+	Seat,
+	Ledge,
+	Iron,
+	Wood,
+	Pylon,
+	Count
+};
+
+/** The asset name of a surface's material, e.g. MI_Q_Wall. */
+const TCHAR* SurfaceAsset(ESurface Surface);
+/** /Game/Look/Quest/<Name>.<Name> */
+FString ObjectPath(const TCHAR* Name);
+
+/** The surface's material, or null when it is not built (the caller keeps the greybox tint). */
+UMaterialInterface* Surface(ESurface Surface);
+UMaterialInterface* SkyMaterial();
+UMaterialInterface* BannerMaterial();
+
+/** The camera's grade: filmic tonemapper on, a fixed manual exposure, modest bloom, no auto exposure, no vignette. */
+void ApplyCamera(UCameraComponent& Camera);
+
+/** The sun, the sky light (captured from the sky dome), the brazier lights and the haze. Replaces the flat lights. */
+void BuildLights(AActor& Owner, const FArenaLayout& Layout);
+
+/** The painted sky dome: one unlit sphere around the arena. Replaces the flat look's stack of tinted panels. */
+void BuildSky(AActor& Owner);
+
+/** Dressing toward S1 that the greybox has no part for: banners hung on the arena wall and the stone ledge at the dais's front edge. */
+void BuildDressing(AActor& Owner, const FArenaLayout& Layout);
+
+/** Re-captures the sky light once the dome's material has compiled (the first capture can see the default material). */
+void RecaptureSky(UWorld& World);
+}
diff --git a/apps/vr/tools/look/create-quest-look-assets.ps1 b/apps/vr/tools/look/create-quest-look-assets.ps1
new file mode 100644
index 0000000..0f3ecbe
--- /dev/null
+++ b/apps/vr/tools/look/create-quest-look-assets.ps1
@@ -0,0 +1,34 @@
+# Builds the quest look's assets under /Game/Look/Quest (Look/CreateQuestLookAssetsCommandlet.h) from the PNGs in
+# apps/vr/art/look/quest (written by prep_quest_textures.py from the studio stills). One editor process, headless.
+# Success is exit 0 and "MAGEVR_QUEST_ASSETS done" in the log; anything else exits 1.
+param([string]$Run = "push/quest")
+
+$ErrorActionPreference = "Stop"
+$ToolsDir = Split-Path -Parent $PSScriptRoot
+$VrDir = Split-Path -Parent $ToolsDir
+$Repo = Split-Path -Parent (Split-Path -Parent $VrDir)
+$Editor = "C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe"
+$Project = Join-Path $VrDir "Game\MageArenaVR.uproject"
+$RunDir = Join-Path $Repo "runs\$Run"
+$LogPath = Join-Path $RunDir "create-quest-look-assets.log"
+
+foreach ($Png in Get-ChildItem (Join-Path $VrDir "art\look\quest\*.png")) {
+	$Bytes = [System.IO.File]::ReadAllBytes($Png.FullName)
+	if ($Bytes.Length -lt 8 -or $Bytes[1] -ne 0x50 -or $Bytes[2] -ne 0x4E -or $Bytes[3] -ne 0x47) {
+		Write-Host "create-quest-look-assets: $($Png.FullName) is not a PNG (a Git LFS pointer?). Run git lfs pull."
+		exit 1
+	}
+}
+
+New-Item -ItemType Directory -Force -Path $RunDir | Out-Null
+if (Test-Path $LogPath) { Remove-Item -Force $LogPath }
+Write-Host "create-quest-look-assets: running the CreateQuestLookAssets commandlet"
+& $Editor $Project -run=CreateQuestLookAssets -unattended -nosplash -nop4 -stdout -FullStdOutLogOutput "-abslog=$LogPath" | Out-Null
+$Code = $LASTEXITCODE
+Select-String -Path $LogPath -Pattern "MAGEVR_QUEST_ASSETS|Error:" | ForEach-Object { Write-Host $_.Line }
+if ($Code -ne 0 -or -not (Select-String -Path $LogPath -Pattern "MAGEVR_QUEST_ASSETS done" -Quiet)) {
+	Write-Host "create-quest-look-assets: FAIL (exit $Code)"
+	exit 1
+}
+Write-Host "create-quest-look-assets: ok"
+exit 0
-- 
