+FTransform QuestSpells::UprightCard(const FVector& CentreCm, const FVector& EyeCm, double WidthCm, double HeightCm, bool bMirror)
+{
+	FVector Toward = EyeCm - CentreCm;
+	Toward.Z = 0.0;
+	Toward = Toward.GetSafeNormal(UE_SMALL_NUMBER, FVector::ForwardVector);
+	// The plane's U across (right as the eye sees it), V down, its face toward the eye.
+	const FVector Across = FVector::CrossProduct(FVector::UpVector, Toward) * (bMirror ? -1.0 : 1.0);
+	const FVector Down = -FVector::UpVector;
+	const FVector Face = FVector::CrossProduct(Across, Down);
+	return FTransform(FMatrix(Across, Down, Face, FVector::ZeroVector).ToQuat(), CentreCm, FVector(WidthCm / 100.0, HeightCm / 100.0, 1.0));
+}
+
+FTransform QuestSpells::FacingCard(const FVector& CentreCm, const FVector& EyeCm, double SizeCm)
+{
+	const FVector Toward = (EyeCm - CentreCm).GetSafeNormal(UE_SMALL_NUMBER, FVector::ForwardVector);
+	return FTransform(FRotationMatrix::MakeFromZ(Toward).ToQuat(), CentreCm, FVector(SizeCm / 100.0, SizeCm / 100.0, 1.0));
+}
+
+void QuestSpells::MakeRuneLayers(AActor& Owner, UInstancedStaticMeshComponent*& OutFlames, UInstancedStaticMeshComponent*& OutHalos)
+{
+	OutFlames = nullptr;
+	OutHalos = nullptr;
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	UMaterialInterface* Fire = EnvFireMaterial();
+	UMaterialInterface* Halo = HaloMaterial();
+	if (!Plane || !Fire || !Halo)
+	{
+		return;
+	}
+	UMaterialInstanceDynamic* FireTint = UMaterialInstanceDynamic::Create(Fire, &Owner);
+	FireTint->SetScalarParameterValue(TEXT("TintAmount"), 1.f);
+	OutFlames = Greybox::MakeInstances(&Owner, Plane, FireTint);
+	OutHalos = Greybox::MakeInstances(&Owner, Plane, UMaterialInstanceDynamic::Create(Halo, &Owner));
+	for (UInstancedStaticMeshComponent* Layer : {OutFlames, OutHalos})
+	{
+		if (Layer)
+		{
+			Layer->SetCastShadow(false);
+			Layer->SetNumCustomDataFloats(1);
+		}
+	}
+}
+
+void QuestSpells::PoseRuneLayers(UInstancedStaticMeshComponent* Flames, UInstancedStaticMeshComponent* Halos, TConstArrayView<FVector> CapsCm, const FVector& EyeCm, const FLinearColor& Colour, float Pulse)
+{
+	if (!Flames || !Halos)
+	{
+		return;
+	}
+	TArray<FTransform> FlameCards;
+	TArray<FTransform> HaloCards;
+	TArray<float> Phases;
+	for (int32 Index = 0; Index < CapsCm.Num(); ++Index)
+	{
+		const double Height = 95.0 + 45.0 * Pulse;
+		FlameCards.Add(UprightCard(CapsCm[Index] + FVector(0.0, 0.0, Height * 0.32), EyeCm, Height * 0.55, Height, Index % 2 == 1));
+		HaloCards.Add(FacingCard(CapsCm[Index] + FVector(0.0, 0.0, 20.0), EyeCm, 190.0 + 90.0 * Pulse));
+		Phases.Add(static_cast<float>(Index) * 1.7f);
+	}
+	for (const TPair<UInstancedStaticMeshComponent*, const TArray<FTransform>*> Layer : {TPair<UInstancedStaticMeshComponent*, const TArray<FTransform>*>(Flames, &FlameCards), TPair<UInstancedStaticMeshComponent*, const TArray<FTransform>*>(Halos, &HaloCards)})
+	{
+		if (Layer.Key->GetInstanceCount() != Layer.Value->Num())
+		{
+			Layer.Key->ClearInstances();
+			Layer.Key->AddInstances(*Layer.Value, false, true);
+		}
+		else
+		{
+			Layer.Key->BatchUpdateInstancesTransforms(0, *Layer.Value, true, true, true);
+		}
+		if (!Phases.IsEmpty())
+		{
+			Layer.Key->SetCustomData(0, Phases.Num() - 1, Phases, true);
+		}
+		if (UMaterialInstanceDynamic* Tint = Cast<UMaterialInstanceDynamic>(Layer.Key->GetMaterial(0)))
+		{
+			Tint->SetVectorParameterValue(TEXT("Color"), Layer.Key == Halos ? Colour * 2.2f : Colour);
+		}
+	}
+}
+
+void QuestSpells::TrailFlamePuffs(const FVector& AtCm, const FVector& FlightDir, double CoreDiameterCm, double TimeS, int32 Seed, TArray<SpellVfx::FPuff>& Out)
+{
+	for (int32 Step = 1; Step <= 3; ++Step)
+	{
+		SpellVfx::FPuff& Puff = Out.AddDefaulted_GetRef();
+		const double Wobble = 0.08 * FMath::Sin(TimeS * 13.0 + Seed + Step * 1.9);
+		Puff.CentreCm = AtCm - FlightDir * CoreDiameterCm * (0.55 + 0.6 * Step) + FVector(0.0, 0.0, CoreDiameterCm * (0.12 * Step + Wobble));
+		Puff.SizeCm = FVector(CoreDiameterCm * (1.9 - 0.4 * Step));
+		Puff.Cell = (FMath::FloorToInt32(TimeS * SpellVfx::FlipbookFps) + Step + Seed) % 2 == 0 ? SpellVfx::ECell::FireFlameA : SpellVfx::ECell::FireFlameB;
+		Puff.bMirror = Step % 2 == 0;
+		Puff.Roll = static_cast<float>(TimeS * 2.3 + Step);
+	}
+}
