+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreateBrennicEpicCommandlet.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Commandlets/Commandlet.h"
+#include "CreateBrennicEpicCommandlet.generated.h"
+
+/**
+ * Graphics push 10-28, Tier B hero asset: Brennic's epic texture set on the committed SK_Brennic's own UVs
+ * (apps/vr/art/characters/brennic/epic/bake_epic.py), imported into /Game/Look/Epic/Brennic with its material built in
+ * code: M_BrennicEpic (base colour, DirectX normal, ORM = AO / roughness / metallic / skin mask; subsurface-profile
+ * skin through the mask, SSP_BrennicEpic_Skin). SK_Brennic itself is not touched, so the flat look draws him as before;
+ * the epic look swaps the material at run time (Look/BrennicEpicLook.h).
+ * Usage: -run=CreateBrennicEpic [-source=<dir with T_BrennicEpic_{BaseColor,Normal,ORM}.png>]. Editor builds only.
+ */
+UCLASS()
+class MAGEARENAVR_API UCreateBrennicEpicCommandlet : public UCommandlet
+{
+	GENERATED_BODY()
+
+public:
+	UCreateBrennicEpicCommandlet();
+	virtual int32 Main(const FString& Params) override;
+};
diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/MaterialGraph.h b/apps/vr/Game/Source/MageArenaVR/Tools/MaterialGraph.h
new file mode 100644
index 0000000..5a32f9d
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/MaterialGraph.h
@@ -0,0 +1,127 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+#if WITH_EDITOR
+#include "AssetImportTask.h"
+#include "AssetToolsModule.h"
+#include "Engine/Texture2D.h"
+#include "IAssetTools.h"
+#include "MageArenaVR.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialExpressionCustom.h"
+#include "Materials/MaterialExpressionScalarParameter.h"
+#include "Materials/MaterialExpressionVectorParameter.h"
+#include "Misc/PackageName.h"
+#include "UObject/Package.h"
+#include "UObject/SavePackage.h"
+#include "UObject/UObjectIterator.h"
+
+/**
+ * Small helpers for the graphics-push commandlets (Tools/CreateBrennicEpicCommandlet, Tools/CreateEpicLookAssetsCommandlet):
+ * a material graph built in code (the ImportCreatureMesh pattern), a texture import and a package save. Editor builds only.
+ */
+namespace MaterialGraph
+{
+template <typename T>
+T* Add(UMaterial& Material, int32 X, int32 Y)
+{
+	T* Expression = NewObject<T>(&Material);
+	Expression->MaterialExpressionEditorX = X;
+	Expression->MaterialExpressionEditorY = Y;
+	Material.GetExpressionCollection().AddExpression(Expression);
+	return Expression;
+}
+
+inline UMaterialExpressionScalarParameter* Scalar(UMaterial& Material, const TCHAR* Name, double Value, int32 Y)
+{
+	UMaterialExpressionScalarParameter* Parameter = Add<UMaterialExpressionScalarParameter>(Material, -900, Y);
+	Parameter->ParameterName = Name;
+	Parameter->DefaultValue = static_cast<float>(Value);
+	return Parameter;
+}
+
+inline UMaterialExpressionVectorParameter* Vector(UMaterial& Material, const TCHAR* Name, const FLinearColor& Value, int32 Y)
+{
+	UMaterialExpressionVectorParameter* Parameter = Add<UMaterialExpressionVectorParameter>(Material, -900, Y);
+	Parameter->ParameterName = Name;
+	Parameter->DefaultValue = Value;
+	return Parameter;
+}
+
+inline void Input(UMaterialExpressionCustom& Custom, const TCHAR* Name, UMaterialExpression* From, int32 OutputIndex = 0)
+{
+	FCustomInput& In = Custom.Inputs.AddDefaulted_GetRef();
+	In.InputName = Name;
+	In.Input.Connect(OutputIndex, From);
+}
+
+inline UMaterial* NewMaterial(const FString& Folder, const FString& Name)
+{
+	UPackage* Package = CreatePackage(*(Folder / Name));
+	return NewObject<UMaterial>(Package, FName(*Name), RF_Public | RF_Standalone | RF_Transactional);
+}
+
+/** Imports one PNG as a texture asset; bLinear marks data maps (no sRGB), Compression picks normal-map or mask packing. */
+inline UTexture2D* ImportTexture(const FString& File, const FString& Folder, const FString& Name, bool bLinear, TextureCompressionSettings Compression)
+{
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>("AssetTools").Get();
+	UAssetImportTask* Task = NewObject<UAssetImportTask>();
+	Task->Filename = File;
+	Task->DestinationPath = Folder;
+	Task->DestinationName = Name;
+	Task->bReplaceExisting = true;
+	Task->bReplaceExistingSettings = true;
+	Task->bAutomated = true;
+	Task->bSave = false;
+	AssetTools.ImportAssetTasks({Task});
+	const TArray<UObject*> Objects = Task->GetObjects();
+	UTexture2D* Texture = Objects.Num() > 0 ? Cast<UTexture2D>(Objects[0]) : nullptr;
+	if (!Texture)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail texture %s"), *File);
+		return nullptr;
+	}
+	Texture->PreEditChange(nullptr);
+	Texture->SRGB = !bLinear;
+	Texture->CompressionSettings = Compression;
+	Texture->PostEditChange();
+	Texture->MarkPackageDirty();
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS texture %s %dx%d srgb=%d"), *Texture->GetPathName(), Texture->Source.GetSizeX(), Texture->Source.GetSizeY(),
+	    Texture->SRGB ? 1 : 0);
+	return Texture;
+}
+
+/** Saves every dirty package under Folder; false if one fails. */
+inline bool SaveDirtyUnder(const FString& Folder, int32& OutSaved)
+{
+	TArray<UPackage*> Packages;
+	for (TObjectIterator<UPackage> It; It; ++It)
+	{
+		if (It->GetName().StartsWith(Folder + TEXT("/")) && It->IsDirty())
+		{
+			Packages.Add(*It);
+		}
+	}
+	bool bOk = true;
+	for (UPackage* Package : Packages)
+	{
+		const FString File = FPackageName::LongPackageNameToFilename(Package->GetName(), FPackageName::GetAssetPackageExtension());
+		FSavePackageArgs Args;
+		Args.TopLevelFlags = RF_Public | RF_Standalone;
+		Args.SaveFlags = SAVE_NoError;
+		if (UPackage::SavePackage(Package, Package->FindAssetInPackage(), *File, Args))
+		{
+			++OutSaved;
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS saved %s"), *File);
+		}
+		else
+		{
+			UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail save %s"), *File);
+			bOk = false;
+		}
+	}
+	return bOk;
+}
+}
+#endif
diff --git a/apps/vr/art/characters/brennic/HANDOFF.md b/apps/vr/art/characters/brennic/HANDOFF.md
index 35935d0..dd14377 100644
--- a/apps/vr/art/characters/brennic/HANDOFF.md
+++ b/apps/vr/art/characters/brennic/HANDOFF.md
@@ -60,3 +60,33 @@ blender -b -P apps/vr/tools/assets/rig_anim.py -- <archive>/work/Brennic_finish.
 blender -b -P apps/vr/tools/assets/metrics.py -- <archive>/SK_Brennic.fbx <archive>/metrics.json
 blender -b -P apps/vr/tools/assets/render_evidence.py -- <archive>/SK_Brennic.fbx <archive> Brennic <archive>/work/Brennic_rig.json
 ```
+
+## Epic texture set (graphics push 10-28, Tier B, Lynx)
+
+A texture-space finish of the **committed** in-game Brennic (`Content/Characters/Brennic/Source/Brennic.fbx`, the DINOv3
+bake LOD0 of ad38b9b) on his own UVs: no geometry, rig or clip changes, so `SK_Brennic` stays byte-identical and the flat
+look is untouched. The epic look swaps his material at run time (`Look/BrennicEpicLook.h`).
+
+| File (`epic/`) | What |
+|---|---|
+| `head_ortho.py` | front orthographic albedo render of the head (centre z 1.62 m, 0.40 m square), to place face landmarks |
+| `face_overlay.py` | the face accents drawn in that frame: eye whites, irises, lash lines, a heavy scowling brow, frown creases, nostrils, a lower lip and a down-turned mouth line, beard strands over the pale chin patch |
+| `bake_epic.py` | Cycles bakes (position, normal, AO, the albedo with the overlay projected along +X onto front-facing head texels), then region masks (tunic, skin, iron collar, bronze brooch, hair, leather, cloak) and the maps below |
+| `T_BrennicEpic_BaseColor.png` | 2048 sRGB: tunic regraded to S1's deep crimson, collar dark iron, brooch bronze, cloak charcoal brown, light AO multiply, gutters dilated |
+| `T_BrennicEpic_Normal.png` | 2048 DirectX tangent normal: hair curls, wool weave, the albedo's own folds |
+| `T_BrennicEpic_ORM.png` | 2048 linear: R AO, G roughness (skin 0.52, wool 0.78-0.82, iron 0.42, bronze 0.38), B metallic, A skin (subsurface) mask |
+| `inspect.py` | the before/after turntable and face close-ups |
+
+Rebuild (absolute paths; Blender 5.2.2):
+
+```
+python face_overlay.py <out>/face_overlay.png
+blender -b -P bake_epic.py -- <repo>/apps/vr/Game/Content/Characters/Brennic/Source/Brennic.fbx <repo>/apps/vr/Game/Content/Characters/Brennic/Source/T_Brennic_BaseColor.png <out>/face_overlay.png <out> 2048
+# copy <out>/T_BrennicEpic_*.png here, then (editor build):
+UnrealEditor-Cmd MageArenaVR.uproject -run=CreateBrennicEpic
+```
+
+`-run=CreateBrennicEpic` writes `/Game/Look/Epic/Brennic/` (the three textures, `SSP_BrennicEpic_Skin`,
+`M_BrennicEpic`: subsurface-profile skin through the ORM alpha mask). Another look takes him with
+`BrennicEpicLook::ApplyAll(World)` (or its own material on the same three textures; a mobile path would drop the
+subsurface profile). Still missing: curls in the hair silhouette, finger-separated hands (mitten mesh), sandal straps.
