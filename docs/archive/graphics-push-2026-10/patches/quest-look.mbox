+// The fires as painted flame cards (M_Q_SpellGlow's fireball cells) instead of the greybox's glow spheres: two layers
+// in BrazierFire's own environment colours (never a threat's), each card turned to the seated eye, which never moves.
+// The floor braziers (whose spheres the quest look switches off in AArenaGreybox::BuildProps) and the pylon bowls share
+// the two draws. A 30 Hz timer flickers them.
+void PoseFireCards(UInstancedStaticMeshComponent* Body, UInstancedStaticMeshComponent* Heart, const TArray<FArenaProp>& Fires, const FVector& EyeCm, double TimeS)
+{
+	TArray<SpellVfx::FPuff> BodyPuffs;
+	TArray<SpellVfx::FPuff> HeartPuffs;
+	for (int32 Index = 0; Index < Fires.Num(); ++Index)
+	{
+		const FArenaProp& Fire = Fires[Index];
+		const double SizeCm = Fire.FlameRadiusM * 100.0 * 3.4;
+		const FVector BaseCm = ToCm(FVector(Fire.PositionM.X, Fire.PositionM.Y, Fire.StandHeightM + Fire.BowlHeightM));
+		const double Phase = TimeS * 1.3 + Index * 2.17;
+		for (int32 Card = 0; Card < 2; ++Card)
+		{
+			SpellVfx::FPuff& Puff = BodyPuffs.AddDefaulted_GetRef();
+			const double Sway = 1.0 + 0.1 * FMath::Sin(Phase * (5.0 + Card * 2.3));
+			Puff.SizeCm = FVector(SizeCm * (Card == 0 ? 1.0 : 0.8) * Sway);
+			Puff.CentreCm = BaseCm + FVector(0.0, 0.0, Puff.SizeCm.X * 0.36);
+			Puff.Cell = (FMath::FloorToInt32(TimeS * SpellVfx::FlipbookFps + Index + Card) % 2 == 0) ? SpellVfx::ECell::FireFlameA : SpellVfx::ECell::FireFlameB;
+			Puff.bMirror = Card == 1;
+			Puff.Roll = static_cast<float>(0.15 * FMath::Sin(Phase * 3.0 + Card));
+		}
+		SpellVfx::FPuff& Core = HeartPuffs.AddDefaulted_GetRef();
+		Core.SizeCm = FVector(SizeCm * 0.5 * (1.0 + 0.08 * FMath::Sin(Phase * 9.0)));
+		Core.CentreCm = BaseCm + FVector(0.0, 0.0, Core.SizeCm.X * 0.3);
+		Core.Cell = SpellVfx::ECell::FireFlameA;
+		SpellVfx::FPuff& Sparks = HeartPuffs.AddDefaulted_GetRef();
+		Sparks.SizeCm = FVector(SizeCm * 0.9);
+		Sparks.CentreCm = BaseCm + FVector(0.0, 0.0, SizeCm * (0.75 + 0.1 * FMath::Sin(Phase * 2.0)));
+		Sparks.Cell = SpellVfx::ECell::FireEmbers;
+		Sparks.Roll = static_cast<float>(Phase);
+	}
+	const auto Pose = [&EyeCm](UInstancedStaticMeshComponent* Layer, const TArray<SpellVfx::FPuff>& Puffs)
+	{
+		if (!Layer)
+		{
+			return;
+		}
+		TArray<FTransform> Transforms;
+		TArray<float> Data;
+		for (const SpellVfx::FPuff& Puff : Puffs)
+		{
+			Transforms.Add(SpellVfx::CardTransform(Puff, EyeCm));
+			float Custom[SpellVfx::CardCustomFloats];
