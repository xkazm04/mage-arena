@@ -74,12 +74,14 @@ sky = load("sky-01.png")
 # saturated, the horizon glow kept warm.
 h = sky.shape[0]
 t = np.linspace(1.0, 0.0, h)[:, None, None]
-cool = np.clip((t - 0.35) / 0.65, 0.0, 1.0) ** 1.3 * 0.62
+cool = np.clip((t - 0.3) / 0.7, 0.0, 1.0) ** 1.2 * 0.7
 luma = (sky * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1, keepdims=True)
 target = luma * np.array([0.78, 0.92, 1.18])
 sky = sky * (1 - cool) + target * cool
 grey = (sky * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1, keepdims=True)
-sky = grey + (sky - grey) * 0.88
+sky = grey + (sky - grey) * 0.7
+# S1's sky is peach, not amber: a touch less green and blue-neutral.
+sky = sky * np.array([1.0, 0.93, 0.97])
 save(sky, "T_Q_Sky_D.png", (2048, 1024))
 
