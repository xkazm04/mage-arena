diff --git a/apps/vr/tools/capture-s1.ps1 b/apps/vr/tools/capture-s1.ps1
new file mode 100644
index 0000000..5efbd51
--- /dev/null
+++ b/apps/vr/tools/capture-s1.ps1
@@ -0,0 +1,73 @@
+# The graphics push's S1 shot (docs/concepts/GRAPHICS-PUSH-2026-10-28.md, "The common yardstick"; Look/S1ShotCapture.h):
+# one rendered (not -nullrhi) editor run of -MageArenaS1Shot under -MageArenaLook=<Look>, at S1's 1376 x 768, writing
+# s1-game.png (the game camera) and s1-keyart.png (S1's framing) to <Out>. Success is all of: MAGEVR_CAPTURE_DONE and
+# no MAGEVR_CAPTURE_FAIL in the log, both PNGs on disk and non-empty, and manifest.json beside them. Anything else exits 1.
+# One Unreal process: the caller keeps to the push's limit (one per tier, 8 GB free).
+# Usage: capture-s1.ps1 -Look flat|quest|epic [-Out runs/push/<look>/<round>] [-ExtraArgs "-MageArenaS1Pitch=-6"]
+param(
+	[ValidateSet("flat", "quest", "epic")][string]$Look = "flat",
+	[string]$Out = "",
+	[string]$ExtraArgs = "",
+	[int]$TimeoutMinutes = 15
+)
+
+$ErrorActionPreference = "Stop"
+$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
+$VrDir = (Resolve-Path "$ScriptDir\..").Path
+$RepoDir = (Resolve-Path "$VrDir\..\..").Path
+$Project = Join-Path $VrDir "Game\MageArenaVR.uproject"
+$Editor = "C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe"
+
+if (-not $Out) { $Out = "runs/push/$Look/s1" }
+# The driver takes a repo-relative folder; an absolute -Out under the repo is made relative.
+$OutFull = if ([System.IO.Path]::IsPathRooted($Out)) { $Out } else { Join-Path $RepoDir $Out }
+$OutFull = [System.IO.Path]::GetFullPath($OutFull)
+if (-not $OutFull.StartsWith($RepoDir, [System.StringComparison]::OrdinalIgnoreCase)) {
+	Write-Host "capture-s1: FAIL -Out must be inside the repo ($RepoDir)"
+	exit 1
+}
+$OutRel = $OutFull.Substring($RepoDir.Length).TrimStart('\', '/').Replace('\', '/')
+if (-not (Test-Path $OutFull)) { New-Item -ItemType Directory -Path $OutFull -Force | Out-Null }
+foreach ($Name in @("s1-game.png", "s1-keyart.png", "manifest.json")) {
+	$Old = Join-Path $OutFull $Name
+	if (Test-Path $Old) { Remove-Item -Force $Old }
+}
+
+$LogPath = Join-Path $OutFull "capture-s1.log"
+if (Test-Path $LogPath) { Remove-Item -Force $LogPath }
+$ArgumentList = @(
+	$Project, "-game", "-RenderOffScreen", "-ResX=1376", "-ResY=768", "-unattended", "-nosplash", "-nohmd",
+	"-stdout", "-FullStdOutLogOutput", "-log", "-abslog=$LogPath",
+	"-MageArenaS1Shot", "-MageArenaLook=$Look", "-MageArenaS1Out=$OutRel",
+	"-ExecCmds=`"DisableAllScreenMessages; sg.PostProcessQuality 3`""
+)
+if ($ExtraArgs) { $ArgumentList += $ExtraArgs }
+
+Write-Host "capture-s1: look=$Look out=$OutRel"
+$Started = Get-Date
+$Process = Start-Process -FilePath $Editor -ArgumentList $ArgumentList -PassThru -WindowStyle Hidden `
+	-RedirectStandardOutput (Join-Path $OutFull "stdout.log") -RedirectStandardError (Join-Path $OutFull "stderr.log")
+if (-not $Process.WaitForExit($TimeoutMinutes * 60000)) {
+	& taskkill.exe /T /F /PID $Process.Id | Out-Host
+	Write-Host "capture-s1: FAIL the run passed the $TimeoutMinutes minute timeout and was stopped"
+	exit 1
+}
+Write-Host ("capture-s1: editor exited after {0:N0} s" -f ((Get-Date) - $Started).TotalSeconds)
+
+$Failures = @()
+$LogText = if (Test-Path $LogPath) { Get-Content -Raw -Path $LogPath } else { "" }
+if (Test-Path $LogPath) { Select-String -Path $LogPath -Pattern "MAGEVR_S1|MAGEVR_SHOT|MAGEVR_CAPTURE|MAGEVR_LOOK|MAGEVR_RIVAL_CLIP" | ForEach-Object { Write-Host $_.Line } }
+if (-not $LogText) { $Failures += "no log at $LogPath" }
+if ($LogText -notmatch "MAGEVR_CAPTURE_DONE") { $Failures += "missing MAGEVR_CAPTURE_DONE" }
+if ($LogText -match "MAGEVR_CAPTURE_FAIL") { $Failures += "the log has MAGEVR_CAPTURE_FAIL" }
+foreach ($Name in @("s1-game.png", "s1-keyart.png", "manifest.json")) {
+	$Path = Join-Path $OutFull $Name
+	if (-not (Test-Path $Path)) { $Failures += "missing $Path" }
+	elseif ((Get-Item $Path).Length -eq 0) { $Failures += "empty $Path" }
+}
+if ($Failures.Count -gt 0) {
+	foreach ($Why in $Failures) { Write-Host "capture-s1: FAIL $Why" }
+	exit 1
+}
+Write-Host "capture-s1: ok $OutFull\s1-game.png $OutFull\s1-keyart.png"
+exit 0
