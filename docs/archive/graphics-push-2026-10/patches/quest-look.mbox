+// Brennic on Quest (Tier B's texture set, Look/BrennicEpicLook.h): default lit, no subsurface. The skin takes a cheap wrap
+// (a warm lift where the ORM's skin mask is), and a pale gold rim on the silhouette parts him from the sandstone wall.
+const TCHAR* BrennicGlowCode = TEXT(
+    "float f = 1.0 - saturate(dot(normalize(N), normalize(V)));\n"
+    "float rim = pow(f, 3.0) * Rim;\n"
+    "return Base * Skin * Wrap * float3(1.0, 0.55, 0.4) + float3(1.0, 0.82, 0.55) * rim;");
+
+UMaterial* BuildBrennic()
+{
+	const TCHAR* Name = TEXT("M_Q_Brennic");
+	const auto Load = [](const TCHAR* Texture)
+	{
+		return LoadObject<UTexture2D>(nullptr, *FString::Printf(TEXT("/Game/Look/Epic/Brennic/%s.%s"), Texture, Texture), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	};
+	UTexture2D* BaseTexture = Load(TEXT("T_BrennicEpic_BaseColor"));
+	UTexture2D* NormalTexture = Load(TEXT("T_BrennicEpic_Normal"));
+	UTexture2D* OrmTexture = Load(TEXT("T_BrennicEpic_ORM"));
+	if (!BaseTexture || !NormalTexture || !OrmTexture)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_QUEST_ASSETS %s skipped: Tier B's /Game/Look/Epic/Brennic textures are not here (cherry-pick ff1f720)"), Name);
+		return nullptr;
+	}
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Opaque;
+	Material->SetShadingModel(MSM_DefaultLit);
+	Material->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+	UMaterialExpressionTextureSample* Base = G.Make<UMaterialExpressionTextureSample>();
+	Base->Texture = BaseTexture;
+	Base->SamplerType = SAMPLERTYPE_Color;
+	UMaterialExpressionTextureSample* Bump = G.Make<UMaterialExpressionTextureSample>();
+	Bump->Texture = NormalTexture;
+	Bump->SamplerType = SAMPLERTYPE_Normal;
+	UMaterialExpressionTextureSample* Orm = G.Make<UMaterialExpressionTextureSample>();
+	Orm->Texture = OrmTexture;
+	Orm->SamplerType = SAMPLERTYPE_Masks;
+	UMaterialExpression* Glow = G.Custom(TEXT("WrapRim"), CMOT_Float3, BrennicGlowCode,
+	    {{TEXT("Base"), Base}, {TEXT("Skin"), Orm, 4}, {TEXT("N"), G.Make<UMaterialExpressionVertexNormalWS>()}, {TEXT("V"), G.Make<UMaterialExpressionCameraVectorWS>()},
+	        {TEXT("Wrap"), G.Scalar(TEXT("SkinWrap"), 0.12f)}, {TEXT("Rim"), G.Scalar(TEXT("RimStrength"), 0.55f)}});
+	Material->GetEditorOnlyData()->BaseColor.Connect(0, Base);
+	Material->GetEditorOnlyData()->Normal.Connect(0, Bump);
+	Material->GetEditorOnlyData()->AmbientOcclusion.Connect(1, Orm);
+	Material->GetEditorOnlyData()->Roughness.Connect(2, Orm);
+	Material->GetEditorOnlyData()->Metallic.Connect(3, Orm);
+	Material->GetEditorOnlyData()->Specular.Expression = G.Scalar(TEXT("Specular"), 0.4f);
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Glow;
+	return Finish(Material, Name) ? Material : nullptr;
+}
