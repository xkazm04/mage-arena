+++ b/apps/vr/art/characters/brennic/epic/cast_open.py
@@ -0,0 +1,98 @@
+"""Brennic's arms-out Cast for the non-flat looks (graphics push 10-28): S1 shows him mid-cast with both arms thrust
+forward and apart, palms toward the seat; the committed Cast throws one arm up and keeps the other low.
+
+blender -b -P cast_open.py -- <Brennic.fbx> <out.fbx> [pitch_deg]
+
+Takes the in-game FBX's Cast take, and from the wind-up on blends both upper and lower arms toward a forward-and-out
+spread (+X is his forward), holding it through the release, then blends back over the last frames so the clip still
+hands off to Idle. Writes one take, CastOpen, with the same frame count; the Cast clip itself is untouched.
+"""
+import math
+import sys
+
+import bpy
+import mathutils
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+SRC, OUT = argv[0], argv[1]
+LIFT = float(argv[2]) if len(argv) > 2 else 8.0
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=SRC)
+arm = next(o for o in bpy.data.objects if o.type == 'ARMATURE')
+cast = next(a for a in bpy.data.actions if a.name.endswith("Cast"))
+if arm.animation_data is None:
+    arm.animation_data_create()
+for track in arm.animation_data.nla_tracks:
+    track.mute = True
+action = cast.copy()
+action.name = "CastOpen"
+arm.animation_data.action = action
+f0, f1 = (int(round(v)) for v in action.frame_range)
+print("CASTOPEN frames", f0, f1)
+
+
+def smooth(a, b, x):
+    t = min(max((x - a) / (b - a), 0.0), 1.0)
+    return t * t * (3 - 2 * t)
+
+
+def direction(side, yaw_out, pitch_up):
+    # +X forward, +Y his left; side +1 = left arm, -1 = right arm
+    y, p = math.radians(yaw_out), math.radians(pitch_up)
+    return mathutils.Vector((math.cos(p) * math.cos(y), side * math.cos(p) * math.sin(y), math.sin(p))).normalized()
+
+
+TARGETS = {
+    "upperarm": lambda side: direction(side, 38.0, LIFT - 6.0),
+    "lowerarm": lambda side: direction(side, 26.0, LIFT),
+    "hand": lambda side: direction(side, 18.0, LIFT + 34.0),  # the wrist bent back: palm toward the seat
+}
+span = f1 - f0
+for pb in arm.pose.bones:
+    pb.rotation_mode = 'QUATERNION'
+for frame in range(f0, f1 + 1):
+    bpy.context.scene.frame_set(frame)
+    w = smooth(f0 + 0.15 * span, f0 + 0.35 * span, frame) * (1.0 - smooth(f1 - 0.12 * span, f1, frame))
+    for part in ("upperarm", "lowerarm", "hand"):
+        for side, suffix in ((1, "l"), (-1, "r")):
+            pb = arm.pose.bones.get(f"{part}_{suffix}")
+            if pb is None:
+                continue
+            m = pb.matrix.copy()
+            axis = m.to_3x3().col[1].normalized()
+            target = axis.slerp(TARGETS[part](side), w) if w > 0 else axis
+            rot = axis.rotation_difference(target)
+            loc = m.to_translation()
+            pb.matrix = mathutils.Matrix.Translation(loc) @ rot.to_matrix().to_4x4() @ mathutils.Matrix.Translation(-loc) @ m
+            bpy.context.view_layer.update()
+            pb.keyframe_insert("rotation_quaternion", frame=frame)
+print("CASTOPEN keyed", action.name)
+
+bpy.context.scene.frame_start, bpy.context.scene.frame_end = f0, f1  # the take's own range, not the scene default
+for o in bpy.data.objects:
+    o.select_set(o.type in ('ARMATURE', 'MESH'))
+bpy.context.view_layer.objects.active = arm
+bpy.ops.export_scene.fbx(filepath=OUT, use_selection=True, object_types={'ARMATURE', 'MESH'}, apply_scale_options='FBX_SCALE_ALL',
+                         mesh_smooth_type='FACE', add_leaf_bones=False, armature_nodetype='NULL', bake_anim=True,
+                         bake_anim_use_all_bones=True, bake_anim_use_nla_strips=False, bake_anim_use_all_actions=False,
+                         bake_anim_force_startend_keying=True, bake_anim_step=1.0, bake_anim_simplify_factor=0.0,
+                         path_mode='STRIP', embed_textures=False)
+print("CASTOPEN exported", OUT)
+
+# a preview strip of the held pose
+bpy.context.scene.frame_set(int(f0 + 0.6 * span))
+scn = bpy.context.scene
+scn.render.engine = 'BLENDER_EEVEE'
+scn.render.resolution_x, scn.render.resolution_y = 640, 640
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam"))
+scn.collection.objects.link(cam)
+scn.camera = cam
+cam.location = (5.0, 0.0, 1.3)
+cam.rotation_euler = (math.radians(90), 0, math.radians(90))
+sun = bpy.data.objects.new("Sun", bpy.data.lights.new("Sun", 'SUN'))
+scn.collection.objects.link(sun)
+sun.rotation_euler = (math.radians(50), 0, math.radians(60))
+scn.world = bpy.data.worlds.new("W")
+scn.render.filepath = OUT.replace(".fbx", "_preview.png")
+bpy.ops.render.render(write_still=True)
-- 
