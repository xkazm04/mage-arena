+{
+constexpr int32 S1ShotId = 941000;
+// Wall seconds the pose holds before the first still: the ward clip reaches its hold, shadows and streaming settle.
+constexpr double SettleS = 2.5;
+constexpr int32 SettleFrames = 30;
+// Frames the key-art FOV holds before its still, so the camera and the shadow cascades have taken it.
+constexpr int32 KeyArtFrames = 6;
+// S1: the top of Brennic's head sits about a tenth of the frame height below the frame's top edge.
+constexpr double KeyArtTopMargin = 0.1;
+}
+
+US1ShotCaptureDriver::US1ShotCaptureDriver()
+{
+	SetTickableTickType(ETickableTickType::Never);
+}
+
+bool US1ShotCaptureDriver::IsRequested()
+{
+	return FParse::Param(FCommandLine::Get(), TEXT("MageArenaS1Shot"));
+}
+
+void US1ShotCaptureDriver::Start()
+{
+	OutDir = FString::Printf(TEXT("runs/push/%s/s1"), ArenaLook::Name(ArenaLook::Current()));
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1Out="), OutDir);
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1CastS="), CastS);
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1BoltOutM="), BoltOutM);
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1Pitch="), PitchDeg);
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1KeyArtFraction="), KeyArtFraction);
+	bRunning = true;
+	RunStartWall = FPlatformTime::Seconds();
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_S1 start look=%s out=%s castS=%.2f boltOutM=%.2f pitch=%.1f keyArtFraction=%.2f"), ArenaLook::Name(ArenaLook::Current()), *OutDir, CastS, BoltOutM,
+	    PitchDeg, KeyArtFraction);
+	Enter(EStep::WaitStable);
+	SetTickableTickType(ETickableTickType::Always);
+	Evidence.Begin(TEXT("S1Shot"));
+	Evidence.Note(TEXT("look"), ArenaLook::Name(ArenaLook::Current()));
+	if (!MageArenaCapture::CanCapture())
+	{
+		Fail(TEXT("no rhi"));
+	}
+}
+
+void US1ShotCaptureDriver::Enter(EStep Next)
+{
+	Step = Next;
+	StepStartWall = FPlatformTime::Seconds();
+	Frames = 0;
+}
+
+void US1ShotCaptureDriver::Fail(const FString& Reason)
+{
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_CAPTURE_FAIL %s"), *Reason);
+	Enter(EStep::Quit);
+}
+
+AMageArenaPawn* US1ShotCaptureDriver::FindPawn() const
+{
+	UWorld* World = GetWorld();
+	if (!World)
+	{
+		return nullptr;
+	}
+	TActorIterator<AMageArenaPawn> It(World);
+	return It ? *It : nullptr;
+}
+
+UArenaSessionSubsystem* US1ShotCaptureDriver::SessionSys() const
+{
+	UWorld* World = GetWorld();
+	return World ? World->GetSubsystem<UArenaSessionSubsystem>() : nullptr;
+}
+
+USkeletalMeshComponent* US1ShotCaptureDriver::FigureMesh() const
+{
+	UArenaSessionSubsystem* Session = SessionSys();
+	ASessionPresentation* Presentation = Session ? Session->GetPresentation() : nullptr;
+	const URivalFigureComponent* Figure = Presentation ? Presentation->FindComponentByClass<URivalFigureComponent>() : nullptr;
+	return Figure ? Figure->GetMesh() : nullptr;
+}
+
+bool US1ShotCaptureDriver::PoseScene()
+{
+	UArenaSessionSubsystem* Session = SessionSys();
+	if (!Session)
+	{
+		Fail(TEXT("no session"));
+		return false;
+	}
+	FArenaSession& Bout = Session->GetSession();
+	// The bout is frozen (SetFrameHold), so the kernel never steps again and the capture owns its state.
+	FGames& Games = const_cast<FGames&>(Bout.GetGames());
+	FArenaState& State = Games.State;
+	FActor* Player = SimFindActor(State, Games.PlayerId);
+	const int32 RivalId = Games.VrRules.IsSet() ? Games.VrRules->RivalRuntime.ActorId : -1;
+	FActor* Rival = SimFindActor(State, RivalId);
+	if (!Player || !Rival)
+	{
+		Fail(FString::Printf(TEXT("no player or no rival (rival id %d)"), RivalId));
+		return false;
+	}
+	const FSimVec Seat = Player->Pos;
+	const FSimVec Ahead = SimUnit(Player->Facing, FSimVec{1.0, 0.0});
+	// His own distance at the bout's start (the far spawn ring) unless -MageArenaS1RivalM= asks for another.
+	double DistanceM = SimDistance(Seat, Rival->Pos);
+	double RivalM = 0.0;
+	if (FParse::Value(FCommandLine::Get(), TEXT("MageArenaS1RivalM="), RivalM) && RivalM > 1.0)
+	{
+		DistanceM = RivalM;
+	}
+	for (FActor& Actor : State.Actors)
+	{
+		if (Actor.Id != Games.PlayerId && Actor.Id != RivalId)
+		{
+			Actor.bDown = true;
+		}
+	}
+	Rival->bDown = false;
+	Rival->Pos = SimAdd(Seat, SimScale(Ahead, DistanceM));
+	Rival->PreviousPos = Rival->Pos;
+	Rival->Facing = SimScale(Ahead, -1.0);
+
+	// His cast, dated back so the figure starts CastS into its Cast clip (RivalFigure plays from the event's tick).
+	const int32 Back = FMath::Max(1, FMath::RoundToInt32(CastS / SimDt()));
+	Emit(State, TEXT("cast"), *Rival);
+	State.Events.Last().Tick = State.Tick - Back;
+
+	State.Projectiles.Reset();
+	State.Telegraphs.Reset();
+	const FSimVec From = Rival->Pos;
+	const FSimVec Lane = SimUnit(SimSub(Seat, From));
+	FProjectile& Shot = State.Projectiles.AddDefaulted_GetRef();
+	Shot.Id = S1ShotId;
+	Shot.ActivationId = Shot.Id;
+	Shot.OwnerId = RivalId;
+	Shot.Family = TEXT("magic");
+	Shot.bBolt = true;
+	Shot.Radius = KernelData().ProjectileRadiusM;
+	Shot.Source = From;
+	Shot.OriginPos = From;
+	Shot.AimedAt = Seat;
+	Shot.Pos = SimAdd(Seat, SimScale(Lane, -FMath::Min(BoltOutM, DistanceM)));
+	Shot.Velocity = SimScale(Lane, 14.0);
+	Shot.PreviousPos = SimSub(Shot.Pos, SimScale(Shot.Velocity, SimDt()));
+
+	BrennicFeetCm = Bout.KernelToUnrealCm(Rival->Pos);
+	Evidence.Note(TEXT("rivalDistanceM"), FString::Printf(TEXT("%.2f"), DistanceM));
+	Evidence.Note(TEXT("boltOutM"), FString::Printf(TEXT("%.2f"), BoltOutM));
+	Evidence.Note(TEXT("castS"), FString::Printf(TEXT("%.2f"), CastS));
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_S1 pose rival=%d distance=%.2f m bolt=%.2f m out castTicksBack=%d"), RivalId, DistanceM, BoltOutM, Back);
+
+	if (UGameInstance* Instance = GetWorld() ? GetWorld()->GetGameInstance() : nullptr)
+	{
+		if (UHandInputSubsystem* Hands = Instance->GetSubsystem<UHandInputSubsystem>())
+		{
+			Hands->SetWardHeld(true, EClipVariant::Normal);
+		}
+	}
+	AimCamera(PitchDeg);
+	return true;
+}
+
+void US1ShotCaptureDriver::AimCamera(float Pitch)
+{
+	AMageArenaPawn* Pawn = FindPawn();
+	AController* Controller = Pawn ? Pawn->GetController() : nullptr;
+	const UCameraComponent* Camera = Pawn ? Pawn->FindComponentByClass<UCameraComponent>() : nullptr;
+	if (!Controller || !Camera)
+	{
+		return;
+	}
+	const FVector Delta = BrennicFeetCm - Camera->GetComponentLocation();
+	const float Yaw = static_cast<float>(FMath::RadiansToDegrees(FMath::Atan2(Delta.Y, Delta.X)));
+	Controller->SetControlRotation(Pawn->ClampLookRotation(FRotator(Pitch, Yaw, 0.f)));
+}
+
+void US1ShotCaptureDriver::FreezeFigure()
+{
+	// The figure's clip runs on wall time (GlobalAnimRateScale follows the session pause, not the frame hold): pin it.
+	if (USkeletalMeshComponent* Mesh = FigureMesh())
+	{
+		Mesh->SetPosition(static_cast<float>(CastS), false);
+		Mesh->bPauseAnims = true;
+		Mesh->RefreshBoneTransforms();
+	}
+}
+
+bool US1ShotCaptureDriver::KeyArtFraming(float& OutFovDeg, float& OutPitchDeg) const
+{
+	AMageArenaPawn* Pawn = FindPawn();
+	const UCameraComponent* Camera = Pawn ? Pawn->FindComponentByClass<UCameraComponent>() : nullptr;
+	const USkeletalMeshComponent* Mesh = FigureMesh();
+	if (!Camera || !Mesh)
+	{
+		return false;
+	}
+	const FVector Eye = Camera->GetComponentLocation();
+	const FBox Box = Mesh->Bounds.GetBox();
+	const double Horizontal = FVector2D(BrennicFeetCm.X - Eye.X, BrennicFeetCm.Y - Eye.Y).Size();
+	const double TopDeg = FMath::RadiansToDegrees(FMath::Atan2(Box.Max.Z - Eye.Z, Horizontal));
+	const double BottomDeg = FMath::RadiansToDegrees(FMath::Atan2(BrennicFeetCm.Z - Eye.Z, Horizontal));
+	const double VerticalFov = FMath::Clamp((TopDeg - BottomDeg) / FMath::Max(KeyArtFraction, 0.05), 10.0, 120.0);
+	const double Aspect = 1376.0 / 768.0;
+	OutFovDeg = static_cast<float>(2.0 * FMath::RadiansToDegrees(FMath::Atan(Aspect * FMath::Tan(FMath::DegreesToRadians(VerticalFov * 0.5)))));
+	// The view centre sits half a frame below the top edge; the head's top KeyArtTopMargin of a frame below that edge.
+	OutPitchDeg = static_cast<float>(TopDeg + KeyArtTopMargin * VerticalFov - 0.5 * VerticalFov);
+	return true;
+}
+
+void US1ShotCaptureDriver::RequestShot(const TCHAR* FileName)
+{
+	const FString Path = MageArenaCapture::RepoPath(FPaths::Combine(OutDir, FileName));
+	FScreenshotRequest::RequestScreenshot(Path, false, false, false);
+	bShotOpen = true;
+	++ShotCount;
+	Evidence.Requested(FileName, Path, SessionSys());
+	// The previous frame's RHI counters: the posed scene as drawn just before the shot.
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_SHOT name=%s drawCalls=%d rhiPrimitives=%d path=%s"), FileName, GNumDrawCallsRHI[0], GNumPrimitivesDrawnRHI[0], *Path);
+	Evidence.Note(FString::Printf(TEXT("counters.%s"), FileName), FString::Printf(TEXT("drawCalls=%d rhiPrimitives=%d"), GNumDrawCallsRHI[0], GNumPrimitivesDrawnRHI[0]));
+}
+
+void US1ShotCaptureDriver::Tick(float DeltaTime)
+{
+	(void)DeltaTime;
+	if (!bRunning)
+	{
+		return;
+	}
+	if (bShotOpen)
+	{
+		const ECaptureShotPoll Shot = Evidence.Poll();
+		if (Shot == ECaptureShotPoll::Pending)
+		{
+			return;
+		}
+		bShotOpen = false;
+		if (Shot == ECaptureShotPoll::Failed)
+		{
+			Fail(Evidence.GetFailure());
+			return;
+		}
+	}
+	const double Now = FPlatformTime::Seconds();
+	const double Elapsed = Now - StepStartWall;
+	if (Step != EStep::Quit && Now - RunStartWall > 600.0)
+	{
+		Fail(FString::Printf(TEXT("timeout in step %d"), static_cast<int32>(Step)));
+		return;
+	}
+	++Frames;
+	UArenaSessionSubsystem* Session = SessionSys();
+	FArenaSession* Bout = Session ? &Session->GetSession() : nullptr;
+	AMageArenaPawn* Pawn = FindPawn();
+	const bool bCompilingIdle = (GShaderCompilingManager == nullptr || !GShaderCompilingManager->IsCompiling()) && FAssetCompilingManager::Get().GetNumRemainingAssets() == 0;
+	switch (Step)
+	{
+	case EStep::WaitStable:
+	{
+		const float Delta = FApp::GetDeltaTime();
+		if ((Pawn && Pawn->HasLayout() && bCompilingIdle && Delta > 0.f && Delta < 0.1f && Elapsed >= 2.0) || Elapsed >= 120.0)
+		{
+			if (!Session || !Pawn || !Bout)
+			{
+				Fail(TEXT("session or pawn missing"));
+				break;
+			}
+			Pawn->ApplyFlatPresentation();
+			if (GEngine)
+			{
+				GEngine->Exec(GetWorld(), TEXT("r.MotionBlurQuality 0"));
+			}
+			Bout->SetSaveDirectory(FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("MageArenaTests"), TEXT("s1-capture")));
+			Enter(EStep::StartBout);
+		}
+		break;
+	}
+	case EStep::StartBout:
+		Bout->SetBout(2, true);
+		if (!Session->Start(1, false))
+		{
+			Fail(TEXT("the semifinal did not start"));
+			break;
+		}
+		Bout->SetFrameHold(true);
+		Enter(EStep::Pose);
+		break;
+	case EStep::Pose:
+		// One frame after the start, so the bout's actors and the presentation exist.
+		if (Frames >= 2 && PoseScene())
+		{
+			Enter(EStep::Settle);
+		}
+		break;
+	case EStep::Settle:
+		AimCamera(PitchDeg);
+		if (Frames == 3)
+		{
+			FreezeFigure();
+		}
+		if (Frames >= SettleFrames && Elapsed >= SettleS)
+		{
+			if (GShaderCompilingManager)
+			{
+				GShaderCompilingManager->FinishAllCompilation();
+			}
+			FAssetCompilingManager::Get().FinishAllCompilation();
+			if (!bCompilingIdle && Elapsed < 240.0)
+			{
+				break;
+			}
+			IStreamingManager::Get().StreamAllResources(10.f);
+			FreezeFigure();
+			if (!FigureMesh())
+			{
+				UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_S1 the rival figure did not load: Brennic is drawn as his greybox body"));
+				Evidence.Note(TEXT("figure"), TEXT("greybox body (the rigged figure did not load)"));
+			}
+			Enter(EStep::ShotGame);
+		}
+		break;
+	case EStep::ShotGame:
+		AimCamera(PitchDeg);
+		if (Frames >= 3)
+		{
+			RequestShot(TEXT("s1-game.png"));
+			Enter(EStep::FrameKeyArt);
+		}
+		break;
+	case EStep::FrameKeyArt:
+	{
+		float Fov = 0.f;
+		float KeyPitch = PitchDeg;
+		if (!Pawn || !KeyArtFraming(Fov, KeyPitch))
+		{
+			Fail(TEXT("no figure or camera to frame the key-art shot"));
+			break;
+		}
+		Pawn->SetCaptureFovOverride(Fov);
+		AimCamera(KeyPitch);
+		if (Frames == 1)
+		{
+			UE_LOG(LogMageArena, Log, TEXT("MAGEVR_S1 keyart fov=%.2f pitch=%.2f fraction=%.2f"), Fov, KeyPitch, KeyArtFraction);
+			Evidence.Note(TEXT("keyArtFovDeg"), FString::Printf(TEXT("%.2f"), Fov));
+			Evidence.Note(TEXT("keyArtPitchDeg"), FString::Printf(TEXT("%.2f"), KeyPitch));
+		}
+		if (Frames >= KeyArtFrames)
+		{
+			Enter(EStep::ShotKeyArt);
+		}
+		break;
+	}
+	case EStep::ShotKeyArt:
+		RequestShot(TEXT("s1-keyart.png"));
+		Enter(EStep::Finish);
+		break;
+	case EStep::Finish:
+	{
+		if (Pawn)
+		{
+			Pawn->SetCaptureFovOverride(0.f);
+		}
+		FString ManifestError;
+		if (ShotCount == 2 && Evidence.WriteManifest(MageArenaCapture::RepoPath(FPaths::Combine(OutDir, TEXT("manifest.json"))), ManifestError))
+		{
+			UE_LOG(LogMageArena, Log, TEXT("MAGEVR_CAPTURE_DONE shots=%d"), ShotCount);
+		}
+		else
+		{
+			UE_LOG(LogMageArena, Error, TEXT("MAGEVR_CAPTURE_FAIL shots=%d %s"), ShotCount, *ManifestError);
+		}
+		Enter(EStep::Quit);
+		break;
+	}
+	case EStep::Quit:
+		bRunning = false;
+		SetTickableTickType(ETickableTickType::Never);
+		if (UWorld* World = GetWorld())
+		{
+			if (APlayerController* Controller = World->GetFirstPlayerController())
+			{
+				Controller->ConsoleCommand(TEXT("Quit"));
+			}
+		}
+		break;
+	default:
+		break;
+	}
+}
