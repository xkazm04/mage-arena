diff --git a/apps/vr/Game/Source/MageArenaVR/Look/QuestSpells.cpp b/apps/vr/Game/Source/MageArenaVR/Look/QuestSpells.cpp
new file mode 100644
index 0000000..6bce64c
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/QuestSpells.cpp
@@ -0,0 +1,132 @@
+#include "Look/QuestSpells.h"
+
+#include "Components/InstancedStaticMeshComponent.h"
+#include "Components/SkeletalMeshComponent.h"
+#include "Engine/StaticMesh.h"
+#include "Greybox/ArenaLayout.h"
+#include "Greybox/GreyboxUtil.h"
+#include "Look/ArenaLook.h"
+#include "MageArenaVR.h"
+#include "Materials/MaterialInterface.h"
+
+namespace
+{
+UMaterialInterface* LoadSpell(const TCHAR* Name)
+{
+	const FString Path = FString::Printf(TEXT("%s/%s.%s"), QuestSpells::Folder, Name, Name);
+	UMaterialInterface* Material = LoadObject<UMaterialInterface>(nullptr, *Path, nullptr, LOAD_NoWarn | LOAD_Quiet);
+	if (!Material)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_QUEST_SPELLS missing %s (run apps/vr/tools/look/create-quest-spell-assets.ps1)"), Name);
+	}
+	return Material;
+}
+
+// The ward's cards: how many share the arc, how tall the wave stands and how far below the palm it starts (cm), and the
+// share of the panorama (one copy of the wave of the two side by side) the whole arc shows.
+constexpr int32 WardCardCount = 14;
+constexpr double WardHeightCm = 26.0;
+constexpr double WardBelowPalmCm = 14.0;
+constexpr float WardUSpan = 0.5f;
+}
+
+bool QuestSpells::IsActive()
+{
+	return !ArenaLook::IsFlat();
+}
+
+UMaterialInterface* QuestSpells::GlowMaterial()
+{
+	return IsActive() ? LoadSpell(TEXT("M_Q_SpellGlow")) : nullptr;
+}
+
+UMaterialInterface* QuestSpells::BoltCoreMaterial()
+{
+	return IsActive() ? LoadSpell(TEXT("M_Q_BoltCore")) : nullptr;
+}
+
+void QuestSpells::HandFlamePuffs(const USkeletalMeshComponent& Mesh, double TimeS, TArray<SpellVfx::FPuff>& Out)
+{
+	static const TCHAR* const Fingers[] = {TEXT("thumb"), TEXT("index"), TEXT("middle"), TEXT("ring"), TEXT("pinky"), TEXT("finger")};
+	int32 Hands = 0;
+	for (int32 Bone = 0; Bone < Mesh.GetNumBones() && Hands < 2; ++Bone)
+	{
+		const FString Name = Mesh.GetBoneName(Bone).ToString().ToLower();
+		bool bFinger = false;
+		for (const TCHAR* Finger : Fingers)
+		{
+			bFinger |= Name.Contains(Finger);
+		}
+		if (!Name.Contains(TEXT("hand")) || bFinger)
+		{
+			continue;
+		}
+		const FVector At = Mesh.GetBoneLocation(Mesh.GetBoneName(Bone));
+		for (int32 Layer = 0; Layer < 2; ++Layer)
+		{
+			SpellVfx::FPuff& Puff = Out.AddDefaulted_GetRef();
+			const double Flicker = 1.0 + 0.12 * FMath::Sin(TimeS * (7.0 + Layer * 3.1) + Bone);
+			Puff.CentreCm = At + FVector(0.0, 0.0, 6.0 + Layer * 6.0);
+			Puff.SizeCm = FVector((Layer == 0 ? 34.0 : 24.0) * Flicker);
+			Puff.Cell = (FMath::FloorToInt32(TimeS * SpellVfx::FlipbookFps) + Layer) % 2 == 0 ? SpellVfx::ECell::FireFlameA : SpellVfx::ECell::FireFlameB;
+			Puff.bMirror = Layer == 1;
+			Puff.Roll = static_cast<float>(TimeS * 1.7 + Layer);
+		}
+		++Hands;
+	}
+}
+
+UInstancedStaticMeshComponent* QuestSpells::MakeWardCards(USceneComponent& Parent)
+{
+	UMaterialInterface* Material = IsActive() ? LoadSpell(TEXT("M_Q_Ward")) : nullptr;
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	AActor* Owner = Parent.GetOwner();
+	if (!Material || !Plane || !Owner)
+	{
+		return nullptr;
+	}
+	UInstancedStaticMeshComponent* Cards = Greybox::MakeInstances(Owner, Plane, Material);
+	if (!Cards)
+	{
+		return nullptr;
+	}
+	Cards->AttachToComponent(&Parent, FAttachmentTransformRules::KeepRelativeTransform);
+	Cards->SetCastShadow(false);
+	Cards->SetNumCustomDataFloats(2);
+	Cards->SetVisibility(false);
+	return Cards;
+}
+
+void QuestSpells::PoseWardCards(UInstancedStaticMeshComponent& Cards, const FArenaLayout& Layout, const FVector& Palm, const FVector& Normal, const FVector& Right, const FVector& Up)
+{
+	const double Mid = (Layout.WardArcInnerM + Layout.WardArcOuterM) * 50.0;
+	const double Half = FMath::DegreesToRadians(Layout.WardArcDeg * 0.5);
+	const double Step = FMath::DegreesToRadians(Layout.WardArcDeg / WardCardCount) * Mid * 1.03;
+	TArray<FTransform> Transforms;
+	TArray<float> Data;
+	for (int32 Index = 0; Index < WardCardCount; ++Index)
+	{
+		const double Angle = FMath::Lerp(-Half, Half, (Index + 0.5) / static_cast<double>(WardCardCount));
+		const FVector Dir = Normal * FMath::Cos(Angle) + Right * FMath::Sin(Angle);
+		const FVector Tangent = (-Normal * FMath::Sin(Angle) + Right * FMath::Cos(Angle)).GetSafeNormal();
+		// The plane's U along the arc, its V down the wave, its face toward the palm.
+		const FVector X = Tangent;
+		const FVector Y = -Up;
+		const FVector Z = FVector::CrossProduct(X, Y);
+		const FVector Centre = Palm + Dir * Mid + Up * (WardHeightCm * 0.5 - WardBelowPalmCm);
+		Transforms.Add(FTransform(FMatrix(X, Y, Z, FVector::ZeroVector).ToQuat(), Centre, FVector(Step / 100.0, WardHeightCm / 100.0, 1.0)));
+		Data.Add(WardUSpan * Index / WardCardCount);
+		Data.Add(WardUSpan / WardCardCount);
+	}
+	if (Cards.GetInstanceCount() != WardCardCount)
+	{
+		Cards.ClearInstances();
+		Cards.AddInstances(Transforms, false, false);
+	}
+	else
+	{
+		Cards.BatchUpdateInstancesTransforms(0, Transforms, false, true, true);
+	}
+	Cards.SetCustomData(0, WardCardCount - 1, Data, true);
+	Cards.SetVisibility(true);
+}
