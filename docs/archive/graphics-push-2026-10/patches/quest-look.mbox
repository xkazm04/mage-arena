+void StyleBar(UStaticMeshComponent* Bar, const FLinearColor& Colour, UObject& Outer);
+
+/** The softened hue a styled bar shows: 40 % toward its own luminance, a little dimmer. Exposed for tests. */
+FLinearColor Soften(const FLinearColor& Colour);
+}
