+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Engine/SubsurfaceProfile.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionMultiply.h"
+#include "Materials/MaterialExpressionTextureSampleParameter2D.h"
+#include "ShaderCompiler.h"
+#endif
+
+UCreateBrennicEpicCommandlet::UCreateBrennicEpicCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UCreateBrennicEpicCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	FString Source = FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/characters/brennic/epic"));
+	FParse::Value(*Params, TEXT("source="), Source);
+	Source = FPaths::ConvertRelativePathToFull(Source);
+	const FString Folder = BrennicEpicLook::Folder();
+	UTexture2D* Base = ImportTexture(Source / TEXT("T_BrennicEpic_BaseColor.png"), Folder, TEXT("T_BrennicEpic_BaseColor"), false, TC_Default);
+	UTexture2D* Normal = ImportTexture(Source / TEXT("T_BrennicEpic_Normal.png"), Folder, TEXT("T_BrennicEpic_Normal"), true, TC_Normalmap);
+	UTexture2D* Orm = ImportTexture(Source / TEXT("T_BrennicEpic_ORM.png"), Folder, TEXT("T_BrennicEpic_ORM"), true, TC_Masks);
+	if (!Base || !Normal || !Orm)
+	{
+		return 1;
+	}
+
+	// Skin: a warm, short scatter (the engine's default profile is close; the albedo and mean free path lean red).
+	UPackage* ProfilePackage = CreatePackage(*(Folder / TEXT("SSP_BrennicEpic_Skin")));
+	USubsurfaceProfile* Profile = NewObject<USubsurfaceProfile>(ProfilePackage, TEXT("SSP_BrennicEpic_Skin"), RF_Public | RF_Standalone);
+	Profile->Settings.SurfaceAlbedo = FLinearColor(0.91f, 0.34f, 0.25f);
+	Profile->Settings.MeanFreePathColor = FLinearColor(1.0f, 0.35f, 0.20f);
+	Profile->Settings.MeanFreePathDistance = 0.6f;
+	Profile->MarkPackageDirty();
+
+	UMaterial* Material = NewMaterial(Folder, TEXT("M_BrennicEpic"));
+	Material->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+	Material->SetShadingModel(MSM_SubsurfaceProfile);
+	Material->SubsurfaceProfile = Profile;
+	UMaterialEditorOnlyData* Editor = Material->GetEditorOnlyData();
+
+	UMaterialExpressionTextureSampleParameter2D* BaseSample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -1200, 0);
+	BaseSample->ParameterName = TEXT("BaseColor");
+	BaseSample->Texture = Base;
+	UMaterialExpressionTextureSampleParameter2D* NormalSample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -1200, 300);
+	NormalSample->ParameterName = TEXT("Normal");
+	NormalSample->Texture = Normal;
+	NormalSample->SamplerType = SAMPLERTYPE_Normal;
+	UMaterialExpressionTextureSampleParameter2D* OrmSample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -1200, 600);
+	OrmSample->ParameterName = TEXT("ORM");
+	OrmSample->Texture = Orm;
+	OrmSample->SamplerType = SAMPLERTYPE_Masks;
+
+	UMaterialExpressionMultiply* Gain = Add<UMaterialExpressionMultiply>(*Material, -400, 0);
+	Gain->A.Connect(0, BaseSample);
+	Gain->B.Connect(0, Scalar(*Material, TEXT("BaseGain"), 1.0, 100));
+	Editor->BaseColor.Connect(0, Gain);
+	Editor->Normal.Connect(0, NormalSample);
+	Editor->AmbientOcclusion.Connect(1, OrmSample);
+	Editor->Metallic.Connect(3, OrmSample);
+	UMaterialExpressionMultiply* Rough = Add<UMaterialExpressionMultiply>(*Material, -400, 650);
+	Rough->A.Connect(2, OrmSample);
+	Rough->B.Connect(0, Scalar(*Material, TEXT("RoughnessScale"), 1.0, 700));
+	Editor->Roughness.Connect(0, Rough);
+	// Subsurface-profile materials read the scatter amount from Opacity: the skin mask in ORM alpha.
+	UMaterialExpressionMultiply* Scatter = Add<UMaterialExpressionMultiply>(*Material, -400, 800);
+	Scatter->A.Connect(4, OrmSample);
+	Scatter->B.Connect(0, Scalar(*Material, TEXT("SkinScatter"), 0.85, 850));
+	Editor->Opacity.Connect(0, Scatter);
+	Editor->Specular.Connect(0, Scalar(*Material, TEXT("Specular"), 0.45, 950));
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+
+	Material->ForceRecompileForRendering();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done brennic saved=%d from %s"), Saved, *Source);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreateBrennicEpicCommandlet.h b/apps/vr/Game/Source/MageArenaVR/Tools/CreateBrennicEpicCommandlet.h
