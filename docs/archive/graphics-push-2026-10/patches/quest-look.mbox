+#include "Look/CuffLook.h"
+
+#include "Components/StaticMeshComponent.h"
+#include "Look/ArenaLook.h"
+#include "MageArenaVR.h"
+#include "Materials/MaterialInstanceDynamic.h"
+#include "Materials/MaterialInterface.h"
+
+namespace
+{
+UMaterialInterface* LoadCuff(const TCHAR* Name)
+{
+	if (ArenaLook::IsFlat())
+	{
+		return nullptr;
+	}
+	return LoadObject<UMaterialInterface>(nullptr, *FString::Printf(TEXT("%s/%s.%s"), *CuffLook::Folder(), Name, Name), nullptr, LOAD_NoWarn | LOAD_Quiet);
+}
+}
+
+FString CuffLook::Folder()
+{
+	return TEXT("/Game/Look/Shared/Cuff");
+}
+
+UMaterialInterface* CuffLook::PanelBase()
+{
+	return LoadCuff(TEXT("M_CuffStyled"));
+}
+
+FLinearColor CuffLook::Soften(const FLinearColor& Colour)
+{
+	const float Luma = 0.2126f * Colour.R + 0.7152f * Colour.G + 0.0722f * Colour.B;
+	const FLinearColor Grey(Luma, Luma, Luma);
+	return (Colour + (Grey - Colour) * 0.4f) * 0.85f;
+}
+
+void CuffLook::StyleBar(UStaticMeshComponent* Bar, const FLinearColor& Colour, UObject& Outer)
+{
+	UMaterialInterface* Rune = Bar ? LoadCuff(TEXT("M_CuffRune")) : nullptr;
+	if (!Rune)
+	{
+		return;
+	}
+	UMaterialInstanceDynamic* Tint = UMaterialInstanceDynamic::Create(Rune, &Outer);
+	Tint->SetVectorParameterValue(TEXT("Color"), Soften(Colour));
+	Tint->SetScalarParameterValue(TEXT("Gain"), 1.1f);
+	Bar->SetMaterial(0, Tint);
+	Bar->SetCastShadow(false);
+}
