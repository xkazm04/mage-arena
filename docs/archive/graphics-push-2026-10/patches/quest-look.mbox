+// The player's hands on Quest (Tier B's SK_PlayerHands texture set, Look/PlayerHandsLook.h). Isolated on r3: the skin
+// albedo itself is near white-pink (sRGB about 230, 200, 180), so the warm sun lit it chalk-white; the light is the one
+// the sand reads right under. The quest skin tans the albedo (regional variation kept: the painted backs, knuckles and
+// tips keep their relative tones), lifts the pink where it is already pinkest (knuckles, palms, tips), and adds a cheap
+// subsurface-like wrap (a warm self-light on the skin mask) with roughness 0.5.
+const TCHAR* HandSkinCode = TEXT(
+    "float3 tanned = Base * float3(0.58, 0.40, 0.30);\n"
+    "float pink = saturate((Base.r - Base.g) * 4.0 - 0.25);\n"
+    "return lerp(tanned, tanned * float3(1.12, 0.86, 0.84), pink);");
+const TCHAR* HandWrapCode = TEXT(
+    "float f = 1.0 - saturate(dot(normalize(N), normalize(V)));\n"
+    "return Skin * (0.06 + 0.12 * f * f) * float3(1.0, 0.45, 0.32);");
+
+UMaterial* BuildHands()
+{
+	const TCHAR* Name = TEXT("M_Q_Hands");
+	const auto Load = [](const TCHAR* Texture)
+	{
+		return LoadObject<UTexture2D>(nullptr, *FString::Printf(TEXT("/Game/Look/Shared/Hands/%s.%s"), Texture, Texture), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	};
+	UTexture2D* BaseTexture = Load(TEXT("T_PlayerHands_BaseColor"));
+	UTexture2D* OrmTexture = Load(TEXT("T_PlayerHands_ORM"));
+	if (!BaseTexture || !OrmTexture)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_QUEST_ASSETS %s skipped: Tier B's /Game/Look/Shared/Hands textures are not here (cherry-pick a34ce4c)"), Name);
+		return nullptr;
+	}
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Opaque;
+	Material->SetShadingModel(MSM_DefaultLit);
+	Material->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+	UMaterialExpressionTextureSample* Base = G.Make<UMaterialExpressionTextureSample>();
+	Base->Texture = BaseTexture;
+	Base->SamplerType = SAMPLERTYPE_Color;
+	UMaterialExpressionTextureSample* Orm = G.Make<UMaterialExpressionTextureSample>();
+	Orm->Texture = OrmTexture;
+	Orm->SamplerType = OrmTexture->SRGB ? SAMPLERTYPE_Color : (OrmTexture->CompressionSettings == TC_Masks ? SAMPLERTYPE_Masks : SAMPLERTYPE_LinearColor);
+	UMaterialExpression* Skin = G.Custom(TEXT("Tan"), CMOT_Float3, HandSkinCode, {{TEXT("Base"), Base}});
+	UMaterialExpression* Wrap = G.Custom(TEXT("Wrap"), CMOT_Float3, HandWrapCode,
+	    {{TEXT("Skin"), Skin}, {TEXT("N"), G.Make<UMaterialExpressionVertexNormalWS>()}, {TEXT("V"), G.Make<UMaterialExpressionCameraVectorWS>()}});
+	Material->GetEditorOnlyData()->BaseColor.Expression = Skin;
+	Material->GetEditorOnlyData()->AmbientOcclusion.Connect(1, Orm);
+	Material->GetEditorOnlyData()->Roughness.Expression = G.Scalar(TEXT("Roughness"), 0.5f);
+	Material->GetEditorOnlyData()->Specular.Expression = G.Scalar(TEXT("Specular"), 0.35f);
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Wrap;
+	return Finish(Material, Name) ? Material : nullptr;
+}
