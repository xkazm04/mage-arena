From 000ec626c5dabefc0e25cc25b530530110c10382 Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Wed, 28 Oct 2026 10:38:31 +0100
Subject: [PATCH 10/35] fix(budget): count the skinned player hands in the D-G4
 stress population

Off the flat look the hands are one skinned mesh (Look/PlayerHandsLook.h), not
26 joint spheres a hand, so the stress run read hands=0 and failed "population
short". A visible skinned hands mesh now draws every tracked hand; flat is
counted exactly as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../MageArenaVR/Budget/BudgetStressDriver.cpp     | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/apps/vr/Game/Source/MageArenaVR/Budget/BudgetStressDriver.cpp b/apps/vr/Game/Source/MageArenaVR/Budget/BudgetStressDriver.cpp
index 10a5260..30cef6e 100644
--- a/apps/vr/Game/Source/MageArenaVR/Budget/BudgetStressDriver.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Budget/BudgetStressDriver.cpp
@@ -1,5 +1,6 @@
 #include "Budget/BudgetStressDriver.h"
 
+#include "Components/PoseableMeshComponent.h"
 #include "Async/Future.h"
 #include "Camera/CameraTypes.h"
 #include "Components/InstancedStaticMeshComponent.h"
@@ -627,6 +628,20 @@ UBudgetStressDriver::FPopulation UBudgetStressDriver::CountPopulation() const
 		}
 	}
 	Population.Hands = FMath::Min(Tracked, Population.HandInstances / MageHandJointCount);
+	// The graphics push: off the flat look the hands are one skinned mesh (Look/PlayerHandsLook.h), not joint spheres;
+	// a visible one draws every tracked hand.
+	if (AMageArenaPawn* Pawn = FindPawn(World))
+	{
+		TArray<UPoseableMeshComponent*> Skinned;
+		Pawn->GetComponents<UPoseableMeshComponent>(Skinned);
+		for (const UPoseableMeshComponent* Component : Skinned)
+		{
+			if (Component && Component->IsVisible() && Component->GetSkinnedAsset())
+			{
+				Population.Hands = Tracked;
+			}
+		}
+	}
 	return Population;
 }
 
