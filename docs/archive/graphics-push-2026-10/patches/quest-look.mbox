+	{
+		return;
+	}
+	UMaterialInterface* Painted = LoadObject<UMaterialInterface>(nullptr, *(Folder() / TEXT("M_CrowdPainted.M_CrowdPainted")));
+	if (!Painted)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_LOOK painted crowd missing (run -run=CreateCrowdPainted); the clay crowd stays"));
+		return;
+	}
+	const TConstArrayView<ArenaCrowd::FVariant> Variants = ArenaCrowd::Variants();
+	TInlineComponentArray<UInstancedStaticMeshComponent*> Layers(&Arena);
+	for (UInstancedStaticMeshComponent* Layer : Layers)
+	{
+		const UMaterialInterface* Current = Layer->GetMaterial(0);
+		if (!Current || !Current->GetName().Contains(ArenaCrowd::MaterialName) || Layer->NumCustomDataFloats != ArenaCrowd::CustomDataFloats)
+		{
+			continue;
+		}
+		int32 Changed = 0;
+		const int32 Count = Layer->GetInstanceCount();
+		for (int32 Index = 0; Index < Count; ++Index)
+		{
+			float Data[ArenaCrowd::CustomDataFloats];
+			for (int32 Float = 0; Float < ArenaCrowd::CustomDataFloats; ++Float)
+			{
+				Data[Float] = Layer->PerInstanceSMCustomData[Index * ArenaCrowd::CustomDataFloats + Float];
+			}
+			if (Data[ArenaCrowd::FlatFloatIndex] > 0.5f)
+			{
+				continue; // a flat-colour banner
+			}
+			int32 Variant = INDEX_NONE;
+			for (int32 Candidate = 0; Candidate < Variants.Num() && Candidate < 4; ++Candidate)
+			{
+				if (FMath::IsNearlyEqual(Data[0], static_cast<float>(Variants[Candidate].U0), 1.0e-3f))
+				{
+					Variant = Candidate;
+				}
+			}
+			if (Variant == INDEX_NONE)
+			{
+				continue;
+			}
+			// The card's V orientation as T57 chose it: rect[1] is the figure's top when V runs down the card.
+			const bool bVDown = FMath::IsNearlyEqual(Data[1], static_cast<float>(1.0 - Variants[Variant].V1), 1.0e-3f);
+			const double* Cell = CrowdPaintedAtlas::Cells[Variant][(Index * 7 + Index / 5) % CrowdPaintedAtlas::CellsPerVariant];
+			const float Top = static_cast<float>(1.0 - Cell[3]);
+			const float Bottom = static_cast<float>(1.0 - Cell[1]);
+			Data[0] = static_cast<float>(Cell[0]);
+			Data[1] = bVDown ? Top : Bottom;
+			Data[2] = static_cast<float>(Cell[2]);
+			Data[3] = bVDown ? Bottom : Top;
+			Layer->SetCustomData(Index, MakeArrayView(Data, ArenaCrowd::CustomDataFloats), false);
+			++Changed;
+		}
+		Layer->SetMaterial(0, Painted);
+		Layer->MarkRenderStateDirty();
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK painted crowd cards=%d of %d"), Changed, Count);
+	}
+}
