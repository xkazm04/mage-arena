From ad347c16f398a4d145e12717d893d33c6ef4b205 Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Wed, 28 Oct 2026 10:57:27 +0100
Subject: [PATCH 18/35] feat(art): painted crowd variety, mirrored figures and
 scale jitter

CrowdLook mirrors every other painted figure (its rect's U ends swapped, ten looks per T57
variant) and scales each card by up to 12 % about its feet, from a hash of its index, so
the stands stop reading as a uniform grid. Non-flat looks only; flat keeps the clay crowd.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Game/Source/MageArenaVR/Look/CrowdLook.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/apps/vr/Game/Source/MageArenaVR/Look/CrowdLook.cpp b/apps/vr/Game/Source/MageArenaVR/Look/CrowdLook.cpp
index 1970ea4..c2d6ef9 100644
--- a/apps/vr/Game/Source/MageArenaVR/Look/CrowdLook.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Look/CrowdLook.cpp
@@ -64,11 +64,25 @@ void CrowdLook::Apply(AActor& Arena)
 			const double* Cell = CrowdPaintedAtlas::Cells[Variant][(Index * 7 + Index / 5) % CrowdPaintedAtlas::CellsPerVariant];
 			const float Top = static_cast<float>(1.0 - Cell[3]);
 			const float Bottom = static_cast<float>(1.0 - Cell[1]);
-			Data[0] = static_cast<float>(Cell[0]);
+			// Variety: every other figure mirrored (its U ends swapped: the figures face both ways), and each card scaled by
+			// up to 12 % about its feet, so the stands stop reading as a uniform grid. A hash of the index, deterministic.
+			const uint32 Hash = (static_cast<uint32>(Index) * 2654435761u) ^ 0x9E3779B9u;
+			const bool bMirror = (Hash >> 7) & 1u;
+			Data[0] = static_cast<float>(bMirror ? Cell[2] : Cell[0]);
 			Data[1] = bVDown ? Top : Bottom;
-			Data[2] = static_cast<float>(Cell[2]);
+			Data[2] = static_cast<float>(bMirror ? Cell[0] : Cell[2]);
 			Data[3] = bVDown ? Bottom : Top;
 			Layer->SetCustomData(Index, MakeArrayView(Data, ArenaCrowd::CustomDataFloats), false);
+			FTransform Card;
+			if (Layer->GetInstanceTransform(Index, Card, false))
+			{
+				const float Scale = 0.88f + 0.24f * static_cast<float>((Hash >> 11) & 1023u) / 1023.f;
+				const FVector Size = Card.GetScale3D();
+				const double HeightCm = FMath::Max(FMath::Abs(Size.X), FMath::Abs(Size.Y)) * 100.0;
+				Card.SetScale3D(Size * Scale);
+				Card.AddToTranslation(FVector(0.0, 0.0, (Scale - 1.0) * HeightCm * 0.5));
+				Layer->UpdateInstanceTransform(Index, Card, false, false, true);
+			}
 			++Changed;
 		}
 		Layer->SetMaterial(0, Painted);
-- 
