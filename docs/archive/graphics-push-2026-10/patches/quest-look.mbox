+		}
+		Cached = Material;
+	}
+	int32 Changed = 0;
+	for (TObjectIterator<USkeletalMeshComponent> It; It; ++It)
+	{
+		USkeletalMeshComponent* Component = *It;
+		if (Component->GetWorld() != &World || !BrennicEpicLook::DrawsBrennic(*Component) || Component->GetMaterial(0) == Material)
+		{
+			continue;
+		}
+		for (int32 Slot = 0; Slot < Component->GetNumMaterials(); ++Slot)
+		{
+			Component->SetMaterial(Slot, Material);
+		}
+		++Changed;
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK Brennic material on %s"), *Component->GetPathName());
+	}
+	return Changed;
 }
 
