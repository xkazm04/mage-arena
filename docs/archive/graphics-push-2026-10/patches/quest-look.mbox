+#pragma once
+
+#include "CoreMinimal.h"
+
+class USkeletalMeshComponent;
+class UWorld;
+
+/**
+ * Brennic's epic-look material (graphics push 10-28, Tier B hero asset). SK_Brennic is unchanged; under the epic look
+ * every component drawing it gets M_BrennicEpic (Tools/CreateBrennicEpicCommandlet) in all its slots, so the rig and the
+ * four clips are the committed ones and the flat look never sees the new textures.
+ */
+namespace BrennicEpicLook
+{
+/** /Game/Look/Epic/Brennic: the textures, the skin profile and M_BrennicEpic. */
+FString Folder();
+
+/** True when Component draws SK_Brennic. */
+bool DrawsBrennic(const USkeletalMeshComponent& Component);
+
+/** Puts M_BrennicEpic in every slot of every component in World that draws SK_Brennic; returns how many it changed. */
+int32 ApplyAll(UWorld& World);
+}
