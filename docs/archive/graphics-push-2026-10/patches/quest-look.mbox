From 6c0b2ed25ab22f4a38f5a11aa6d5c56fe95ce64c Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Wed, 28 Oct 2026 11:21:50 +0100
Subject: [PATCH 28/35] feat(look): wall coping off flat and wall-hung banners
 under the epic look

Off flat, each wall segment gets S1's coping: a slab a little wider than the wall, overhanging
the arena side, instanced into the wall's own component (no extra draw; Tier A's 150 budget
holds). Under the epic look the banner cloth also hangs on the wall face, every second
segment and none behind the seat, as the quest look already does, in the cloth's own
component.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../MageArenaVR/Greybox/ArenaGreyboxActor.cpp | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/apps/vr/Game/Source/MageArenaVR/Greybox/ArenaGreyboxActor.cpp b/apps/vr/Game/Source/MageArenaVR/Greybox/ArenaGreyboxActor.cpp
index 0f1ff88..78fabdb 100644
--- a/apps/vr/Game/Source/MageArenaVR/Greybox/ArenaGreyboxActor.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Greybox/ArenaGreyboxActor.cpp
@@ -215,6 +215,13 @@ void AArenaGreybox::BuildShell(UStaticMesh* Cube, UStaticMesh* Cylinder)
 
 		const FVector WallCentre = Mid + Normal * (Layout.WallThicknessM * 0.5) + FVector(0.0, 0.0, Layout.WallHeightM * 0.5);
 		AddBox(WallMesh, WallCentre, Rotation, FVector(ChordLen * 1.04, Layout.WallThicknessM, Layout.WallHeightM));
+		// The non-flat looks cap the wall with S1's coping: a slab a little wider than the wall, overhanging the arena side,
+		// instanced into the wall's own component (no extra draw).
+		if (!ArenaLook::IsFlat())
+		{
+			const FVector CopingCentre = Mid + Normal * (Layout.WallThicknessM * 0.5 - 0.1) + FVector(0.0, 0.0, Layout.WallHeightM + 0.11);
+			AddBox(WallMesh, CopingCentre, Rotation, FVector(ChordLen * 1.06, Layout.WallThicknessM + 0.24, 0.22));
+		}
 
 		for (int32 Tier = 0; Tier < Layout.StandTiers; ++Tier)
 		{
@@ -302,6 +309,28 @@ void AArenaGreybox::BuildProps(UStaticMesh* Cube, UStaticMesh* Cylinder)
 		AddBox(Bars, BarCentre, ClothRotation, BarSize);
 	}
 
+	// The epic look hangs S1's banners on the wall face too, as the quest look does (QuestLook: every second segment, none
+	// behind the seat), into the banner cloth's own component (no extra draw).
+	if (Cloth && ArenaLook::Current() == EArenaLook::Epic)
+	{
+		const int32 WallSegments = FMath::Max(Layout.WallSegments, 3);
+		for (int32 Index = 0; Index < WallSegments; Index += 2)
+		{
+			const double T0 = 2.0 * PI * Index / WallSegments;
+			const double T1 = 2.0 * PI * (Index + 1) / WallSegments;
+			const double MidAngle = (T0 + T1) * 0.5;
+			if (FMath::Abs(FMath::UnwindRadians(MidAngle - PI)) < FMath::DegreesToRadians(60.0))
+			{
+				continue;
+			}
+			const FVector P0(Layout.FloorRadiusXM * FMath::Cos(T0), Layout.FloorRadiusYM * FMath::Sin(T0), 0.0);
+			const FVector P1(Layout.FloorRadiusXM * FMath::Cos(T1), Layout.FloorRadiusYM * FMath::Sin(T1), 0.0);
+			const FVector Outward = FVector(Layout.FloorRadiusYM * FMath::Cos(MidAngle), Layout.FloorRadiusXM * FMath::Sin(MidAngle), 0.0).GetSafeNormal();
+			const FVector Centre = (P0 + P1) * 0.5 - Outward * 0.04 + FVector(0.0, 0.0, Layout.WallHeightM - 0.12 - 1.05);
+			AddBox(Cloth, Centre, FRotationMatrix::MakeFromXZ(-Outward, FVector::UpVector).ToQuat(), FVector(0.04, 1.05, 2.1));
+		}
+	}
+
 	for (const FSpawnMarker& Marker : Layout.SpawnMarkers)
 	{
 		const FVector Centre(Marker.PositionM.X, Marker.PositionM.Y, Layout.MarkerPostHeightM * 0.5);
-- 
