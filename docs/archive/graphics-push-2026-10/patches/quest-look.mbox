+# The judges' notes on r3: no dark band where the dome meets the stands, and no hard sun line. Below the horizon glow
+# the still's dark blue hills fade into a warm haze (a hint of them kept), and the sun's disc is softened into a glow.
+from PIL import ImageFilter as _Filter
+
+h = sky.shape[0]
+glow_row = int(h * 0.80)
+haze = sky[glow_row - 8: glow_row].reshape(-1, 3).mean(axis=0)
+rows = np.linspace(0.0, 1.0, h)[:, None, None]
+toward_haze = np.clip((rows - 0.80) / 0.12, 0.0, 1.0) * 0.82
+sky = sky * (1 - toward_haze) + haze * toward_haze
+soft = np.asarray(Image.fromarray(sky.clip(0, 255).astype(np.uint8)).filter(_Filter.GaussianBlur(22)), dtype=np.float32)
+luma = (sky * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1)
+lower = np.zeros_like(luma)
+lower[h // 2:] = 1.0
+bright = np.clip((luma - 200.0) / 40.0, 0.0, 1.0) * lower
+bright = np.asarray(Image.fromarray((bright * 255).astype(np.uint8)).filter(_Filter.GaussianBlur(30)), dtype=np.float32)[..., None] / 255.0
+bright = np.clip(bright * 3.0, 0.0, 1.0)
+sky = sky * (1 - bright) + soft * bright
 save(sky, "T_Q_Sky_D.png", (2048, 1024))
 
 banner = load("banner-01.png")
