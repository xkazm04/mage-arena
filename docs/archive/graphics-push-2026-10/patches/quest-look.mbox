@@ -0,0 +1,31 @@
+"""Mean colour (sRGB 0-255), hue (deg), saturation and value of four regions in S1 and in a game frame, both 1376x768.
+
+The regions are boxes (x0, y0, x1, y1) chosen per image so each samples the same thing: lit sand, lit wall, the sky's
+top and sand in shadow. Run: python apps/vr/tools/look/grade_compare.py <s1.jpg> <frame.png> [<frame2.png> ...]
+"""
+import colorsys
+import sys
+
+import numpy as np
+from PIL import Image
+
+S1 = {"sand": (1060, 340, 1300, 420), "wall": (920, 235, 1240, 300), "sky top": (300, 0, 1100, 35), "shadow": (40, 520, 160, 600)}
+GAME = {"sand": (900, 380, 1300, 450), "wall": (1050, 275, 1300, 335), "sky top": (300, 0, 1100, 30), "shadow": (40, 420, 300, 480)}
+
+
+def stats(path, boxes):
+    a = np.asarray(Image.open(path).convert("RGB").resize((1376, 768)), dtype=np.float64)
+    out = {}
+    for name, (x0, y0, x1, y1) in boxes.items():
+        m = a[y0:y1, x0:x1].reshape(-1, 3).mean(axis=0)
+        h, s, v = colorsys.rgb_to_hsv(*(m / 255.0))
+        out[name] = (m, h * 360, s, v)
+    return out
+
+
+paths = sys.argv[1:]
+rows = [("S1", stats(paths[0], S1))] + [(p.replace("\\", "/").split("/")[-2], stats(p, GAME)) for p in paths[1:]]
+for name in S1:
+    for label, st in rows:
+        m, h, s, v = st[name]
+        print(f"{name:8s} {label:10s} rgb=({m[0]:5.1f},{m[1]:5.1f},{m[2]:5.1f}) hue={h:5.1f} sat={s:.2f} val={v:.2f}")
