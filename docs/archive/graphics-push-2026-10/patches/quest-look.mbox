+constexpr double WardArchRiseCm = 34.0;
 constexpr float WardUSpan = 0.5f;
 }
 
@@ -207,20 +208,28 @@ void QuestSpells::PoseWardCards(UInstancedStaticMeshComponent& Cards, const FAre
 {
 	const double Mid = (Layout.WardArcInnerM + Layout.WardArcOuterM) * 50.0;
 	const double Half = FMath::DegreesToRadians(Layout.WardArcDeg * 0.5);
-	const double Step = FMath::DegreesToRadians(Layout.WardArcDeg / WardCardCount) * Mid * 1.03;
+	// S1's arch: low in the middle where the bolt meets it, rising up both sides to frame it. The cards are one ribbon:
+	// each lies along the curve's own tangent (rising at the sides), so neighbours meet edge to edge with no steps.
+	// Visual only: the ward's gameplay geometry is the detector's, not these cards.
+	const auto Along = [&](double Across)
+	{
+		const double Angle = Across * Half;
+		const FVector Dir = Normal * FMath::Cos(Angle) + Right * FMath::Sin(Angle);
+		return Palm + Dir * Mid + Up * (WardArchRiseCm * FMath::Pow(FMath::Abs(Across), 1.7) + WardHeightCm * 0.5 - WardBelowPalmCm);
+	};
 	TArray<FTransform> Transforms;
 	TArray<float> Data;
 	for (int32 Index = 0; Index < WardCardCount; ++Index)
 	{
-		const double Angle = FMath::Lerp(-Half, Half, (Index + 0.5) / static_cast<double>(WardCardCount));
-		const FVector Dir = Normal * FMath::Cos(Angle) + Right * FMath::Sin(Angle);
-		const FVector Tangent = (-Normal * FMath::Sin(Angle) + Right * FMath::Cos(Angle)).GetSafeNormal();
-		// The plane's U along the arc, its V down the wave, its face toward the palm.
-		const FVector X = Tangent;
-		const FVector Y = -Up;
+		const double A0 = Index / static_cast<double>(WardCardCount) * 2.0 - 1.0;
+		const double A1 = (Index + 1) / static_cast<double>(WardCardCount) * 2.0 - 1.0;
+		const FVector P0 = Along(A0);
+		const FVector P1 = Along(A1);
+		// The plane's U along the ribbon, its V down the wave (square to the ribbon, as near to world down as it can be).
+		const FVector X = (P1 - P0).GetSafeNormal();
+		const FVector Y = -(Up - X * FVector::DotProduct(Up, X)).GetSafeNormal();
 		const FVector Z = FVector::CrossProduct(X, Y);
-		const FVector Centre = Palm + Dir * Mid + Up * (WardHeightCm * 0.5 - WardBelowPalmCm);
-		Transforms.Add(FTransform(FMatrix(X, Y, Z, FVector::ZeroVector).ToQuat(), Centre, FVector(Step / 100.0, WardHeightCm / 100.0, 1.0)));
+		Transforms.Add(FTransform(FMatrix(X, Y, Z, FVector::ZeroVector).ToQuat(), (P0 + P1) * 0.5, FVector((P1 - P0).Size() * 1.02 / 100.0, WardHeightCm / 100.0, 1.0)));
 		Data.Add(WardUSpan * Index / WardCardCount);
 		Data.Add(WardUSpan / WardCardCount);
 	}
