@@ -0,0 +1,184 @@
+#include "Tools/CreatePlayerHandsCommandlet.h"
+
+#include "Look/PlayerHandsLook.h"
+#include "MageArenaVR.h"
+#include "Misc/Paths.h"
+#include "Tools/MaterialGraph.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Engine/SkeletalMesh.h"
+#include "Engine/SubsurfaceProfile.h"
+#include "Factories/FbxFactory.h"
+#include "Factories/FbxImportUI.h"
+#include "Factories/FbxSkeletalMeshImportData.h"
+#include "Materials/MaterialExpressionMultiply.h"
+#include "Materials/MaterialExpressionTextureSampleParameter2D.h"
+#include "ShaderCompiler.h"
+#endif
+
+UCreatePlayerHandsCommandlet::UCreatePlayerHandsCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+#if WITH_EDITOR
+namespace
+{
+UMaterial* BuildSkin(const FString& Folder, const TCHAR* Name, UTexture2D& Base, UTexture2D& Orm, USubsurfaceProfile* Profile)
+{
+	using namespace MaterialGraph;
+	UMaterial* Material = NewMaterial(Folder, Name);
+	Material->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+	UMaterialEditorOnlyData* Editor = Material->GetEditorOnlyData();
+	UMaterialExpressionTextureSampleParameter2D* BaseSample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -1200, 0);
+	BaseSample->ParameterName = TEXT("BaseColor");
+	BaseSample->Texture = &Base;
+	UMaterialExpressionTextureSampleParameter2D* OrmSample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -1200, 400);
+	OrmSample->ParameterName = TEXT("ORM");
+	OrmSample->Texture = &Orm;
+	OrmSample->SamplerType = SAMPLERTYPE_Masks;
+	UMaterialExpressionMultiply* Tint = Add<UMaterialExpressionMultiply>(*Material, -400, 0);
+	Tint->A.Connect(0, BaseSample);
+	Tint->B.Connect(0, Vector(*Material, TEXT("SkinTint"), FLinearColor::White, 100));
+	Editor->BaseColor.Connect(0, Tint);
+	Editor->AmbientOcclusion.Connect(1, OrmSample);
+	Editor->Roughness.Connect(2, OrmSample);
+	Editor->Specular.Connect(0, Scalar(*Material, TEXT("Specular"), 0.45, 600));
+	if (Profile)
+	{
+		Material->SetShadingModel(MSM_SubsurfaceProfile);
+		Material->SubsurfaceProfile = Profile;
+		UMaterialExpressionMultiply* Scatter = Add<UMaterialExpressionMultiply>(*Material, -400, 700);
+		Scatter->A.Connect(4, OrmSample);
+		Scatter->B.Connect(0, Scalar(*Material, TEXT("SkinScatter"), 0.9, 750));
+		Editor->Opacity.Connect(0, Scatter);
+	}
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+	return Material;
+}
+}
+#endif
+
+int32 UCreatePlayerHandsCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	FString Source = FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/hands/export"));
+	FParse::Value(*Params, TEXT("source="), Source);
+	Source = FPaths::ConvertRelativePathToFull(Source);
+	const FString Folder = PlayerHandsLook::Folder();
+	UTexture2D* Base = ImportTexture(Source / TEXT("T_PlayerHands_BaseColor.png"), Folder, TEXT("T_PlayerHands_BaseColor"), false, TC_Default);
+	UTexture2D* Orm = ImportTexture(Source / TEXT("T_PlayerHands_ORM.png"), Folder, TEXT("T_PlayerHands_ORM"), true, TC_Masks);
+	if (!Base || !Orm)
+	{
+		return 1;
+	}
+
+	// The legacy FBX factory, as ImportCreatureMesh: mesh and skeleton only, no materials, no physics, scale 100 (the
+	// export writes metres into a file read as centimetres).
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>("AssetTools").Get();
+	UFbxFactory* Factory = NewObject<UFbxFactory>();
+	Factory->AddToRoot();
+	UFbxImportUI* Options = NewObject<UFbxImportUI>();
+	Options->bAutomatedImportShouldDetectType = false;
+	Options->MeshTypeToImport = FBXIT_SkeletalMesh;
+	Options->OriginalImportType = FBXIT_SkeletalMesh;
+	Options->bImportAsSkeletal = true;
+	Options->bImportMesh = true;
+	Options->bImportAnimations = false;
+	Options->bCreatePhysicsAsset = false;
+	Options->bImportMaterials = false;
+	Options->bImportTextures = false;
+	Options->SkeletalMeshImportData->ImportUniformScale = 100.f;
+	Options->SkeletalMeshImportData->bConvertScene = true;
+	Options->SkeletalMeshImportData->bForceFrontXAxis = false;
+	Options->SkeletalMeshImportData->bConvertSceneUnit = false;
+	UAssetImportTask* Task = NewObject<UAssetImportTask>();
+	Task->Filename = Source / TEXT("SK_PlayerHands.fbx");
+	Task->DestinationPath = Folder;
+	Task->DestinationName = TEXT("SK_PlayerHands");
+	Task->bReplaceExisting = true;
+	Task->bReplaceExistingSettings = true;
+	Task->bAutomated = true;
+	Task->bSave = false;
+	Task->Factory = Factory;
+	Task->Options = Options;
+	AssetTools.ImportAssetTasks({Task});
+	Factory->RemoveFromRoot();
+	USkeletalMesh* Mesh = nullptr;
+	for (UObject* Object : Task->GetObjects())
+	{
+		Mesh = Mesh ? Mesh : Cast<USkeletalMesh>(Object);
+	}
+	if (!Mesh)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail hands fbx %s"), *Task->Filename);
+		return 1;
+	}
+
+	UPackage* ProfilePackage = CreatePackage(*(Folder / TEXT("SSP_PlayerHands_Skin")));
+	ProfilePackage->FullyLoad();
+	USubsurfaceProfile* Profile = FindObject<USubsurfaceProfile>(ProfilePackage, TEXT("SSP_PlayerHands_Skin"));
+	if (!Profile)
+	{
+		Profile = NewObject<USubsurfaceProfile>(ProfilePackage, TEXT("SSP_PlayerHands_Skin"), RF_Public | RF_Standalone);
+	}
+	Profile->Settings.SurfaceAlbedo = FLinearColor(0.91f, 0.40f, 0.30f);
+	Profile->Settings.MeanFreePathColor = FLinearColor(1.0f, 0.38f, 0.22f);
+	Profile->Settings.MeanFreePathDistance = 0.5f;
+	Profile->MarkPackageDirty();
+	UMaterial* Epic = BuildSkin(Folder, TEXT("M_PlayerHandsEpic"), *Base, *Orm, Profile);
+	UMaterial* Lite = BuildSkin(Folder, TEXT("M_PlayerHandsLite"), *Base, *Orm, nullptr);
+	UMaterial* Sleeve = NewMaterial(Folder, TEXT("M_PlayerSleeve"));
+	Sleeve->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+	Sleeve->GetEditorOnlyData()->BaseColor.Connect(0, Vector(*Sleeve, TEXT("SleeveColour"), FLinearColor(0.022f, 0.020f, 0.030f), 0));
+	Sleeve->GetEditorOnlyData()->Roughness.Connect(0, Scalar(*Sleeve, TEXT("Roughness"), 0.9, 100));
+	Sleeve->GetEditorOnlyData()->Specular.Connect(0, Scalar(*Sleeve, TEXT("Specular"), 0.3, 200));
+	Sleeve->PreEditChange(nullptr);
+	Sleeve->PostEditChange();
+	Sleeve->MarkPackageDirty();
+
+	for (FSkeletalMaterial& Slot : Mesh->GetMaterials())
+	{
+		const bool bSleeve = Slot.ImportedMaterialSlotName.ToString().Contains(TEXT("Sleeve")) || Slot.MaterialSlotName.ToString().Contains(TEXT("Sleeve"));
+		Slot.MaterialInterface = bSleeve ? Sleeve : Lite;
+		UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS hands slot %s -> %s"), *Slot.MaterialSlotName.ToString(), *Slot.MaterialInterface->GetName());
+	}
+	Mesh->PostEditChange();
+	Mesh->MarkPackageDirty();
+	const FReferenceSkeleton& Skeleton = Mesh->GetRefSkeleton();
+	FString Names;
+	for (int32 Bone = 0; Bone < Skeleton.GetNum(); ++Bone)
+	{
+		Names += Skeleton.GetBoneName(Bone).ToString() + TEXT(" ");
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS hands mesh %s bones=%d [%s] extent=(%.1f, %.1f, %.1f) cm"), *Mesh->GetPathName(), Skeleton.GetNum(), *Names,
+	    Mesh->GetImportedBounds().BoxExtent.X, Mesh->GetImportedBounds().BoxExtent.Y, Mesh->GetImportedBounds().BoxExtent.Z);
+
+	for (UMaterial* Material : {Epic, Lite, Sleeve})
+	{
+		Material->ForceRecompileForRendering();
+	}
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done hands saved=%d from %s"), Saved, *Source);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreatePlayerHandsCommandlet.h b/apps/vr/Game/Source/MageArenaVR/Tools/CreatePlayerHandsCommandlet.h
new file mode 100644
index 0000000..edab982
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreatePlayerHandsCommandlet.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Commandlets/Commandlet.h"
+#include "CreatePlayerHandsCommandlet.generated.h"
+
+/**
+ * Graphics push 10-28, shared hero asset (Tier B builds it, both non-flat looks use it): the player's skinned hands and
+ * forearms with dark sleeves (apps/vr/art/hands/build_hands.py, MPFB base mesh) imported into /Game/Look/Shared/Hands as
+ * SK_PlayerHands, with T_PlayerHands_BaseColor / _ORM and three materials built in code: M_PlayerHandsEpic (subsurface
+ * profile skin through the ORM alpha mask), M_PlayerHandsLite (default lit, the mobile-forward fallback) and
+ * M_PlayerSleeve (dark wool). Look/PlayerHandsLook.h drives the bones from the HandFrame.
+ * Usage: -run=CreatePlayerHands [-source=<dir with SK_PlayerHands.fbx and the two PNGs>]. Editor builds only.
+ */
+UCLASS()
+class MAGEARENAVR_API UCreatePlayerHandsCommandlet : public UCommandlet
+{
+	GENERATED_BODY()
+
+public:
+	UCreatePlayerHandsCommandlet();
+	virtual int32 Main(const FString& Params) override;
+};
diff --git a/apps/vr/art/hands/build_hands.py b/apps/vr/art/hands/build_hands.py
new file mode 100644
index 0000000..627382a
--- /dev/null
+++ b/apps/vr/art/hands/build_hands.py
@@ -0,0 +1,425 @@
+"""The player's hands (graphics push 10-28, Tier B hero asset): both forearms and hands of an MPFB (MakeHuman, CC0 base
+mesh) adult male with the game_engine rig's finger bones, a dark wool sleeve over each forearm, and a regional skin
+albedo (tanner backs, pinker palms and fingertips, redder knuckles, pale nails) baked into a UV of their own.
+
+blender -b -P build_hands.py -- <outdir> [res]
+
+Writes <outdir>/SK_PlayerHands.fbx (one mesh, slots Skin and Sleeve; bones root, lowerarm_l/r, hand_l/r, the three
+phalanges of each finger and thumb, plus leaf ends so the engine knows where each last phalanx points),
+T_PlayerHands_BaseColor.png (sRGB), T_PlayerHands_ORM.png (R AO, G roughness, B 0, A skin mask), hands_preview.png
+and hands.json (bone heads, metres, Blender space). Runtime: Look/PlayerHandsLook.h drives the bones from the 26-joint
+HandFrame by aiming each bone at its child joint.
+"""
+import json
+import math
+import os
+import sys
+
+import addon_utils
+import bmesh
+import bpy
+import mathutils
+import numpy as np
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+OUT = argv[0]
+RES = int(argv[1]) if len(argv) > 1 else 2048
+os.makedirs(OUT, exist_ok=True)
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+addon_utils.enable("bl_ext.user_default.mpfb", default_set=True)
+from bl_ext.user_default.mpfb.services.humanservice import HumanService  # noqa: E402
+from bl_ext.user_default.mpfb.services.locationservice import LocationService  # noqa: E402
+from bl_ext.user_default.mpfb.services.targetservice import TargetService  # noqa: E402
+
+macros = TargetService.get_default_macro_info_dict()
+macros["gender"] = 1.0
+macros["age"] = 0.55
+macros["muscle"] = 0.7
+macros["weight"] = 0.55
+body = HumanService.create_human(scale=0.1, macro_detail_dict=macros)
+rig = HumanService.add_builtin_rig(body, "game_engine")
+print("HANDS created", body.name, len(body.data.vertices), "rig bones", len(rig.data.bones))
+
+SIDES = ("l", "r")
+FINGERS = ("thumb", "index", "middle", "ring", "pinky")
+KEEP = {"Root"}
+for s in SIDES:
+    KEEP |= {f"lowerarm_{s}", f"hand_{s}"} | {f"{f}_0{i}_{s}" for f in FINGERS for i in (1, 2, 3)}
+
+# ---------------------------------------------------------------- bake the macro shape keys, drop the helper geometry
+bpy.context.view_layer.objects.active = body
+for o in bpy.context.scene.objects:
+    o.select_set(o == body)
+if body.data.shape_keys:
+    bpy.ops.object.shape_key_remove(all=True, apply_mix=True)
+for m in list(body.modifiers):
+    if m.type == 'MASK':
+        body.modifiers.remove(m)
+
+bones = {b.name: b for b in rig.data.bones}
+head = {n: rig.matrix_world @ bones[n].head_local for n in bones}
+tail = {n: rig.matrix_world @ bones[n].tail_local for n in bones}
+
+# nail mask in MakeHuman UV
+nails_path = os.path.join(LocationService.get_mpfb_data("textures"), "mpfb_fingernails.jpg")
+nails_img = bpy.data.images.load(nails_path)
+nw, nh = nails_img.size
+nails_px = np.array(nails_img.pixels[:], dtype=np.float32).reshape(nh, nw, -1)[..., 0]
+
+me = body.data
+vg_index = {g.name: g.index for g in body.vertex_groups}
+body_group = vg_index.get("body")
+inv = {g.index: g.name for g in body.vertex_groups}
+
+
+def weights(v):
+    return {inv[g.group]: g.weight for g in v.groups}
+
+
+keep_v = np.zeros(len(me.vertices), bool)
+for v in me.vertices:
+    w = weights(v)
+    if w.get("body", 0.0) < 0.5:
+        continue
+    arm = sum(val for name, val in w.items() if name in KEEP and name != "Root")
+    if arm < 0.5:
+        continue
+    side = "l" if v.co.x > 0 else "r"
+    e = head[f"lowerarm_{side}"]
+    h = head[f"hand_{side}"]
+    axis = (h - e)
+    t = (v.co - e).dot(axis) / axis.length_squared
+    keep_v[v.index] = t > 0.42  # the wrist-side 58 % of the forearm; the sleeve hides the cut
+print("HANDS kept verts", int(keep_v.sum()))
+
+bm = bmesh.new()
+bm.from_mesh(me)
+bm.verts.ensure_lookup_table()
+bmesh.ops.delete(bm, geom=[v for v in bm.verts if not keep_v[v.index]], context='VERTS')
+bm.to_mesh(me)
+bm.free()
+
+# vertex groups: only the kept bones, normalised
+for g in list(body.vertex_groups):
+    if g.name not in KEEP:
+        body.vertex_groups.remove(g)
+for v in me.vertices:
+    total = sum(g.weight for g in v.groups)
+    if total <= 0:
+        side = "l" if v.co.x > 0 else "r"
+        body.vertex_groups[f"lowerarm_{side}"].add([v.index], 1.0, 'REPLACE')
+        continue
+    for g in v.groups:
+        g.weight /= total
+
+# subdivide once for a close-up silhouette (weights interpolate)
+sub = body.modifiers.new("Sub", 'SUBSURF')
+sub.levels = 1
+sub.render_levels = 1
+# keep the armature modifier last
+arm_mods = [m for m in body.modifiers if m.type == 'ARMATURE']
+bpy.ops.object.modifier_move_to_index(modifier="Sub", index=0)
+bpy.ops.object.modifier_apply(modifier="Sub")
+print("HANDS verts after subdivision", len(me.vertices), "polys", len(me.polygons))
+
+# ---------------------------------------------------------------- armature: only the forearm-and-hand bones under root
+bpy.context.view_layer.objects.active = rig
+for o in bpy.context.scene.objects:
+    o.select_set(o == rig)
+bpy.ops.object.mode_set(mode='EDIT')
+eb = rig.data.edit_bones
+for b in list(eb):
+    if b.name not in KEEP:
+        eb.remove(b)
+for s in SIDES:
+    eb[f"lowerarm_{s}"].parent = eb["Root"]
+eb["Root"].head = (0, 0, 0)
+eb["Root"].tail = (0, 0.1, 0)
+bpy.ops.object.mode_set(mode='OBJECT')
+
+# ---------------------------------------------------------------- sleeves: a dark wool tube over each forearm
+me.materials.clear()
+for poly in me.polygons:
+    poly.material_index = 0  # MPFB's body polygons keep their own slot indices; every one of them is skin here
+skin_mat = bpy.data.materials.new("Skin")
+sleeve_mat = bpy.data.materials.new("Sleeve")
+me.materials.append(skin_mat)
+me.materials.append(sleeve_mat)
+for s in SIDES:
+    e = head[f"lowerarm_{s}"]
+    h = head[f"hand_{s}"]
+    axis = (h - e).normalized()
+    length = (h - e).length
+    # forearm radius near the cut, from the kept skin
+    pts = [body.matrix_world @ v.co for v in me.vertices if ((v.co.x > 0) == (s == "l"))]
+    radii = [((p - e) - axis * (p - e).dot(axis)).length for p in pts if 0.45 < (p - e).dot(axis) / length < 0.6]
+    r0 = (max(radii) if radii else 0.05) * 1.08
+    start = e + axis * (0.40 * length)
+    end = e + axis * (0.90 * length)
+    bpy.ops.mesh.primitive_cylinder_add(vertices=48, radius=1.0, depth=1.0, end_fill_type='NOTHING')
+    bpy.ops.object.shade_smooth()
+    tube = bpy.context.active_object
+    tube.name = f"Sleeve_{s}"
+    tm = tube.data
+    for v in tm.vertices:
+        z = v.co.z + 0.5  # 0 at the elbow end, 1 at the cuff
+        flare = 1.0 + 0.10 * z + 0.05 * math.sin(v.co.x * 9.0 + v.co.y * 7.0)  # a loose cuff and a few folds
+        v.co.x *= r0 * flare
+        v.co.y *= r0 * flare
+        v.co.z = z
+    rot = mathutils.Vector((0, 0, 1)).rotation_difference(axis)
+    tube.matrix_world = mathutils.Matrix.Translation(start) @ rot.to_matrix().to_4x4() @ mathutils.Matrix.Diagonal((1, 1, (end - start).length, 1))
+    bpy.ops.object.transform_apply(location=True, rotation=True, scale=True)
+    sol = tube.modifiers.new("Thick", 'SOLIDIFY')
+    sol.thickness = 0.006
+    bpy.ops.object.modifier_apply(modifier="Thick")
+    tm.materials.clear()
+    tm.materials.append(sleeve_mat)
+    for poly in tm.polygons:
+        poly.use_smooth = True
+    vg = tube.vertex_groups.new(name=f"lowerarm_{s}")
+    vg.add(list(range(len(tm.vertices))), 1.0, 'REPLACE')
+    for o in bpy.context.scene.objects:
+        o.select_set(o in (tube, body))
+    bpy.context.view_layer.objects.active = body
+    bpy.ops.object.join()
+
+# ---------------------------------------------------------------- UVs: a fresh unwrap so the hands own the texture
+me = body.data
+mh_uv = me.uv_layers[0].name
+new_uv = me.uv_layers.new(name="HandsUV")
+HANDS_UV = new_uv.name
+me.uv_layers.active = new_uv
+bpy.ops.object.mode_set(mode='EDIT')
+bpy.ops.mesh.select_all(action='SELECT')
+bpy.ops.uv.smart_project(angle_limit=math.radians(60), island_margin=0.004)
+bpy.ops.uv.pack_islands(rotate=True, margin=0.004)
+bpy.ops.object.mode_set(mode='OBJECT')
+
+# ---------------------------------------------------------------- regional skin colour per vertex (rest pose)
+loops_uv = np.zeros((len(me.loops), 2), np.float32)
+me.uv_layers[mh_uv].data.foreach_get("uv", loops_uv.ravel())
+vert_nail = np.zeros(len(me.vertices), np.float32)
+for li, loop in enumerate(me.loops):
+    u, v = loops_uv[li]
+    x = int(min(max(u, 0), 0.9999) * nw)
+    y = int(min(max(v, 0), 0.9999) * nh)
+    vert_nail[loop.vertex_index] = max(vert_nail[loop.vertex_index], nails_px[y, x])
+sleeve_v = np.zeros(len(me.vertices), bool)
+for p in me.polygons:
+    if p.material_index == 1:
+        for vi in p.vertices:
+            sleeve_v[vi] = True
+
+
+def palm_normal(s):
+    a = head[f"index_01_{s}"] - head[f"pinky_01_{s}"]
+    b = head[f"middle_01_{s}"] - head[f"hand_{s}"]
+    return a.cross(b).normalized()
+
+
+# Orient each palm normal by the nails: nail vertices face away from the palm.
+pn = {}
+for s in SIDES:
+    n = palm_normal(s)
+    nail_n = mathutils.Vector((0, 0, 0))
+    for v in me.vertices:
+        if vert_nail[v.index] > 0.5 and ((v.co.x > 0) == (s == "l")):
+            nail_n += v.normal
+    pn[s] = -n if nail_n.dot(n) > 0 else n
+    print("HANDS palm normal", s, tuple(round(c, 3) for c in pn[s]))
+
+SKIN = np.array([222, 160, 126]) / 255.0
+BACK = np.array([204, 142, 106]) / 255.0
+PALM = np.array([236, 168, 146]) / 255.0
+KNUCK = np.array([214, 128, 108]) / 255.0
+NAIL = np.array([238, 196, 184]) / 255.0
+SLEEVE = np.array([42, 40, 50]) / 255.0
+cols = np.zeros((len(me.vertices), 4), np.float32)
+rough = np.zeros(len(me.vertices), np.float32)
+for v in me.vertices:
+    i = v.index
+    if sleeve_v[i]:
+        cols[i, :3] = SLEEVE
+        rough[i] = 0.9
+        continue
+    s = "l" if v.co.x > 0 else "r"
+    facing = v.normal.dot(pn[s])  # +1 palm, -1 back
+    c = SKIN.copy()
+    c = c + (PALM - SKIN) * max(facing, 0) + (BACK - SKIN) * max(-facing, 0)
+    # knuckles: the back of each finger root and middle joint
+    k = 0.0
+    for f in FINGERS[1:]:
+        for j in ("01", "02"):
+            d = (v.co - head[f"{f}_{j}_{s}"]).length
+            k = max(k, max(0.0, 1.0 - d / 0.016))
+    k *= max(-facing, 0) ** 0.5
+    c = c + (KNUCK - c) * k * 0.8
+    # fingertips pinker
+    tip = 0.0
+    for f in FINGERS:
+        d = (v.co - tail[f"{f}_03_{s}"]).length
+        tip = max(tip, max(0.0, 1.0 - d / 0.018))
+    c = c + (PALM - c) * tip * 0.6
+    n = min(1.0, vert_nail[i] * 1.2)
+    c = c + (NAIL - c) * n
+    cols[i, :3] = c
+    rough[i] = 0.56 + 0.08 * max(facing, 0) - 0.26 * n
+cols[:, 3] = 1.0
+ca = me.color_attributes.new("Region", 'FLOAT_COLOR', 'POINT')
+ca.data.foreach_set("color", cols.ravel())
+ra = me.color_attributes.new("Rough", 'FLOAT_COLOR', 'POINT')
+rc = np.zeros_like(cols)
+rc[:, 0] = rough
+rc[:, 1] = (~sleeve_v).astype(np.float32)
+rc[:, 3] = 1
+ra.data.foreach_set("color", rc.ravel())
+
+# ---------------------------------------------------------------- bake albedo, roughness+skin, AO into the new UV
+scn = bpy.context.scene
+scn.render.engine = 'CYCLES'
+scn.cycles.device = 'CPU'
+scn.cycles.samples = 1
+for o in bpy.context.scene.objects:
+    o.select_set(o == body)
+bpy.context.view_layer.objects.active = body
+rig_mod = [m for m in body.modifiers if m.type == 'ARMATURE']
+for m in rig_mod:
+    m.show_render = False
+
+
+def bake(kind, wire, name, samples=1):
+    img = bpy.data.images.new(name, RES, RES, alpha=True, float_buffer=True)
+    img.colorspace_settings.name = 'Non-Color'
+    mat = bpy.data.materials.new("Bake" + name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for nd in list(nt.nodes):
+        nt.nodes.remove(nd)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    if kind == 'EMIT':
+        em = nt.nodes.new("ShaderNodeEmission")
+        nt.links.new(em.outputs[0], out.inputs[0])
+        wire(nt, em.inputs[0])
+    else:
+        nt.links.new(nt.nodes.new("ShaderNodeBsdfDiffuse").outputs[0], out.inputs[0])
+    tex = nt.nodes.new("ShaderNodeTexImage")
+    tex.image = img
+    nt.nodes.active = tex
+    saved = [s.material for s in body.material_slots]
+    for slot in body.material_slots:
+        slot.material = mat
+    scn.cycles.samples = samples
+    bpy.ops.object.bake(type=kind, margin=8, use_clear=True, uv_layer=HANDS_UV)
+    for slot, m in zip(body.material_slots, saved):
+        slot.material = m
+    px = np.empty(RES * RES * 4, np.float32)
+    img.pixels.foreach_get(px)
+    return px.reshape(RES, RES, 4)
+
+
+def wire_albedo(nt, sock):
+    attr = nt.nodes.new("ShaderNodeAttribute")
+    attr.attribute_name = "Region"
+    noise = nt.nodes.new("ShaderNodeTexNoise")
+    noise.inputs["Scale"].default_value = 180.0
+    noise.inputs["Detail"].default_value = 6.0
+    mix = nt.nodes.new("ShaderNodeMix")
+    mix.data_type = 'RGBA'
+    mix.blend_type = 'OVERLAY'
+    mix.inputs["Factor"].default_value = 0.10
+    nt.links.new(attr.outputs["Color"], mix.inputs[6])
+    nt.links.new(noise.outputs["Fac"], mix.inputs[7])
+    nt.links.new(mix.outputs[2], sock)
+
+
+def wire_rough(nt, sock):
+    attr = nt.nodes.new("ShaderNodeAttribute")
+    attr.attribute_name = "Rough"
+    nt.links.new(attr.outputs["Color"], sock)
+
+
+albedo = bake('EMIT', wire_albedo, "alb")
+rough_px = bake('EMIT', wire_rough, "rgh")
+scn.world = bpy.data.worlds.new("W")
+scn.world.light_settings.distance = 0.03
+ao = bake('AO', None, "ao", samples=64)
+
+
+def save(name, rgba, srgb):
+    a = np.clip(rgba, 0, 1)
+    if srgb:
+        a[..., :3] = np.where(a[..., :3] <= 0.0031308, a[..., :3] * 12.92, 1.055 * np.power(a[..., :3], 1 / 2.4) - 0.055)
+    img = bpy.data.images.new(name, RES, RES, alpha=True)
+    img.colorspace_settings.name = 'Non-Color'
+    img.pixels.foreach_set(a.astype(np.float32).ravel())
+    img.filepath_raw = os.path.join(OUT, name)
+    img.file_format = 'PNG'
+    img.save()
+    print("HANDS saved", img.filepath_raw)
+
+
+alb = albedo.copy()
+alb[..., :3] *= (0.75 + 0.25 * ao[..., :1])
+alb[..., 3] = 1
+save("T_PlayerHands_BaseColor.png", alb, True)
+orm = np.stack([ao[..., 0], rough_px[..., 0], np.zeros_like(ao[..., 0]), rough_px[..., 1]], -1)
+save("T_PlayerHands_ORM.png", orm, False)
+for m in rig_mod:
+    m.show_render = True
+
+# drop the MakeHuman UV and the bake attributes; the FBX carries one UV
+for layer in [l.name for l in me.uv_layers if l.name != HANDS_UV]:
+    me.uv_layers.remove(me.uv_layers[layer])
+me.uv_layers[HANDS_UV].name = "UVMap"
+for name in ("Region", "Rough"):
+    me.color_attributes.remove(me.color_attributes[name])
+body.name = "SM_PlayerHands"
+
+info = {s: {n: list(head[n]) for n in KEEP if n.endswith("_" + s)} for s in SIDES}
+info["palmNormal"] = {s: list(pn[s]) for s in SIDES}
+info["verts"] = len(me.vertices)
+info["tris"] = sum(len(p.vertices) - 2 for p in me.polygons)
+json.dump(info, open(os.path.join(OUT, "hands.json"), "w"), indent=1)
+print("HANDS tris", info["tris"])
+
+for o in bpy.context.scene.objects:
+    o.select_set(o in (body, rig))
+bpy.context.view_layer.objects.active = rig
+bpy.ops.export_scene.fbx(filepath=os.path.join(OUT, "SK_PlayerHands.fbx"), use_selection=True, object_types={'ARMATURE', 'MESH'},
+                         apply_scale_options='FBX_SCALE_ALL', mesh_smooth_type='FACE', add_leaf_bones=True, armature_nodetype='NULL',
+                         bake_anim=False, path_mode='STRIP', embed_textures=False)
+print("HANDS exported")
+
+# ---------------------------------------------------------------- preview: textured, studio light, from the front
+prev = bpy.data.materials.new("Preview")
+prev.use_nodes = True
+nt = prev.node_tree
+bsdf = nt.nodes["Principled BSDF"]
+t = nt.nodes.new("ShaderNodeTexImage")
+t.image = bpy.data.images.load(os.path.join(OUT, "T_PlayerHands_BaseColor.png"))
+nt.links.new(t.outputs[0], bsdf.inputs["Base Color"])
+bsdf.inputs["Roughness"].default_value = 0.55
+bsdf.inputs["Subsurface Weight"].default_value = 0.15
+for slot in body.material_slots:
+    slot.material = prev
+scn.render.engine = 'BLENDER_EEVEE'
+scn.render.resolution_x = 1200
+scn.render.resolution_y = 700
+w = scn.world
+w.use_nodes = True
+w.node_tree.nodes["Background"].inputs[0].default_value = (0.5, 0.45, 0.4, 1)
+sun = bpy.data.objects.new("Sun", bpy.data.lights.new("Sun", 'SUN'))
+scn.collection.objects.link(sun)
+sun.data.energy = 3
+sun.rotation_euler = (math.radians(40), 0, math.radians(20))
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam"))
+scn.collection.objects.link(cam)
+scn.camera = cam
+c = (head["hand_l"] + head["hand_r"]) * 0.5
+cam.location = c + mathutils.Vector((0, -1.6, 0.05))
+cam.rotation_euler = (c - cam.location).to_track_quat('-Z', 'Y').to_euler()
+cam.data.lens = 50
+scn.render.filepath = os.path.join(OUT, "hands_preview.png")
+bpy.ops.render.render(write_still=True)
