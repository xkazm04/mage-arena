diff --git a/apps/vr/art/crowd-painted/pack_crowd.py b/apps/vr/art/crowd-painted/pack_crowd.py
new file mode 100644
index 0000000..851b3e8
--- /dev/null
+++ b/apps/vr/art/crowd-painted/pack_crowd.py
@@ -0,0 +1,133 @@
+"""Packs the painted crowd atlas (graphics push 10-28, shared asset) from two studio stills of spectators on chroma green.
+
+python pack_crowd.py <standing.png> <seated.png> <out_dir> <header.h>
+
+Each still holds a row of separate figures on #00B140. The green is keyed out (soft alpha, despilled), each figure is
+found as a run of non-empty columns, and five figures go to each of the T57 crowd's four variants at that variant's own
+card aspect (ArenaStands.cpp VariantTable: SeatedCalm, SeatedLean, StandingCheer, StandingPoint), so every card keeps its
+size and only its atlas rect changes. Writes <out_dir>/T_CrowdPainted.png (2048 RGBA, colours dilated under the
+transparent texels so mips never fringe green), crowd_painted_sheet.png (a review sheet) and <header.h>, the rect table
+Look/CrowdLook.cpp reads (u0, v0, u1, v1 with v up from the atlas bottom, as the T57 table).
+"""
+import sys
+
+import numpy as np
+from PIL import Image, ImageFilter
+
+STANDING, SEATED, OUT, HEADER = sys.argv[1:5]
+SIZE = 2048
+ROW_H = 512
+PER = 5
+# Name, the T57 variant's card width / height (VariantTable), which still, which figures of it
+GROUPS = [
+    ("SeatedCalm", 0.6796 / 1.3, "seated", [0, 2, 4, 6, 8]),
+    ("SeatedLean", 0.6703 / 1.1753, "seated", [1, 3, 5, 7, 9]),
+    ("StandingCheer", 0.8551 / 1.9886, "standing", [0, 2, 3, 6, 9]),
+    ("StandingPoint", 1.05 / 1.75, "standing", [1, 4, 5, 7, 8]),
+]
+
+
+def key(path):
+    im = np.asarray(Image.open(path).convert("RGB")).astype(np.float32) / 255.0
+    r, g, b = im[..., 0], im[..., 1], im[..., 2]
+    greenness = g - np.maximum(r, b)
+    alpha = np.clip(1.0 - (greenness - 0.08) / 0.12, 0.0, 1.0)
+    # despill: no channel of a kept edge texel may lean green
+    g2 = np.minimum(g, np.maximum(r, b) * 1.02)
+    rgb = np.stack([r, g2, b], -1)
+    return rgb, alpha
+
+
+def figures(alpha):
+    """Each figure's box: 4-connected components of the keyed mask at quarter resolution; small pieces (a detached
+    fist, a sandal strap) join the figure whose box is nearest."""
+    small = alpha[::4, ::4] > 0.5
+    h, w = small.shape
+    label = np.zeros((h, w), np.int32)
+    boxes = []
+    for y in range(h):
+        for x in range(w):
+            if small[y, x] and not label[y, x]:
+                n = len(boxes) + 1
+                stack = [(y, x)]
+                label[y, x] = n
+                x0 = x1 = x
+                y0 = y1 = y
+                count = 0
+                while stack:
+                    cy, cx = stack.pop()
+                    count += 1
+                    x0, x1, y0, y1 = min(x0, cx), max(x1, cx), min(y0, cy), max(y1, cy)
+                    for ny, nx in ((cy + 1, cx), (cy - 1, cx), (cy, cx + 1), (cy, cx - 1)):
+                        if 0 <= ny < h and 0 <= nx < w and small[ny, nx] and not label[ny, nx]:
+                            label[ny, nx] = n
+                            stack.append((ny, nx))
+                boxes.append([x0, y0, x1 + 1, y1 + 1, count])
+    big = [b for b in boxes if b[4] > 400]
+    for piece in boxes:
+        if piece[4] > 400 or not big:
+            continue
+        cx = (piece[0] + piece[2]) / 2
+        host = min(big, key=lambda b: abs((b[0] + b[2]) / 2 - cx))
+        host[0], host[1], host[2], host[3] = min(host[0], piece[0]), min(host[1], piece[1]), max(host[2], piece[2]), max(host[3], piece[3])
+    big.sort(key=lambda b: b[0])
+    return [(b[0] * 4, b[1] * 4, b[2] * 4, b[3] * 4) for b in big]
+
+
+atlas = np.zeros((SIZE, SIZE, 4), np.float32)
+stills = {"standing": key(STANDING), "seated": key(SEATED)}
+found = {k: figures(v[1]) for k, v in stills.items()}
+print({k: len(v) for k, v in found.items()})
+rects = []
+for row, (name, aspect, still, picks) in enumerate(GROUPS):
+    rgb, alpha = stills[still]
+    boxes = found[still]
+    cell_w = int(round(ROW_H * aspect))
+    y_top = row * ROW_H
+    group = []
+    for slot, pick in enumerate(picks):
+        x0, y0, x1, y1 = boxes[pick % len(boxes)]
+        crop = np.concatenate([rgb[y0:y1, x0:x1], alpha[y0:y1, x0:x1, None]], -1)
+        h, w = crop.shape[:2]
+        margin = 6
+        scale = min((ROW_H - 2 * margin) / h, (cell_w - 2 * margin) / w)
+        nw, nh = max(1, int(w * scale)), max(1, int(h * scale))
+        img = Image.fromarray((crop * 255).astype(np.uint8), "RGBA").resize((nw, nh), Image.LANCZOS)
+        cell = np.zeros((ROW_H, cell_w, 4), np.float32)
+        ox = (cell_w - nw) // 2
+        oy = ROW_H - margin - nh  # feet on the cell's bottom edge
+        cell[oy:oy + nh, ox:ox + nw] = np.asarray(img).astype(np.float32) / 255.0
+        cx = slot * (cell_w + 8)
+        atlas[y_top:y_top + ROW_H, cx:cx + cell_w] = cell
+        u0, u1 = cx / SIZE, (cx + cell_w) / SIZE
+        v0, v1 = 1.0 - (y_top + ROW_H) / SIZE, 1.0 - y_top / SIZE
+        group.append((u0, v0, u1, v1))
+    rects.append((name, group))
+
+# colours under the transparent texels: repeated blurs of the premultiplied colour, so mips stay figure-coloured
+a = atlas[..., 3:4]
+rgb = atlas[..., :3] * a
+acc_rgb, acc_a = rgb.copy(), a.copy()
+for radius in (2, 4, 8, 16, 32):
+    pr = np.asarray(Image.fromarray((np.clip(rgb, 0, 1) * 255).astype(np.uint8), "RGB").filter(ImageFilter.BoxBlur(radius))).astype(np.float32) / 255.0
+    pa = np.asarray(Image.fromarray((np.clip(a[..., 0], 0, 1) * 255).astype(np.uint8), "L").filter(ImageFilter.BoxBlur(radius))).astype(np.float32)[..., None] / 255.0
+    need = acc_a < 0.5
+    fill = np.where(pa > 1e-3, pr / np.maximum(pa, 1e-3), 0)
+    acc_rgb = np.where(need & (pa > 1e-3), fill, acc_rgb)
+    acc_a = np.where(need & (pa > 1e-3), 1.0, acc_a)
+final_rgb = np.where(a > 0.5, atlas[..., :3], acc_rgb)
+out = np.concatenate([final_rgb, a], -1)
+Image.fromarray((np.clip(out, 0, 1) * 255).astype(np.uint8), "RGBA").save(f"{OUT}/T_CrowdPainted.png")
+sheet = Image.new("RGBA", (SIZE, SIZE), (90, 90, 100, 255))
+sheet.alpha_composite(Image.fromarray((np.concatenate([atlas[..., :3], a], -1) * 255).astype(np.uint8), "RGBA"))
+sheet.convert("RGB").resize((1024, 1024)).save(f"{OUT}/crowd_painted_sheet.png")
+
+with open(HEADER, "w", newline="\n") as f:
+    f.write("#pragma once\n\n// Generated by apps/vr/art/crowd-painted/pack_crowd.py: T_CrowdPainted's cells, five per T57 crowd variant, in the\n")
+    f.write("// T57 table's order and card aspect. u0, v0, u1, v1, v up from the atlas bottom.\n\n")
+    f.write("namespace CrowdPaintedAtlas\n{\ninline constexpr int32 CellsPerVariant = %d;\n" % PER)
+    f.write("inline constexpr double Cells[4][%d][4] = {\n" % PER)
+    for name, group in rects:
+        f.write("    // %s\n    {%s},\n" % (name, ", ".join("{%.6f, %.6f, %.6f, %.6f}" % r for r in group)))
+    f.write("};\n}\n")
+print("packed", [n for n, _ in rects])
