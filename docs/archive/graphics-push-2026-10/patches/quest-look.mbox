+int32 UCreateQuestLookAssetsCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	(void)Params;
+	using QuestLook::ESurface;
+	// Everything is rebuilt from nothing: an asset left on disk would load and refuse the save over it.
+	TArray<FString> Existing;
+	IFileManager::Get().FindFiles(Existing, *FPaths::Combine(FPaths::ProjectContentDir(), TEXT("Look/Quest")), TEXT("*.uasset"));
+	for (const FString& File : Existing)
+	{
+		IFileManager::Get().Delete(*FPaths::Combine(FPaths::ProjectContentDir(), TEXT("Look/Quest"), File), false, true, true);
+	}
+
+	TMap<FString, UTexture2D*> Textures;
+	const TPair<const TCHAR*, ETextureKind> Imports[] = {
+	    {TEXT("T_Q_Stone_D"), ETextureKind::Colour},
+	    {TEXT("T_Q_Stone_N"), ETextureKind::Normal},
+	    {TEXT("T_Q_Sand_D"), ETextureKind::Colour},
+	    {TEXT("T_Q_Sand_N"), ETextureKind::Normal},
+	    {TEXT("T_Q_Flagstone_D"), ETextureKind::Colour},
+	    {TEXT("T_Q_Flagstone_N"), ETextureKind::Normal},
+	    {TEXT("T_Q_Sky_D"), ETextureKind::Sky},
+	    {TEXT("T_Q_Banner_D"), ETextureKind::Cloth},
+	};
+	for (const TPair<const TCHAR*, ETextureKind>& Import : Imports)
+	{
+		UTexture2D* Texture = ImportTexture(Import.Key, Import.Value);
+		if (!Texture)
+		{
+			return 1;
+		}
+		Textures.Add(Import.Key, Texture);
+	}
+
+	UMaterial* Surface = BuildSurface(Textures[TEXT("T_Q_Stone_D")], Textures[TEXT("T_Q_Stone_N")]);
+	UMaterial* Sky = BuildSky(Textures[TEXT("T_Q_Sky_D")]);
+	UMaterial* Banner = BuildBanner(Textures[TEXT("T_Q_Banner_D")]);
+	if (!Surface || !Sky || !Banner)
+	{
+		return 1;
+	}
+
+	// The stone still's crop is 761 of 1024 rows tall, so V tiles at 761/1024 of U and the blocks keep their shape.
+	constexpr float StoneAspect = 761.f / 1024.f;
+	const FSurfaceSpec Specs[] = {
+	    {ESurface::Wall, TEXT("T_Q_Stone_D"), TEXT("T_Q_Stone_N"), {380.f, 380.f * StoneAspect}, FLinearColor(1.f, 0.97f, 0.93f), 0.85f, 1.f, 140.f, 0.55f},
+	    {ESurface::Stands, TEXT("T_Q_Stone_D"), TEXT("T_Q_Stone_N"), {320.f, 320.f * StoneAspect}, FLinearColor(0.9f, 0.84f, 0.78f), 0.9f, 1.f, 60.f, 0.75f},
+	    {ESurface::Sand, TEXT("T_Q_Sand_D"), TEXT("T_Q_Sand_N"), {420.f, 420.f}, FLinearColor(0.8f, 0.71f, 0.64f), 0.95f, 0.8f, 1.f, 1.f, 0.55f, 0.5f, 0.2f},
+	    {ESurface::Dais, TEXT("T_Q_Flagstone_D"), TEXT("T_Q_Flagstone_N"), {240.f, 240.f}, FLinearColor(0.6f, 0.56f, 0.54f), 0.8f, 1.2f, 30.f, 0.7f},
+	    {ESurface::Pad, TEXT("T_Q_Flagstone_D"), TEXT("T_Q_Flagstone_N"), {140.f, 140.f}, FLinearColor(1.f, 0.86f, 0.66f), 0.75f},
+	    {ESurface::Seat, TEXT("T_Q_Stone_D"), TEXT("T_Q_Stone_N"), {160.f, 160.f * StoneAspect}, FLinearColor(0.88f, 0.84f, 0.8f), 0.85f},
+	    {ESurface::Ledge, TEXT("T_Q_Flagstone_D"), TEXT("T_Q_Flagstone_N"), {260.f, 260.f}, FLinearColor(1.f, 0.95f, 0.9f), 0.8f},
+	    {ESurface::Iron, TEXT("T_Q_Flagstone_D"), TEXT("T_Q_Flagstone_N"), {90.f, 90.f}, FLinearColor(0.11f, 0.095f, 0.085f), 0.5f, 0.6f, 1.f, 1.f, 1.f, 0.f, 0.5f},
+	    {ESurface::Wood, TEXT("T_Q_Stone_D"), TEXT("T_Q_Stone_N"), {60.f, 400.f}, FLinearColor(0.42f, 0.24f, 0.12f), 0.8f, 0.5f},
+	    {ESurface::Pylon, TEXT("T_Q_Stone_D"), TEXT("T_Q_Stone_N"), {260.f, 260.f * StoneAspect}, FLinearColor(0.97f, 0.93f, 0.88f), 0.85f, 1.f, 120.f, 0.65f},
+	};
+	// The sand's rim of shade follows the floor ellipse (arena-layout.json floor.radiusXM / radiusYM: 16 x 10 m).
+	const FVector2f EllipseCm(1600.f, 1000.f);
+	for (const FSurfaceSpec& Spec : Specs)
+	{
+		if (!BuildInstance(Surface, Spec, Textures, EllipseCm))
+		{
+			return 1;
+		}
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS done"));
+	return 0;
+#else
+	(void)Params;
+	return 1;
+#endif
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.h b/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.h
