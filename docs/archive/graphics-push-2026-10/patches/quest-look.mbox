 """Packs the painted crowd atlas (graphics push 10-28, shared asset) from two studio stills of spectators on chroma green.
 
-python pack_crowd.py <standing.png> <seated.png> <out_dir> <header.h>
+python pack_crowd.py <standing.png> <seated.png> <out_dir> <header.h> [<banner.png>]
 
 Each still holds a row of separate figures on #00B140. The green is keyed out (soft alpha, despilled), each figure is
 found as a run of non-empty columns, and five figures go to each of the T57 crowd's four variants at that variant's own
@@ -15,6 +15,7 @@ import numpy as np
 from PIL import Image, ImageFilter
 
 STANDING, SEATED, OUT, HEADER = sys.argv[1:5]
+BANNER = sys.argv[5] if len(sys.argv) > 5 else None
 SIZE = 2048
 ROW_H = 512
 PER = 5
@@ -104,6 +105,22 @@ for row, (name, aspect, still, picks) in enumerate(GROUPS):
         group.append((u0, v0, u1, v1))
     rects.append((name, group))
 
+# The T65 stand banners (1 m x 2.8 m cards) get S1's red and gold sun banner: keyed off its white notch, hung from the
+# top of a cell of the card's own aspect in the free column to the right.
+banner_rect = None
+if BANNER:
+    b = np.asarray(Image.open(BANNER).convert("RGB")).astype(np.float32) / 255.0
+    white = (b.min(-1) > 0.86) & ((b.max(-1) - b.min(-1)) < 0.08)
+    ba = np.where(white, 0.0, 1.0)
+    cell_h = 2 * ROW_H
+    cell_w = int(round(cell_h * 1.0 / 2.8))
+    bx = SIZE - cell_w - 24
+    img = Image.fromarray((np.concatenate([b, ba[..., None]], -1) * 255).astype(np.uint8), "RGBA")
+    nh = int(round(img.height * cell_w / img.width))
+    img = img.resize((cell_w, min(nh, cell_h)), Image.LANCZOS)
+    atlas[0:img.height, bx:bx + cell_w] = np.asarray(img).astype(np.float32) / 255.0
+    banner_rect = (bx / SIZE, 1.0 - cell_h / SIZE, (bx + cell_w) / SIZE, 1.0)
+
 # colours under the transparent texels: repeated blurs of the premultiplied colour, so mips stay figure-coloured
 a = atlas[..., 3:4]
 rgb = atlas[..., :3] * a
@@ -129,5 +146,9 @@ with open(HEADER, "w", newline="\n") as f:
     f.write("inline constexpr double Cells[4][%d][4] = {\n" % PER)
     for name, group in rects:
         f.write("    // %s\n    {%s},\n" % (name, ", ".join("{%.6f, %.6f, %.6f, %.6f}" % r for r in group)))
-    f.write("};\n}\n")
+    f.write("};\n")
+    if banner_rect:
+        f.write("// The T65 stand banner: S1's red and gold sun banner, hung from the top of a 1 x 2.8 cell.\n")
+        f.write("inline constexpr double BannerCell[4] = {%.6f, %.6f, %.6f, %.6f};\n" % banner_rect)
+    f.write("}\n")
 print("packed", [n for n, _ in rects])
