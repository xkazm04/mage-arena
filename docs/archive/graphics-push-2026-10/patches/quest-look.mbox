+/**
+ * The graphics push's shared yardstick (docs/concepts/GRAPHICS-PUSH-2026-10-28.md, "The common yardstick"):
+ * -MageArenaS1Shot, run by apps/vr/tools/capture-s1.ps1. One deterministic still of key art S1 in the game, under any
+ * -MageArenaLook=, written as two PNGs to -MageArenaS1Out= (a repo-relative folder, default runs/push/<look>/s1):
+ *   s1-game.png    the game camera (the layout FOV), the truth the scorecard is read from
+ *   s1-keyart.png  the same eye with a narrower FOV, so Brennic fills S1's share of the frame height (a comparison aid)
+ *
+ * Staging (the spell VFX capture's frozen-kernel method, Session/SpellVfxCapture.h): the Brennic semifinal (SetBout(2, true)) starts with a human
+ * player and is frozen at once (SetFrameHold), so the capture owns the kernel state. Brennic (the bout's rival) stands
+ * on the seat's forward line at his own distance from the seat at the bout's start, facing it; every other opponent is
+ * laid down. A "cast" event of his, dated CastS seconds back, puts his rigged figure (Session/RivalFigure.h) that far
+ * into its Cast clip, and the clip is then paused there. One of his Fire bolts flies at the seat, BoltOutM metres out.
+ * The player's ward is raised through the hand pipeline (UHandInputSubsystem::SetWardHeld, the recorded ward clip), as
+ * the greybox capture raises it. The camera looks at Brennic with PitchDeg of pitch. Nothing writes combat data.
+ * Overrides for tuning without a rebuild: -MageArenaS1CastS= -MageArenaS1BoltOutM= -MageArenaS1Pitch= -MageArenaS1RivalM=
+ * -MageArenaS1KeyArtFraction= (Brennic's share of the key-art frame height, S1's is about 0.5).
+ * Ends in MAGEVR_CAPTURE_DONE with manifest.json beside the PNGs, or MAGEVR_CAPTURE_FAIL.
+ */
+UCLASS()
+class MAGEARENAVR_API US1ShotCaptureDriver : public UObject, public FTickableGameObject
+{
+	GENERATED_BODY()
+
+public:
+	US1ShotCaptureDriver();
+
+	void Start();
+
+	/** True when the command line asks for this capture. */
+	static bool IsRequested();
+
+	virtual void Tick(float DeltaTime) override;
+	virtual TStatId GetStatId() const override;
+	virtual bool IsTickable() const override;
+	virtual UWorld* GetTickableGameObjectWorld() const override;
+	virtual void BeginDestroy() override;
+
+private:
+	enum class EStep : uint8
+	{
+		WaitStable,
+		StartBout,
+		Pose,
+		Settle,
+		ShotGame,
+		FrameKeyArt,
+		ShotKeyArt,
+		Finish,
+		Quit
+	};
+
+	void Enter(EStep Next);
+	void Fail(const FString& Reason);
+	bool PoseScene();
+	void FreezeFigure();
+	void AimCamera(float PitchDeg);
+	/** The key-art FOV (horizontal, degrees) and pitch that put Brennic's figure at KeyArtFraction of the frame height. */
+	bool KeyArtFraming(float& OutFovDeg, float& OutPitchDeg) const;
+	void RequestShot(const TCHAR* FileName);
+	AMageArenaPawn* FindPawn() const;
+	UArenaSessionSubsystem* SessionSys() const;
+	class USkeletalMeshComponent* FigureMesh() const;
+
+	EStep Step = EStep::WaitStable;
+	bool bRunning = false;
+	bool bShotOpen = false;
+	int32 Frames = 0;
+	double StepStartWall = 0.0;
+	double RunStartWall = 0.0;
+	int32 ShotCount = 0;
+	FString OutDir;
+	double CastS = 0.62;
+	double BoltOutM = 3.2;
+	float PitchDeg = -7.f;
+	double KeyArtFraction = 0.5;
+	FVector BrennicFeetCm = FVector::ZeroVector;
+	FCaptureEvidence Evidence;
+};
