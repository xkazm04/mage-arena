-// The core: the fire pattern panning over the sphere in the threat colour, brighter where it faces the eye, and the heart
-// across its middle. A black core (the unblockable) stays black: everything scales by its colour.
+// The core: a swirling flame, not an orb. The fire pattern turns round the sphere and pans through it, in the threat
+// colour with strong contrast, brighter facing the eye, the heart only at its very middle; its rim is masked raggedly by
+// the same pattern, so the silhouette licks instead of ending in a glossy edge. A black core (the unblockable) stays a
+// whole black sphere: nothing glows and nothing is masked away.
 const TCHAR* CoreCode = TEXT("float f = saturate(dot(normalize(N), normalize(V)));\n"
                              "float glows = max(max(C.r, C.g), C.b) > 0.001 ? 1.0 : 0.0;\n"
-                             "float3 body = C * (0.6 + 0.9 * Noise) * lerp(0.7, 1.25, f);\n"
-                             "return lerp(body, H * 2.0, pow(f, 6.0) * 0.55 * glows);");
+                             "float3 body = C * (0.6 + 0.95 * saturate(Noise)) * lerp(0.75, 1.3, f);\n"
+                             "return lerp(body, H * 1.8, pow(f, 8.0) * 0.45 * glows);");
+const TCHAR* CoreMaskCode = TEXT("float f = saturate(dot(normalize(N), normalize(V)));\n"
+                                 "float glows = max(max(C.r, C.g), C.b) > 0.001 ? 1.0 : 0.0;\n"
+                                 "return lerp(1.0, f * 1.25 + Noise * 0.65, glows);");
+const TCHAR* CoreUvCode = TEXT("float2 p = Uv - 0.5;\n"
+                               "float a = T * 1.7 + length(p) * 3.0;\n"
+                               "float2 r = float2(p.x * cos(a) - p.y * sin(a), p.x * sin(a) + p.y * cos(a));\n"
+                               "return (r + 0.5) * float2(2.0, 1.0) + T * float2(0.23, -0.31);");
 
 bool BuildCore(UTexture2D* Noise)
 {
 	const TCHAR* Name = TEXT("M_Q_BoltCore");
-	FGraph G{NewMaterial(Name, BLEND_Opaque)};
+	FGraph G{NewMaterial(Name, BLEND_Masked)};
 	UMaterial* Material = G.Material;
-	UMaterialExpression* Uv = G.Custom(TEXT("CoreUv"), CMOT_Float2, TEXT("return Uv * float2(2.0, 1.0) + T * float2(0.23, -0.31);"),
-	    {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("T"), G.Make<UMaterialExpressionTime>()}});
+	Material->OpacityMaskClipValue = 0.75f;
+	UMaterialExpression* Uv = G.Custom(TEXT("CoreUv"), CMOT_Float2, CoreUvCode, {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("T"), G.Make<UMaterialExpressionTime>()}});
 	UMaterialExpressionTextureSample* Pattern = G.Sample(Noise, SAMPLERTYPE_LinearColor, Uv);
 	UMaterialExpression* Colour = G.Colour();
+	UMaterialExpression* Normal = G.Make<UMaterialExpressionVertexNormalWS>();
+	UMaterialExpression* View = G.Make<UMaterialExpressionCameraVectorWS>();
 	UMaterialExpression* Heart = G.Custom(TEXT("Heart"), CMOT_Float3, HeartCode, {{TEXT("C"), Colour}});
-	UMaterialExpression* Emissive = G.Custom(TEXT("Core"), CMOT_Float3, CoreCode,
-	    {{TEXT("C"), Colour}, {TEXT("H"), Heart}, {TEXT("Noise"), Pattern, 1}, {TEXT("N"), G.Make<UMaterialExpressionVertexNormalWS>()}, {TEXT("V"), G.Make<UMaterialExpressionCameraVectorWS>()}});
+	UMaterialExpression* Emissive = G.Custom(TEXT("Core"), CMOT_Float3, CoreCode, {{TEXT("C"), Colour}, {TEXT("H"), Heart}, {TEXT("Noise"), Pattern, 1}, {TEXT("N"), Normal}, {TEXT("V"), View}});
+	UMaterialExpression* Mask = G.Custom(TEXT("Ragged"), CMOT_Float1, CoreMaskCode, {{TEXT("C"), Colour}, {TEXT("Noise"), Pattern, 1}, {TEXT("N"), Normal}, {TEXT("V"), View}});
 	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	Material->GetEditorOnlyData()->OpacityMask.Expression = Mask;
 	return Finish(Material, Name);
 }
 
