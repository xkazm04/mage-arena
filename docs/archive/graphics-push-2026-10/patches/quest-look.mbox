-both.save(OUT / "T_Q_WardWave.png")
-print("T_Q_WardWave.png", both.size)
+def wave_band(name):
+    """One wave still as colour + alpha: its band only (top spray to where the body fades), fading out toward the palm."""
+    wave = rgb(name)
+    h = wave.shape[0]
+    wave = wave[int(h * 0.1): int(h * 0.68)]
+    rows = np.linspace(0.0, 1.0, wave.shape[0])
+    fade = np.clip((0.92 - rows) / 0.32, 0.0, 1.0) ** 2
+    alpha = coverage(wave, 0.12, 0.3) * fade[:, None]
+    colour = np.clip(wave / np.maximum(wave.max(axis=-1, keepdims=True), 0.04), 0.0, 1.0)
+    colour = colour * np.clip(wave.max(axis=-1, keepdims=True) * 1.3, 0.35, 1.0)
+    rgba = np.dstack([colour, alpha])
+    return np.asarray(Image.fromarray((rgba * 255).astype(np.uint8), "RGBA").resize((1024, 512), Image.LANCZOS), dtype=np.float32)
+
+
+# Two different waves side by side (no mirror, so the arc never shows a mirrored pair of curls). Each is 1120 px wide;
+# the 96 px past its own 1024 cross-fade into the next one's first 96, so the panorama wraps without a seam.
+def band_wide(name):
+    return np.asarray(Image.fromarray(wave_band(name).astype(np.uint8), "RGBA").resize((1120, 512), Image.LANCZOS), dtype=np.float32)
+
+
+a, b = band_wide("wardwave-01.png"), band_wide("wardwave-02.png")
+t = np.linspace(0.0, 1.0, 96)[None, :, None]
+both = np.concatenate([a[:, 96:1024], a[:, 1024:1120] * (1 - t) + b[:, 0:96] * t, b[:, 96:1024], b[:, 1024:1120] * (1 - t) + a[:, 0:96] * t], axis=1)
+Image.fromarray(both.clip(0, 255).astype(np.uint8), "RGBA").save(OUT / "T_Q_WardWave.png")
+print("T_Q_WardWave.png", both.shape)
+
+# The environment flame: a tall painted flame on black, kept as its own colour (additive: black adds nothing).
+flame = Image.open(SRC / "flame-01.png").convert("RGB").resize((512, 1024), Image.LANCZOS)
+flame.save(OUT / "T_Q_EnvFlame.png")
+print("T_Q_EnvFlame.png", flame.size)
 
