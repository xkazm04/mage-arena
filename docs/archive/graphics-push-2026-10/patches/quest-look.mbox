@@ -39,6 +39,9 @@ double Clock(double Real);
 
 inline constexpr const TCHAR* Folder = TEXT("/Game/Look/Spells");
 
+/** A warm bolt's white-gold hot heart: the colour (HDR, above 1) its additive heart card takes in M_Q_SpellHalo. */
+inline const FLinearColor HotHeartColour = FLinearColor(4.0f, 3.1f, 1.8f, 1.0f);
+
 /** M_Q_SpellGlow, or null when it is not built (the caller keeps M_SpellGlow). */
 UMaterialInterface* GlowMaterial();
