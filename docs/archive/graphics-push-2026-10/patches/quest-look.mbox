@@ -0,0 +1,306 @@
+#include "Look/CreateQuestSpellAssetsCommandlet.h"
+
+#include "Look/QuestSpells.h"
+#include "MageArenaVR.h"
+#include "Misc/Paths.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "AssetImportTask.h"
+#include "AssetToolsModule.h"
+#include "Engine/Texture2D.h"
+#include "HAL/FileManager.h"
+#include "IAssetTools.h"
+#include "MaterialShared.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialExpressionCameraVectorWS.h"
+#include "Materials/MaterialExpressionCustom.h"
+#include "Materials/MaterialExpressionPerInstanceCustomData.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureSample.h"
+#include "Materials/MaterialExpressionTime.h"
+#include "Materials/MaterialExpressionVectorParameter.h"
+#include "Materials/MaterialExpressionVertexNormalWS.h"
+#include "Misc/PackageName.h"
+#include "ShaderCompiler.h"
+#include "UObject/Package.h"
+#include "UObject/SavePackage.h"
+#endif
+
+UCreateQuestSpellAssetsCommandlet::UCreateQuestSpellAssetsCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+#if WITH_EDITOR
+namespace
+{
+bool Save(UObject* Asset, const TCHAR* Name)
+{
+	UPackage* Package = Asset->GetOutermost();
+	const FString File = FPackageName::LongPackageNameToFilename(Package->GetName(), FPackageName::GetAssetPackageExtension());
+	FSavePackageArgs SaveArgs;
+	SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;
+	SaveArgs.SaveFlags = SAVE_NoError;
+	if (!UPackage::SavePackage(Package, Asset, *File, SaveArgs))
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_SPELL_ASSETS fail %s save %s"), Name, *File);
+		return false;
+	}
+	return true;
+}
+
+UTexture2D* ImportTexture(const TCHAR* Name, bool bColour, bool bClampV)
+{
+	const FString Png = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/look/spells"), FString(Name) + TEXT(".png")));
+	if (!FPaths::FileExists(Png))
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_SPELL_ASSETS fail %s missing %s"), Name, *Png);
+		return nullptr;
+	}
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>("AssetTools").Get();
+	UAssetImportTask* Task = NewObject<UAssetImportTask>();
+	Task->Filename = Png;
+	Task->DestinationPath = QuestSpells::Folder;
+	Task->DestinationName = Name;
+	Task->bReplaceExisting = true;
+	Task->bReplaceExistingSettings = true;
+	Task->bAutomated = true;
+	Task->bSave = false;
+	AssetTools.ImportAssetTasks({Task});
+	UTexture2D* Texture = nullptr;
+	for (UObject* Object : Task->GetObjects())
+	{
+		Texture = Texture ? Texture : Cast<UTexture2D>(Object);
+	}
+	if (!Texture)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_SPELL_ASSETS fail %s import"), Name);
+		return nullptr;
+	}
+	// The atlas and the noise carry data (shade, coverage), not colour; the wave is colour.
+	Texture->SRGB = bColour;
+	Texture->CompressionSettings = TC_Default;
+	Texture->MipGenSettings = TMGS_FromTextureGroup;
+	Texture->LODGroup = TEXTUREGROUP_Effects;
+	if (bClampV)
+	{
+		Texture->AddressY = TA_Clamp;
+	}
+	Texture->PostEditChange();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (!Save(Texture, Name))
+	{
+		return nullptr;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_SPELL_ASSETS %s %dx%d srgb=%d"), Name, Texture->Source.GetSizeX(), Texture->Source.GetSizeY(), bColour ? 1 : 0);
+	return Texture;
+}
+
+struct FGraph
+{
+	UMaterial* Material = nullptr;
+	int32 Next = 0;
+
+	template <typename T>
+	T* Make()
+	{
+		T* Expression = NewObject<T>(Material);
+		Expression->MaterialExpressionEditorX = -300 * (1 + Next % 4);
+		Expression->MaterialExpressionEditorY = 120 * Next;
+		++Next;
+		Material->GetExpressionCollection().AddExpression(Expression);
+		return Expression;
+	}
+
+	UMaterialExpressionPerInstanceCustomData* Data(int32 Index, float Default)
+	{
+		UMaterialExpressionPerInstanceCustomData* Node = Make<UMaterialExpressionPerInstanceCustomData>();
+		Node->DataIndex = Index;
+		Node->ConstDefaultValue = Default;
+		return Node;
+	}
+
+	UMaterialExpressionTextureSample* Sample(UTexture2D* Texture, EMaterialSamplerType Type, UMaterialExpression* Uv)
+	{
+		UMaterialExpressionTextureSample* Node = Make<UMaterialExpressionTextureSample>();
+		Node->Texture = Texture;
+		Node->SamplerType = Type;
+		Node->Coordinates.Expression = Uv;
+		return Node;
+	}
+
+	struct FIn
+	{
+		const TCHAR* Name;
+		UMaterialExpression* Expression;
+		int32 Output = 0;
+	};
+
+	UMaterialExpression* Custom(const TCHAR* Description, ECustomMaterialOutputType Type, const TCHAR* Code, std::initializer_list<FIn> Inputs)
+	{
+		UMaterialExpressionCustom* Node = Make<UMaterialExpressionCustom>();
+		Node->Description = Description;
+		Node->OutputType = Type;
+		Node->Code = Code;
+		Node->Inputs.Reset();
+		for (const FIn& In : Inputs)
+		{
+			FCustomInput& Input = Node->Inputs.AddDefaulted_GetRef();
+			Input.InputName = In.Name;
+			Input.Input.Connect(In.Output, In.Expression);
+		}
+		return Node;
+	}
+
+	UMaterialExpression* Colour()
+	{
+		UMaterialExpressionVectorParameter* Node = Make<UMaterialExpressionVectorParameter>();
+		Node->ParameterName = TEXT("Color");
+		Node->DefaultValue = FLinearColor(1.f, 0.45f, 0.1f);
+		return Node;
+	}
+};
+
+UMaterial* NewMaterial(const TCHAR* Name, EBlendMode Blend)
+{
+	UPackage* Package = CreatePackage(*FString::Printf(TEXT("%s/%s"), QuestSpells::Folder, Name));
+	UMaterial* Material = NewObject<UMaterial>(Package, Name, RF_Public | RF_Standalone | RF_Transactional);
+	Material->MaterialDomain = MD_Surface;
+	Material->BlendMode = Blend;
+	Material->SetShadingModel(MSM_Unlit);
+	return Material;
+}
+
+bool Finish(UMaterial* Material, const TCHAR* Name)
+{
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	if (const FMaterialResource* Resource = Material->GetMaterialResource(GMaxRHIShaderPlatform))
+	{
+		for (const FString& Error : Resource->GetCompileErrors())
+		{
+			UE_LOG(LogMageArena, Error, TEXT("MAGEVR_SPELL_ASSETS %s compile error: %s"), Name, *Error);
+		}
+	}
+	if (!Save(Material, Name))
+	{
+		return false;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_SPELL_ASSETS %s built"), Name);
+	return true;
+}
+
+// The heart: a warm colour (red well over blue) turns white-gold at its brightest, a cool one a lighter tone of itself.
+// HDR above 1 so bloom (where it exists) haloes it; the colour below the heart is always the threat's own.
+const TCHAR* HeartCode = TEXT("float warm = saturate((C.r - C.b) * 1.6);\n"
+                              "return lerp(C, float3(1.0, 0.86, 0.56), warm * 0.85);");
+
+// T63's card UV (SpellVfx::CardCustomData): U = u x d0 + d1, V = v / 4 + d2.
+const TCHAR* CardUvCode = TEXT("return float2(Uv.x * D0 + D1, Uv.y * 0.25 + D2);");
+
+// Shade to light: the cell's shade in the threat colour, lifted past the filmic toe, plus the heart at its brightest
+// pixels. The shared row (V offset 0.75: the unblockable's SoftGlow, the streaks, the grit) never takes a heart.
+const TCHAR* GlowCode = TEXT("float body = pow(saturate(S), 0.6) * 1.2;\n"
+                             "float hearty = D2 < 0.74 ? 1.0 : 0.0;\n"
+                             "return C * body + H * pow(saturate(S), 6.0) * 2.2 * hearty;");
+
+bool BuildGlow(UTexture2D* Atlas)
+{
+	const TCHAR* Name = TEXT("M_Q_SpellGlow");
+	FGraph G{NewMaterial(Name, BLEND_Translucent)};
+	UMaterial* Material = G.Material;
+	Material->TwoSided = true;
+	Material->bUsedWithInstancedStaticMeshes = true;
+	UMaterialExpression* D0 = G.Data(0, 0.25f);
+	UMaterialExpression* D1 = G.Data(1, 0.f);
+	UMaterialExpression* D2 = G.Data(2, 0.75f);
+	UMaterialExpression* Uv = G.Custom(TEXT("CardUv"), CMOT_Float2, CardUvCode, {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("D0"), D0}, {TEXT("D1"), D1}, {TEXT("D2"), D2}});
+	UMaterialExpressionTextureSample* Cell = G.Sample(Atlas, SAMPLERTYPE_LinearColor, Uv);
+	UMaterialExpression* Colour = G.Colour();
+	UMaterialExpression* Heart = G.Custom(TEXT("Heart"), CMOT_Float3, HeartCode, {{TEXT("C"), Colour}});
+	UMaterialExpression* Emissive = G.Custom(TEXT("Glow"), CMOT_Float3, GlowCode, {{TEXT("C"), Colour}, {TEXT("H"), Heart}, {TEXT("S"), Cell, 1}, {TEXT("D2"), D2}});
+	UMaterialExpression* Opacity = G.Custom(TEXT("Cover"), CMOT_Float1, TEXT("return saturate(A * 1.25) * lerp(0.3, 1.0, saturate(S * 1.4));"), {{TEXT("A"), Cell, 4}, {TEXT("S"), Cell, 1}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	Material->GetEditorOnlyData()->Opacity.Expression = Opacity;
+	return Finish(Material, Name);
+}
+
+// The core: the fire pattern panning over the sphere in the threat colour, brighter where it faces the eye, and the heart
+// across its middle. A black core (the unblockable) stays black: everything scales by its colour.
+const TCHAR* CoreCode = TEXT("float f = saturate(dot(normalize(N), normalize(V)));\n"
+                             "float glows = max(max(C.r, C.g), C.b) > 0.001 ? 1.0 : 0.0;\n"
+                             "float3 body = C * (0.6 + 0.9 * Noise) * lerp(0.7, 1.25, f);\n"
+                             "return lerp(body, H * 2.0, pow(f, 6.0) * 0.55 * glows);");
+
+bool BuildCore(UTexture2D* Noise)
+{
+	const TCHAR* Name = TEXT("M_Q_BoltCore");
+	FGraph G{NewMaterial(Name, BLEND_Opaque)};
+	UMaterial* Material = G.Material;
+	UMaterialExpression* Uv = G.Custom(TEXT("CoreUv"), CMOT_Float2, TEXT("return Uv * float2(2.0, 1.0) + T * float2(0.23, -0.31);"),
+	    {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("T"), G.Make<UMaterialExpressionTime>()}});
+	UMaterialExpressionTextureSample* Pattern = G.Sample(Noise, SAMPLERTYPE_LinearColor, Uv);
+	UMaterialExpression* Colour = G.Colour();
+	UMaterialExpression* Heart = G.Custom(TEXT("Heart"), CMOT_Float3, HeartCode, {{TEXT("C"), Colour}});
+	UMaterialExpression* Emissive = G.Custom(TEXT("Core"), CMOT_Float3, CoreCode,
+	    {{TEXT("C"), Colour}, {TEXT("H"), Heart}, {TEXT("Noise"), Pattern, 1}, {TEXT("N"), G.Make<UMaterialExpressionVertexNormalWS>()}, {TEXT("V"), G.Make<UMaterialExpressionCameraVectorWS>()}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	return Finish(Material, Name);
+}
+
+// The ward's wave: one copy of it spread over the arc's cards (d0 the card's start, d1 its width in U), drifting along the
+// arc. The water's own turquoise and white crest, lifted past the filmic toe.
+bool BuildWard(UTexture2D* Wave)
+{
+	const TCHAR* Name = TEXT("M_Q_Ward");
+	FGraph G{NewMaterial(Name, BLEND_Translucent)};
+	UMaterial* Material = G.Material;
+	Material->TwoSided = true;
+	Material->bUsedWithInstancedStaticMeshes = true;
+	UMaterialExpression* Uv = G.Custom(TEXT("WardUv"), CMOT_Float2, TEXT("return float2(D0 + Uv.x * D1 + T * 0.035, Uv.y);"),
+	    {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("D0"), G.Data(0, 0.f)}, {TEXT("D1"), G.Data(1, 0.5f)}, {TEXT("T"), G.Make<UMaterialExpressionTime>()}});
+	UMaterialExpressionTextureSample* Water = G.Sample(Wave, SAMPLERTYPE_Color, Uv);
+	UMaterialExpression* Emissive = G.Custom(TEXT("Water"), CMOT_Float3, TEXT("return Rgb * 1.55 + pow(saturate(dot(Rgb, float3(0.33, 0.33, 0.33))), 4.0) * 1.2;"), {{TEXT("Rgb"), Water}});
+	// The arc's two ends fade out over its outer tenth, so the last card shows no hard edge.
+	UMaterialExpression* Opacity = G.Custom(TEXT("Cover"), CMOT_Float1, TEXT("float u = D0 + Uv.x * D1;\nreturn saturate(A * 0.92) * saturate(min(u, 0.5 - u) / 0.05);"),
+	    {{TEXT("A"), Water, 4}, {TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("D0"), G.Data(0, 0.f)}, {TEXT("D1"), G.Data(1, 0.5f)}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Emissive;
+	Material->GetEditorOnlyData()->Opacity.Expression = Opacity;
+	return Finish(Material, Name);
+}
+}
+#endif
+
+int32 UCreateQuestSpellAssetsCommandlet::Main(const FString& Params)
+{
+	(void)Params;
+#if WITH_EDITOR
+	TArray<FString> Existing;
+	const FString Dir = FPaths::Combine(FPaths::ProjectContentDir(), TEXT("Look/Spells"));
+	IFileManager::Get().FindFiles(Existing, *Dir, TEXT("*.uasset"));
+	for (const FString& File : Existing)
+	{
+		IFileManager::Get().Delete(*FPaths::Combine(Dir, File), false, true, true);
+	}
+	UTexture2D* Atlas = ImportTexture(TEXT("T_Q_SpellFlipbook"), false, false);
+	UTexture2D* Wave = ImportTexture(TEXT("T_Q_WardWave"), true, true);
+	UTexture2D* Noise = ImportTexture(TEXT("T_Q_CoreNoise"), false, false);
+	if (!Atlas || !Wave || !Noise || !BuildGlow(Atlas) || !BuildCore(Noise) || !BuildWard(Wave))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_SPELL_ASSETS done"));
+	return 0;
+#else
+	return 1;
+#endif
+}
