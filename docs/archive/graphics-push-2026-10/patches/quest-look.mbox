+/**
+ * The recorded clips curl the thumb into a hook (the ward clip's distal phalanx turns about 130 degrees back on the one
+ * before it), which the skinned thumb draws as a pale claw. For the picture only, each thumb segment is held within
+ * MaxThumbBendDeg of the one before it, lengths kept; the gesture pipeline never sees this.
+ */
+constexpr double MaxThumbBendDeg = 30.0;
+
+void StraightenThumb(FVector (&At)[4])
+{
+	for (int32 Index = 2; Index < 4; ++Index)
+	{
+		const FVector Parent = (At[Index - 1] - At[Index - 2]).GetSafeNormal();
+		const FVector Offset = At[Index] - At[Index - 1];
+		const FVector Dir = Offset.GetSafeNormal();
+		const double Bend = FMath::RadiansToDegrees(FMath::Acos(FMath::Clamp(FVector::DotProduct(Parent, Dir), -1.0, 1.0)));
+		if (Bend > MaxThumbBendDeg && !Parent.IsNearlyZero() && !Dir.IsNearlyZero())
+		{
+			const FQuat Full = FQuat::FindBetweenNormals(Parent, Dir);
+			const FVector Held = FQuat::Slerp(FQuat::Identity, Full, MaxThumbBendDeg / Bend).RotateVector(Parent);
+			At[Index] = At[Index - 1] + Held * Offset.Size();
+		}
+	}
+}
