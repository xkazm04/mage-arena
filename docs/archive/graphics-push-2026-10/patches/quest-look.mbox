+void BuildFireCards(AActor& Owner, const FArenaLayout& Layout, const FArenaLayout& PylonFires)
+{
+	UMaterialInterface* Glow = QuestSpells::GlowMaterial();
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	const FRunePad* Seat = Layout.FindPad(1);
+	UWorld* World = Owner.GetWorld();
+	if (!Glow || !Plane || !Seat || !World || BrazierFire::IsSwitchedOff())
+	{
+		return;
+	}
+	TArray<FArenaProp> Fires = Layout.Braziers;
+	Fires.Append(PylonFires.Braziers);
+	const FVector EyeCm = ToCm(Layout.EyeLocationM(*Seat));
+	TArray<UInstancedStaticMeshComponent*> Layers;
+	for (const BrazierFire::ELayer Layer : {BrazierFire::ELayer::Body, BrazierFire::ELayer::Heart})
+	{
+		UInstancedStaticMeshComponent* Cards = Greybox::MakeInstances(&Owner, Plane, Greybox::Tint(Glow, &Owner, BrazierFire::FlameColour(ActiveElementPalette(), Layer) * FireCardGain));
+		if (Cards)
+		{
+			Cards->SetNumCustomDataFloats(SpellVfx::CardCustomFloats);
+			Cards->SetCastShadow(false);
+		}
+		Layers.Add(Cards);
+	}
+	TWeakObjectPtr<UInstancedStaticMeshComponent> Body(Layers[0]);
+	TWeakObjectPtr<UInstancedStaticMeshComponent> Heart(Layers[1]);
+	PoseFireCards(Body.Get(), Heart.Get(), Fires, EyeCm, 0.0);
+	FTimerHandle Handle;
+	World->GetTimerManager().SetTimer(Handle, FTimerDelegate::CreateWeakLambda(&Owner, [Body, Heart, Fires, EyeCm, &Owner]()
+	{
+		if (const UWorld* Live = Owner.GetWorld())
+		{
+			PoseFireCards(Body.Get(), Heart.Get(), Fires, EyeCm, Live->GetTimeSeconds());
+		}
+	}),
+	    1.f / 30.f, true);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK fire cards fires=%d"), Fires.Num());
+}
