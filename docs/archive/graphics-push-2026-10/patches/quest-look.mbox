diff --git a/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.cpp b/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.cpp
new file mode 100644
index 0000000..35823ae
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.cpp
@@ -0,0 +1,184 @@
+#include "Look/PlayerHandsLook.h"
+
+#include "Components/PoseableMeshComponent.h"
+#include "Engine/SkeletalMesh.h"
+#include "GameFramework/Actor.h"
+#include "HeadMountedDisplayTypes.h"
+#include "Hands/HandFrame.h"
+#include "Look/ArenaLook.h"
+#include "MageArenaVR.h"
+#include "Materials/MaterialInterface.h"
+#include "Misc/Parse.h"
+
+namespace
+{
+FVector Joint(const FHandFrame& Frame, EHandKeypoint Key)
+{
+	return Frame.Joints[static_cast<int32>(Key)].Location;
+}
+
+struct FRest
+{
+	TArray<FTransform> ComponentSpace;
+	const FReferenceSkeleton* Skeleton = nullptr;
+
+	int32 Index(const FString& Name) const { return Skeleton->FindBoneIndex(FName(*Name)); }
+	FVector Head(const FString& Name) const
+	{
+		const int32 Bone = Index(Name);
+		return ComponentSpace.IsValidIndex(Bone) ? ComponentSpace[Bone].GetLocation() : FVector::ZeroVector;
+	}
+};
+
+FRest RestOf(const USkeletalMesh& Mesh)
+{
+	FRest Rest;
+	Rest.Skeleton = &Mesh.GetRefSkeleton();
+	const TArray<FTransform>& Local = Rest.Skeleton->GetRefBonePose();
+	Rest.ComponentSpace.SetNum(Local.Num());
+	for (int32 Bone = 0; Bone < Local.Num(); ++Bone)
+	{
+		const int32 Parent = Rest.Skeleton->GetParentIndex(Bone);
+		Rest.ComponentSpace[Bone] = Parent == INDEX_NONE ? Local[Bone] : Local[Bone] * Rest.ComponentSpace[Parent];
+	}
+	return Rest;
+}
+
+FVector PalmNormal(const FVector& IndexRoot, const FVector& LittleRoot, const FVector& MiddleRoot, const FVector& Wrist)
+{
+	return FVector::CrossProduct(IndexRoot - LittleRoot, MiddleRoot - Wrist).GetSafeNormal();
+}
+
+struct FFinger
+{
+	const TCHAR* Bone;
+	EHandKeypoint Joints[4]; // the three bones' heads and the tip
+};
+
+const FFinger Fingers[] = {
+    {TEXT("thumb"), {EHandKeypoint::ThumbMetacarpal, EHandKeypoint::ThumbProximal, EHandKeypoint::ThumbDistal, EHandKeypoint::ThumbTip}},
+    {TEXT("index"), {EHandKeypoint::IndexProximal, EHandKeypoint::IndexIntermediate, EHandKeypoint::IndexDistal, EHandKeypoint::IndexTip}},
+    {TEXT("middle"), {EHandKeypoint::MiddleProximal, EHandKeypoint::MiddleIntermediate, EHandKeypoint::MiddleDistal, EHandKeypoint::MiddleTip}},
+    {TEXT("ring"), {EHandKeypoint::RingProximal, EHandKeypoint::RingIntermediate, EHandKeypoint::RingDistal, EHandKeypoint::RingTip}},
+    {TEXT("pinky"), {EHandKeypoint::LittleProximal, EHandKeypoint::LittleIntermediate, EHandKeypoint::LittleDistal, EHandKeypoint::LittleTip}},
+};
+
+void PoseSide(UPoseableMeshComponent& Mesh, const FRest& Rest, const TCHAR* Side, const FHandFrame* Frame)
+{
+	auto Name = [Side](const FString& Bone)
+	{ return FString::Printf(TEXT("%s_%s"), *Bone, Side); };
+	const int32 Forearm = Rest.Index(Name(TEXT("lowerarm")));
+	if (Forearm == INDEX_NONE)
+	{
+		return;
+	}
+	if (!Frame || Frame->Joints.Num() < MageHandJointCount)
+	{
+		// Fold the whole arm into a point under the seat; every child keeps its local transform.
+		Mesh.SetBoneTransformByName(FName(*Name(TEXT("lowerarm"))), FTransform(FQuat::Identity, FVector(0.0, 0.0, -500.0), FVector(0.001)), EBoneSpaces::ComponentSpace);
+		return;
+	}
+	const FVector RestNormal = PalmNormal(Rest.Head(Name(TEXT("index_01"))), Rest.Head(Name(TEXT("pinky_01"))), Rest.Head(Name(TEXT("middle_01"))), Rest.Head(Name(TEXT("hand"))));
+	const FVector LiveNormal = PalmNormal(Joint(*Frame, EHandKeypoint::IndexProximal), Joint(*Frame, EHandKeypoint::LittleProximal), Joint(*Frame, EHandKeypoint::MiddleProximal),
+	    Joint(*Frame, EHandKeypoint::Wrist));
+
+	// Each bone: its head on HeadAt, its rest direction (to RestChild's head) onto (AimAt - HeadAt), the palm normal kept.
+	auto Aim = [&](const FString& Bone, const FString& RestChild, const FVector& HeadAt, const FVector& AimAt)
+	{
+		const int32 Index = Rest.Index(Bone);
+		if (Index == INDEX_NONE)
+		{
+			return;
+		}
+		const FVector RestDir = (Rest.Head(RestChild) - Rest.Head(Bone)).GetSafeNormal();
+		const FVector LiveDir = (AimAt - HeadAt).GetSafeNormal();
+		const FQuat From = FRotationMatrix::MakeFromXZ(RestDir, RestNormal).ToQuat();
+		const FQuat To = FRotationMatrix::MakeFromXZ(LiveDir, LiveNormal).ToQuat();
+		const FTransform& RestCs = Rest.ComponentSpace[Index];
+		const FQuat Rotation = To * From.Inverse() * RestCs.GetRotation();
+		Mesh.SetBoneTransformByName(FName(*Bone), FTransform(Rotation, HeadAt, RestCs.GetScale3D()), EBoneSpaces::ComponentSpace);
+	};
+
+	const FVector Wrist = Joint(*Frame, EHandKeypoint::Wrist);
+	const FVector Knuckle = Joint(*Frame, EHandKeypoint::MiddleProximal);
+	// No elbow is tracked: the forearm continues the hand's axis, its elbow a little lower than the wrist.
+	const double ForearmCm = (Rest.Head(Name(TEXT("hand"))) - Rest.Head(Name(TEXT("lowerarm")))).Size();
+	const FVector ForearmDir = ((Knuckle - Wrist).GetSafeNormal() + FVector(0.0, 0.0, 0.35)).GetSafeNormal();
+	Aim(Name(TEXT("lowerarm")), Name(TEXT("hand")), Wrist - ForearmDir * ForearmCm, Wrist);
+	Aim(Name(TEXT("hand")), Name(TEXT("middle_01")), Wrist, Knuckle);
+	for (const FFinger& Finger : Fingers)
+	{
+		for (int32 Segment = 0; Segment < 3; ++Segment)
+		{
+			const FString Bone = Name(FString::Printf(TEXT("%s_0%d"), Finger.Bone, Segment + 1));
+			const FString Child = Segment < 2 ? Name(FString::Printf(TEXT("%s_0%d"), Finger.Bone, Segment + 2)) : Bone + TEXT("_end");
+			Aim(Bone, Child, Joint(*Frame, Finger.Joints[Segment]), Joint(*Frame, Finger.Joints[Segment + 1]));
+		}
+	}
+}
+}
+
+FString PlayerHandsLook::Folder()
+{
+	return TEXT("/Game/Look/Shared/Hands");
+}
+
+UPoseableMeshComponent* PlayerHandsLook::Create(AActor& Owner)
+{
+	if (ArenaLook::IsFlat() || FParse::Param(FCommandLine::Get(), TEXT("nullrhi")))
+	{
+		return nullptr;
+	}
+	USkeletalMesh* Mesh = LoadObject<USkeletalMesh>(nullptr, *(Folder() / TEXT("SK_PlayerHands.SK_PlayerHands")));
+	if (!Mesh)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_LOOK player hands missing (run -run=CreatePlayerHands); the mannequin stays"));
+		return nullptr;
+	}
+	const TCHAR* SkinName = ArenaLook::Current() == EArenaLook::Epic ? TEXT("M_PlayerHandsEpic") : TEXT("M_PlayerHandsLite");
+	UMaterialInterface* Skin = LoadObject<UMaterialInterface>(nullptr, *FString::Printf(TEXT("%s/%s.%s"), *Folder(), SkinName, SkinName));
+	UPoseableMeshComponent* Hands = NewObject<UPoseableMeshComponent>(&Owner, TEXT("PlayerHands"));
+	Hands->SetSkinnedAssetAndUpdate(Mesh);
+	for (int32 Slot = 0; Slot < Hands->GetNumMaterials(); ++Slot)
+	{
+		if (Skin && !Mesh->GetMaterials()[Slot].MaterialSlotName.ToString().Contains(TEXT("Sleeve")))
+		{
+			Hands->SetMaterial(Slot, Skin);
+		}
+	}
+	Hands->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	Hands->SetCastShadow(true);
+	Hands->bCastDynamicShadow = true;
+	// The bounds follow the reference pose (arms at the sides, a metre up); the posed hands are elsewhere in front of the seat.
+	Hands->SetBoundsScale(20.f);
+	Hands->SetupAttachment(Owner.GetRootComponent());
+	Hands->RegisterComponent();
+	Owner.AddInstanceComponent(Hands);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK player hands on %s skin=%s bones=%d"), *Owner.GetName(), SkinName, Mesh->GetRefSkeleton().GetNum());
+	return Hands;
+}
+
+void PlayerHandsLook::Pose(UPoseableMeshComponent& Mesh, const FHandFrame* Left, const FHandFrame* Right)
+{
+	const USkeletalMesh* Asset = Cast<USkeletalMesh>(Mesh.GetSkinnedAsset());
+	if (!Asset)
+	{
+		return;
+	}
+	const FRest Rest = RestOf(*Asset);
+	PoseSide(Mesh, Rest, TEXT("l"), Left);
+	PoseSide(Mesh, Rest, TEXT("r"), Right);
+	Mesh.MarkRefreshTransformDirty();
+}
+
+FHandFrame PlayerHandsLook::Mirrored(const FHandFrame& Frame)
+{
+	FHandFrame Out = Frame;
+	Out.Hand = Frame.Hand == EControllerHand::Left ? EControllerHand::Right : EControllerHand::Left;
+	for (FHandJointPose& Pose : Out.Joints)
+	{
+		Pose.Location.Y = -Pose.Location.Y;
+		Pose.Rotation = FQuat(-Pose.Rotation.X, Pose.Rotation.Y, -Pose.Rotation.Z, Pose.Rotation.W);
+	}
+	return Out;
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.h b/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.h
new file mode 100644
index 0000000..e063278
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/PlayerHandsLook.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+class AActor;
+class UPoseableMeshComponent;
+struct FHandFrame;
+
+/**
+ * The player's skinned hands under the non-flat looks (graphics push 10-28, shared hero asset; flat keeps the T59
+ * mannequin). SK_PlayerHands (Tools/CreatePlayerHandsCommandlet, MPFB base mesh: both forearms with dark sleeves, three
+ * bones per finger and thumb) is posed every frame from the same 26-joint HandFrame the gesture pipeline reads: each
+ * bone is placed at its joint and turned so its rest direction (to its child joint) and the palm normal map onto the
+ * live ones. Rotation conventions of the rig or the tracker never enter, only joint positions.
+ */
+namespace PlayerHandsLook
+{
+/** /Game/Look/Shared/Hands. */
+FString Folder();
+
+/**
+ * A poseable SK_PlayerHands on Owner's root (the space the mannequin layers draw in), with M_PlayerHandsEpic under the
+ * epic look and M_PlayerHandsLite under quest. Null under flat, under -nullrhi, or when the asset is missing.
+ */
+UPoseableMeshComponent* Create(AActor& Owner);
+
+/** Poses both forearms; a side whose frame is null folds away (scaled to nothing). Frames are in Owner-root space, cm. */
+void Pose(UPoseableMeshComponent& Mesh, const FHandFrame* Left, const FHandFrame* Right);
+
+/** The other hand, mirrored across the seat's vertical plane (Y -> -Y). The S1 shot's second hand, never gameplay. */
+FHandFrame Mirrored(const FHandFrame& Frame);
+}
