+// Generated by apps/vr/art/crowd-painted/pack_crowd.py: T_CrowdPainted's cells, five per T57 crowd variant, in the
+// T57 table's order and card aspect. u0, v0, u1, v1, v up from the atlas bottom.
+
+namespace CrowdPaintedAtlas
+{
+inline constexpr int32 CellsPerVariant = 5;
+inline constexpr double Cells[4][5][4] = {
+    // SeatedCalm
+    {{0.000000, 0.750000, 0.130859, 1.000000}, {0.134766, 0.750000, 0.265625, 1.000000}, {0.269531, 0.750000, 0.400391, 1.000000}, {0.404297, 0.750000, 0.535156, 1.000000}, {0.539062, 0.750000, 0.669922, 1.000000}},
+    // SeatedLean
+    {{0.000000, 0.500000, 0.142578, 0.750000}, {0.146484, 0.500000, 0.289062, 0.750000}, {0.292969, 0.500000, 0.435547, 0.750000}, {0.439453, 0.500000, 0.582031, 0.750000}, {0.585938, 0.500000, 0.728516, 0.750000}},
+    // StandingCheer
+    {{0.000000, 0.250000, 0.107422, 0.500000}, {0.111328, 0.250000, 0.218750, 0.500000}, {0.222656, 0.250000, 0.330078, 0.500000}, {0.333984, 0.250000, 0.441406, 0.500000}, {0.445312, 0.250000, 0.552734, 0.500000}},
+    // StandingPoint
+    {{0.000000, 0.000000, 0.149902, 0.250000}, {0.153809, 0.000000, 0.303711, 0.250000}, {0.307617, 0.000000, 0.457520, 0.250000}, {0.461426, 0.000000, 0.611328, 0.250000}, {0.615234, 0.000000, 0.765137, 0.250000}},
