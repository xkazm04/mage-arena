+++ b/apps/vr/Game/Source/MageArenaVR/Look/RivalBackdrop.cpp
@@ -0,0 +1,42 @@
+#include "Look/RivalBackdrop.h"
+
+#include "Components/InstancedStaticMeshComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Greybox/ArenaLayout.h"
+#include "Greybox/GreyboxUtil.h"
+#include "Look/ArenaLook.h"
+#include "Look/QuestLook.h"
+#include "MageArenaVR.h"
+
+void RivalBackdrop::Build(AActor& Owner, const FArenaLayout& Layout)
+{
+	if (ArenaLook::IsFlat())
+	{
+		return;
+	}
+	UStaticMesh* Cube = Greybox::LoadShape(TEXT("Cube"));
+	UMaterialInterface* Recess = Greybox::Tint(Greybox::UnlitOpaqueMaterial(), &Owner, FLinearColor(0.018f, 0.013f, 0.011f));
+	UMaterialInterface* Stone = QuestLook::Surface(QuestLook::ESurface::Pylon);
+	if (!Cube || !Recess || !Stone)
+	{
+		return;
+	}
+	const auto Cm = [](const FVector& Metres)
+	{ return Metres * 100.0; };
+	const double FaceX = Layout.FloorRadiusXM;
+	// One plain mesh: the engine's unlit material has no instanced usage.
+	if (UStaticMeshComponent* Gate = Greybox::MakeMesh(&Owner, Cube, Recess))
+	{
+		Greybox::SetSized(Gate, Cm(FVector(0.12, 2.6, 2.7)));
+		Gate->SetWorldLocation(Cm(FVector(FaceX - 0.04, 0.0, 1.35)));
+		Gate->SetCastShadow(false);
+	}
+	if (UInstancedStaticMeshComponent* Frame = Greybox::MakeInstances(&Owner, Cube, Stone))
+	{
+		Greybox::AddSized(Frame, Cm(FVector(FaceX - 0.12, 0.0, 2.85)), FQuat::Identity, Cm(FVector(0.3, 3.3, 0.36)));
+		Greybox::AddSized(Frame, Cm(FVector(FaceX - 0.12, -1.5, 1.35)), FQuat::Identity, Cm(FVector(0.3, 0.32, 2.7)));
+		Greybox::AddSized(Frame, Cm(FVector(FaceX - 0.12, 1.5, 1.35)), FQuat::Identity, Cm(FVector(0.3, 0.32, 2.7)));
+		Frame->SetCastShadow(true);
+	}
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK rival backdrop gate at x=%.1f m"), FaceX);
+}
