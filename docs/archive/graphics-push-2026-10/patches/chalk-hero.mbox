+	if (QuestLook::IsActive())
+	{
+		if (UMaterialInterface* Quest = QuestLook::Surface(Surface))
+		{
+			return Quest;
+		}
+	}
+	return Greybox::Tint(Basic, Owner, Colour);
+}
 }
 
