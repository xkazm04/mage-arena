+	// S1's hands are warm and tanned; one tan multiply for both looks (the quest light and the epic skin profile both
+	// read the albedo pale), so the tiers stay alike. -MageArenaHandTint=r,g,b overrides it.
+	FLinearColor Tan(0.86f, 0.72f, 0.60f);
+	FString TintArg;
+	if (FParse::Value(FCommandLine::Get(), TEXT("MageArenaHandTint="), TintArg))
+	{
+		TArray<FString> Parts;
+		TintArg.ParseIntoArray(Parts, TEXT(","));
+		if (Parts.Num() == 3)
+		{
+			Tan = FLinearColor(FCString::Atof(*Parts[0]), FCString::Atof(*Parts[1]), FCString::Atof(*Parts[2]));
+		}
+	}
+	UMaterialInstanceDynamic* Tinted = Skin ? UMaterialInstanceDynamic::Create(Skin, Hands) : nullptr;
+	if (Tinted)
+	{
+		Tinted->SetVectorParameterValue(TEXT("SkinTint"), Tan);
+	}
 	for (int32 Slot = 0; Slot < Hands->GetNumMaterials(); ++Slot)
 	{
-		if (Skin && !Mesh->GetMaterials()[Slot].MaterialSlotName.ToString().Contains(TEXT("Sleeve")))
+		if (Tinted && !Mesh->GetMaterials()[Slot].MaterialSlotName.ToString().Contains(TEXT("Sleeve")))
 		{
-			Hands->SetMaterial(Slot, Skin);
+			Hands->SetMaterial(Slot, Tinted);
 		}
 	}
 	Hands->SetCollisionEnabled(ECollisionEnabled::NoCollision);
