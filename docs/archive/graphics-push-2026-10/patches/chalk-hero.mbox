diff --git a/apps/vr/art/characters/brennic/sprite/pack_atlas.py b/apps/vr/art/characters/brennic/sprite/pack_atlas.py
new file mode 100644
index 0000000..a6a308d
--- /dev/null
+++ b/apps/vr/art/characters/brennic/sprite/pack_atlas.py
@@ -0,0 +1,108 @@
+"""2.5D spike S2: pack Brennic's repainted clips into one 4096x4096 flipbook page of 256 px cells (16 x 16).
+
+python pack_atlas.py <gen_dir> <out_png> [--fps 24]
+  <gen_dir>/rig/<Clip>/f_####.png      the rig render (RGBA, 30 fps): its alpha bounds the matte
+  <gen_dir>/v2v/<Clip>/f_####.png      the repaint (RGB, 30 fps, same framing)
+  <gen_dir>/matte/<Clip>/m_####.png    the BiRefNet matte of the repaint
+Each clip starts on a new row; frames are resampled from 30 fps to --fps over the rig clip's own length. Colour per frame
+is matched to the clip's first frame (Lab mean/std on the figure) to damp flicker. Writes <out_png> and <out_png>.json
+(per clip: first cell, frame count, fps) plus a contact sheet per clip and the flicker figures.
+The cell covers the rig camera's 2.4 m frame: feet 0.2 m above the cell's bottom, at 16 m from the seat eye.
+"""
+import json, os, sys
+import numpy as np
+from PIL import Image, ImageFilter
+
+CLIPS = ["Idle", "Cast", "Hit", "Death"]
+CELL, COLS = 256, 16
+
+
+def rgb2lab(a):
+    a = a / 255.0
+    a = np.where(a > 0.04045, ((a + 0.055) / 1.055) ** 2.4, a / 12.92)
+    m = np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]])
+    xyz = a @ m.T / np.array([0.9505, 1.0, 1.089])
+    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
+    return np.stack([116 * f[..., 1] - 16, 500 * (f[..., 0] - f[..., 1]), 200 * (f[..., 1] - f[..., 2])], -1)
+
+
+def lab2rgb(l):
+    fy = (l[..., 0] + 16) / 116
+    fx, fz = fy + l[..., 1] / 500, fy - l[..., 2] / 200
+    f = np.stack([fx, fy, fz], -1)
+    xyz = np.where(f > 0.2069, f ** 3, (f - 16 / 116) / 7.787) * np.array([0.9505, 1.0, 1.089])
+    m = np.linalg.inv(np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]]))
+    a = np.clip(xyz @ m.T, 0, 1)
+    a = np.where(a > 0.0031308, 1.055 * a ** (1 / 2.4) - 0.055, a * 12.92)
+    return np.clip(a * 255, 0, 255)
+
+
+def main():
+    gen, out = sys.argv[1], sys.argv[2]
+    fps = int(sys.argv[sys.argv.index("--fps") + 1]) if "--fps" in sys.argv else 24
+    page = Image.new("RGBA", (CELL * COLS, CELL * COLS), (0, 0, 0, 0))
+    meta = {"cell_px": CELL, "cols": COLS, "fps": fps, "cell_m": 2.4, "foot_m": 0.2, "clips": {}}
+    row = 0
+    for clip in CLIPS:
+        rig_dir, v_dir, m_dir = (os.path.join(gen, k, clip) for k in ("rig", "v2v", "matte"))
+        n_rig = len([f for f in os.listdir(rig_dir) if f.endswith(".png")])
+        n_v = len([f for f in os.listdir(v_dir) if f.endswith(".png")])
+        # A loop's last rig frame repeats its first: Idle packs the span without it.
+        count = round((n_rig - 1) / 30.0 * fps) if clip == "Idle" else max(1, round((n_rig - 1) / 30.0 * fps) + 1)
+        cells, flick, ref = [], [], None
+        prev_lo = None
+        for k in range(count):
+            src = min(round(k * 30.0 / fps), n_rig - 1, n_v - 1)
+            rgb = np.asarray(Image.open(os.path.join(v_dir, "f_%04d.png" % src)).convert("RGB"), dtype=np.float64)
+            size = rgb.shape[1], rgb.shape[0]
+            rig_a = Image.open(os.path.join(rig_dir, "f_%04d.png" % min(src, n_rig - 1))).getchannel("A").resize(size)
+            bound = np.asarray(rig_a.filter(ImageFilter.MaxFilter(13)).filter(ImageFilter.GaussianBlur(3)), dtype=np.float64) / 255.0
+            matte = np.asarray(Image.open(os.path.join(m_dir, "m_%04d.png" % src)).convert("L").resize(size), dtype=np.float64) / 255.0
+            alpha = np.clip(matte * np.clip(bound * 1.5, 0, 1), 0, 1)
+            fig = alpha > 0.5
+            lab = rgb2lab(rgb)
+            if ref is None:
+                ref = (lab[fig].mean(0), lab[fig].std(0) + 1e-3)
+            else:
+                mu, sd = lab[fig].mean(0), lab[fig].std(0) + 1e-3
+                lab = (lab - mu) / sd * ref[1] + ref[0]
+                rgb = lab2rgb(lab)
+            # Flicker: mean change of the blurred, matted figure between frames (motion included), 0..255.
+            lo = np.asarray(Image.fromarray((rgb * alpha[..., None]).astype(np.uint8)).resize((96, 96), Image.BILINEAR), dtype=np.float64)
+            if prev_lo is not None:
+                flick.append(float(np.abs(lo - prev_lo).mean()))
+            prev_lo = lo
+            # Bleed colour into the clear area so mips never pull in black fringes.
+            rgba = Image.fromarray(np.dstack([rgb, alpha * 255]).astype(np.uint8), "RGBA")
+            cell = rgba.resize((CELL, CELL), Image.LANCZOS)
+            cells.append(cell)
+        start = row * COLS
+        for k, cell in enumerate(cells):
+            i = start + k
+            page.paste(cell, ((i % COLS) * CELL, (i // COLS) * CELL))
+        meta["clips"][clip] = {"first": start, "count": count, "rig_frames_30fps": n_rig, "flicker_mean": round(float(np.mean(flick)) if flick else 0.0, 2)}
+        sheet = Image.new("RGB", (CELL * 8, CELL * ((count + 7) // 8)), (40, 40, 42))
+        for k, cell in enumerate(cells):
+            bg = Image.new("RGBA", cell.size, (40, 40, 42, 255)); bg.alpha_composite(cell)
+            sheet.paste(bg.convert("RGB"), ((k % 8) * CELL, (k // 8) * CELL))
+        sheet.save(os.path.splitext(out)[0] + f"-sheet-{clip}.png")
+        row += (count + COLS - 1) // COLS
+        print(clip, "first", start, "count", count, "flicker", meta["clips"][clip]["flicker_mean"])
+    if row > COLS:
+        raise SystemExit(f"page overflow: {row} rows")
+    # Edge bleed: fill transparent texels with their neighbours' colour (alpha untouched).
+    a = np.asarray(page, dtype=np.float64)
+    rgb, al = a[..., :3], a[..., 3:] / 255.0
+    acc, w = rgb * al, al.copy()
+    for _ in range(4):
+        acc = np.asarray(Image.fromarray(np.clip(acc, 0, 255).astype(np.uint8)).filter(ImageFilter.BoxBlur(2)), dtype=np.float64)
+        w = np.asarray(Image.fromarray((np.clip(w[..., 0], 0, 1) * 255).astype(np.uint8)).filter(ImageFilter.BoxBlur(2)), dtype=np.float64)[..., None] / 255.0
+    fill = np.where(w > 1e-3, acc / np.maximum(w, 1e-3), 0)
+    outrgb = np.where(al > 0.02, rgb, np.clip(fill, 0, 255))
+    Image.fromarray(np.dstack([outrgb, a[..., 3]]).astype(np.uint8), "RGBA").save(out)
+    meta["rows_used"] = row
+    json.dump(meta, open(out + ".json", "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/apps/vr/art/characters/brennic/sprite/pack_fire.py b/apps/vr/art/characters/brennic/sprite/pack_fire.py
new file mode 100644
index 0000000..32ca683
--- /dev/null
+++ b/apps/vr/art/characters/brennic/sprite/pack_fire.py
@@ -0,0 +1,58 @@
+"""2.5D spike S2: the fire flipbook from an LTX-2.5 image-to-video clip of a chalk fireball on black.
+
+python pack_fire.py <frames_dir> <out_png> [--frames 64] [--cell 256] [--fade 8]
+Finds the frame pair at least --frames apart that matches best (L2 on 64 px greyscale), cuts the loop there, and
+crossfades its last --fade frames into its first so the seam closes. Resamples the loop to --frames cells, crushes the
+black floor (rgb' = max(rgb - b0, 0) / (1 - b0), b0 = 0.04: additive RGB on black is the emission, no alpha), and packs a
+square grid that fills the page (8 x 8 of 256 px = 2048; the material divides the page by its Cols and Rows) with a contact sheet and a json of the loop.
+"""
+import json, os, sys
+import numpy as np
+from PIL import Image
+
+
+def arg(name, default):
+    return type(default)(sys.argv[sys.argv.index(name) + 1]) if name in sys.argv else default
+
+
+def main():
+    src, out = sys.argv[1], sys.argv[2]
+    n_out, cell, fade, b0 = arg("--frames", 64), arg("--cell", 256), arg("--fade", 8), 0.04
+    files = sorted(f for f in os.listdir(src) if f.endswith(".png"))
+    frames = [np.asarray(Image.open(os.path.join(src, f)).convert("RGB"), dtype=np.float64) / 255.0 for f in files]
+    small = [np.asarray(Image.fromarray((f * 255).astype(np.uint8)).convert("L").resize((64, 64)), dtype=np.float64) for f in frames]
+    n, gap = len(frames), n_out  # a loop at least as long as its cells: never stretched
+    best = None
+    for a in range(fade, n - gap):  # room before the head for the crossfade
+        for b in range(a + gap, n):
+            d = float(np.mean((small[a] - small[b]) ** 2))
+            if best is None or d < best[0]:
+                best = (d, a, b)
+    _, a, b = best
+    loop = frames[a:b]
+    # Crossfade: the loop's tail blends into the frames just before its head, so frame b-1 leads into frame a.
+    k = min(fade, len(loop) // 3, a)
+    for i in range(k):
+        w = (i + 1) / (k + 1)
+        loop[len(loop) - k + i] = loop[len(loop) - k + i] * (1 - w) + frames[a - k + i] * w
+    grid = int(np.ceil(np.sqrt(n_out)))
+    side = 1 << int(np.ceil(np.log2(grid * cell)))
+    page = Image.new("RGB", (side, side), (0, 0, 0))
+    cells = []
+    for i in range(n_out):
+        f = loop[min(int(i * len(loop) / n_out), len(loop) - 1)]
+        f = np.clip((f - b0) / (1 - b0), 0, 1)
+        im = Image.fromarray((f * 255).astype(np.uint8)).resize((cell, cell), Image.LANCZOS)
+        cells.append(im)
+        page.paste(im, ((i % grid) * cell, (i // grid) * cell))
+    page.save(out)
+    sheet = Image.new("RGB", (cell * 9 // 2, cell // 2 * ((n_out + 8) // 9)))
+    for i, im in enumerate(cells):
+        sheet.paste(im.resize((cell // 2, cell // 2)), ((i % 9) * cell // 2, (i // 9) * cell // 2))
+    sheet.save(os.path.splitext(out)[0] + "-sheet.png")
+    json.dump({"src": src, "frames_in": n, "loop": [a, b], "loop_l2": round(best[0], 2), "fade": k, "cells": n_out, "grid": grid, "cell_px": cell, "page_px": side, "b0": b0}, open(out + ".json", "w"), indent=1)
+    print("loop", a, b, "l2", round(best[0], 2), "cells", n_out, "grid", grid, "page", side)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/apps/vr/art/characters/brennic/sprite/render_clips.py b/apps/vr/art/characters/brennic/sprite/render_clips.py
new file mode 100644
index 0000000..e0b0515
--- /dev/null
+++ b/apps/vr/art/characters/brennic/sprite/render_clips.py
@@ -0,0 +1,85 @@
+# 2.5D spike S2: render Brennic's game clips (Idle, Cast = CastLunge under chalk, Hit, Death) from the seat camera, locked
+# off, as the driving video for the repaint. The motion and timing are the game's own; only the paint is generated.
+# blender -b -P render_clips.py -- <SK_Brennic.fbx> <A_Brennic_CastLunge.fbx> <T_BrennicChalk_BaseColor.png> <outdir> [res]
+# Writes <outdir>/<Clip>/f_####.png (RGBA, transparent background, 30 fps, the FBX's own frame rate) and clips.json.
+import bpy, sys, os, math, json, mathutils
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+fbx, lunge, albedo, out = argv[:4]
+res = int(argv[4]) if len(argv) > 4 else 768
+os.makedirs(out, exist_ok=True)
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=fbx)
+arm = [o for o in bpy.data.objects if o.type == 'ARMATURE'][0]
+meshes = [o for o in bpy.data.objects if o.type == 'MESH']
+base_actions = {a.name.split('|')[-1]: a for a in bpy.data.actions}
+print("ACTIONS", list(base_actions))
+before = set(bpy.data.actions)
+bpy.ops.import_scene.fbx(filepath=lunge)
+lunge_actions = [a for a in bpy.data.actions if a not in before]
+# The lunge FBX brings its own armature and mesh: keep only its action.
+for o in list(bpy.data.objects):
+    if o not in meshes and o != arm:
+        bpy.data.objects.remove(o, do_unlink=True)
+print("LUNGE", [a.name for a in lunge_actions])
+
+img = bpy.data.images.load(albedo)
+mat = bpy.data.materials.new("M_Chalk")
+mat.use_nodes = True
+nt = mat.node_tree
+bsdf = nt.nodes["Principled BSDF"]
+tex = nt.nodes.new("ShaderNodeTexImage"); tex.image = img
+nt.links.new(tex.outputs["Color"], bsdf.inputs["Base Color"])
+bsdf.inputs["Roughness"].default_value = 0.85
+# The chalk albedo is laid out for the engine's UVs; the repaint wants clean value blocks, so by default the FBX's own
+# six flat materials stay (BR_ALBEDO=1 swaps in the albedo).
+if os.environ.get("BR_ALBEDO") == "1":
+    for o in meshes:
+        o.data.materials.clear(); o.data.materials.append(mat)
+
+scn = bpy.context.scene
+engines = [e.identifier for e in bpy.types.RenderSettings.bl_rna.properties['engine'].enum_items]
+scn.render.engine = 'BLENDER_EEVEE' if 'BLENDER_EEVEE' in engines else 'BLENDER_EEVEE_NEXT'
+scn.render.resolution_x = res; scn.render.resolution_y = res
+scn.render.film_transparent = True
+scn.render.image_settings.file_format = 'PNG'; scn.render.image_settings.color_mode = 'RGBA'
+scn.view_settings.view_transform = 'Standard'
+scn.world = bpy.data.worlds.new("W"); scn.world.use_nodes = True
+scn.world.node_tree.nodes["Background"].inputs[0].default_value = (0.5, 0.48, 0.46, 1)
+scn.world.node_tree.nodes["Background"].inputs[1].default_value = 0.7
+# Warm key from the front, high left (S30-KEY's firelit front), a cool rim from behind.
+key = bpy.data.objects.new("Key", bpy.data.lights.new("Key", 'SUN')); scn.collection.objects.link(key)
+key.data.energy = 3.2; key.data.color = (1.0, 0.86, 0.7)
+key.rotation_euler = mathutils.Vector((14.0, 6.0, 9.0)).to_track_quat('Z', 'Y').to_euler()
+rim = bpy.data.objects.new("Rim", bpy.data.lights.new("Rim", 'SUN')); scn.collection.objects.link(rim)
+rim.data.energy = 1.6; rim.data.color = (0.75, 0.82, 1.0)
+rim.rotation_euler = mathutils.Vector((-10.0, -4.0, 6.0)).to_track_quat('Z', 'Y').to_euler()
+
+# The seat eye: 16 m out along his facing (+X), 1.9 m up, aimed at his middle. Frame 2.4 m tall (the cell): feet 0.2 m above its bottom.
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam")); scn.collection.objects.link(cam); scn.camera = cam
+dist, eye_h, aim_h, frame_m = 16.0, 1.9, 1.0, 2.4
+cam.location = (dist, 0.0, eye_h)
+cam.rotation_euler = (mathutils.Vector((0.0, 0.0, aim_h)) - cam.location).to_track_quat('-Z', 'Y').to_euler()
+cam.data.sensor_fit = 'VERTICAL'
+cam.data.angle = 2.0 * math.atan(frame_m * 0.5 / dist)
+
+clips = {"Idle": base_actions.get("Idle"), "Cast": lunge_actions[0] if lunge_actions else base_actions.get("Cast"), "Hit": base_actions.get("Hit"), "Death": base_actions.get("Death")}
+if not arm.animation_data:
+    arm.animation_data_create()
+for t in arm.animation_data.nla_tracks:
+    t.mute = True
+scn.render.fps = 30
+meta = {"fps": 30, "res": res, "camera": {"dist_m": dist, "eye_h_m": eye_h, "aim_h_m": aim_h, "frame_m": frame_m}, "clips": {}}
+for name, action in clips.items():
+    arm.animation_data.action = action
+    if hasattr(arm.animation_data, "action_slot") and action.slots:
+        arm.animation_data.action_slot = action.slots[0]
+    f0, f1 = (int(round(x)) for x in action.frame_range)
+    d = os.path.join(out, name); os.makedirs(d, exist_ok=True)
+    for i, f in enumerate(range(f0, f1 + 1)):
+        scn.frame_set(f)
+        scn.render.filepath = os.path.join(d, "f_%04d.png" % i)
+        bpy.ops.render.render(write_still=True)
+    meta["clips"][name] = {"action": action.name, "frames": f1 - f0 + 1}
+    print("CLIP", name, action.name, f1 - f0 + 1)
+json.dump(meta, open(os.path.join(out, "clips.json"), "w"), indent=1)
