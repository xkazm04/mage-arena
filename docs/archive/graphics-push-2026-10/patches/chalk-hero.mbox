diff --git a/apps/vr/art/hands/hands_paint.py b/apps/vr/art/hands/hands_paint.py
new file mode 100644
index 0000000..5bff9c3
--- /dev/null
+++ b/apps/vr/art/hands/hands_paint.py
@@ -0,0 +1,266 @@
+"""Painted hands (round 2 of the chalk hero): Flux 2 repaints of light-neutral views of SK_PlayerHands, projected back
+onto the hands' own UVs (research report, pipeline D).
+
+blender -b -P hands_paint.py -- views   <export_dir> <out_dir> [res]
+    Renders each hand from VIEWS (orthographic, world light only, the regional skin albedo) to <out_dir>/view_<hand>_<name>.png
+    with its depth (<...>_z.exr) and writes <out_dir>/views.json (camera position, axes, ortho scale per view).
+blender -b -P hands_paint.py -- project <export_dir> <out_dir> <painted_dir> [res]
+    Bakes texel position and normal on HandsUV, and for every view whose repaint <painted_dir>/view_<hand>_<name>.png exists
+    projects it onto the texels that view sees (depth test) with weight cos^2(normal, view), feathered at the frame edge.
+    Skin texels no view reaches, and the sleeves, keep the drawn chalk albedo (T_PlayerHandsChalkDrawn_BaseColor.png, hero-7).
+    Writes <out_dir>/T_PlayerHandsPainted_BaseColor.png and coverage.png.
+"""
+import json
+import math
+import os
+import sys
+
+import bpy
+import mathutils
+import numpy as np
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+MODE, EXPORT, OUT = argv[0], argv[1], argv[2]
+PAINTED = argv[3] if MODE == "project" else None
+RES = int(argv[4 if MODE == "project" else 3]) if len(argv) > (4 if MODE == "project" else 3) else 2048
+VIEW_PX = 768
+os.makedirs(OUT, exist_ok=True)
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=os.path.join(EXPORT, "SK_PlayerHands.fbx"))
+arm = [o for o in bpy.data.objects if o.type == 'ARMATURE'][0]
+body = [o for o in bpy.data.objects if o.type == 'MESH'][0]
+uv_name = "HandsUV" if "HandsUV" in body.data.uv_layers else body.data.uv_layers.active.name
+body.data.uv_layers.active = body.data.uv_layers[uv_name]
+scn = bpy.context.scene
+deps = bpy.context.evaluated_depsgraph_get()
+
+
+def bone_head(name):
+    return arm.matrix_world @ arm.data.bones[name].head_local
+
+
+def hand_frame(side):
+    wrist = bone_head(f"hand_{side}")
+    tips = [bone_head(f"{f}_03_{side}") for f in ("index", "middle", "ring", "pinky")]
+    knuckles = [bone_head(f"{f}_01_{side}") for f in ("index", "middle", "ring", "pinky")]
+    centre = (wrist + sum(tips, mathutils.Vector()) / 4) * 0.5
+    along = (sum(tips, mathutils.Vector()) / 4 - wrist).normalized()
+    across = (knuckles[0] - knuckles[3]).normalized()  # pinky -> index
+    palm = along.cross(across).normalized()
+    # The palm faces the thumb side's cross product one way on each hand: make it point away from the back of the hand,
+    # toward where the thumb tip curls (the thumb sits on the palm side of the knuckle line).
+    thumb = bone_head(f"thumb_03_{side}")
+    if (thumb - centre).dot(palm) < 0:
+        palm = -palm
+    across = palm.cross(along).normalized()
+    return centre, along, across, palm
+
+
+# (name, direction the camera looks FROM, in the hand frame: along, across, palm)
+VIEWS = [
+    ("dorsal", (0.0, 0.0, -1.0)),
+    ("palmar", (0.0, 0.0, 1.0)),
+    ("radial", (0.0, 1.0, 0.0)),
+    ("ulnar", (0.0, -1.0, 0.0)),
+    ("tips", (1.0, 0.0, -0.45)),
+    ("dorsal_wrist", (-0.6, 0.0, -1.0)),
+]
+
+
+def setup_render():
+    engines = [e.identifier for e in bpy.types.RenderSettings.bl_rna.properties['engine'].enum_items]
+    scn.render.engine = 'BLENDER_EEVEE' if 'BLENDER_EEVEE' in engines else 'BLENDER_EEVEE_NEXT'
+    scn.render.resolution_x = scn.render.resolution_y = VIEW_PX
+    scn.view_settings.view_transform = 'Standard'
+    scn.world = bpy.data.worlds.new("W")
+    scn.world.use_nodes = True
+    scn.world.node_tree.nodes["Background"].inputs[0].default_value = (1, 1, 1, 1)
+    scn.world.node_tree.nodes["Background"].inputs[1].default_value = 1.0
+
+
+def albedo_material():
+    img = bpy.data.images.load(os.path.join(EXPORT, "T_PlayerHands_BaseColor.png"))
+    mat = bpy.data.materials.new("Neutral")
+    mat.use_nodes = True
+    nt = mat.node_tree
+    bsdf = nt.nodes["Principled BSDF"]
+    uvn = nt.nodes.new("ShaderNodeUVMap"); uvn.uv_map = uv_name
+    tex = nt.nodes.new("ShaderNodeTexImage"); tex.image = img
+    nt.links.new(uvn.outputs[0], tex.inputs[0])
+    nt.links.new(tex.outputs["Color"], bsdf.inputs["Base Color"])
+    bsdf.inputs["Roughness"].default_value = 1.0
+    return mat
+
+
+def depth_material():
+    mat = bpy.data.materials.new("Depth")
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for n in list(nt.nodes):
+        nt.nodes.remove(n)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    cam = nt.nodes.new("ShaderNodeCameraData")
+    nt.links.new(cam.outputs["View Z Depth"], em.inputs["Strength"])
+    em.inputs["Color"].default_value = (1, 1, 1, 1)
+    nt.links.new(em.outputs[0], out.inputs[0])
+    return mat
+
+
+def place_camera(cam, side, view):
+    centre, along, across, palm = hand_frame(side)
+    a, c, p = view[1]
+    d = (along * a + across * c + palm * p).normalized()
+    pos = centre + d * 1.0
+    cam.location = pos
+    # Roll so the fingers point up in the frame where possible.
+    up = along if abs(d.dot(along)) < 0.9 else palm
+    m = mathutils.Matrix.Identity(3)
+    z = d
+    x = up.cross(z).normalized()
+    y = z.cross(x).normalized()
+    m.col[0], m.col[1], m.col[2] = x, y, z
+    cam.rotation_euler = m.to_euler()
+    cam.data.type = 'ORTHO'
+    cam.data.ortho_scale = 0.27
+    cam.data.clip_start, cam.data.clip_end = 0.01, 3.0
+    return {"pos": list(pos), "x": list(x), "y": list(y), "z": list(z), "ortho": cam.data.ortho_scale}
+
+
+if MODE == "views":
+    setup_render()
+    cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam")); scn.collection.objects.link(cam); scn.camera = cam
+    alb, dep = albedo_material(), depth_material()
+    meta = {}
+    for side in ("r", "l"):
+        for view in VIEWS:
+            key = f"view_{side}_{view[0]}"
+            meta[key] = place_camera(cam, side, view)
+            body.data.materials.clear(); body.data.materials.append(alb)
+            scn.render.film_transparent = False
+            scn.render.image_settings.file_format = 'PNG'; scn.render.image_settings.color_mode = 'RGB'
+            scn.world.node_tree.nodes["Background"].inputs[0].default_value = (1, 1, 1, 1)
+            scn.render.filepath = os.path.join(OUT, key + ".png")
+            bpy.ops.render.render(write_still=True)
+            body.data.materials.clear(); body.data.materials.append(dep)
+            scn.world.node_tree.nodes["Background"].inputs[0].default_value = (0, 0, 0, 1)
+            scn.view_settings.view_transform = 'Raw' if 'Raw' in [t.identifier for t in bpy.types.ColorManagedViewSettings.bl_rna.properties['view_transform'].enum_items] else 'Standard'
+            scn.render.image_settings.file_format = 'OPEN_EXR'; scn.render.image_settings.color_mode = 'RGB'
+            scn.render.filepath = os.path.join(OUT, key + "_z.exr")
+            bpy.ops.render.render(write_still=True)
+            scn.view_settings.view_transform = 'Standard'
+    json.dump(meta, open(os.path.join(OUT, "views.json"), "w"), indent=1)
+    print("HANDS_PAINT views", len(meta))
+    sys.exit(0)
+
+# ---- project ----
+scn.render.engine = 'CYCLES'
+scn.cycles.device = 'CPU'
+
+
+def bake_geo(output, name):
+    img = bpy.data.images.new(name, RES, RES, alpha=True, float_buffer=True)
+    img.colorspace_settings.name = 'Non-Color'
+    mat = bpy.data.materials.new("Bake" + name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for nd in list(nt.nodes):
+        nt.nodes.remove(nd)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    geo = nt.nodes.new("ShaderNodeNewGeometry")
+    nt.links.new(geo.outputs[output], em.inputs[0])
+    nt.links.new(em.outputs[0], out.inputs[0])
+    tex = nt.nodes.new("ShaderNodeTexImage"); tex.image = img
+    nt.nodes.active = tex
+    body.data.materials.clear(); body.data.materials.append(mat)
+    for o in bpy.context.view_layer.objects:
+        o.select_set(o == body)
+    bpy.context.view_layer.objects.active = body
+    scn.cycles.samples = 1
+    bpy.ops.object.bake(type='EMIT', margin=4, use_clear=True, uv_layer=uv_name)
+    px = np.empty(RES * RES * 4, np.float32)
+    img.pixels.foreach_get(px)
+    return px.reshape(RES, RES, 4)
+
+
+def load_px(path):
+    img = bpy.data.images.load(path)
+    img.colorspace_settings.name = 'Non-Color'
+    w, h = img.size
+    px = np.empty(w * h * 4, np.float32)
+    img.pixels.foreach_get(px)
+    return px.reshape(h, w, 4)  # row 0 = bottom
+
+
+P = bake_geo("Position", "pos")
+N = bake_geo("Normal", "nrm")
+covered = P[..., 3] > 0.5
+N = N[..., :3] / np.maximum(np.linalg.norm(N[..., :3], axis=-1, keepdims=True), 1e-6)
+P = P[..., :3]
+old = load_px(os.path.join(EXPORT, "T_PlayerHandsChalkDrawn_BaseColor.png"))
+orm = load_px(os.path.join(EXPORT, "T_PlayerHands_ORM.png"))
+if old.shape[0] != RES:
+    raise SystemExit("chalk albedo and RES differ")
+skin = orm[..., 3] > 0.5
+meta = json.load(open(os.path.join(OUT, "views.json")))
+acc = np.zeros((RES, RES, 3), np.float64)
+wsum = np.zeros((RES, RES), np.float64)
+used = []
+for key, cam in meta.items():
+    path = os.path.join(PAINTED, key + ".png")
+    if not os.path.exists(path):
+        continue
+    paint = load_px(path)[..., :3]
+    zimg = load_px(os.path.join(OUT, key + "_z.exr"))[..., 0]
+    pos, x, y, z = (np.array(cam[k]) for k in ("pos", "x", "y", "z"))
+    half = cam["ortho"] * 0.5
+    rel = P - pos
+    u = (rel @ x) / half * 0.5 + 0.5
+    v = (rel @ y) / half * 0.5 + 0.5
+    depth = -(rel @ z)  # distance in front of the camera (it looks along -z)
+    ph, pw = paint.shape[:2]
+    ix = np.clip((u * (pw - 1)).round().astype(int), 0, pw - 1)
+    iy = np.clip((v * (ph - 1)).round().astype(int), 0, ph - 1)
+    inside = (u > 0.01) & (u < 0.99) & (v > 0.01) & (v < 0.99)
+    zs = zimg[iy, ix]
+    visible = inside & covered & skin & (depth <= zs + 0.0025)
+    facing = np.clip(N @ z, 0, 1)  # z points from the hand toward the camera
+    edge = np.clip(np.minimum.reduce([u, 1 - u, v, 1 - v]) / 0.08, 0, 1)
+    w = np.where(visible, facing ** 2 * edge, 0.0)
+    w = np.where(facing > 0.2, w, 0.0)
+    # The repaint's white background where an outline still misses the mesh by a pixel or two: never projected.
+    sample = paint[iy, ix]
+    w = np.where((sample.min(-1) > 0.86) & (sample.max(-1) - sample.min(-1) < 0.08), 0.0, w)
+    # The oblique views (fingertips, wrist) align worst after align_views.py (IoU about 0.75 against 0.92-0.96): they only
+    # fill what the main four views miss.
+    if key.endswith("_tips") or key.endswith("_dorsal_wrist"):
+        w *= 0.3
+    acc += sample.astype(np.float64) * w[..., None]
+    wsum += w
+    used.append(key)
+    print("HANDS_PAINT projected", key, "texels", int((w > 0).sum()))
+
+painted = acc / np.maximum(wsum, 1e-6)[..., None]
+# The repaints come out a little grey next to the drawn hero-7 skin: saturation x1.1 and a slightly warmer balance on what they
+# painted (display values).
+lum = (painted * np.array([0.2126, 0.7152, 0.0722])).sum(-1, keepdims=True)
+painted = np.clip((lum + (painted - lum) * 1.1) * np.array([1.05, 1.0, 0.95]), 0, 1)
+# Blend toward the old chalk albedo where the views reach thinly (seams between views stay soft).
+alpha = np.clip(wsum / 0.35, 0, 1)[..., None]
+old_lin = old[..., :3]
+res = np.where(skin[..., None], painted * alpha + old_lin * (1 - alpha), old_lin)
+res = np.concatenate([res, np.ones((RES, RES, 1))], -1).astype(np.float32)
+img = bpy.data.images.new("T_PlayerHandsPainted_BaseColor", RES, RES, alpha=True)
+img.colorspace_settings.name = 'Non-Color'
+img.pixels.foreach_set(res.ravel())
+img.filepath_raw = os.path.join(OUT, "T_PlayerHandsPainted_BaseColor.png")
+img.file_format = 'PNG'
+img.save()
+cov = np.repeat(np.clip(wsum, 0, 1)[..., None], 3, -1)
+cimg = bpy.data.images.new("coverage", RES, RES, alpha=True)
+cimg.colorspace_settings.name = 'Non-Color'
+cimg.pixels.foreach_set(np.concatenate([cov, np.ones((RES, RES, 1))], -1).astype(np.float32).ravel())
+cimg.filepath_raw = os.path.join(OUT, "coverage.png"); cimg.file_format = 'PNG'; cimg.save()
+print("HANDS_PAINT done views", used, "skin texels reached", float((wsum[skin] > 0).mean()))
-- 
