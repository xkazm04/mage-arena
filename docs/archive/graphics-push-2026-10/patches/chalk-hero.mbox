+# The chalk half of build_hands.py (Chalk & Slate, style 30), exec'd by build_hands.py after the painted bakes, in its
+# namespace: bake(), save(), albedo, ao, rough_px (G = skin mask), head, tail, pn, SIDES, FINGERS, RES. Writes
+# T_PlayerHandsChalk_BaseColor.png: warm pastel skin drawn in pencil and chalk (knuckle creases, the main knuckles'
+# outlines, veins on the backs of the hands and wrists, hatching in the shade, grain) and the short sleeves in slate-blue
+# cloth with chalk fold lines. Display values.
+
+
+def _wire_geo(output):
+    def wire(nt, sock):
+        g = nt.nodes.new("ShaderNodeNewGeometry")
+        nt.links.new(g.outputs[output], sock)
+    return wire
+
+
+Pt = bake('EMIT', _wire_geo("Position"), "chpos")[..., :3]
+Nt = bake('EMIT', _wire_geo("Normal"), "chnrm")[..., :3]
+Nt = Nt / np.maximum(np.linalg.norm(Nt, axis=-1, keepdims=True), 1e-6)
+skin_m = np.clip(rough_px[..., 1], 0, 1)
+sleeve_m = np.clip(1.0 - skin_m, 0, 1) * (albedo[..., 3] > 0.5)
+covered = albedo[..., 3] > 0.5
+rng_c = np.random.default_rng(3803)
+yy, xx = np.mgrid[0:RES, 0:RES].astype(np.float32)
+
+
+def _blur(a, k):
+    for _ in range(2):
+        a = sum(np.roll(a, s, 0) for s in range(-k, k + 1)) / (2 * k + 1)
+        a = sum(np.roll(a, s, 1) for s in range(-k, k + 1)) / (2 * k + 1)
+    return a
+
+
+def _v(x):
+    return np.array(list(x), np.float32)
+
+
+# Base: the painted regional skin, lifted toward a warm pastel (S30: light, warm, pencil-shaded skin).
+lin = np.clip(albedo[..., :3], 0, 1)
+srgb = np.where(lin <= 0.0031308, lin * 12.92, 1.055 * np.power(lin, 1 / 2.4) - 0.055)
+skin_col = srgb * 0.65 + np.array([0.95, 0.74, 0.57], np.float32) * 0.35
+lines = np.zeros((RES, RES), np.float32)      # dark pencil lines (0..1)
+for s in SIDES:
+    side = (Pt[..., 0] > 0) if s == "l" else (Pt[..., 0] <= 0)
+    palm_n = _v(pn[s])
+    facing = (Nt * palm_n).sum(-1)              # +1 palm, -1 back
+    back = np.clip(-facing * 2.0, 0, 1)
+    # Creases across each finger at its two inner joints (both sides), and the main knuckles' outlines on the back.
+    for f in FINGERS:
+        for j, nxt in (("02", "03"), ("03", None)):
+            J = _v(head[f"{f}_{j}_{s}"])
+            K = _v(head[f"{f}_{nxt}_{s}"]) if nxt else _v(tail[f"{f}_03_{s}"])
+            axis = (K - J) / max(np.linalg.norm(K - J), 1e-6)
+            plane = np.abs(((Pt - J) * axis).sum(-1))
+            near = np.linalg.norm(Pt - J, axis=-1) < 0.013
+            lines = np.maximum(lines, (plane < 0.0008) * near * side * 0.5)
+            lines = np.maximum(lines, (np.abs(plane - 0.0028) < 0.0005) * near * side * back * 0.25)
+        if f != "thumb":
+            J = _v(head[f"{f}_01_{s}"])
+            dist = np.linalg.norm(Pt - J, axis=-1)
+            lines = np.maximum(lines, (np.abs(dist - 0.0085) < 0.0007) * back * side * 0.4)
+    # Veins on the back of the hand and the wrist: three wavy lines from the wrist toward the knuckles, one up the arm.
+    W0 = _v(head[f"hand_{s}"])
+    K0 = _v(head[f"middle_01_{s}"])
+    a = (K0 - W0) / np.linalg.norm(K0 - W0)
+    b = np.cross(palm_n, a)
+    b = b / np.linalg.norm(b)
+    t = ((Pt - W0) * a).sum(-1) / np.linalg.norm(K0 - W0)
+    lat = ((Pt - W0) * b).sum(-1)
+    for k, (off, amp, ph) in enumerate(((-0.017, 0.003, 0.4), (0.001, 0.0035, 1.9), (0.016, 0.0028, 3.1))):
+        curve = off * (1.0 - 0.35 * np.clip(t, 0, 1)) + amp * np.sin(t * 7.5 + ph)
+        vein = (np.abs(lat - curve) < 0.0009) * (t > 0.08) * (t < 0.82) * back * side
+        lines = np.maximum(lines, vein * 0.26)
+    arm_vein = (np.abs(lat - (0.004 + 0.004 * np.sin(t * 3.0))) < 0.0013) * (t < -0.05) * (t > -1.4) * back * side
+    lines = np.maximum(lines, arm_vein * 0.2)
+
+# Pencil hatching in the shade: the form light from above and the front, the palms (facing down here) hatched.
+Lh = np.array([0.0, -0.45, 0.89], np.float32)
+form = np.clip((Nt * Lh).sum(-1) * 0.7 + 0.35, 0, 1) * (0.6 + 0.4 * np.clip(ao[..., 0], 0, 1))
+wob = _blur(rng_c.random((RES, RES)).astype(np.float32), 3)
+hatch = (np.mod((xx * 0.707 - yy * 0.707) / 4.5 + wob * 1.4, 1.0) < 0.35) * (_blur(rng_c.random((RES, RES)).astype(np.float32), 2) > 0.45)
+shade = np.clip((0.45 - form) / 0.3, 0, 1)
+gaps = _blur(rng_c.random((RES, RES)).astype(np.float32), 2) > 0.38
+line_ink = np.array([0.36, 0.20, 0.16], np.float32)
+skin_out = skin_col * (1.0 - 0.30 * (hatch * shade)[..., None])
+skin_out = skin_out * (1.0 - 0.18 * (1.0 - form))[..., None]
+skin_out = skin_out * (1 - (lines * gaps)[..., None]) + line_ink * (lines * gaps)[..., None]
+
+# The sleeve: slate-blue cloth with lighter chalk fold lines round it and a few darker hatches.
+sl_body = np.array([0.23, 0.28, 0.36], np.float32)
+sl_lit = np.array([0.36, 0.42, 0.52], np.float32)
+sleeve_col = np.where((form > 0.5)[..., None], sl_lit, sl_body)
+fold = (np.mod(Pt[..., 2] * 260.0 + wob * 2.2 + Pt[..., 0] * 40.0, 1.0) < 0.12) * gaps
+sleeve_col = sleeve_col * (1 - 0.6 * fold[..., None]) + np.array([0.78, 0.82, 0.86], np.float32) * 0.6 * fold[..., None]
+sleeve_col = sleeve_col * (1.0 - 0.35 * (hatch * shade)[..., None])
+
+out_c = np.where(skin_m[..., None] > 0.5, skin_out, sleeve_col)
+grain = rng_c.random((RES, RES)).astype(np.float32)
+out_c = np.clip(out_c * (0.88 + 0.22 * (0.6 * grain + 0.4 * _blur(grain, 1)))[..., None], 0, 1)
+out_c = np.where(covered[..., None], out_c, np.array([0.8, 0.62, 0.52], np.float32))
+chalk_rgba = np.concatenate([out_c, np.ones((RES, RES, 1), np.float32)], -1)
+save("T_PlayerHandsChalk_BaseColor.png", chalk_rgba, False)
