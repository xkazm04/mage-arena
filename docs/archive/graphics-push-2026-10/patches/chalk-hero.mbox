+	case ESpriteClip::Sunfall:
+		return FrameAt(ERivalClip::Cast, Count, Seconds, Lengths, Fps);
+	case ESpriteClip::Hit:
+		return FrameAt(ERivalClip::Hit, Count, Seconds, Lengths, Fps);
+	case ESpriteClip::Death:
