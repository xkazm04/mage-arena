+void QuestLook::PoseChalkCuff(UPoseableMeshComponent& Hands, UStaticMeshComponent*& Cuff)
+{
+	if (ArenaStyle::Current() != EArenaStyle::Chalk || !Hands.GetOwner())
+	{
+		return;
+	}
+	if (!Cuff)
+	{
+		UMaterialInterface* Bronze = LoadObject<UMaterialInterface>(nullptr, TEXT("/Game/Look/Quest/Chalk/M_Q_ChalkCuff.M_Q_ChalkCuff"), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		UStaticMesh* Cylinder = Greybox::LoadShape(TEXT("Cylinder"));
+		if (!Bronze || !Cylinder)
+		{
+			return;
+		}
+		Cuff = NewObject<UStaticMeshComponent>(Hands.GetOwner());
+		Cuff->SetStaticMesh(Cylinder);
+		Cuff->SetMaterial(0, Bronze);
+		Cuff->SetCastShadow(false);
+		Cuff->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+		Cuff->RegisterComponent();
+	}
+	// The forearm runs from lowerarm_l to hand_l; the band sits a little short of the wrist, along that axis.
+	const FVector Elbow = Hands.GetBoneLocationByName(TEXT("lowerarm_l"), EBoneSpaces::WorldSpace);
+	const FVector Wrist = Hands.GetBoneLocationByName(TEXT("hand_l"), EBoneSpaces::WorldSpace);
+	const FVector Axis = Wrist - Elbow;
+	if (Axis.SizeSquared() < 1.0 || Wrist.Z < -100000.0)
+	{
+		Cuff->SetVisibility(false);
+		return;
+	}
+	Cuff->SetVisibility(true);
+	Cuff->SetWorldLocationAndRotation(Wrist - Axis.GetSafeNormal() * 4.0, FRotationMatrix::MakeFromZ(Axis.GetSafeNormal()).ToQuat());
+	Cuff->SetWorldScale3D(FVector(0.075, 0.075, 0.045));
+}
