+void PlayerHandsLook::ApplyPointingPose(FHandFrame& Frame)
+{
+	if (Frame.Joints.Num() < MageHandJointCount)
+	{
+		return;
+	}
+	auto At = [&Frame](EHandKeypoint Key) -> FVector&
+	{ return Frame.Joints[static_cast<int32>(Key)].Location; };
+	const FVector Wrist = At(EHandKeypoint::Wrist);
+	const FVector Forward = (At(EHandKeypoint::MiddleProximal) - Wrist).GetSafeNormal();
+	// The palm side: the normal of the knuckle plane, turned toward where the recorded fingers already curl.
+	FVector Palm = FVector::CrossProduct(At(EHandKeypoint::IndexProximal) - At(EHandKeypoint::LittleProximal), Forward).GetSafeNormal();
+	const FVector Curl = At(EHandKeypoint::MiddleTip) - At(EHandKeypoint::MiddleProximal);
+	if (FVector::DotProduct(Curl, Palm) < 0.0)
+	{
+		Palm = -Palm;
+	}
+	auto Chain = [&](const EHandKeypoint(&Keys)[4], const double(&BendDeg)[3])
+	{
+		double Angle = 0.0;
+		FVector Joint = At(Keys[0]);
+		for (int32 Index = 0; Index < 3; ++Index)
+		{
+			const double Length = FVector::Dist(Frame.Joints[static_cast<int32>(Keys[Index])].Location, Frame.Joints[static_cast<int32>(Keys[Index + 1])].Location);
+			Angle += FMath::DegreesToRadians(BendDeg[Index]);
+			const FVector Dir = Forward * FMath::Cos(Angle) + Palm * FMath::Sin(Angle);
+			Joint += Dir * Length;
+			At(Keys[Index + 1]) = Joint;
+		}
+	};
+	const EHandKeypoint Index[4] = {EHandKeypoint::IndexProximal, EHandKeypoint::IndexIntermediate, EHandKeypoint::IndexDistal, EHandKeypoint::IndexTip};
+	const EHandKeypoint Middle[4] = {EHandKeypoint::MiddleProximal, EHandKeypoint::MiddleIntermediate, EHandKeypoint::MiddleDistal, EHandKeypoint::MiddleTip};
+	const EHandKeypoint Ring[4] = {EHandKeypoint::RingProximal, EHandKeypoint::RingIntermediate, EHandKeypoint::RingDistal, EHandKeypoint::RingTip};
+	const EHandKeypoint Little[4] = {EHandKeypoint::LittleProximal, EHandKeypoint::LittleIntermediate, EHandKeypoint::LittleDistal, EHandKeypoint::LittleTip};
+	const double Straight[3] = {2.0, 2.0, 1.0};
+	const double Curled[3] = {75.0, 95.0, 55.0};
+	Chain(Index, Straight);
+	Chain(Middle, Curled);
+	Chain(Ring, Curled);
+	Chain(Little, Curled);
+	// The thumb tucked across the curled fingers: from its proximal joint toward the middle finger's folded middle joint.
+	// The thumb rests along the curled fingers' side: from its proximal joint toward the middle finger's folded middle joint
+	// (the picture's 30 degree thumb clamp keeps it short of a full tuck).
+	const FVector ThumbBase = At(EHandKeypoint::ThumbProximal);
+	const FVector Target = At(EHandKeypoint::MiddleDistal) + Palm * 1.2;
+	const FVector Dir = (Target - ThumbBase).GetSafeNormal();
+	const double L1 = FVector::Dist(ThumbBase, At(EHandKeypoint::ThumbDistal));
+	const double L2 = FVector::Dist(At(EHandKeypoint::ThumbDistal), At(EHandKeypoint::ThumbTip));
+	At(EHandKeypoint::ThumbDistal) = ThumbBase + Dir * L1;
+	At(EHandKeypoint::ThumbTip) = At(EHandKeypoint::ThumbDistal) + (Dir + Palm * 0.25).GetSafeNormal() * L2;
+}
