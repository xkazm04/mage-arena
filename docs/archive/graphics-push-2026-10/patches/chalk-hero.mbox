+    if key not in _CHALK_CACHE:
+        _CHALK_CACHE[key] = (_noise(h, w, 9, 3901), _noise(h, w, 3, 3902), _noise(h, w, 24, 3903))
+    n_width, n_grain, n_break = _CHALK_CACHE[key]
+    a8 = Image.fromarray((alpha * 255).astype(np.uint8))
+    er = [np.asarray(a8.filter(ImageFilter.MinFilter(k)), dtype=np.float64) / 255.0 for k in (9, 15, 21)]
+    # Inner bands 4, 7 and 10 px deep at the 768 px repaint (1.3-3.3 px in the 256 px cell); the width noise picks.
+    thin, mid, thick = alpha - er[0], alpha - er[1], alpha - er[2]
