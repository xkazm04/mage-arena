--- a/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.cpp
@@ -27,6 +27,7 @@
 #include "HAL/FileManager.h"
 #include "HAL/IConsoleManager.h"
 #include "Look/BrennicEpicLook.h"
+#include "Look/QuestLook.h"
 #include "Look/QuestSpells.h"
 #include "MageArenaVR.h"
 #include "Materials/MaterialInstanceDynamic.h"
@@ -390,6 +391,21 @@ void EpicLook::DressArena(AActor& Arena, const FArenaLayout& Layout)
 	}
 	DressSurfaces(Arena, Layout);
 	DressSkyAndLight(Arena, Layout, *Rig);
+	// S1's stone pylons with their bowl fires (Tier A's, QuestLook::BuildPylons), each fire a flickering light here.
+	for (const FVector& FireCm : QuestLook::BuildPylons(Arena, Layout, false))
+	{
+		UPointLightComponent* Light = NewObject<UPointLightComponent>(Rig);
+		Light->SetMobility(EComponentMobility::Movable);
+		Light->SetupAttachment(Rig->GetRootComponent());
+		Light->RegisterComponent();
+		Light->SetWorldLocation(FireCm);
+		Light->SetIntensityUnits(ELightUnits::Candelas);
+		Light->SetLightColor(FLinearColor(1.f, 0.52f, 0.2f));
+		Light->SetAttenuationRadius(1400.f);
+		Light->SetSourceRadius(25.f);
+		Light->SetCastShadows(false);
+		Rig->AddBrazierLight(Light, ParamOr(TEXT("MageArenaEpicBrazierCd="), 40.f) * 1.5f);
+	}
 	DressPost(*Rig);
 	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK epic dressed braziers=%d"), Layout.Braziers.Num());
 }
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/QuestLook.cpp b/apps/vr/Game/Source/MageArenaVR/Look/QuestLook.cpp
