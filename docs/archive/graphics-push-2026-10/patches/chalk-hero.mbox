+// The chalk cuff with its HUD (Look/ChalkCuffLook.h). th is the angle round the wrist from the side facing the camera, h
+// the height along the band (-1..1). Four runes on the upper half (the first LitRunes lit in coloured chalk, the rest
+// engraved), four tally strips under them (HP, mana, stamina, clock, each filled from the left to its fraction), a warm
+// seam across the band while the collar crack shows; bronze chalk with grain and darker rims elsewhere.
+const TCHAR* CuffHudCode = TEXT(
+    "float3 ax = normalize(Axis.xyz);\n"
+    "float3 d = WP - Centre.xyz;\n"
+    "float along = dot(d, ax);\n"
+    "float h = along / max(HalfHeight, 0.1);\n"
+    "float3 rad = d - ax * along;\n"
+    "float3 tc = Cam - Centre.xyz; tc = tc - ax * dot(tc, ax);\n"
+    "float3 fwd = normalize(tc + 1e-4);\n"
+    "float3 side = normalize(cross(fwd, ax));\n"
+    "float deg = degrees(atan2(dot(rad, side), dot(rad, fwd)));\n"
+    "float n = frac(sin(dot(floor(float2(deg * 3.0, h * 30.0)), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float face = saturate(cos(radians(deg)));\n"
+    "float3 c = Bronze * lerp(0.8, 1.08, n) * (0.5 + 0.6 * face);\n"
+    "c = abs(h) > 0.88 ? Bronze * 0.32 : c;\n"
+    "float3 ink = Bronze * 0.3;\n"
+    "// runes: four cells 22 degrees wide on the facing side, upper band\n"
+    "float cellW = 22.0;\n"
+    "float u = (deg + 2.0 * cellW) / cellW;\n"
+    "float ci = floor(u);\n"
+    "float2 p = float2((u - ci) * 2.0 - 1.0, ((h - 0.08) / 0.74) * 2.0 - 1.0);\n"
+    "float inRow = (ci >= 0.0 && ci <= 3.0 && h > 0.08 && h < 0.82) ? 1.0 : 0.0;\n"
+    "float2 a0 = float2(-0.3, -0.8), b0 = float2(-0.3, 0.8), a1 = float2(-0.3, 0.25), b1 = float2(0.45, 0.65), a2 = float2(-0.3, -0.15), b2 = float2(0.45, 0.25);\n"
+    "if (ci == 1.0) { a0 = float2(-0.4, -0.8); b0 = float2(-0.4, 0.7); a1 = float2(-0.4, 0.7); b1 = float2(0.4, 0.25); a2 = float2(0.4, 0.25); b2 = float2(0.4, -0.8); }\n"
+    "if (ci == 2.0) { a0 = float2(-0.45, -0.8); b0 = float2(-0.45, 0.8); a1 = float2(0.45, -0.8); b1 = float2(0.45, 0.8); a2 = float2(-0.45, 0.8); b2 = float2(0.45, -0.8); }\n"
+    "if (ci == 3.0) { a0 = float2(-0.4, -0.8); b0 = float2(-0.4, 0.8); a1 = float2(-0.4, 0.8); b1 = float2(0.45, -0.1); a2 = float2(0.45, 0.8); b2 = float2(0.45, -0.8); }\n"
+    "float2 pa = p - a0, ba = b0 - a0; float d0 = length(pa - ba * saturate(dot(pa, ba) / dot(ba, ba)));\n"
+    "pa = p - a1; ba = b1 - a1; float d1 = length(pa - ba * saturate(dot(pa, ba) / dot(ba, ba)));\n"
+    "pa = p - a2; ba = b2 - a2; float d2 = length(pa - ba * saturate(dot(pa, ba) / dot(ba, ba)));\n"
+    "float dm = min(d0, min(d1, d2));\n"
+    "float stroke = (dm < 0.17 ? 1.0 : 0.0) * inRow * (n > 0.12 ? 1.0 : 0.6);\n"
+    "float3 runeCol = ci < 1.0 ? float3(0.45, 0.78, 1.0) : (ci < 2.0 ? float3(1.0, 0.45, 0.32) : (ci < 3.0 ? float3(0.5, 0.92, 0.55) : float3(1.0, 0.86, 0.38)));\n"
+    "float lit = ci < LitRunes ? 1.0 : 0.0;\n"
+    "c = lerp(c, lerp(ink, runeCol * 1.25, lit), stroke);\n"
+    "c += runeCol * 0.35 * lit * inRow * saturate(1.0 - dm / 0.45) * (1.0 - stroke);\n"
+    "// tally strips: HP, mana, stamina, clock, from h -0.12 down, across 100 degrees of the facing side\n"
+    "float span = (deg + 50.0) / 100.0;\n"
+    "float inSpan = (span > 0.0 && span < 1.0) ? 1.0 : 0.0;\n"
+    "float4 fr = float4(Hp, Mana, Stamina, Clock);\n"
+    "for (int i = 0; i < 4; i++)\n"
+    "{\n"
+    "    float hc = -0.14 - 0.2 * i;\n"
+    "    float band = (abs(h - hc) < 0.07 ? 1.0 : 0.0) * inSpan;\n"
+    "    float3 sc = i == 0 ? HpColour : (i == 1 ? ManaColour : (i == 2 ? StaminaColour : ClockColour));\n"
+    "    float filled = span < fr[i] ? 1.0 : 0.0;\n"
+    "    float3 chalk = sc * 1.35 * lerp(0.85, 1.12, n);\n"
+    "    c = lerp(c, lerp(ink, chalk, filled), band);\n"
+    "}\n"
+    "// the collar crack: a warm-white seam across the band, light leaking through\n"
+    "float seam = (abs(deg - 8.0 + 14.0 * h) < 1.6 ? 1.0 : 0.0) * Crack * (abs(h) < 0.88 ? 1.0 : 0.0);\n"
+    "c = lerp(c, float3(1.0, 0.93, 0.78) * 2.2, seam);\n"
+    "return c;\n");
