+
+#include "Components/PoseableMeshComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Greybox/GreyboxUtil.h"
+#include "Look/ArenaStyle.h"
+#include "Look/CuffLook.h"
+#include "MageArenaVR.h"
+#include "Session/PresentationLook.h"
+#include "Materials/MaterialInstanceDynamic.h"
+
+namespace
+{
+struct FGauges
+{
+	float Hp = 1.f;
+	float Mana = 1.f;
+	float Stamina = 1.f;
+	float Clock = 0.f;
+	float Lit = 2.f;
+	float Crack = 0.f;
+};
+
+FGauges& Gauges()
+{
+	static FGauges State;
+	return State;
+}
+
+// The band: 8.5 cm across, 7.5 cm tall (the engine cylinder is 100 cm by 100 cm), a little short of the wrist.
+constexpr double DiameterCm = 8.5;
+constexpr double HeightCm = 7.5;
+constexpr double BackFromWristCm = 4.5;
+}
+
+void ChalkCuffLook::SetGauges(float Hp, float Mana, float Stamina, float Clock, int32 LitRunes)
+{
+	FGauges& State = Gauges();
+	State.Hp = FMath::Clamp(Hp, 0.f, 1.f);
+	State.Mana = FMath::Clamp(Mana, 0.f, 1.f);
+	State.Stamina = FMath::Clamp(Stamina, 0.f, 1.f);
+	State.Clock = FMath::Clamp(Clock, 0.f, 1.f);
+	State.Lit = static_cast<float>(FMath::Clamp(LitRunes, 0, 4));
+}
+
+void ChalkCuffLook::SetCrack(bool bCrack)
+{
+	Gauges().Crack = bCrack ? 1.f : 0.f;
+}
+
+bool ChalkCuffLook::Pose(UPoseableMeshComponent& Hands, UStaticMeshComponent*& Cuff)
+{
+	if (ArenaStyle::Current() != EArenaStyle::Chalk || !Hands.GetOwner())
+	{
+		return false;
+	}
+	UMaterialInstanceDynamic* Mid = Cuff ? Cast<UMaterialInstanceDynamic>(Cuff->GetMaterial(0)) : nullptr;
+	if (!Cuff || !Mid || !Mid->Parent || Mid->Parent->GetName() != TEXT("M_ChalkCuffHud"))
+	{
+		UMaterialInterface* Hud = LoadObject<UMaterialInterface>(nullptr, *(CuffLook::Folder() / TEXT("M_ChalkCuffHud.M_ChalkCuffHud")), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		UStaticMesh* Cylinder = Greybox::LoadShape(TEXT("Cylinder"));
+		if (!Hud || !Cylinder)
+		{
+			return false;
+		}
+		if (!Cuff)
+		{
+			Cuff = NewObject<UStaticMeshComponent>(Hands.GetOwner());
+			Cuff->SetCastShadow(false);
+			Cuff->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+			Cuff->RegisterComponent();
+		}
+		Cuff->SetStaticMesh(Cylinder);
+		Mid = UMaterialInstanceDynamic::Create(Hud, Cuff);
+		Cuff->SetMaterial(0, Mid);
+		// The old bars' hues (SessionPresentation: HP from PresentationLook, mana, stamina, clock), softened as CuffLook does.
+		const TPair<const TCHAR*, FLinearColor> Hues[] = {{TEXT("HpColour"), CuffLook::Soften(PresentationLook::HpFillColour())},
+		    {TEXT("ManaColour"), CuffLook::Soften(FLinearColor(0.08f, 0.25f, 0.75f))}, {TEXT("StaminaColour"), CuffLook::Soften(FLinearColor(0.15f, 0.55f, 0.18f))},
+		    {TEXT("ClockColour"), CuffLook::Soften(FLinearColor(0.75f, 0.55f, 0.12f))}};
+		for (const TPair<const TCHAR*, FLinearColor>& Hue : Hues)
+		{
+			Mid->SetVectorParameterValue(Hue.Key, Hue.Value);
+		}
+	}
+	const FVector Elbow = Hands.GetBoneLocationByName(TEXT("lowerarm_l"), EBoneSpaces::WorldSpace);
+	const FVector Wrist = Hands.GetBoneLocationByName(TEXT("hand_l"), EBoneSpaces::WorldSpace);
+	const FVector Axis = (Wrist - Elbow).GetSafeNormal();
+	if ((Wrist - Elbow).SizeSquared() < 1.0 || Wrist.Z < -100000.0)
+	{
+		Cuff->SetVisibility(false);
+		return true;
+	}
+	const FVector Centre = Wrist - Axis * BackFromWristCm;
+	Cuff->SetVisibility(true);
+	Cuff->SetWorldLocationAndRotation(Centre, FRotationMatrix::MakeFromZ(Axis).ToQuat());
+	Cuff->SetWorldScale3D(FVector(DiameterCm / 100.0, DiameterCm / 100.0, HeightCm / 100.0));
+	const FGauges& State = Gauges();
+	Mid->SetVectorParameterValue(TEXT("Centre"), FLinearColor(Centre.X, Centre.Y, Centre.Z, 0.f));
+	Mid->SetVectorParameterValue(TEXT("Axis"), FLinearColor(Axis.X, Axis.Y, Axis.Z, 0.f));
+	Mid->SetScalarParameterValue(TEXT("HalfHeight"), static_cast<float>(HeightCm * 0.5));
+	Mid->SetScalarParameterValue(TEXT("Hp"), State.Hp);
+	Mid->SetScalarParameterValue(TEXT("Mana"), State.Mana);
+	Mid->SetScalarParameterValue(TEXT("Stamina"), State.Stamina);
+	Mid->SetScalarParameterValue(TEXT("Clock"), State.Clock);
+	Mid->SetScalarParameterValue(TEXT("LitRunes"), State.Lit);
+	Mid->SetScalarParameterValue(TEXT("Crack"), State.Crack);
+	return true;
+}
