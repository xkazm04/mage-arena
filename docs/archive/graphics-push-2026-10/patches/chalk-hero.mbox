+"""2.5D spike S1: the projection's inputs into art/look/chalk for the look commandlet (CreateQuestLookAssets -style=chalk).
+
+- T_Q_25D_Depth.png: the export's scene depth (25d-depth.f32, cm along the capture's view axis) as 16-bit grey,
+  log-encoded from 10 cm to 1 km (the material decodes exp(v * ln 1e4) * 10); the sky (no geometry) saturates at 1.
+- T_Q_25D_Paint.png: the painting (a gen_25d_scene.py draw, or the beauty itself for the round-trip check), at the
+  export's size.
+- 25d-camera.json: the export's capture camera, copied.
+
+Usage: python prep_25d.py <export dir> <painting png>
+"""
+import json
+import shutil
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+OUT = Path(__file__).resolve().parents[2] / "art" / "look" / "chalk"
+
+
+def main():
+    export, paint = Path(sys.argv[1]), Path(sys.argv[2])
+    cam = json.loads((export / "25d-camera.json").read_text(encoding="utf-8"))
+    w, h = cam["width"], cam["height"]
+    depth = np.fromfile(export / "25d-depth.f32", dtype="<f4").reshape(h, w)
+    v = np.log(np.clip(depth, 10.0, 1.0e5) / 10.0) / np.log(1.0e4)
+    Image.fromarray(np.round(v * 65535.0).astype(np.uint16)).save(OUT / "T_Q_25D_Depth.png")
+    Image.open(paint).convert("RGB").resize((w, h), Image.LANCZOS).save(OUT / "T_Q_25D_Paint.png")
+    shutil.copyfile(export / "25d-camera.json", OUT / "25d-camera.json")
+    print(f"prep_25d: {w}x{h} depth {float(depth.min()):.0f}..{float(np.percentile(depth, 99)):.0f} cm, paint {paint.name}")
+
+
+if __name__ == "__main__":
+    main()
