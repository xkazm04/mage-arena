+bool QuestLook::Is25D()
+{
+	int32 Value = 0;
+	return ArenaStyle::Current() == EArenaStyle::Chalk && FParse::Value(FCommandLine::Get(), TEXT("MageArena25D="), Value) && Value != 0;
+}
+
 UMaterialInterface* QuestLook::Surface(ESurface Surface)
 {
+	// 2.5D spike S1: the floor, the board and the dais take the projected painting (their *25D instance) when it was built.
+	if (Is25D() && (Surface == ESurface::Sand || Surface == ESurface::Dais || Surface == ESurface::Pad || Surface == ESurface::Seat || Surface == ESurface::Ledge))
+	{
+		if (UMaterialInterface* Projected = LoadQuest(*(FString(SurfaceAsset(Surface)) + TEXT("25D"))))
+		{
+			return Projected;
+		}
+	}
 	return LoadQuest(SurfaceAsset(Surface));
 }
 
 UMaterialInterface* QuestLook::SkyMaterial()
 {
+	if (Is25D())
+	{
+		if (UMaterialInterface* Projected = LoadQuest(TEXT("MI_Q_Sky25D")))
+		{
+			return Projected;
+		}
+	}
 	return LoadQuest(TEXT("M_Q_Sky"));
 }
 
