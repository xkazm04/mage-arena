-sky = sky * (1 - cool) + target * cool
+# Judge round 2: S1's sky reads golden-peach to a viewer, and the teal-lilac regrade (driven by region numbers) read as a
+# muddy mauve dome. The still keeps its own warm sunset colours, only a little less saturated.
 grey = (sky * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1, keepdims=True)
-sky = grey + (sky - grey) * 0.5
-# S1's sky is peach, not amber: a touch less green and blue-neutral.
