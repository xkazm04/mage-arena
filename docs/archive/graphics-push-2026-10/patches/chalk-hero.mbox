+// forward, right, up, tan of the half FOVs) comes from 25d-camera.json; the scene depth it saw (log-encoded, 10 cm to
+// 1 km) gates the projection where the eye now sees a surface the capture did not (a face turned away, a disoccluded
+// one, outside the frame): there the p11 drawing (Fallback) stays. The painting is display-referred (after the
+// tonemapper), so it is mapped back through an inverse of the filmic curve (Narkowicz ACES fit) and the exposure gain;
+// PaintGamma lifts the darks the fit's toe crushes (round trip of the beauty itself: the board came back at half its value).
+const TCHAR* Project25DCode = TEXT(
+    "float3 d = P - CamPos.xyz;\n"
+    "float z = dot(d, CamF.xyz);\n"
+    "float zs = max(z, 1.0);\n"
+    "float2 uv = float2(0.5 + 0.5 * dot(d, CamR.xyz) / (zs * TanH), 0.5 - 0.5 * dot(d, CamU.xyz) / (zs * TanV));\n"
+    "float inside = (z > 1.0 && uv.x > 0.002 && uv.x < 0.998 && uv.y > 0.002 && uv.y < 0.998) ? 1.0 : 0.0;\n"
+    "float stored = exp(Texture2DSample(DepthTex, DepthTexSampler, uv).r * 9.21034) * 10.0;\n"
+    "float seen = (z <= stored * 1.08 + 30.0 || stored > 90000.0) ? 1.0 : 0.0;\n"
+    "float facing = UseFacing > 0.5 ? saturate(dot(normalize(N), normalize(-d)) * 8.0) : 1.0;\n"
+    "float3 y = min(pow(Texture2DSample(PaintTex, PaintTexSampler, uv).rgb, PaintGamma), 0.985);\n"
+    "float3 a = 2.51 - 2.43 * y;\n"
+    "float3 b = 0.03 - 0.59 * y;\n"
+    "float3 c = -0.14 * y;\n"
+    "float3 x = (-b + sqrt(max(b * b - 4.0 * a * c, 0.0))) / (2.0 * a);\n"
+    "return lerp(Fallback, x * PaintGain, inside * seen * facing);");
