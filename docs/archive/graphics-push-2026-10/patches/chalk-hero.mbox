+def fit_to(rgb, alpha, target, scale=None):
+    """Scales (about the feet) and shifts the painted figure so its feet line and centre match target's silhouette; at
+    `scale` when given (one per clip, so the size never pumps), else so its height matches too. Returns rgb, alpha, scale."""
+    a, t = _bbox(alpha), _bbox(target)
+    if a is None or t is None:
