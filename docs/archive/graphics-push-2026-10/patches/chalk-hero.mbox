+
+int32 FrameAt(ERivalClip Clip, int32 Count, double Seconds, const RivalClips::FLengths& Lengths)
+{
+	if (Count <= 1)
+	{
+		return 0;
+	}
+	const double T = FMath::Max(0.0, Seconds);
+	switch (Clip)
+	{
+	case ERivalClip::Cast:
+	case ERivalClip::Hit:
+	{
+		const double Length = FMath::Max(0.05, Clip == ERivalClip::Cast ? Lengths.CastS : Lengths.HitS);
+		return FMath::Clamp(FMath::FloorToInt32(T / Length * Count), 0, Count - 1);
+	}
+	case ERivalClip::Death:
+		return FMath::Min(FMath::FloorToInt32(T * Fps), Count - 1);
+	default:
+		return FMath::FloorToInt32(T * Fps) % Count;
+	}
+}
+}
