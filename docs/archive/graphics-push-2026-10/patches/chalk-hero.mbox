+	UMaterialExpression* Opacity = G.Custom(TEXT("Cover"), CMOT_Float1, TEXT("float u = D0 + Uv.x * D1;\nreturn saturate(A * 0.92) * saturate(min(u, 0.5 - u) / 0.05) * saturate(1.3 - Uv.y * 1.05);"),
 	    {{TEXT("A"), Water, 4}, {TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("D0"), G.Data(0, 0.f)}, {TEXT("D1"), G.Data(1, 0.5f)}});
