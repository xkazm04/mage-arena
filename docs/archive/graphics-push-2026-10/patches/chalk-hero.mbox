+	// An FBX import over an existing animation keeps that asset's old import settings (the T68 pitfall: a re-import of
+	// CastLunge came in at a hundredth of the scale and folded Brennic into his feet). Delete it first, unloaded.
+	{
+		const FString PackageName = BrennicEpicLook::Folder() / AssetName;
+		FString File;
+		if (FPackageName::TryConvertLongPackageNameToFilename(PackageName, File, FPackageName::GetAssetPackageExtension()) && IFileManager::Get().FileExists(*File))
+		{
+			if (FindPackage(nullptr, *PackageName))
+			{
+				UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail %s is already loaded; cannot replace it"), *PackageName);
+				return 1;
+			}
+			IFileManager::Get().Delete(*FPaths::ConvertRelativePathToFull(File), true, true);
+			IAssetRegistry::GetChecked().ScanPathsSynchronous({BrennicEpicLook::Folder()}, true);
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS replace deleted %s"), *PackageName);
+		}
+	}
 	// As ImportCreatureMesh imported the four clips: legacy FBX factory, scale 100, no front-axis change; animation only.
 	UFbxFactory* Factory = NewObject<UFbxFactory>();
 	Factory->AddToRoot();
