+// Sets a scalar parameter's default on a built material (the builder's G.Scalar nodes), by name.
+void SetDefaultScalar(UMaterial& Material, const TCHAR* Name, float Value)
+{
+	for (UMaterialExpression* Expression : Material.GetExpressions())
+	{
