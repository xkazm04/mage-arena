+// Probe 3: the chalk figure shading (Brennic, the hands), unlit. The albedo is laid in two or three flat value steps by
+// N.L (drawn, not shaded), its colour pushed toward pastel saturation; the shade side and the creases (ORM ambient
+// occlusion) get diagonal hatching; one side carries a pale chalk rim; the silhouette is a broken, varying-width dark
+// contour from the view angle. Grain on top. Thin enough for a forearm at arm's length and for Brennic at 16 m.
+const TCHAR* ChalkFigureCode = TEXT(
+    "float3 nn = normalize(N); float3 vv = normalize(V);\n"
+    "float ndl = dot(nn, normalize(L));\n"
+    "float lit = ndl > 0.3 ? 1.0 : (ndl > -0.15 ? 0.74 : 0.52);\n"
+    "float3 c = Base * Tint * lit;\n"
+    "float l = dot(c, float3(0.2126, 0.7152, 0.0722));\n"
+    "c = max(lerp(l.xxx, c, Sat), 0.0);\n"
+    "float n = frac(sin(dot(floor(Uv0 * 700.0), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float h = smoothstep(0.55, 0.85, abs(frac((Uv0.x + Uv0.y) * Hatch) - 0.5) * 2.0);\n"
+    "float shade = saturate((1.0 - lit) * 2.2 + (1.0 - Ao) * 1.6);\n"
+    "c = lerp(c, c * 0.42, h * saturate(shade) * 0.8);\n"
+    "float f = 1.0 - saturate(dot(nn, vv));\n"
+    "c += RimColour * pow(f, 2.5) * saturate(dot(nn, normalize(RimDir))) * Rim;\n"
+    "float edge = (f > (0.62 + 0.18 * n) ? 1.0 : 0.0) * (n > 0.25 ? 1.0 : 0.4);\n"
+    "c = lerp(c, Dark, edge * Contour);\n"
+    "return c * lerp(0.86, 1.04, n) * Bright;");
+
+UMaterial* BuildChalkFigure(const TCHAR* Name, UTexture2D* BaseTexture, UTexture2D* OrmTexture, const FLinearColor& Tint, float Sat, float Hatch, float Rim, float Contour, float Bright)
+{
