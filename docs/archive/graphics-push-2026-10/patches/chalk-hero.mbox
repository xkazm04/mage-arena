diff --git a/apps/vr/tools/look/control_25d.py b/apps/vr/tools/look/control_25d.py
new file mode 100644
index 0000000..4b852d6
--- /dev/null
+++ b/apps/vr/tools/look/control_25d.py
@@ -0,0 +1,48 @@
+"""2.5D spike S1/E2: ControlNet hints for one exported face (S1ShotCapture -MageArena25DExport).
+
+- control-depth.png: inverse depth from the engine's own scene depth (near bright, the sky black), the Depth Anything
+  convention the FLUX.2 Fun ControlNet Union was trained on.
+- control-edge.png: white lines on black from the beauty's luminance gradient and the depth's log gradient (geometry
+  edges and the drawn line work), a Canny-like hint.
+
+Usage: python control_25d.py <export dir> [--size 1024]
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+
+def grad(a):
+    gx = np.zeros_like(a)
+    gy = np.zeros_like(a)
+    gx[:, 1:-1] = a[:, 2:] - a[:, :-2]
+    gy[1:-1, :] = a[2:, :] - a[:-2, :]
+    return np.hypot(gx, gy)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("export")
+    p.add_argument("--size", type=int, default=1024)
+    o = p.parse_args()
+    d = Path(o.export)
+    cam = json.loads((d / "25d-camera.json").read_text(encoding="utf-8"))
+    depth = np.fromfile(d / "25d-depth.f32", dtype="<f4").reshape(cam["height"], cam["width"]).astype(np.float64)
+    inv = 1.0 / np.clip(depth, 50.0, 1.0e9)
+    near = np.percentile(inv[depth < 1.0e6], 99.5) if (depth < 1.0e6).any() else inv.max()
+    dep = np.clip(inv / near, 0.0, 1.0) ** 0.6
+    size = (o.size, o.size * cam["height"] // cam["width"])
+    Image.fromarray((dep * 255).astype(np.uint8)).convert("RGB").resize(size, Image.LANCZOS).save(d / "control-depth.png")
+    lum = np.asarray(Image.open(d / "25d-beauty.png").convert("L"), dtype=np.float64)
+    e = np.clip(grad(lum) / 60.0, 0, 1)
+    e = np.maximum(e, np.clip(grad(np.log(np.clip(depth, 10.0, 1.0e5))) / 0.05, 0, 1))
+    e = (e > 0.35).astype(np.float64)
+    Image.fromarray((e * 255).astype(np.uint8)).convert("RGB").resize(size, Image.LANCZOS).save(d / "control-edge.png")
+    print(f"control_25d: {d.name} {size[0]}x{size[1]}")
+
+
+if __name__ == "__main__":
+    main()
