--- /dev/null
+++ b/apps/vr/tools/look/stitch_25d.py
@@ -0,0 +1,135 @@
+"""2.5D spike S1/E2: stitch painted cube-like faces into one horizon-aligned panorama from the seat eye.
+
+Each face is an export dir (S1ShotCapture -MageArena25DExport: 25d-camera.json, 25d-depth.f32) plus its painting. Every
+panorama texel is a direction from the eye (yaw across, pitch down the rows, about the S30 aim's level forward); each face
+that sees it contributes, weighted by how far inside its frame the texel lies (a feather over the outer `--feather` of
+the frame), so the overlaps blend instead of meeting at a hard seam. The depth panorama keeps the radial distance (the
+material compares |P - eye|), from the face that sees the texel most centrally.
+
+Writes into art/look/chalk: T_Q_25D_Paint.png, T_Q_25D_Depth.png (16-bit, log 10 cm..1 km) and 25d-camera.json with the
+panorama's mapping (projection "pano").
+
+Usage: python stitch_25d.py --face <export dir>=<painting png> [--face ...] [--width 6144] [--height 2048]
+       [--yaw-min -145] [--yaw-span 290] [--pitch-max 35] [--pitch-span 110] [--feather 0.12]
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+OUT = Path(__file__).resolve().parents[2] / "art" / "look" / "chalk"
+
+
+def bilinear(img, u, v):
+    h, w = img.shape[:2]
+    x = np.clip(u * w - 0.5, 0, w - 1.001)
+    y = np.clip(v * h - 0.5, 0, h - 1.001)
+    x0, y0 = np.floor(x).astype(int), np.floor(y).astype(int)
+    fx, fy = x - x0, y - y0
+    if img.ndim == 3:
+        fx, fy = fx[..., None], fy[..., None]
+    a = img[y0, x0] * (1 - fx) + img[y0, x0 + 1] * fx
+    b = img[y0 + 1, x0] * (1 - fx) + img[y0 + 1, x0 + 1] * fx
+    return a * (1 - fy) + b * fy
+
+
+def mute_orange(rgb, amount):
+    """Flux paints the sand orange whatever the prompt says; S30's is a muted ochre pastel. Desaturate the orange hues
+    (about 15-50 degrees) by `amount`, a little darker, leaving the slate, the chalk whites and the banners' reds and blues."""
+    x = np.clip(rgb / 255.0, 0, 1)
+    mx, mn = x.max(-1), x.min(-1)
+    sat = np.where(mx > 1e-4, (mx - mn) / np.maximum(mx, 1e-4), 0)
+    r, g, b = x[..., 0], x[..., 1], x[..., 2]
+    hue = (np.degrees(np.arctan2(np.sqrt(3) * (g - b), 2 * r - g - b)) + 360) % 360
+    w = np.clip(1 - np.abs(hue - 32) / 22, 0, 1) * np.clip((sat - 0.25) / 0.2, 0, 1)
+    lum = (0.2126 * r + 0.7152 * g + 0.0722 * b)[..., None]
+    k = (amount * w)[..., None]
+    out = x * (1 - k) + (lum + (x - lum) * 0.35) * k
+    out = out * (1 - 0.06 * k)
+    return np.clip(out * 255.0, 0, 255)
+
+
+def main():
+    a = argparse.ArgumentParser()
+    a.add_argument("--face", action="append", required=True)
+    a.add_argument("--width", type=int, default=6144)
+    a.add_argument("--height", type=int, default=2048)
+    a.add_argument("--yaw-min", type=float, default=-145.0)
+    a.add_argument("--yaw-span", type=float, default=290.0)
+    a.add_argument("--pitch-max", type=float, default=35.0)
+    a.add_argument("--pitch-span", type=float, default=110.0)
+    a.add_argument("--feather", type=float, default=0.12)
+    a.add_argument("--exposure", type=float, default=1.0, help="linear gain on the painting before it is written")
+    a.add_argument("--gamma", type=float, default=1.0, help="linear-light power on the painting (1.25 cancels PaintGamma 0.8)")
+    a.add_argument("--depth-div", type=int, default=4, help="the depth texture is the panorama's size divided by this")
+    a.add_argument("--mute-sand", type=float, default=0.8, help="0..1, how far the orange sand is pulled to S30's muted ochre")
+    o = a.parse_args()
+    faces = []
+    for spec in o.face:
+        d, p = spec.split("=", 1)
+        cam = json.loads((Path(d) / "25d-camera.json").read_text(encoding="utf-8"))
+        depth = np.fromfile(Path(d) / "25d-depth.f32", dtype="<f4").reshape(cam["height"], cam["width"])
+        paint = np.asarray(Image.open(p).convert("RGB").resize((cam["width"], cam["height"]), Image.LANCZOS), dtype=np.float32)
+        faces.append((cam, depth, paint))
+    base = faces[0][0]
+    eye = np.array(base["eye"], dtype=np.float64)
+    # The panorama's frame: level forward at the first face's yaw, world up.
+    yaw0 = np.radians(base["yaw"])
+    fwd = np.array([np.cos(yaw0), np.sin(yaw0), 0.0])
+    up = np.array([0.0, 0.0, 1.0])
+    right = np.array([-np.sin(yaw0), np.cos(yaw0), 0.0])
+    W, H = o.width, o.height
+    yaw = np.radians(o.yaw_min + (np.arange(W) + 0.5) / W * o.yaw_span)[None, :]
+    pitch = np.radians(o.pitch_max - (np.arange(H) + 0.5) / H * o.pitch_span)[:, None]
+    dirs = (np.cos(pitch)[..., None] * (np.cos(yaw)[..., None] * fwd + np.sin(yaw)[..., None] * right) + np.sin(pitch)[..., None] * up)
+    acc = np.zeros((H, W, 3))
+    wsum = np.zeros((H, W))
+    best = np.full((H, W), -1.0)
+    radial = np.full((H, W), 1.0e7)
+    for cam, depth, paint in faces:
+        F, R, U = (np.array(cam[k]) for k in ("forward", "right", "up"))
+        tanh = np.tan(np.radians(cam["hfovDeg"]) / 2)
+        tanv = tanh * cam["height"] / cam["width"]
+        z = dirs @ F
+        ok = z > 1e-3
+        zs = np.where(ok, z, 1.0)
+        u = 0.5 + 0.5 * (dirs @ R) / (zs * tanh)
+        v = 0.5 - 0.5 * (dirs @ U) / (zs * tanv)
+        inside = ok & (u > 0) & (u < 1) & (v > 0) & (v < 1)
+        edge = np.minimum(np.minimum(u, 1 - u), np.minimum(v, 1 - v))
+        w = np.where(inside, np.clip(edge / o.feather, 0, 1), 0.0) ** 2
+        col = bilinear(paint, u, v)
+        acc += col * w[..., None]
+        wsum += w
+        zd = bilinear(depth, u, v)
+        r = zd / np.maximum(z, 1e-3)
+        take = inside & (edge > best)
+        radial = np.where(take, r, radial)
+        best = np.where(take, edge, best)
+    col = acc / np.maximum(wsum, 1e-6)[..., None]
+    if o.mute_sand > 0:
+        col = mute_orange(col, o.mute_sand)
+    if o.exposure != 1.0 or o.gamma != 1.0:
+        # The shader lifts the painting by PaintGamma and inverts the filmic curve; a painting brighter than our own render
+        # (Flux paints in the dust and chalk) comes back washed out, so it is pre-darkened here in linear light.
+        lin = np.where(col / 255.0 <= 0.04045, col / 255.0 / 12.92, ((col / 255.0 + 0.055) / 1.055) ** 2.4)
+        lin = np.clip(lin ** o.gamma * o.exposure, 0, 1)
+        col = np.where(lin <= 0.0031308, lin * 12.92, 1.055 * lin ** (1 / 2.4) - 0.055) * 255.0
+    col[wsum < 1e-6] = (42, 47, 51)
+    Image.fromarray(np.clip(col, 0, 255).astype(np.uint8)).save(OUT / "T_Q_25D_Paint.png")
+    vlog = np.log(np.clip(radial, 10.0, 1.0e5) / 10.0) / np.log(1.0e4)
+    # Depth only gates occlusion (8% tolerance), so a quarter of the paint's size is plenty: 25 MB of R16F becomes 1.6 MB.
+    dh, dw = max(1, H // o.depth_div), max(1, W // o.depth_div)
+    small = vlog.reshape(dh, o.depth_div, dw, o.depth_div).min(axis=(1, 3)) if H % o.depth_div == 0 and W % o.depth_div == 0 else vlog
+    Image.fromarray(np.round(small * 65535.0).astype(np.uint16)).save(OUT / "T_Q_25D_Depth.png")
+    meta = {"projection": "pano", "eye": eye.tolist(), "forward": fwd.tolist(), "right": right.tolist(), "up": up.tolist(),
+            "yawMinDeg": o.yaw_min, "yawSpanDeg": o.yaw_span, "pitchMaxDeg": o.pitch_max, "pitchSpanDeg": o.pitch_span,
+            "width": W, "height": H, "faces": o.face}
+    (OUT / "25d-camera.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
+    print(f"stitch_25d: {len(faces)} faces into {W}x{H}, covered {float((wsum > 0).mean()):.3f}")
+
+
+if __name__ == "__main__":
+    main()
-- 
