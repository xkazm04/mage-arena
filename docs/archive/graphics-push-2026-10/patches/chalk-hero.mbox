diff --git a/apps/vr/tools/look/stitch_25d.py b/apps/vr/tools/look/stitch_25d.py
index 11dd51e..8cbd751 100644
--- a/apps/vr/tools/look/stitch_25d.py
+++ b/apps/vr/tools/look/stitch_25d.py
@@ -51,6 +51,56 @@ def mute_orange(rgb, amount):
     return np.clip(out * 255.0, 0, 255)
 
 
+def box_blur(img, r):
+    """A separable box blur of radius r (pixels), edges clamped."""
+    out = img.astype(np.float64)
+    for axis in (0, 1):
+        pad = [(0, 0)] * out.ndim
+        pad[axis] = (r + 1, r)
+        c = np.cumsum(np.pad(out, pad, mode="edge"), axis=axis)
+        hi = np.take(c, np.arange(2 * r + 1, c.shape[axis]), axis=axis)
+        lo = np.take(c, np.arange(0, c.shape[axis] - 2 * r - 1), axis=axis)
+        out = (hi - lo) / (2 * r + 1)
+    return out
+
+
+def clean_sand(rgb, amount):
+    """Flux's footprints come out as dark blobs that read as stains: on the ochre sand, pull pixels much darker than
+    their neighbourhood back toward it (the drawn grain stays; the big dark decals fade)."""
+    x = rgb.astype(np.float64)
+    r, g, b = x[..., 0], x[..., 1], x[..., 2]
+    sandy = np.clip(((r - b) - 25.0) / 40.0, 0, 1) * np.clip((r - 70.0) / 50.0, 0, 1)
+    sandy = box_blur(sandy, 6)
+    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
+    local = box_blur(lum, 40)
+    dark = np.clip((local - lum - 5.0) / 15.0, 0, 1) * sandy * amount
+    soft = box_blur(x, 40)
+    return x * (1 - dark[..., None]) + soft * dark[..., None]
+
+
+def smudge_edges(rgb, radial, rows_px, seed=7):
+    """The near floor meets the sand along the dais front, a ruler-straight depth step. Smear a dusty chalk band across
+    it: per column, rows within a noisy width of a strong depth step are blended toward a vertical blur, lightened a
+    little toward chalk dust."""
+    lr = np.log(np.clip(radial, 10.0, 1.0e5))
+    step = np.zeros_like(lr)
+    step[1:-1] = np.abs(lr[2:] - lr[:-2])
+    edge = (step > 0.25).astype(np.float64)
+    rng = np.random.default_rng(seed)
+    w = rows_px * (0.6 + 0.8 * box_blur(rng.random(rgb.shape[:2]), 25))
+    near = box_blur(edge, rows_px) * (2 * rows_px + 1)
+    band = np.clip(near, 0, 1)
+    # Only the lower half of the panorama (the floor), not the wall's foot.
+    rows = np.linspace(0.0, 1.0, rgb.shape[0])[:, None]
+    band = band * np.clip((rows - 0.30) / 0.04, 0, 1)
+    soft = box_blur(rgb, max(2, rows_px // 2))
+    grain = rng.random(rgb.shape[:2])
+    k = band * np.clip(w / rows_px, 0, 1) * (0.65 + 0.35 * box_blur(grain, 1))
+    # Rubbed chalk dust: the soft mix lifted toward pale chalk, broken by a fine grain.
+    dust = soft * 0.8 + np.array([196.0, 190.0, 178.0]) * 0.2 * (0.6 + 0.8 * grain[..., None])
+    return rgb * (1 - k[..., None]) + dust * k[..., None]
+
