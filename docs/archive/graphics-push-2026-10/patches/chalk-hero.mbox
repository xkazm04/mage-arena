+FString EpicLook::LaunchIniOverrides()
+{
+	const TCHAR* Section = TEXT("[/Script/Engine.RendererSettings]");
+	const TCHAR* Keys[] = {TEXT("r.ForwardShading=False"), TEXT("r.GenerateMeshDistanceFields=True"), TEXT("r.DynamicGlobalIlluminationMethod=1"), TEXT("r.ReflectionMethod=1"),
+	    TEXT("r.Shadow.Virtual.Enable=1"), TEXT("r.AntiAliasingMethod=4")};
+	TArray<FString> Parts;
+	for (const TCHAR* Key : Keys)
+	{
+		Parts.Add(FString(Section) + TEXT(":") + Key);
+	}
+	return TEXT("-ini:Engine:") + FString::Join(Parts, TEXT(","));
+}
+
+void EpicLook::DressArena(AActor& Arena, const FArenaLayout& Layout)
+{
+	UWorld* World = Arena.GetWorld();
+	if (!World)
+	{
+		return;
+	}
+	if (const IConsoleVariable* Forward = IConsoleManager::Get().FindConsoleVariable(TEXT("r.ForwardShading")); Forward && Forward->GetInt() != 0)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_LOOK epic is running forward (no Lumen): launch with %s"), *LaunchIniOverrides());
+	}
+	SetCVar(TEXT("r.VolumetricFog"), 1);
+	SetCVar(TEXT("r.Shadow.Virtual.Enable"), 1);
+	SetCVar(TEXT("r.AntiAliasingMethod"), 4);
+	SetCVar(TEXT("r.Lumen.DiffuseIndirect.Allow"), 1);
+	FActorSpawnParameters Params;
+	Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+	AEpicLookRig* Rig = World->SpawnActor<AEpicLookRig>(AEpicLookRig::StaticClass(), FTransform::Identity, Params);
+	if (!Rig)
+	{
+		return;
+	}
+	DressSurfaces(Arena, Layout);
+	DressSkyAndLight(Arena, Layout, *Rig);
+	DressPost(*Rig);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK epic dressed braziers=%d"), Layout.Braziers.Num());
+}
