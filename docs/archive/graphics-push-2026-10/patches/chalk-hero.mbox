diff --git a/apps/vr/art/hands/align_views.py b/apps/vr/art/hands/align_views.py
new file mode 100644
index 0000000..b8f2f79
--- /dev/null
+++ b/apps/vr/art/hands/align_views.py
@@ -0,0 +1,97 @@
+"""Warps each Flux repaint of a hand view onto the view's own silhouette before projection (hands_paint.py project).
+
+python align_views.py <views_dir> <painted_dir> <out_dir>
+
+Flux img2img keeps the pose but moves outlines by a few millimetres (fingers longer or shifted), and a projected nail or
+knuckle then lands beside the real one. A demons registration of the two silhouettes (pure numpy, coarse to fine) gives
+a smooth displacement field; the repaint is resampled through it, so its outline sits on the mesh's.
+"""
+import os
+import sys
+
+import numpy as np
+from PIL import Image
+
+
+def box(a, r):
+    if r < 1:
+        return a
+    k = 2 * r + 1
+    p = np.pad(a, ((r + 1, r), (0, 0)), mode="edge")
+    c = np.cumsum(p, 0)
+    a = (c[k:] - c[:-k]) / k
+    p = np.pad(a, ((0, 0), (r + 1, r)), mode="edge")
+    c = np.cumsum(p, 1)
+    return (c[:, k:] - c[:, :-k]) / k
+
+
+def blur(a, r):
+    for _ in range(3):
+        a = box(a, r)
+    return a
+
+
+def warp(img, ux, uy):
+    h, w = img.shape[:2]
+    yy, xx = np.mgrid[0:h, 0:w].astype(np.float64)
+    x = np.clip(xx + ux, 0, w - 1.001)
+    y = np.clip(yy + uy, 0, h - 1.001)
+    x0, y0 = np.floor(x).astype(int), np.floor(y).astype(int)
+    fx, fy = x - x0, y - y0
+    if img.ndim == 3:
+        fx, fy = fx[..., None], fy[..., None]
+    return (img[y0, x0] * (1 - fx) * (1 - fy) + img[y0, x0 + 1] * fx * (1 - fy) + img[y0 + 1, x0] * (1 - fx) * fy + img[y0 + 1, x0 + 1] * fx * fy)
+
+
+def mask(path, size):
+    g = np.asarray(Image.open(path).convert("L").resize(size, Image.BILINEAR), dtype=np.float64)
+    return (g < 235).astype(np.float64)
+
+
+def demons(fixed, moving, iters=80, sigma=3):
+    """Displacement (ux, uy) such that moving sampled at x + u matches fixed."""
+    ux = np.zeros_like(fixed)
+    uy = np.zeros_like(fixed)
+    f = blur(fixed, 2)
+    gy, gx = np.gradient(f)
+    for _ in range(iters):
+        m = warp(blur(moving, 2), ux, uy)
+        diff = m - f
+        den = gx * gx + gy * gy + diff * diff + 1e-6
+        ux -= diff * gx / den
+        uy -= diff * gy / den
+        ux, uy = blur(ux, sigma), blur(uy, sigma)
+    return ux, uy
+
+
+def main():
+    views, painted, out = sys.argv[1:4]
+    os.makedirs(out, exist_ok=True)
+    for name in sorted(os.listdir(painted)):
+        if not name.endswith(".png"):
+            continue
+        src = np.asarray(Image.open(os.path.join(painted, name)).convert("RGB"), dtype=np.float64)
+        h, w = src.shape[:2]
+        ux = np.zeros((h, w))
+        uy = np.zeros((h, w))
+        for scale in (4, 2, 1):
+            size = (w // scale, h // scale)
+            fixed = mask(os.path.join(views, name), size)
+            moving = mask(os.path.join(painted, name), size)
+            # Carry the coarser field down: resample to this scale and pre-warp the moving mask with it.
+            cux = np.asarray(Image.fromarray(ux.astype(np.float32)).resize(size, Image.BILINEAR), dtype=np.float64) / scale
+            cuy = np.asarray(Image.fromarray(uy.astype(np.float32)).resize(size, Image.BILINEAR), dtype=np.float64) / scale
+            dux, duy = demons(fixed, warp(moving, cux, cuy), iters=60 if scale > 1 else 30, sigma=max(2, 6 // scale))
+            ux = np.asarray(Image.fromarray((cux + dux).astype(np.float32)).resize((w, h), Image.BILINEAR), dtype=np.float64) * scale
+            uy = np.asarray(Image.fromarray((cuy + duy).astype(np.float32)).resize((w, h), Image.BILINEAR), dtype=np.float64) * scale
+        aligned = warp(src, ux, uy)
+        fixed = mask(os.path.join(views, name), (w, h))
+        before = mask(os.path.join(painted, name), (w, h))
+        after = (np.asarray(Image.fromarray(aligned.astype(np.uint8)).convert("L"), dtype=np.float64) < 235).astype(np.float64)
+        iou = lambda a, b: float((a * b).sum() / max(((a + b) > 0).sum(), 1))
+        Image.fromarray(np.clip(aligned, 0, 255).astype(np.uint8)).save(os.path.join(out, name))
+        print(f"ALIGN {name} iou {iou(fixed, before):.3f} -> {iou(fixed, after):.3f} max shift {float(np.hypot(ux, uy).max()):.1f} px")
+
+
+if __name__ == "__main__":
+    main()
