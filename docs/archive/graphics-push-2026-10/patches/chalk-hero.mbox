+	        {TEXT("Uv0"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("L"), G.Vector(TEXT("SunDir"), FLinearColor(-0.62f, -0.52f, 0.59f, 0.f))},
+	        {TEXT("Tint"), G.Vector(TEXT("Tint"), Tint)}, {TEXT("Sat"), G.Scalar(TEXT("Saturation"), Sat)}, {TEXT("Hatch"), G.Scalar(TEXT("HatchFreq"), Hatch)},
+	        {TEXT("RimColour"), G.Vector(TEXT("RimColour"), FLinearColor(0.85f, 0.83f, 0.76f))}, {TEXT("RimDir"), G.Vector(TEXT("RimDir"), FLinearColor(0.2f, 0.9f, 0.4f, 0.f))},
