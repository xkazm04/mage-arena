+						SpellVfx::SplashPuffs(SpellVfx::ETrail::Droplets, At + TowardEye.GetSafeNormal() * Core * 1.2, TowardEye.GetSafeNormal(), FMath::Frac(Now * 1.4), Projectile.Id, false, Spray);
+						GlowFrame.Add(Water.GetValue(), Spray);
+					}
+				}
 			}
 			GlowFrame.Add(Shot.Glow.GetValue(), Puffs);
