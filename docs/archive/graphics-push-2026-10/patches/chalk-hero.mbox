+bool URivalFigureComponent::LoadSprite()
+{
+	AActor* Owner = GetOwner();
+	const FString Folder = RivalSprite::Folder();
+	auto LoadQuiet = [&Folder](const FString& Name) -> UObject*
+	{
+		const FString Package = Folder / Name;
+		return FPackageName::DoesPackageExist(Package) ? LoadObject<UObject>(nullptr, *FString::Printf(TEXT("%s.%s"), *Package, *Name), nullptr, LOAD_NoWarn | LOAD_Quiet) : nullptr;
+	};
+	UMaterialInterface* Material = Cast<UMaterialInterface>(LoadQuiet(TEXT("M_RivalSprite")));
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	UTexture2D* Atlas = Cast<UTexture2D>(LoadQuiet(TEXT("T_RivalSprite")));
+	if (!Owner || !Material || !Plane || !Atlas)
+	{
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_RIVAL_SPRITE none folder=%s material=%d atlas=%d (the 3D figure stays)"), *Folder, Material ? 1 : 0, Atlas ? 1 : 0);
+		return false;
+	}
+	Sprite = NewObject<UStaticMeshComponent>(Owner, TEXT("RivalSpriteCard"));
+	Sprite->SetMobility(EComponentMobility::Movable);
+	Sprite->SetupAttachment(Owner->GetRootComponent());
+	Sprite->SetStaticMesh(Plane);
+	Sprite->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	Sprite->SetCastShadow(false);
+	Sprite->ComponentTags.Add(TEXT("ChalkHull"));
+	SpriteMid = UMaterialInstanceDynamic::Create(Material, this);
+	Sprite->SetMaterial(0, SpriteMid);
+	Sprite->RegisterComponent();
+	Sprite->SetVisibility(false);
+	// The hidden rig still poses every frame: its hands place the cast's fire flipbook on the painted hands.
+	if (Mesh)
+	{
+		Mesh->VisibilityBasedAnimTickOption = EVisibilityBasedAnimTickOption::AlwaysTickPoseAndRefreshBones;
+	}
+	SpriteMid->SetTextureParameterValue(TEXT("Atlas"), Atlas);
+	SpriteMid->SetScalarParameterValue(TEXT("Cols"), static_cast<float>(RivalSprite::Cols));
+	SpriteMid->SetScalarParameterValue(TEXT("Rows"), static_cast<float>(RivalSprite::Rows));
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_RIVAL_SPRITE loaded %s %dx%d cells %dx%d"), *Atlas->GetPathName(), Atlas->GetSizeX(), Atlas->GetSizeY(), RivalSprite::Cols, RivalSprite::Rows);
+	return true;
+}
