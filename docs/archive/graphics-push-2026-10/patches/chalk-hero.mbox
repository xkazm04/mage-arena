+			Tan = FLinearColor(FCString::Atof(*Parts[0]), FCString::Atof(*Parts[1]), FCString::Atof(*Parts[2]));
+		}
+	}
+	UMaterialInstanceDynamic* Tinted = Skin ? UMaterialInstanceDynamic::Create(Skin, Hands) : nullptr;
+	if (Tinted)
+	{
