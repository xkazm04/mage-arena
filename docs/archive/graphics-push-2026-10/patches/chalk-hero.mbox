+	if (UTexture2D* Wave = LoadObject<UTexture2D>(nullptr, TEXT("/Game/Look/Spells/T_Q_WardWave.T_Q_WardWave")))
+	{
+		UMaterial* Ward = NewMaterial(Folder, TEXT("M_EpicWard"));
+		Ward->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+		Ward->SetShadingModel(MSM_Unlit);
+		Ward->BlendMode = BLEND_Translucent;
+		Ward->TwoSided = true;
+		UMaterialExpressionPerInstanceCustomData* D0 = Add<UMaterialExpressionPerInstanceCustomData>(*Ward, -1200, 0);
+		D0->DataIndex = 0;
+		UMaterialExpressionPerInstanceCustomData* D1 = Add<UMaterialExpressionPerInstanceCustomData>(*Ward, -1200, 100);
+		D1->DataIndex = 1;
+		D1->ConstDefaultValue = 0.5f;
+		UMaterialExpressionTextureCoordinate* WardUv = Add<UMaterialExpressionTextureCoordinate>(*Ward, -1200, 200);
+		UMaterialExpressionTextureObjectParameter* WaveTex = Add<UMaterialExpressionTextureObjectParameter>(*Ward, -1200, 300);
+		WaveTex->ParameterName = TEXT("Wave");
+		WaveTex->Texture = Wave;
+		UMaterialExpressionCustom* Water = Add<UMaterialExpressionCustom>(*Ward, -600, 0);
+		Water->Description = TEXT("EpicWater");
+		Water->OutputType = CMOT_Float4;
+		Water->Inputs.Reset();
+		Input(*Water, TEXT("Uv"), WardUv);
+		Input(*Water, TEXT("D0"), D0);
+		Input(*Water, TEXT("D1"), D1);
+		Input(*Water, TEXT("T"), Add<UMaterialExpressionTime>(*Ward, -1200, 400));
+		Input(*Water, TEXT("Tex"), WaveTex);
+		Input(*Water, TEXT("Cover"), Scalar(*Ward, TEXT("Cover"), 0.78, 500));
+		Water->Code = TEXT(
