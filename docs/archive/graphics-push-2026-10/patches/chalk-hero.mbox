+struct FSurface
+{
+	const TCHAR* Texture = nullptr; // nullptr = plain tint
+	float Mode = 3.f;
+	float TileM = 2.4f;
+	float Roughness = 0.85f;
+	float Bump = 3.f;
+	float Metallic = 0.f;
+	FLinearColor Tint = FLinearColor::White;
+	bool bShadow = true;
+};
+
+/** Which epic surface a greybox colour stands for. Order matters where the layout repeats a colour. */
+bool SurfaceFor(const FArenaLayout& Layout, const FLinearColor& Colour, FSurface& Out)
+{
+	auto Is = [&Colour](const FLinearColor& Other)
+	{ return Colour.Equals(Other, 1.0e-3f); };
+	if (Is(Layout.Sand))
+	{
+		Out = {TEXT("T_EpicSand"), 1.f, 4.0f, 0.95f, 0.45f, 0.f, FLinearColor(1.f, 0.93f, 0.86f), false};
+		return true;
+	}
+	if (Is(Layout.Stone) || Is(Layout.WallColour))
+	{
+		Out = {TEXT("T_EpicStoneBlocks"), 0.f, 2.4f, 0.82f, 3.f, 0.f, FLinearColor(0.86f, 0.84f, 0.82f), true};
+		return true;
+	}
+	if (Is(Layout.Dais) || Is(Layout.PadRing) || Is(Layout.Seat))
+	{
+		Out = {TEXT("T_EpicFlagstone"), 0.f, 2.0f, 0.8f, 2.f, 0.f, Is(Layout.Dais) ? FLinearColor(0.75f, 0.70f, 0.64f) : FLinearColor(0.9f, 0.85f, 0.78f), true};
+		return true;
+	}
+	if (Is(Layout.Marker))
+	{
+		Out = {TEXT("T_EpicStoneBlocks"), 0.f, 1.2f, 0.85f, 2.f, 0.f, FLinearColor(0.55f, 0.50f, 0.46f), true};
+		return true;
+	}
+	if (Is(Layout.Brazier))
+	{
+		Out = {nullptr, 3.f, 1.f, 0.45f, 0.f, 0.7f, FLinearColor(0.06f, 0.055f, 0.05f), true};
+		return true;
+	}
+	if (Is(Layout.BannerPole))
+	{
+		Out = {nullptr, 3.f, 1.f, 0.6f, 0.f, 0.f, FLinearColor(0.10f, 0.06f, 0.035f), true};
+		return true;
+	}
+	if (Is(Layout.BannerCloth))
+	{
+		Out = {TEXT("T_EpicBanner"), 2.f, 1.f, 0.85f, 0.f, 0.f, FLinearColor::White, true};
+		return true;
+	}
+	return false;
+}
+
+void DressSurfaces(AActor& Arena, const FArenaLayout& Layout)
+{
+	UMaterialInterface* Master = LoadObject<UMaterialInterface>(nullptr, *(EpicLook::SurfaceFolder() / TEXT("M_EpicSurface.M_EpicSurface")));
+	UMaterialInterface* Basic = Greybox::BasicMaterial();
+	if (!Master)
+	{
+		UE_LOG(LogMageArena, Warning, TEXT("MAGEVR_LOOK epic surfaces missing (run -run=CreateEpicLookAssets); the greybox tints stay"));
+		return;
+	}
+	TInlineComponentArray<UStaticMeshComponent*> Parts(&Arena);
+	int32 Dressed = 0;
+	for (UStaticMeshComponent* Part : Parts)
+	{
+		UMaterialInstanceDynamic* Old = Cast<UMaterialInstanceDynamic>(Part->GetMaterial(0));
+		FLinearColor Colour;
+		FSurface Surface;
+		if (!Old || Old->Parent != Basic || !Old->GetVectorParameterValue(FHashedMaterialParameterInfo(TEXT("Color")), Colour) || !SurfaceFor(Layout, Colour, Surface))
+		{
+			continue;
+		}
+		UMaterialInstanceDynamic* Mid = UMaterialInstanceDynamic::Create(Master, &Arena);
+		if (Surface.Texture)
+		{
+			if (UTexture* Texture = LoadObject<UTexture>(nullptr, *FString::Printf(TEXT("%s/%s.%s"), *EpicLook::SurfaceFolder(), Surface.Texture, Surface.Texture)))
+			{
+				Mid->SetTextureParameterValue(TEXT("BaseTex"), Texture);
+			}
+		}
+		Mid->SetScalarParameterValue(TEXT("Mode"), Surface.Mode);
+		Mid->SetScalarParameterValue(TEXT("TileM"), Surface.TileM);
+		Mid->SetScalarParameterValue(TEXT("Roughness"), Surface.Roughness);
+		Mid->SetScalarParameterValue(TEXT("Bump"), Surface.Bump);
+		Mid->SetScalarParameterValue(TEXT("Metallic"), Surface.Metallic);
+		Mid->SetVectorParameterValue(TEXT("Tint"), Surface.Tint);
+		Part->SetMaterial(0, Mid);
+		Part->SetCastShadow(Surface.bShadow);
+		++Dressed;
+	}
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_LOOK epic surfaces dressed=%d"), Dressed);
+}
+
+void DressSkyAndLight(AActor& Arena, const FArenaLayout& Layout, AEpicLookRig& Rig)
+{
+	UWorld* World = Arena.GetWorld();
+	FActorSpawnParameters Params;
+	Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+
+	// The sun: low and warm, ahead of the seat and a little to its left (the seat's own forward, pad 1 where the pawn
+	// sits), so the sky beyond Brennic glows gold, he is rimmed, and long soft shadows run across the sand toward the
+	// seat. -MageArenaEpicSunAz= is the sun's azimuth from the seat's forward in degrees (0 = straight ahead, + = right).
+	double ViewYaw = 0.0;
+	if (Layout.Pads.IsValidIndex(1))
+	{
+		ViewYaw = Layout.FlatForwardM(Layout.Pads[1]).Rotation().Yaw;
+	}
+	const float SunPitch = ParamOr(TEXT("MageArenaEpicSunPitch="), 11.f);
+	const float SunYaw = static_cast<float>(ViewYaw) + ParamOr(TEXT("MageArenaEpicSunAz="), -55.f) + 180.f;
+	const float SunLux = ParamOr(TEXT("MageArenaEpicSunLux="), 6.f);
+	for (TActorIterator<ADirectionalLight> It(World); It; ++It)
+	{
+		It->SetActorRotation(FRotator(-SunPitch, SunYaw, 0.f));
+		if (UDirectionalLightComponent* Sun = Cast<UDirectionalLightComponent>(It->GetLightComponent()))
+		{
+			Sun->SetIntensity(SunLux);
+			Sun->SetLightColor(FLinearColor(1.f, 0.93f, 0.84f));
+			Sun->SetAtmosphereSunLight(true);
+			Sun->SetCastShadows(true);
+			Sun->SetLightSourceAngle(ParamOr(TEXT("MageArenaEpicSunAngle="), 2.2f));
+			Sun->SetVolumetricScatteringIntensity(1.5f);
+			Sun->bCastCloudShadows = true;
+			Sun->MarkRenderStateDirty();
+		}
+	}
+
+	ASkyAtmosphere* Atmosphere = World->SpawnActor<ASkyAtmosphere>(ASkyAtmosphere::StaticClass(), FTransform::Identity, Params);
+	if (USkyAtmosphereComponent* Sky = Atmosphere ? Atmosphere->GetComponent() : nullptr)
+	{
+		// A hazier, warmer golden hour than the clear default: more Mie, stronger forward scattering, a far haze on the
+		// stands (the arena is only 30 m across, so the aerial perspective is stretched).
+		Sky->SetMieScatteringScale(ParamOr(TEXT("MageArenaEpicMie="), 0.02f));
+		Sky->SetMieAnisotropy(0.82f);
+		Sky->SetAerialPespectiveViewDistanceScale(ParamOr(TEXT("MageArenaEpicAerial="), 6.f));
+		Sky->SetGroundAlbedo(FColor(150, 120, 80));
+		Sky->SetSkyLuminanceFactor(FLinearColor(1.35f, 1.0f, 0.7f));
+	}
+	// The painted golden-hour panorama (M_EpicSky) on a far sphere around the arena: the physical atmosphere alone
+	// renders a grey-brown sky at this sun height, S1's is a saturated gold with orange clouds. -MageArenaEpicNoPanorama
+	// shows the atmosphere (and its clouds) instead.
+	const bool bPanorama = !FParse::Param(FCommandLine::Get(), TEXT("MageArenaEpicNoPanorama"));
+	UMaterialInterface* SkyMaterial = bPanorama ? LoadObject<UMaterialInterface>(nullptr, *(EpicLook::SurfaceFolder() / TEXT("M_EpicSky.M_EpicSky"))) : nullptr;
+	if (UStaticMesh* Sphere = SkyMaterial ? Greybox::LoadShape(TEXT("Sphere")) : nullptr)
+	{
+		UMaterialInstanceDynamic* SkyMid = UMaterialInstanceDynamic::Create(SkyMaterial, &Rig);
+		SkyMid->SetScalarParameterValue(TEXT("ForwardYaw"), FMath::DegreesToRadians(static_cast<float>(ViewYaw)));
+		SkyMid->SetScalarParameterValue(TEXT("Gain"), ParamOr(TEXT("MageArenaEpicSkyGain="), 1.5f));
+		if (UStaticMeshComponent* Dome = Greybox::MakeMesh(&Rig, Sphere, SkyMid))
+		{
+			Greybox::SetSized(Dome, FVector(40000.0));
+			Dome->SetWorldLocation(FVector::ZeroVector);
+			Dome->SetCastShadow(false);
+			Dome->bAffectDistanceFieldLighting = false;
+			Dome->SetAffectDynamicIndirectLighting(false);
+		}
+	}
+	if (!bPanorama && !FParse::Param(FCommandLine::Get(), TEXT("MageArenaEpicNoClouds")))
+	{
+		AVolumetricCloud* Clouds = World->SpawnActor<AVolumetricCloud>(AVolumetricCloud::StaticClass(), FTransform::Identity, Params);
+		UVolumetricCloudComponent* Cloud = Clouds ? Clouds->FindComponentByClass<UVolumetricCloudComponent>() : nullptr;
+		if (Cloud)
+		{
+			if (UMaterialInterface* CloudMaterial = LoadObject<UMaterialInterface>(nullptr, TEXT("/Engine/EngineSky/VolumetricClouds/m_SimpleVolumetricCloud_Inst.m_SimpleVolumetricCloud_Inst")))
+			{
+				Cloud->SetMaterial(CloudMaterial);
+			}
+			Cloud->SetLayerBottomAltitude(2.5f);
+			Cloud->SetLayerHeight(5.f);
+		}
+	}
+
+	for (TActorIterator<ASkyLight> It(World); It; ++It)
+	{
+		if (USkyLightComponent* Light = It->GetLightComponent())
+		{
+			Light->SourceType = ESkyLightSourceType::SLS_CapturedScene;
+			Light->SetRealTimeCapture(true);
+			Light->SetIntensity(ParamOr(TEXT("MageArenaEpicSkyLight="), 1.1f));
+			Light->SetLightColor(FLinearColor::White);
+			Light->bLowerHemisphereIsBlack = false;
+			Light->SetLowerHemisphereColor(FLinearColor(0.35f, 0.24f, 0.14f));
+			Light->RecaptureSky();
+		}
+	}
+
+	AExponentialHeightFog* Fog = nullptr;
+	for (TActorIterator<AExponentialHeightFog> It(World); It; ++It)
+	{
+		Fog = *It;
+	}
+	Fog = Fog ? Fog : World->SpawnActor<AExponentialHeightFog>(AExponentialHeightFog::StaticClass(), FTransform::Identity, Params);
+	if (UExponentialHeightFogComponent* Haze = Fog ? Fog->GetComponent() : nullptr)
+	{
+		Haze->SetFogDensity(ParamOr(TEXT("MageArenaEpicFog="), 0.012f));
+		Haze->SetFogHeightFalloff(0.35f);
+		Haze->SetFogInscatteringColor(FLinearColor(0.45f, 0.30f, 0.18f));
+		Haze->SetDirectionalInscatteringColor(FLinearColor(0.9f, 0.55f, 0.25f));
+		Haze->SetStartDistance(300.f);
+		Haze->SetFogCutoffDistance(0.f);
+		Haze->SetVolumetricFog(true);
+		Haze->SetVolumetricFogScatteringDistribution(0.6f);
+		Haze->SetVolumetricFogExtinctionScale(0.6f);
+		Haze->SetVolumetricFogAlbedo(FColor(255, 225, 190));
+	}
+
+	// The braziers burn: a warm point light above each bowl, flickering (AEpicLookRig::Tick).
+	const float BrazierCandela = ParamOr(TEXT("MageArenaEpicBrazierCd="), 40.f);
+	for (const FArenaProp& Prop : Layout.Braziers)
+	{
+		UPointLightComponent* Light = NewObject<UPointLightComponent>(&Rig);
+		Light->SetMobility(EComponentMobility::Movable);
+		Light->SetupAttachment(Rig.GetRootComponent());
+		Light->RegisterComponent();
+		// In the flame, above the lip; no shadow, so the bowl does not print a dark disc on the sand beneath it.
+		Light->SetWorldLocation(FVector(Prop.PositionM.X, Prop.PositionM.Y, Prop.StandHeightM + Prop.BowlHeightM + 0.3) * 100.0);
+		Light->SetIntensityUnits(ELightUnits::Candelas);
+		Light->SetLightColor(FLinearColor(1.f, 0.52f, 0.2f));
+		Light->SetAttenuationRadius(1600.f);
+		Light->SetSourceRadius(18.f);
+		Light->SetCastShadows(false);
+		Light->SetVolumetricScatteringIntensity(2.f);
+		Rig.AddBrazierLight(Light, BrazierCandela);
+	}
+}
+
+void DressPost(AEpicLookRig& Rig)
+{
+	UWorld* World = Rig.GetWorld();
+	FActorSpawnParameters Params;
+	Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+	APostProcessVolume* Volume = World->SpawnActor<APostProcessVolume>(APostProcessVolume::StaticClass(), FTransform::Identity, Params);
+	if (!Volume)
+	{
+		return;
+	}
+	Volume->bUnbound = true;
+	Volume->Priority = 10.f;
+	FPostProcessSettings& S = Volume->Settings;
+	S.bOverride_DynamicGlobalIlluminationMethod = true;
+	S.DynamicGlobalIlluminationMethod = EDynamicGlobalIlluminationMethod::Lumen;
+	S.bOverride_ReflectionMethod = true;
+	S.ReflectionMethod = EReflectionMethod::Lumen;
+	S.bOverride_LumenSceneLightingQuality = true;
+	S.LumenSceneLightingQuality = 2.f;
+	S.bOverride_LumenFinalGatherQuality = true;
+	S.LumenFinalGatherQuality = 2.f;
+	// Fixed exposure, so a round's stills compare; the filmic curve stays on (only flat turns the tonemapper off).
+	S.bOverride_AutoExposureMethod = true;
+	S.AutoExposureMethod = AEM_Manual;
+	S.bOverride_AutoExposureApplyPhysicalCameraExposure = true;
+	S.AutoExposureApplyPhysicalCameraExposure = 0;
+	S.bOverride_AutoExposureBias = true;
+	S.AutoExposureBias = ParamOr(TEXT("MageArenaEpicEV="), 0.2f);
+	S.bOverride_LocalExposureHighlightContrastScale = true;
+	S.LocalExposureHighlightContrastScale = 0.8f;
+	S.bOverride_LocalExposureShadowContrastScale = true;
+	S.LocalExposureShadowContrastScale = 0.8f;
+	S.bOverride_BloomIntensity = true;
+	S.BloomIntensity = ParamOr(TEXT("MageArenaEpicBloom="), 0.9f);
+	S.bOverride_VignetteIntensity = true;
+	S.VignetteIntensity = 0.35f;
+	S.bOverride_MotionBlurAmount = true;
+	S.MotionBlurAmount = 0.f;
+	S.bOverride_LensFlareIntensity = true;
+	S.LensFlareIntensity = 0.f;
+	S.bOverride_AmbientOcclusionIntensity = true;
+	S.AmbientOcclusionIntensity = 0.6f;
+	// The grade: a warm white balance and orange-teal split, gentle (S1: warm orange against teal, light haze, glow).
+	S.bOverride_WhiteTemp = true;
+	S.WhiteTemp = ParamOr(TEXT("MageArenaEpicWhiteTemp="), 6600.f);
+	S.bOverride_ColorSaturation = true;
+	S.ColorSaturation = FVector4(1.1, 1.1, 1.1, 1.0);
+	S.bOverride_ColorContrast = true;
+	S.ColorContrast = FVector4(1.06, 1.06, 1.06, 1.0);
+	S.bOverride_ColorOffsetShadows = true;
+	S.ColorOffsetShadows = FVector4(-0.004, 0.002, 0.008, 0.0);
+	S.bOverride_ColorGainHighlights = true;
+	S.ColorGainHighlights = FVector4(1.04, 1.0, 0.94, 1.0);
+	Rig.Post = Volume;
+}
+}
