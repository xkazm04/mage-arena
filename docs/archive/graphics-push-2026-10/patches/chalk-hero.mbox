--- a/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestSpellAssetsCommandlet.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestSpellAssetsCommandlet.cpp
@@ -348,6 +348,63 @@ bool BuildEnvFire(UTexture2D* Flame)
 
 // A soft additive halo (no texture): the glow round a bolt, a fire or a rune, in Color. Bloom does this on desktop; on
 // Quest with MobileHDR off this card is the only glow there is.
+// S5 (judges: the flipbook's core read as "a smooth additive glow"): the fire drawn in chalk over Tier B's flipbook
+// (T_FireSprite, 8 x 8 cells, ~18 fps). Its luminance is laid as four flat pastel bands on the warm ramp (deep red,
+// vermilion, orange, yellow, a white-yellow hot core), each band edge drawn as a broken chalk stroke, a ragged chalk rim
+// where the flame thins, and a soft pastel grain (smooth value noise, no pixel noise). The emission is capped so the bloom
+// stays subdued and the line work survives. Additive on black, one draw for every bolt (the flipbook's ISM).
+const TCHAR* ChalkFireCode = TEXT(
+    "float f = floor(fmod(T * 18.0 + Phase * 64.0, 64.0));\n"
+    "float2 cell = float2(fmod(f, 8.0), floor(f / 8.0));\n"
+    "float2 uv = (cell + clamp(Uv, 0.002, 0.998)) / 8.0;\n"
+    "float3 c = Texture2DSample(Fire, FireSampler, uv).rgb;\n"
+    "float l = saturate(dot(c, float3(0.4, 0.45, 0.15)) * 1.15);\n"
+    "float2 g = Uv * 34.0;\n"
+    "float2 gi = floor(g); float2 gf = frac(g); gf = gf * gf * (3.0 - 2.0 * gf);\n"
+    "float h00 = frac(sin(dot(gi, float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float h10 = frac(sin(dot(gi + float2(1, 0), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float h01 = frac(sin(dot(gi + float2(0, 1), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float h11 = frac(sin(dot(gi + float2(1, 1), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float grain = lerp(lerp(h00, h10, gf.x), lerp(h01, h11, gf.x), gf.y);\n"
+    "float streak = frac(sin(floor((Uv.x + Uv.y * 0.35) * 90.0) * 57.31) * 4375.85);\n"
