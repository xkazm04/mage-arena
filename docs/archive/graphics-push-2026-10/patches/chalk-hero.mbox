 1 file changed, 54 insertions(+), 6 deletions(-)

diff --git a/apps/vr/tools/keyart/studio-still.mts b/apps/vr/tools/keyart/studio-still.mts
index effee96..cef8120 100644
--- a/apps/vr/tools/keyart/studio-still.mts
+++ b/apps/vr/tools/keyart/studio-still.mts
@@ -7,13 +7,55 @@
 //   npx tsx C:/Users/kazda/kiro/mage-arena/apps/vr/tools/keyart/studio-still.mts health
 //   npx tsx C:/Users/kazda/kiro/mage-arena/apps/vr/tools/keyart/studio-still.mts gen --aspect 1:1 --out <file.png> --prompt "<text>"
 // One image per call. The prompt file form (--prompt-file) avoids shell quoting. Every call appends one line to
-// <out dir>/studio-log.jsonl (prompt, aspect, generation id, cleanup, credits), never the API key.
+// <out dir>/studio-log.jsonl (prompt, aspect, generation id, cleanup, credits, style, slot), never the API key.
+//
+// Style composition (apps/vr/art/style/README.md): --style <id> --slot <slot> (or --style <id> --subject-file <txt>
+// --kind texture|figure|vfx|sky) builds the prompt from apps/vr/art/style/<id>/style.json as
+//   STYLE BLOCK + the slot's subject + the suffix of the slot's kind + "Avoid: " + the opposites,
+// and takes the slot's aspect unless --aspect is given. --dry prints the composed prompt and the aspect and spends nothing.
+//   npx tsx .../studio-still.mts gen --style chalk --slot sand --dry
 
 import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
 import { dirname, join, resolve } from "node:path";
-import { pathToFileURL } from "node:url";
+import { fileURLToPath, pathToFileURL } from "node:url";
 
 const GRAVITONE = process.env.GRAVITONE_ROOT ?? "C:/Users/kazda/kiro/gravitone-gcloud";
+const STYLE_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "../../art/style");
+
+interface StyleSlot {
+  kind: string;
+  aspect?: string;
+  subject?: string;
+}
+
+interface StyleManifest {
+  id: string;
+  styleBlock: string;
+  opposites: string;
+  suffixes: Record<string, string>;
+  slots: Record<string, StyleSlot>;
+}
+
+/** The composed prompt and aspect for a style and a slot (or a subject file and kind), from the style's manifest. */
+function composeFromStyle(styleId: string): { prompt: string; aspect?: string; slot: string } {
+  const manifest = JSON.parse(readFileSync(join(STYLE_ROOT, styleId, "style.json"), "utf8")) as StyleManifest;
+  const slotName = arg("slot");
+  const slot = slotName ? manifest.slots[slotName] : undefined;
+  if (slotName && !slot) {
+    throw new Error(`style ${styleId} has no slot ${slotName} (slots: ${Object.keys(manifest.slots).join(", ")})`);
+  }
+  const subject = arg("subject-file") ? readFileSync(arg("subject-file")!, "utf8").trim() : slot?.subject;
+  const kind = arg("kind") ?? slot?.kind;
+  if (!subject || !kind) {
+    throw new Error("--style needs --slot <slot> (with a subject) or --subject-file <txt> --kind texture|figure|vfx|sky");
+  }
+  const suffix = manifest.suffixes[kind];
+  if (suffix === undefined) {
+    throw new Error(`style ${styleId} has no suffix for kind ${kind}`);
+  }
+  const prompt = [manifest.styleBlock, subject, suffix, `Avoid: ${manifest.opposites}`].map((part) => part.trim()).join(" ");
+  return { prompt, aspect: slot?.aspect, slot: slotName ?? `subject:${arg("subject-file")}` };
+}
 
 function loadEnvLocal(): void {
   let text = "";
@@ -43,12 +85,18 @@ async function main(): Promise<void> {
     return;
   }
   if (cmd !== "gen") {
-    console.error("usage: studio-still.mts health | gen --aspect 1:1|16:9|9:16 --out <file> (--prompt <text> | --prompt-file <file>) [--quality low|medium]");
+    console.error("usage: studio-still.mts health | gen [--aspect 1:1|16:9|9:16] --out <file> (--prompt <text> | --prompt-file <file> | --style <id> (--slot <slot> | --subject-file <txt> --kind <kind>)) [--quality low|medium] [--dry]");
     process.exit(2);
   }
-  const aspect = arg("aspect") ?? "1:1";
+  const styleId = arg("style");
+  const composed = styleId ? composeFromStyle(styleId) : undefined;
+  const aspect = arg("aspect") ?? composed?.aspect ?? "1:1";
   const out = arg("out");
-  const prompt = arg("prompt") ?? (arg("prompt-file") ? readFileSync(arg("prompt-file")!, "utf8").trim() : undefined);
+  const prompt = composed?.prompt ?? arg("prompt") ?? (arg("prompt-file") ? readFileSync(arg("prompt-file")!, "utf8").trim() : undefined);
+  if (process.argv.includes("--dry")) {
+    console.log(JSON.stringify({ dry: true, style: styleId, slot: composed?.slot, aspect, prompt }, null, 2));
+    return;
+  }
   if (!out || !prompt) {
     console.error("gen needs --out and --prompt or --prompt-file");
     process.exit(2);
@@ -61,7 +109,7 @@ async function main(): Promise<void> {
   mkdirSync(dirname(path), { recursive: true });
   writeFileSync(path, Buffer.from(image.base64, "base64"));
   const p = result.provenance as { remoteIds?: string[]; cleanup?: string; studio?: { credits?: number; balance?: number }; model?: string };
-  const line = { at: new Date().toISOString(), out: path, aspect, quality, model: p.model, id: p.remoteIds?.[0], cleanup: p.cleanup, credits: p.studio?.credits, balance: p.studio?.balance, prompt };
+  const line = { at: new Date().toISOString(), out: path, aspect, quality, model: p.model, id: p.remoteIds?.[0], cleanup: p.cleanup, credits: p.studio?.credits, balance: p.studio?.balance, style: styleId, slot: composed?.slot, prompt };
   appendFileSync(join(dirname(path), "studio-log.jsonl"), JSON.stringify(line) + "\n");
   console.log(JSON.stringify({ ...line, prompt: undefined, width: image.width, height: image.height }));
   if (p.cleanup !== "deleted") console.error(`WARNING: studio generation ${p.remoteIds?.[0]} was NOT deleted; delete it by hand in the studio.`);
