+#pragma once
+
+#include "CoreMinimal.h"
+#include "Commandlets/Commandlet.h"
+#include "CreateCuffStyledCommandlet.generated.h"
+
+/**
+ * Graphics push 10-28, shared: the styled wrist cuff (Look/CuffLook.h) in /Game/Look/Shared/Cuff. M_CuffStyled is the
+ * panel: unlit translucent, a texture parameter Mask (the cuff masks ShowMask sets, as on the engine pass-through), its
+ * icons warmed and softened, at 60 % cover, with a bronze frame drawn round the plane's edge. M_CuffRune is a bar: an
+ * unlit glowing strip in Color, brightest along its middle. Mobile-safe nodes only.
+ * Usage: -run=CreateCuffStyled. Editor builds only.
+ */
+UCLASS()
+class MAGEARENAVR_API UCreateCuffStyledCommandlet : public UCommandlet
+{
+	GENERATED_BODY()
+
+public:
+	UCreateCuffStyledCommandlet();
+	virtual int32 Main(const FString& Params) override;
+};
