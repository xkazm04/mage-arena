@@ -0,0 +1,77 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "EpicLook.generated.h"
+
+class APostProcessVolume;
+class UPointLightComponent;
+struct FArenaLayout;
+
+/**
+ * The epic look (graphics push 10-28, Tier B, docs/concepts/GRAPHICS-PUSH-2026-10-28.md): the desktop showcase. Applied
+ * only under -MageArenaLook=epic, on top of the greybox the arena actor built: textured world-aligned surfaces
+ * (M_EpicSurface), a sky atmosphere with volumetric clouds and a low warm sun with soft virtual shadows, a real-time sky
+ * light, volumetric haze, the braziers as flickering lights, Lumen GI and reflections, filmic tone curve, bloom, a mild
+ * warm/teal grade, and Brennic's epic material (Look/BrennicEpicLook.h).
+ *
+ * Deferred shading, distance fields and virtual shadow maps are start-up settings, so the project stays forward (flat and
+ * quest unchanged) and an epic run passes them on its command line: EpicLook::LaunchIniOverrides(), used by
+ * apps/vr/tools/capture-epic.ps1.
+ *
+ * -MageArenaEpicShot=<dir> takes stills once shaders have compiled and the light has settled: game.png from the game
+ * camera, then keyart.png from a narrower camera on the same eye framing Brennic (the key-art aid), logs the frame time
+ * (MAGEVR_EPIC_FRAME) and quits.
+ */
+namespace EpicLook
+{
+/** /Game/Look/Epic/Surfaces: the surface textures and M_EpicSurface. */
+FString SurfaceFolder();
+
+/** The -ini: overrides an epic run needs at start-up (deferred, distance fields, Lumen, VSM, TSR). */
+FString LaunchIniOverrides();
+
+/** Dresses the arena Arena built (its components, the world's lights) and spawns the rig. Epic look only. */
+void DressArena(AActor& Arena, const FArenaLayout& Layout);
+}
+
+/** Owns the epic look's runtime pieces: the brazier lights' flicker, Brennic's material swap, the post volume, the stills. */
+UCLASS()
+class MAGEARENAVR_API AEpicLookRig : public AActor
+{
+	GENERATED_BODY()
+
+public:
+	AEpicLookRig();
+	virtual void Tick(float DeltaSeconds) override;
+
+	void AddBrazierLight(UPointLightComponent* Light, float BaseCandela);
+
+	UPROPERTY()
+	TObjectPtr<APostProcessVolume> Post;
+
+private:
+	void TickShot(float DeltaSeconds);
+	void TickSpellLights();
+	void PlaceKeyArtCamera();
+
+	UPROPERTY()
+	TArray<TObjectPtr<UPointLightComponent>> BrazierLights;
+
+	TArray<float> BrazierBase;
+
+	/** One light per visible spell-glow colour layer (pooled), so a bolt lights the rival and the sand it passes. */
+	UPROPERTY()
+	TArray<TObjectPtr<UPointLightComponent>> SpellLights;
+	float BrennicCheck = 0.f;
+
+	// -MageArenaEpicShot
+	FString ShotDir;
+	int32 ShotStage = 0;
+	float StageTime = 0.f;
+	float SettledTime = 0.f;
+	double GameMsSum = 0.0;
+	double GpuMsSum = 0.0;
+	int32 Frames = 0;
+	FString PendingShot;
+};
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/EpicSurfaceHlsl.h b/apps/vr/Game/Source/MageArenaVR/Look/EpicSurfaceHlsl.h
new file mode 100644
index 0000000..7bacb85
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/EpicSurfaceHlsl.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+/**
+ * The HLSL of M_EpicSurface (Tools/CreateEpicLookAssetsCommandlet), kept apart so the shader text is readable.
+ * Inputs of both Custom nodes: WP absolute world position (cm), WN vertex normal (world), UV, Tex (BaseTex object, sampler
+ * TexSampler), Tint, TileM (metres per texture repeat), Mode (0 triplanar texture, 1 triplanar texture plus sand ripples and
+ * grain, 2 banner: BaseTex on the cube face's own UV, 3 plain tint), Rough, Bump.
+ * The texture is always sampled outside any branch (gradients in flow control), then the mode selects.
+ */
+namespace EpicSurfaceHlsl
+{
+inline const TCHAR* Prelude()
+{
+	return TEXT(
+	    "struct EpicSurf\n"
+	    "{\n"
+	    "    float H(float2 p) { p = frac(p * float2(123.34, 456.21)); p += dot(p, p + 45.32); return frac(p.x * p.y); }\n"
+	    "    float VN(float2 p) { float2 i = floor(p); float2 f = frac(p); f = f * f * (3.0 - 2.0 * f);\n"
+	    "        return lerp(lerp(H(i), H(i + float2(1, 0)), f.x), lerp(H(i + float2(0, 1)), H(i + float2(1, 1)), f.x), f.y); }\n"
+	    "    float FBM(float2 p) { float s = 0; float a = 0.5; for (int k = 0; k < 4; k++) { s += a * VN(p); p = p * 2.03 + 17.1; a *= 0.5; } return s; }\n"
+	    "    float Rake(float2 p) { return sin(p.y * 28.56 + FBM(p * 1.3) * 5.0); }\n"
+	    "    float SandH(float2 p) { return FBM(p * 0.6) * 0.5 + Rake(p) * 0.025 * FBM(p * 0.25 + 3.0) + FBM(p * 9.0) * 0.05; }\n"
+	    "};\n"
+	    "EpicSurf S;\n"
+	    "float3 P = WP / 100.0;\n"
+	    "float3 N = normalize(WN);\n"
+	    "float3 W = pow(abs(N), 6.0); W /= max(W.x + W.y + W.z, 1e-4);\n"
+	    "float2 ux = P.yz / TileM; float2 uy = P.xz / TileM; float2 uz = P.xy / TileM;\n"
+	    "float3 tx = Texture2DSample(Tex, TexSampler, ux).rgb;\n"
+	    "float3 ty = Texture2DSample(Tex, TexSampler, uy).rgb;\n"
+	    "float3 tz = Texture2DSample(Tex, TexSampler, uz).rgb;\n"
+	    "float3 tri = tx * W.x + ty * W.y + tz * W.z;\n"
+	    "float2 buv = float2(UV.x, UV.y * 0.78);\n"
+	    "float3 ban = Texture2DSample(Tex, TexSampler, buv).rgb;\n"
+	    "float macro = S.FBM(P.xy * 0.35 + P.z * 0.2);\n");
+}
+
+inline FString ColourCode()
+{
+	return FString(Prelude()) + TEXT("float3 col = Tint * (0.85 + 0.3 * macro);\n"
+	                                 "float rough = Rough;\n"
+	                                 "if (Mode < 1.5)\n"
+	                                 "{\n"
+	                                 "    col = tri * Tint * (0.86 + 0.28 * macro);\n"
+	                                 "    rough = saturate(Rough + (0.45 - dot(tri, float3(0.3, 0.59, 0.11))) * 0.25);\n"
+	                                 "}\n"
+	                                 "if (Mode > 0.5 && Mode < 1.5)\n"
+	                                 "{\n"
+	                                 "    float grain = S.H(floor(P.xy * 260.0));\n"
+	                                 "    float rake = S.Rake(P.xy);\n"
+	                                 "    col *= (0.95 + 0.10 * grain) * (1.0 - 0.025 * rake);\n"
+	                                 "}\n"
+	                                 "if (Mode > 1.5 && Mode < 2.5)\n"
+	                                 "{\n"
+	                                 "    col = ban * Tint;\n"
+	                                 "    rough = 0.85;\n"
+	                                 "}\n"
+	                                 "return float4(col, rough);\n");
+}
+
+inline FString NormalCode()
+{
+	return FString(Prelude()) + TEXT("if (Bump <= 0.0 || Mode > 1.5) { return N; }\n"
+	                                 "float d = 1.0 / 384.0;\n"
+	                                 "float3 L = float3(0.3, 0.59, 0.11);\n"
+	                                 "float hx = dot(tx, L); float hy = dot(ty, L); float hz = dot(tz, L);\n"
+	                                 "float3 g = 0;\n"
+	                                 "g += W.x * float3(0, dot(Texture2DSample(Tex, TexSampler, ux + float2(d, 0)).rgb, L) - hx, dot(Texture2DSample(Tex, TexSampler, ux + float2(0, d)).rgb, L) - hx);\n"
+	                                 "g += W.y * float3(dot(Texture2DSample(Tex, TexSampler, uy + float2(d, 0)).rgb, L) - hy, 0, dot(Texture2DSample(Tex, TexSampler, uy + float2(0, d)).rgb, L) - hy);\n"
+	                                 "g += W.z * float3(dot(Texture2DSample(Tex, TexSampler, uz + float2(d, 0)).rgb, L) - hz, dot(Texture2DSample(Tex, TexSampler, uz + float2(0, d)).rgb, L) - hz, 0);\n"
+	                                 "g *= Bump;\n"
+	                                 "if (Mode > 0.5)\n"
+	                                 "{\n"
+	                                 "    float e = 0.01;\n"
+	                                 "    float h0 = S.SandH(P.xy);\n"
+	                                 "    g += float3((S.SandH(P.xy + float2(e, 0)) - h0) / e, (S.SandH(P.xy + float2(0, e)) - h0) / e, 0) * 0.08 * W.z;\n"
+	                                 "}\n"
+	                                 "return normalize(N - (g - dot(g, N) * N));\n");
+}
+
+/** M_EpicSky: Tex is the 16:9 panorama; its middle faces the seat's forward (ForwardYaw, radians), HalfWidthDeg either
+ * side, mirrored beyond; its horizon row is HorizonV and its top is SpanDeg above the horizon. */
+inline const TCHAR* SkyCode()
+{
+	return TEXT(
+	    "float3 d = normalize(WP - Cam);\n"
+	    "float az = atan2(d.y, d.x) - ForwardYaw;\n"
+	    "az = atan2(sin(az), cos(az));\n"
+	    "float u = 0.5 + az / (2.0 * radians(HalfWidthDeg));\n"
+	    "u = abs(u); u = fmod(u, 2.0); u = u > 1.0 ? 2.0 - u : u;\n"
+	    "float el = asin(clamp(d.z, -1.0, 1.0));\n"
+	    "float v = HorizonV - el / radians(SpanDeg) * HorizonV;\n"
+	    "v = clamp(v, 0.002, 0.998);\n"
+	    "return Texture2DSampleLevel(Tex, TexSampler, float2(u, v), 0).rgb * Gain;\n");
+}
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreateEpicLookAssetsCommandlet.cpp b/apps/vr/Game/Source/MageArenaVR/Tools/CreateEpicLookAssetsCommandlet.cpp
new file mode 100644
index 0000000..314e261
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreateEpicLookAssetsCommandlet.cpp
@@ -0,0 +1,156 @@
+#include "Tools/CreateEpicLookAssetsCommandlet.h"
+
+#include "Look/EpicLook.h"
+#include "Look/EpicSurfaceHlsl.h"
+#include "MageArenaVR.h"
+#include "Misc/Paths.h"
+#include "Tools/MaterialGraph.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Materials/MaterialExpressionCameraPositionWS.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureObjectParameter.h"
+#include "Materials/MaterialExpressionVertexNormalWS.h"
+#include "Materials/MaterialExpressionWorldPosition.h"
+#include "ShaderCompiler.h"
+#endif
+
+UCreateEpicLookAssetsCommandlet::UCreateEpicLookAssetsCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UCreateEpicLookAssetsCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	FString Source = FPaths::Combine(FPaths::ProjectContentDir(), TEXT("Look/Epic/Source"));
+	FParse::Value(*Params, TEXT("source="), Source);
+	Source = FPaths::ConvertRelativePathToFull(Source);
+	const FString Folder = EpicLook::SurfaceFolder();
+	const TPair<const TCHAR*, const TCHAR*> Files[] = {{TEXT("stone-blocks-01.png"), TEXT("T_EpicStoneBlocks")}, {TEXT("sand-01.png"), TEXT("T_EpicSand")},
+	    {TEXT("flagstone-01.png"), TEXT("T_EpicFlagstone")}, {TEXT("banner-01.png"), TEXT("T_EpicBanner")}, {TEXT("sky-01.png"), TEXT("T_EpicSky")}};
+	UTexture2D* Stone = nullptr;
+	UTexture2D* SkyTexture = nullptr;
+	for (const TPair<const TCHAR*, const TCHAR*>& File : Files)
+	{
+		UTexture2D* Texture = ImportTexture(Source / File.Key, Folder, File.Value, false, TC_Default);
+		if (!Texture)
+		{
+			return 1;
+		}
+		Stone = Stone ? Stone : Texture;
+		SkyTexture = Texture;
+	}
+
+	UMaterial* Material = NewMaterial(Folder, TEXT("M_EpicSurface"));
+	Material->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	Material->bTangentSpaceNormal = false;
+	UMaterialEditorOnlyData* Editor = Material->GetEditorOnlyData();
+
+	UMaterialExpressionWorldPosition* Position = Add<UMaterialExpressionWorldPosition>(*Material, -1400, 0);
+	UMaterialExpressionVertexNormalWS* VertexNormal = Add<UMaterialExpressionVertexNormalWS>(*Material, -1400, 100);
+	UMaterialExpressionTextureCoordinate* Uv = Add<UMaterialExpressionTextureCoordinate>(*Material, -1400, 200);
+	UMaterialExpressionTextureObjectParameter* Tex = Add<UMaterialExpressionTextureObjectParameter>(*Material, -1400, 300);
+	Tex->ParameterName = TEXT("BaseTex");
+	Tex->Texture = Stone;
+	UMaterialExpression* Tint = Vector(*Material, TEXT("Tint"), FLinearColor::White, 400);
+	UMaterialExpression* TileM = Scalar(*Material, TEXT("TileM"), 2.4, 500);
+	UMaterialExpression* Mode = Scalar(*Material, TEXT("Mode"), 0.0, 560);
+	UMaterialExpression* Rough = Scalar(*Material, TEXT("Roughness"), 0.85, 620);
+	UMaterialExpression* Bump = Scalar(*Material, TEXT("Bump"), 3.0, 680);
+
+	auto MakeCustom = [&](const TCHAR* Description, ECustomMaterialOutputType Type, const FString& Code, int32 Y)
+	{
+		UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Material, -600, Y);
+		Custom->Description = Description;
+		Custom->OutputType = Type;
+		Custom->Code = Code;
+		Custom->Inputs.Reset();
+		Input(*Custom, TEXT("WP"), Position);
+		Input(*Custom, TEXT("WN"), VertexNormal);
+		Input(*Custom, TEXT("UV"), Uv);
+		Input(*Custom, TEXT("Tex"), Tex);
+		Input(*Custom, TEXT("Tint"), Tint);
+		Input(*Custom, TEXT("TileM"), TileM);
+		Input(*Custom, TEXT("Mode"), Mode);
+		Input(*Custom, TEXT("Rough"), Rough);
+		Input(*Custom, TEXT("Bump"), Bump);
+		return Custom;
+	};
+	UMaterialExpressionCustom* Colour = MakeCustom(TEXT("EpicSurfaceColour"), CMOT_Float4, EpicSurfaceHlsl::ColourCode(), 0);
+	UMaterialExpressionCustom* Normal = MakeCustom(TEXT("EpicSurfaceNormal"), CMOT_Float3, EpicSurfaceHlsl::NormalCode(), 400);
+	UMaterialExpressionComponentMask* Rgb = Add<UMaterialExpressionComponentMask>(*Material, -300, 0);
+	Rgb->Input.Connect(0, Colour);
+	Rgb->R = Rgb->G = Rgb->B = true;
+	Rgb->A = false;
+	UMaterialExpressionComponentMask* Alpha = Add<UMaterialExpressionComponentMask>(*Material, -300, 120);
+	Alpha->Input.Connect(0, Colour);
+	Alpha->R = Alpha->G = Alpha->B = false;
+	Alpha->A = true;
+	Editor->BaseColor.Connect(0, Rgb);
+	Editor->Roughness.Connect(0, Alpha);
+	Editor->Normal.Connect(0, Normal);
+	Editor->Metallic.Connect(0, Scalar(*Material, TEXT("Metallic"), 0.0, 740));
+	Editor->Specular.Connect(0, Scalar(*Material, TEXT("Specular"), 0.4, 800));
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+
+	// M_EpicSky: the painted golden-hour panorama on a far sphere, looked up by view direction (so it sits at infinity),
+	// unlit, two-sided, a sky material so the real-time sky light captures it (Look/EpicSurfaceHlsl.h SkyCode).
+	UMaterial* Sky = NewMaterial(Folder, TEXT("M_EpicSky"));
+	Sky->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Sky->SetShadingModel(MSM_Unlit);
+	Sky->TwoSided = true;
+	Sky->bIsSky = true;
+	{
+		UMaterialExpressionWorldPosition* SkyPosition = Add<UMaterialExpressionWorldPosition>(*Sky, -1400, 0);
+		UMaterialExpressionCameraPositionWS* Camera = Add<UMaterialExpressionCameraPositionWS>(*Sky, -1400, 100);
+		UMaterialExpressionTextureObjectParameter* SkyTex = Add<UMaterialExpressionTextureObjectParameter>(*Sky, -1400, 200);
+		SkyTex->ParameterName = TEXT("SkyTex");
+		SkyTex->Texture = SkyTexture;
+		UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Sky, -600, 0);
+		Custom->Description = TEXT("EpicSkyPanorama");
+		Custom->OutputType = CMOT_Float3;
+		Custom->Code = EpicSurfaceHlsl::SkyCode();
+		Custom->Inputs.Reset();
+		Input(*Custom, TEXT("WP"), SkyPosition);
+		Input(*Custom, TEXT("Cam"), Camera);
+		Input(*Custom, TEXT("Tex"), SkyTex);
+		Input(*Custom, TEXT("ForwardYaw"), Scalar(*Sky, TEXT("ForwardYaw"), 0.0, 300));
+		Input(*Custom, TEXT("HalfWidthDeg"), Scalar(*Sky, TEXT("HalfWidthDeg"), 75.0, 360));
+		Input(*Custom, TEXT("HorizonV"), Scalar(*Sky, TEXT("HorizonV"), 0.84, 420));
+		Input(*Custom, TEXT("SpanDeg"), Scalar(*Sky, TEXT("SpanDeg"), 40.0, 480));
+		Input(*Custom, TEXT("Gain"), Scalar(*Sky, TEXT("Gain"), 1.5, 540));
+		Sky->GetEditorOnlyData()->EmissiveColor.Connect(0, Custom);
+	}
+	Sky->PreEditChange(nullptr);
+	Sky->PostEditChange();
+	Sky->MarkPackageDirty();
+	Sky->ForceRecompileForRendering();
+
+	Material->ForceRecompileForRendering();
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done surfaces saved=%d from %s"), Saved, *Source);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
