+#pragma once
+
+#include "CoreMinimal.h"
+
+class AActor;
+
+/**
+ * The painted crowd under the non-flat looks (graphics push 10-28, shared asset; flat keeps the T57/T65 clay cards and
+ * their tint tests). T_CrowdPainted (apps/vr/art/crowd-painted/pack_crowd.py, two studio stills of colourful cheering
+ * spectators) holds five painted figures per T57 variant at that variant's card aspect, so each card keeps its size,
+ * place and orientation and only its atlas rect and material change. The flat-colour banner instances stay flat.
+ */
+namespace CrowdLook
+{
+/** /Game/Look/Shared/Crowd: T_CrowdPainted and M_CrowdPainted (Tools/CreateCrowdPaintedCommandlet). */
+FString Folder();
+
+/** Re-points Arena's crowd cards at the painted figures. Nothing under flat or when the assets are missing. */
+void Apply(AActor& Arena);
+}
