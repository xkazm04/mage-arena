     return type(default)(sys.argv[sys.argv.index(name) + 1]) if name in sys.argv else default
 
 
+def chalk_edge(f, seed=3911):
+    """Round 3 (judges: give the fire a loose chalk-stroke edge, keep the core): a ragged ring of warm chalk strokes round
+    the flame's outline, broken by a fixed grain (no boil) and streaked upward like pastel strokes. f is 0..1 RGB."""
