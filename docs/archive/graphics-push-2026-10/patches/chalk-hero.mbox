+FHandFrame QuestLook::PointingPose(const FHandFrame& Frame)
+{
+	FHandFrame Out = Frame;
+	if (Out.Joints.Num() <= static_cast<int32>(EHandKeypoint::LittleTip))
+	{
+		return Out;
+	}
+	const auto At = [&Out](EHandKeypoint Key) -> FVector&
+	{ return Out.Joints[static_cast<int32>(Key)].Location; };
+	FVector Normal = FWardDetector::PalmNormal(Frame);
+	if (FVector::DotProduct(Normal, FVector::ForwardVector) < 0.0)
+	{
+		Normal *= -1.0;
+	}
+	const FVector Down = (At(EHandKeypoint::Wrist) - At(EHandKeypoint::MiddleMetacarpal)).GetSafeNormal();
+	const EHandKeypoint Fingers[][4] = {
+	    {EHandKeypoint::MiddleProximal, EHandKeypoint::MiddleIntermediate, EHandKeypoint::MiddleDistal, EHandKeypoint::MiddleTip},
+	    {EHandKeypoint::RingProximal, EHandKeypoint::RingIntermediate, EHandKeypoint::RingDistal, EHandKeypoint::RingTip},
+	    {EHandKeypoint::LittleProximal, EHandKeypoint::LittleIntermediate, EHandKeypoint::LittleDistal, EHandKeypoint::LittleTip},
+	};
+	for (const auto& Finger : Fingers)
+	{
+		const FVector Knuckle = At(Finger[0]);
+		const double Scale = FMath::Max((At(Finger[1]) - Knuckle).Size(), 1.0);
+		At(Finger[1]) = Knuckle + Normal * Scale * 0.85 + Down * Scale * 0.2;
+		At(Finger[2]) = Knuckle + Normal * Scale * 1.15 + Down * Scale * 0.85;
+		At(Finger[3]) = Knuckle + Normal * Scale * 0.8 + Down * Scale * 1.3;
+	}
+	// The thumb lies across the folded middle finger.
+	const FVector Across = At(EHandKeypoint::MiddleIntermediate);
+	At(EHandKeypoint::ThumbDistal) = FMath::Lerp(At(EHandKeypoint::ThumbProximal), Across, 0.55);
+	At(EHandKeypoint::ThumbTip) = FMath::Lerp(At(EHandKeypoint::ThumbProximal), Across, 0.85);
+	return Out;
+}
