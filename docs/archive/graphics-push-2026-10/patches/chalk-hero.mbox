+"""Generated by make_bake_chalk.py from bake_epic.py (bakes, masks) and chalk_synth.py. Do not edit."""
+"""Brennic's epic-look texture set, baked onto the in-game mesh's own UVs (no geometry change, so SK_Brennic and its four
+clips stay exactly as committed in ad38b9b and the flat look is untouched).
+
+blender -b -P bake_epic.py -- <Brennic.fbx> <T_Brennic_BaseColor.png> <face_overlay.png> <outdir> [res]
+
+Writes into <outdir>:
+  T_BrennicEpic_BaseColor.png  sRGB albedo: the TRELLIS bake, regraded per region toward the concept palette
+                               (brick-red tunic, dark iron collar, bronze brooch), the face accents of face_overlay.py
+                               projected from the front, a light AO multiply, and the UV gutters dilated.
+  T_BrennicEpic_Normal.png     tangent-space normal, DirectX green (UE): hair curls, wool weave, the albedo's own folds.
+  T_BrennicEpic_ORM.png        R ambient occlusion, G roughness, B metallic, A subsurface (skin) mask. Linear.
+  masks.png                    region debug view.
+
+Steps: (1) Cycles EMIT bakes of object-space position and normal (the region masks need 3D position: the brooch, the
+head, the hair); (2) an AO bake; (3) an EMIT bake of the albedo with the face overlay projected along +X onto the
+front-facing head texels (the overlay is drawn in head_ortho.py's frame: centre z 1.62 m, 0.40 m square, image x = +Y);
+(4) numpy: masks, regrade, height -> normal, roughness/metal/subsurface; (5) gutter dilation.
+"""
+import math
+import os
+import sys
+
+import bpy
+import numpy as np
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+FBX, ALBEDO, OVERLAY, OUT = argv[0], argv[1], argv[2], argv[3]
+RES = int(argv[4]) if len(argv) > 4 else 2048
+HEAD_CZ, HEAD_SIZE = 1.62, 0.40
+os.makedirs(OUT, exist_ok=True)
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=FBX)
+mesh = None
+for o in bpy.data.objects:
+    if o.type == 'ARMATURE':
+        if o.animation_data:
+            o.animation_data.action = None
+            for t in o.animation_data.nla_tracks:
+                t.mute = True
+        o.data.pose_position = 'REST'
+    if o.type == 'MESH':
+        mesh = o
+assert mesh is not None
+bpy.context.view_layer.objects.active = mesh
+for o in bpy.data.objects:
+    o.select_set(o == mesh)
+
+scn = bpy.context.scene
+scn.render.engine = 'CYCLES'
+scn.cycles.device = 'CPU'
+scn.cycles.samples = 1
+scn.render.bake.margin = 0
+scn.render.bake.use_clear = True
+
+albedo_img = bpy.data.images.load(ALBEDO)
+overlay_img = bpy.data.images.load(OVERLAY)
+
+
+def new_target(name, is_float):
+    img = bpy.data.images.new(name, RES, RES, alpha=True, float_buffer=is_float)
+    img.colorspace_settings.name = 'Non-Color' if is_float else 'sRGB'
+    img.generated_color = (0, 0, 0, 0)
+    return img
+
+
+def bake_emit(build, target, kind='EMIT'):
+    """build(nt, out_socket_target) wires an emission colour; target is the image to bake into."""
+    mat = bpy.data.materials.new("Bake_" + target.name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for n in list(nt.nodes):
+        nt.nodes.remove(n)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    em.inputs["Strength"].default_value = 1.0
+    nt.links.new(em.outputs[0], out.inputs[0])
+    if kind == 'AO':
+        bsdf = nt.nodes.new("ShaderNodeBsdfDiffuse")
+        nt.links.new(bsdf.outputs[0], out.inputs[0])
+    else:
+        build(nt, em.inputs["Color"])
+    tex = nt.nodes.new("ShaderNodeTexImage")
+    tex.image = target
+    nt.nodes.active = tex
+    mesh.data.materials.clear()
+    mesh.data.materials.append(mat)
+    bpy.ops.object.bake(type=kind, margin=4, use_clear=True)  # margin: edge texels the coverage counts must hold values
+    px = np.empty(RES * RES * 4, dtype=np.float32)
+    target.pixels.foreach_get(px)
+    return px.reshape(RES, RES, 4)[::-1].copy()  # row 0 = top (v = 1)
+
+
+def geo_out(name):
+    def build(nt, sock):
+        g = nt.nodes.new("ShaderNodeNewGeometry")
+        if name == "Normal":
+            # map -1..1 -> 0..1 so a non-float path would survive; we read floats anyway
+            vm = nt.nodes.new("ShaderNodeVectorMath")
+            vm.operation = 'MULTIPLY_ADD'
+            vm.inputs[1].default_value = (0.5, 0.5, 0.5)
+            vm.inputs[2].default_value = (0.5, 0.5, 0.5)
+            nt.links.new(g.outputs["Normal"], vm.inputs[0])
+            nt.links.new(vm.outputs[0], sock)
+        else:
+            nt.links.new(g.outputs["Position"], sock)
+    return build
+
+
+pos = bake_emit(geo_out("Position"), new_target("pos", True))
+nrm = bake_emit(geo_out("Normal"), new_target("nrm", True))
+
+
+def uv_cover():
+    """Rasterises the UV triangles: True inside an island (a bake writes every texel, so its alpha cannot tell)."""
+    me = mesh.data
+    me.calc_loop_triangles()
+    uvl = me.uv_layers[0].data
+    mask = np.zeros((RES, RES), bool)
+    for tri in me.loop_triangles:
+        pts = np.array([uvl[li].uv[:] for li in tri.loops]) * RES
+        pts[:, 1] = RES - pts[:, 1]  # row 0 = top
+        x0, y0 = np.floor(pts.min(0)).astype(int)
+        x1, y1 = np.ceil(pts.max(0)).astype(int)
+        x0, y0 = max(x0, 0), max(y0, 0)
+        x1, y1 = min(x1, RES - 1), min(y1, RES - 1)
+        if x1 < x0 or y1 < y0:
+            continue
+        xs, ys = np.meshgrid(np.arange(x0, x1 + 1) + 0.5, np.arange(y0, y1 + 1) + 0.5)
+        (ax, ay), (bx, by), (cx, cy) = pts
+        d = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy)
+        if abs(d) < 1e-12:
+            continue
+        l1 = ((by - cy) * (xs - cx) + (cx - bx) * (ys - cy)) / d
+        l2 = ((cy - ay) * (xs - cx) + (ax - cx) * (ys - cy)) / d
+        l3 = 1 - l1 - l2
+        e = -0.6 / max(abs(d), 1.0) ** 0.5  # a hair of conservative growth
+        inside = (l1 >= e) & (l2 >= e) & (l3 >= e)
+        mask[y0:y1 + 1, x0:x1 + 1] |= inside
+    return mask
+
+
+cover = uv_cover()
+P = pos[..., :3]
+N = nrm[..., :3] * 2.0 - 1.0
+print("BAKE coverage %.3f" % cover.mean())
+
+scn.cycles.samples = 96
+scn.world = bpy.data.worlds.new("W")
+scn.world.use_nodes = True
+scn.world.node_tree.nodes["Background"].inputs[0].default_value = (1, 1, 1, 1)
+scn.world.light_settings.distance = 0.25
+ao = bake_emit(None, new_target("ao", True), kind='AO')[..., 0]
+scn.cycles.samples = 1
+
+
+def build_face(nt, sock):
+    tex = nt.nodes.new("ShaderNodeTexImage")
+    tex.image = albedo_img
+    uv = nt.nodes.new("ShaderNodeUVMap")
+    uv.uv_map = mesh.data.uv_layers[0].name
+    nt.links.new(uv.outputs[0], tex.inputs[0])
+    g = nt.nodes.new("ShaderNodeNewGeometry")
+    sep = nt.nodes.new("ShaderNodeSeparateXYZ")
+    nt.links.new(g.outputs["Position"], sep.inputs[0])
+    u = nt.nodes.new("ShaderNodeMath"); u.operation = 'MULTIPLY_ADD'
+    u.inputs[1].default_value = 1.0 / HEAD_SIZE; u.inputs[2].default_value = 0.5
+    nt.links.new(sep.outputs["Y"], u.inputs[0])
+    v = nt.nodes.new("ShaderNodeMath"); v.operation = 'MULTIPLY_ADD'
+    v.inputs[1].default_value = 1.0 / HEAD_SIZE; v.inputs[2].default_value = 0.5 - HEAD_CZ / HEAD_SIZE
+    nt.links.new(sep.outputs["Z"], v.inputs[0])
+    comb = nt.nodes.new("ShaderNodeCombineXYZ")
+    nt.links.new(u.outputs[0], comb.inputs[0]); nt.links.new(v.outputs[0], comb.inputs[1])
+    ov = nt.nodes.new("ShaderNodeTexImage"); ov.image = overlay_img; ov.extension = 'CLIP'
+    nt.links.new(comb.outputs[0], ov.inputs[0])
+    sepn = nt.nodes.new("ShaderNodeSeparateXYZ")
+    nt.links.new(g.outputs["Normal"], sepn.inputs[0])
+    face = nt.nodes.new("ShaderNodeMapRange")
+    face.inputs["From Min"].default_value = 0.15; face.inputs["From Max"].default_value = 0.45
+    nt.links.new(sepn.outputs["X"], face.inputs["Value"])
+    fac = nt.nodes.new("ShaderNodeMath"); fac.operation = 'MULTIPLY'
+    nt.links.new(ov.outputs["Alpha"], fac.inputs[0]); nt.links.new(face.outputs[0], fac.inputs[1])
+    mix = nt.nodes.new("ShaderNodeMix"); mix.data_type = 'RGBA'
+    nt.links.new(fac.outputs[0], mix.inputs["Factor"])
+    nt.links.new(tex.outputs["Color"], mix.inputs[6])
+    nt.links.new(ov.outputs["Color"], mix.inputs[7])
+    nt.links.new(mix.outputs[2], sock)
+
+
+face_bake = bake_emit(build_face, new_target("face", True))
+col = np.clip(face_bake[..., :3], 0, 1)  # linear
+
+# ---------------------------------------------------------------- masks (on the sRGB-encoded colour, like the eye)
+srgb = np.where(col <= 0.0031308, col * 12.92, 1.055 * np.power(col, 1 / 2.4) - 0.055)
+r, g, b = srgb[..., 0], srgb[..., 1], srgb[..., 2]
+mx = srgb.max(-1); mn = srgb.min(-1); dl = mx - mn
+sat = np.where(mx > 1e-4, dl / np.maximum(mx, 1e-4), 0)
+hue = np.zeros_like(mx)
+m = dl > 1e-4
+rr = (mx == r) & m; gg = (mx == g) & m & ~rr; bb = m & ~rr & ~gg
+hue[rr] = np.mod((g - b)[rr] / dl[rr], 6)
+hue[gg] = (b - r)[gg] / dl[gg] + 2
+hue[bb] = (r - g)[bb] / dl[bb] + 4
+hue *= 60
+X, Y, Z = P[..., 0], P[..., 1], P[..., 2]
+
+
+def smooth(e0, e1, x):
+    t = np.clip((x - e0) / (e1 - e0), 0, 1)
+    return t * t * (3 - 2 * t)
+
+
+redhue = np.maximum(smooth(13, 8, hue), smooth(335, 350, hue))
+tunic = redhue * smooth(0.38, 0.5, sat) * smooth(0.12, 0.2, mx) * smooth(0.55, 0.47, mx) * cover
+skin = smooth(4.0, 9.0, hue) * smooth(40, 28, hue) * smooth(0.22, 0.32, sat) * smooth(0.66, 0.56, sat) * smooth(0.40, 0.50, mx) * cover
+# The collar: head_ortho shows it from 1.49 to 1.58 m, a ring around the neck (radius under about 0.12 m), in a
+# near-neutral grey (about 70,68,67 sRGB) where skin, beard and cloak are all clearly warm.
+neck_r = np.hypot(X + 0.02, Y)
+band = smooth(1.46, 1.48, Z) * smooth(1.61, 1.59, Z) * smooth(0.15, 0.12, neck_r)
+grey = smooth(0.24, 0.14, sat) * smooth(0.12, 0.18, mx)
+iron = np.clip(band * grey, 0, 1) * cover
+brooch = smooth(0.045, 0.03, np.sqrt((Y + 0.007) ** 2 + (Z - 1.449) ** 2)) * (X > 0.0) * cover
+hairz = smooth(1.60, 1.66, Z)
+dark = smooth(0.36, 0.26, mx)
+hair = dark * np.maximum(hairz, smooth(1.52, 1.56, Z) * smooth(1.0, 0.95, mx)) * (1 - iron) * cover
+hair = np.clip(hair * (1 - skin), 0, 1)
+leather = smooth(14, 22, hue) * smooth(45, 36, hue) * smooth(0.35, 0.45, sat) * smooth(0.14, 0.2, mx) * smooth(0.5, 0.42, mx) * smooth(1.40, 1.30, Z) * cover
+leather *= (1 - skin) * (1 - tunic)
+cloak = np.clip(cover - tunic - skin - iron - hair - leather - brooch, 0, 1)
+
+# ---------------------------------------------------------------- gutter dilation (16 passes, 4-neighbour mean)
+
+
+def dilate(img, mask, passes=24):
+    img = img.copy()
+    mk = mask.astype(np.float32)
+    for _ in range(passes):
+        acc = np.zeros_like(img)
+        cnt = np.zeros(mk.shape, np.float32)
+        for sh, ax in ((1, 0), (-1, 0), (1, 1), (-1, 1)):
+            m2 = np.roll(mk, sh, ax)
+            acc += np.roll(img * mk[..., None], sh, ax)
+            cnt += m2
+        grow = (mk == 0) & (cnt > 0)
+        img[grow] = acc[grow] / cnt[grow][..., None]
+        mk = np.where(grow, 1.0, mk)
+    return img
+
+
+def fill(img, mask):
+    """Dilates the islands, then gives every texel still empty the islands' mean, so low mips do not bleed black."""
+    img = dilate(np.where(mask[..., None], img, 0), mask)
+    empty = (img.sum(-1) == 0) & ~mask
+    img[empty] = img[mask].mean(0)
+    return img
+
+
+# ---------------------------------------------------------------- regrade (linear space)
+lum = (col * np.array([0.2126, 0.7152, 0.0722])).sum(-1)
+
+
+
+# The chalk half of bake_chalk.py (Chalk & Slate, style 30): appended after bake_epic.py's bakes and region masks by
+# make_bake_chalk.py, so the masks are exactly the epic set's. Everything here works in display (sRGB) values.
+# Inputs from the first half: RES, OUT, cover, P (object position), N (object normal), ao, masks tunic, skin, iron,
+# brooch, hair, leather, cloak, fill(), bake_emit(), new_target(), overlay_img, mesh, HEAD_CZ, HEAD_SIZE.
+import math as _math
+
+import numpy as np
+
+
+def overlay_layers():
+    """The face overlay (face_overlay.py) projected along +X onto the front of the head: colour and its weight."""
+    def build(want_alpha):
+        def wire(nt, sock):
+            g = nt.nodes.new("ShaderNodeNewGeometry")
+            sep = nt.nodes.new("ShaderNodeSeparateXYZ")
+            nt.links.new(g.outputs["Position"], sep.inputs[0])
+            u = nt.nodes.new("ShaderNodeMath"); u.operation = 'MULTIPLY_ADD'
+            u.inputs[1].default_value = 1.0 / HEAD_SIZE; u.inputs[2].default_value = 0.5
+            nt.links.new(sep.outputs["Y"], u.inputs[0])
+            v = nt.nodes.new("ShaderNodeMath"); v.operation = 'MULTIPLY_ADD'
+            v.inputs[1].default_value = 1.0 / HEAD_SIZE; v.inputs[2].default_value = 0.5 - HEAD_CZ / HEAD_SIZE
+            nt.links.new(sep.outputs["Z"], v.inputs[0])
+            comb = nt.nodes.new("ShaderNodeCombineXYZ")
+            nt.links.new(u.outputs[0], comb.inputs[0]); nt.links.new(v.outputs[0], comb.inputs[1])
+            ov = nt.nodes.new("ShaderNodeTexImage"); ov.image = overlay_img; ov.extension = 'CLIP'
+            nt.links.new(comb.outputs[0], ov.inputs[0])
+            if not want_alpha:
+                nt.links.new(ov.outputs["Color"], sock)
+                return
+            sepn = nt.nodes.new("ShaderNodeSeparateXYZ")
+            nt.links.new(g.outputs["Normal"], sepn.inputs[0])
+            face = nt.nodes.new("ShaderNodeMapRange")
+            face.inputs["From Min"].default_value = 0.15; face.inputs["From Max"].default_value = 0.45
+            nt.links.new(sepn.outputs["X"], face.inputs["Value"])
+            fac = nt.nodes.new("ShaderNodeMath"); fac.operation = 'MULTIPLY'
+            nt.links.new(ov.outputs["Alpha"], fac.inputs[0]); nt.links.new(face.outputs[0], fac.inputs[1])
+            nt.links.new(fac.outputs[0], sock)
+        return wire
+    colour = bake_emit(build(False), new_target("ovc", True))[..., :3]
+    weight = bake_emit(build(True), new_target("ova", True))[..., 0]
+    return colour, np.clip(weight, 0, 1)
+
+
+ov_lin, ov_a = overlay_layers()
+ov_srgb = np.where(ov_lin <= 0.0031308, ov_lin * 12.92, 1.055 * np.power(np.clip(ov_lin, 0, 1), 1 / 2.4) - 0.055)
+
+
+def c(r, g, b):
+    return np.array([r, g, b], np.float32) / 255.0
+
+
+# S30-VR's palette for the opponent: a strong crimson wool robe, a dark cloak, a bronze collar and buckle, warm skin,
+# a near-black beard and brows (they must read at about 40 px). Each region has a shade, a body and a lit tone; the
+# drawing picks between them by the form light (two-tone, as chalk is drawn), never a smooth gradient.
+REGIONS = [
+    ("cloak", cloak, c(40, 33, 32), c(70, 56, 50), c(112, 96, 86)),
+    ("tunic", tunic, c(96, 22, 22), c(146, 36, 32), c(188, 62, 50)),
+    ("leather", leather, c(78, 48, 30), c(122, 78, 46), c(170, 122, 78)),
+    ("skin", skin, c(150, 92, 68), c(214, 150, 112), c(240, 194, 156)),
+    ("hair", hair, c(18, 12, 10), c(40, 28, 22), c(78, 58, 44)),
+    ("iron", iron, c(110, 72, 34), c(170, 116, 58), c(230, 186, 110)),  # S30: the collar is bronze
+    ("brooch", brooch, c(110, 72, 34), c(170, 116, 58), c(236, 196, 120)),
+]
+weights = np.stack([m for _, m, *_ in REGIONS], -1)
+label = np.argmax(weights, -1)
+label = np.where(cover, label, -1)
+
+# The form light: a key from the front-left and above (his +X is forward), as S30 lights him; plus the baked AO.
+L = np.array([0.62, 0.42, 0.66]); L = L / np.linalg.norm(L)
+nl = (N * L).sum(-1)
+form = np.clip(nl * 0.75 + 0.25, 0, 1) * (0.55 + 0.45 * ao)
+tone = np.where(form > 0.55, 2, np.where(form > 0.22, 1, 0))  # lit / body / shade
+
+out = np.zeros((RES, RES, 3), np.float32)
+for i, (_, _, shade, body, lit) in enumerate(REGIONS):
+    sel = label == i
+    out[sel & (tone == 0)] = shade
+    out[sel & (tone == 1)] = body
+    out[sel & (tone == 2)] = lit
+
+rng = np.random.default_rng(3802)
+yy, xx = np.mgrid[0:RES, 0:RES].astype(np.float32)
+
+
+def box_blur(a, k):
+    for _ in range(2):
+        a = sum(np.roll(a, s, 0) for s in range(-k, k + 1)) / (2 * k + 1)
+        a = sum(np.roll(a, s, 1) for s in range(-k, k + 1)) / (2 * k + 1)
+    return a
+
+
+# Hatching drawn into the shade: parallel diagonal chalk strokes in UV space, broken by a stroke noise, denser where
+# the form is darker; lit areas get a few loose light strokes along the folds instead.
+wobble = box_blur(rng.random((RES, RES)).astype(np.float32), 3)
+phase = (xx * 0.707 + yy * 0.707) / 5.5 + wobble * 1.6
+hatch = (np.mod(phase, 1.0) < 0.42).astype(np.float32)
+breaks = box_blur(rng.random((RES, RES)).astype(np.float32), 2) > 0.42
+shade_amt = np.clip((0.42 - form) / 0.3, 0, 1)
+dark_line = hatch * breaks * shade_amt
+out = out * (1 - 0.38 * dark_line[..., None])
+phase2 = (xx * 0.6 - yy * 0.8) / 7.0 + wobble * 2.0
+light_line = (np.mod(phase2, 1.0) < 0.25) * (box_blur(rng.random((RES, RES)).astype(np.float32), 2) > 0.55) * np.clip((form - 0.62) / 0.2, 0, 1)
+out = out + (1 - out) * 0.22 * light_line[..., None]
+
+# Contours: dark chalk lines where one region meets another (robe hem, cloak edge, collar, belt, wraps, hairline, beard
+# line), two to three texels wide with a broken stroke; and along sharp creases of the form (normal turning fast).
+lab = np.where(cover, label, -1)
+edge = np.zeros((RES, RES), bool)
+for sh, ax in ((1, 0), (-1, 0), (1, 1), (-1, 1)):
+    nb = np.roll(lab, sh, ax)
+    edge |= (nb != lab) & (nb >= 0) & (lab >= 0)
+edge_f = box_blur(edge.astype(np.float32), 1) > 0.08
+gN = sum(np.abs(np.roll(N, s, a) - N).sum(-1) for s, a in ((1, 0), (1, 1)))
+crease = (gN > 0.55) & cover
+gaps = box_blur(rng.random((RES, RES)).astype(np.float32), 3) > 0.36
+contour = (edge_f | crease) & gaps
+line_col = c(26, 16, 14)
+out = np.where(contour[..., None], out * 0.25 + line_col * 0.75, out)
+
+# The face: the drawn overlay (eyes, lash lines, scowling brow, mouth, beard strands), bolder: pushed toward its own
+# darkest and lightest values so it survives at game distance.
+ov_bold = np.clip((ov_srgb - 0.5) * 1.35 + 0.5, 0, 1)
+# the beard strands over the chin patch draw in the beard's own near-black, not the overlay's browns
+ov_bold = np.where((ov_bold.max(-1, keepdims=True) < 0.42), ov_bold * 0.55, ov_bold)
+out = out * (1 - ov_a[..., None]) + ov_bold * ov_a[..., None]
+
+# Chalk grain over everything: pigment caught on a rough board, with the lightest strokes keeping the most grain.
+grain = rng.random((RES, RES)).astype(np.float32)
+grain = 0.86 + 0.24 * (0.6 * grain + 0.4 * box_blur(grain, 1))
+out = np.clip(out * grain[..., None], 0, 1)
+
+out = fill(out, cover)
+mask_ao = np.stack([np.clip(ao, 0, 1), np.full_like(ao, 0.9), np.zeros_like(ao), skin], -1)
+mask_ao = fill(mask_ao, cover)
+
+
+def save_raw(name, arr):
+    a = np.clip(arr, 0, 1)
+    if a.shape[-1] == 3:
+        a = np.concatenate([a, np.ones(a.shape[:2] + (1,), np.float32)], -1)
+    img = bpy.data.images.new(name, RES, RES, alpha=True)
+    img.colorspace_settings.name = 'Non-Color'
+    img.pixels.foreach_set(a[::-1].astype(np.float32).ravel())
+    img.filepath_raw = os.path.join(OUT, name)
+    img.file_format = 'PNG'
+    img.save()
+    print("SAVED", img.filepath_raw)
+
+
+save_raw("T_BrennicChalk_BaseColor.png", out)  # already display values
+save_raw("T_BrennicChalk_ORM.png", mask_ao)
diff --git a/apps/vr/art/characters/brennic/epic/cast_lunge.py b/apps/vr/art/characters/brennic/epic/cast_lunge.py
new file mode 100644
index 0000000..f19dfea
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/cast_lunge.py
@@ -0,0 +1,122 @@
+"""Brennic's casting lunge for the Chalk & Slate style (S30-VR: a wide stance, the right arm thrust toward the player
+releasing the fireball, the left arm thrown back for balance, the body leaning into the throw).
+
+blender -b -P cast_lunge.py -- <Brennic.fbx> <out.fbx>
+
+Starts from the committed Cast take (its timing: wind-up, release, recover; 47 frames at 30 fps) and from its first
+quarter blends into the lunge, holds it through the release and blends back over the last frames so the clip hands off
+to Idle. Writes one take, CastLunge; the four committed clips are untouched. The rig has no cloth bones, so the robe
+follows the thighs and does not flare.
+"""
+import math
+import sys
+
+import bpy
+import mathutils
+
+argv = sys.argv[sys.argv.index("--") + 1:]
+SRC, OUT = argv[0], argv[1]
+
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=SRC)
+arm = next(o for o in bpy.data.objects if o.type == 'ARMATURE')
+cast = next(a for a in bpy.data.actions if a.name.endswith("Cast"))
+if arm.animation_data is None:
+    arm.animation_data_create()
+for track in arm.animation_data.nla_tracks:
+    track.mute = True
+action = cast.copy()
+action.name = "CastLunge"
+arm.animation_data.action = action
+f0, f1 = (int(round(v)) for v in action.frame_range)
+span = f1 - f0
+print("CASTLUNGE frames", f0, f1)
+
+
+def smooth(a, b, x):
+    t = min(max((x - a) / (b - a), 0.0), 1.0)
+    return t * t * (3 - 2 * t)
+
+
+def d(fwd, left, up):
+    return mathutils.Vector((fwd, left, up)).normalized()
+
+
+# +X is his forward (toward the player), +Y his left, +Z up. Directions in armature space for each bone's own axis.
+SPLAY = 24.0
+TARGETS = {
+    "spine_01": d(0.22, 0.0, 1.0),
+    "spine_02": d(0.30, -0.04, 1.0),
+    "spine_03": d(0.34, -0.08, 1.0),
+    "upperarm_r": d(0.62, -0.74, 0.22),   # his right arm thrust toward the player and well out to his side (it reads in silhouette from the seat)
+    "lowerarm_r": d(0.72, -0.64, 0.18),
+    "hand_r": d(0.62, -0.42, 0.66),       # the palm pushed out, wrist bent back, the fireball's release
+    "upperarm_l": d(-0.25, 0.82, -0.52),  # the left arm low and out, hand open (S30)
+    "lowerarm_l": d(-0.2, 0.62, -0.76),
+    "hand_l": d(-0.1, 0.55, -0.83),
+    "thigh_l": d(0.18, math.sin(math.radians(SPLAY)), -math.cos(math.radians(SPLAY))),
+    "thigh_r": d(-0.12, -math.sin(math.radians(SPLAY)), -math.cos(math.radians(SPLAY))),
+    "calf_l": d(-0.08, 0.26, -1.0),
+    "calf_r": d(0.04, -0.26, -1.0),
+}
+ORDER = ["spine_01", "spine_02", "spine_03", "upperarm_r", "lowerarm_r", "hand_r", "upperarm_l", "lowerarm_l", "hand_l",
+         "thigh_l", "calf_l", "thigh_r", "calf_r"]
+for pb in arm.pose.bones:
+    pb.rotation_mode = 'QUATERNION'
+leg = (arm.data.bones["thigh_l"].head_local - arm.data.bones["foot_l"].head_local).length
+drop = leg * (1.0 - math.cos(math.radians(SPLAY))) + 0.05  # the stance lowers the hips so the feet stay down
+print("CASTLUNGE leg %.3f drop %.3f" % (leg, drop))
+
+for frame in range(f0, f1 + 1):
+    bpy.context.scene.frame_set(frame)
+    w = smooth(f0 + 0.12 * span, f0 + 0.32 * span, frame) * (1.0 - smooth(f1 - 0.16 * span, f1, frame))
+    pelvis = arm.pose.bones["pelvis"]
+    if w > 0:
+        m = pelvis.matrix.copy()
+        m.translation = m.translation + mathutils.Vector((-0.04, 0.0, -drop)) * w
+        pelvis.matrix = m
+        bpy.context.view_layer.update()
+    pelvis.keyframe_insert("location", frame=frame)
+    pelvis.keyframe_insert("rotation_quaternion", frame=frame)
+    for name in ORDER:
+        pb = arm.pose.bones.get(name)
+        if pb is None:
+            continue
+        mm = pb.matrix.copy()
+        axis = mm.to_3x3().col[1].normalized()
+        target = axis.slerp(TARGETS[name], w) if w > 0 else axis
+        rot = axis.rotation_difference(target)
+        loc = mm.to_translation()
+        pb.matrix = mathutils.Matrix.Translation(loc) @ rot.to_matrix().to_4x4() @ mathutils.Matrix.Translation(-loc) @ mm
+        bpy.context.view_layer.update()
+        pb.keyframe_insert("rotation_quaternion", frame=frame)
+print("CASTLUNGE keyed", action.name)
+
+bpy.context.scene.frame_start, bpy.context.scene.frame_end = f0, f1
+for o in bpy.data.objects:
+    o.select_set(o.type in ('ARMATURE', 'MESH'))
+bpy.context.view_layer.objects.active = arm
+bpy.ops.export_scene.fbx(filepath=OUT, use_selection=True, object_types={'ARMATURE', 'MESH'}, apply_scale_options='FBX_SCALE_ALL',
+                         mesh_smooth_type='FACE', add_leaf_bones=False, armature_nodetype='NULL', bake_anim=True,
+                         bake_anim_use_all_bones=True, bake_anim_use_nla_strips=False, bake_anim_use_all_actions=False,
+                         bake_anim_force_startend_keying=True, bake_anim_step=1.0, bake_anim_simplify_factor=0.0,
+                         path_mode='STRIP', embed_textures=False)
+print("CASTLUNGE exported", OUT)
+
+# preview of the held pose, from the player's side and from his left
+bpy.context.scene.frame_set(int(f0 + 0.6 * span))
+scn = bpy.context.scene
+scn.render.engine = 'BLENDER_EEVEE'
+scn.render.resolution_x, scn.render.resolution_y = 640, 640
+cam = bpy.data.objects.new("Cam", bpy.data.cameras.new("Cam"))
+scn.collection.objects.link(cam)
+scn.camera = cam
+sun = bpy.data.objects.new("Sun", bpy.data.lights.new("Sun", 'SUN'))
+scn.collection.objects.link(sun)
+sun.rotation_euler = (math.radians(50), 0, math.radians(60))
+scn.world = bpy.data.worlds.new("W")
+for tag, loc, rot in (("front", (5.0, 0.0, 1.1), (90, 0, 90)), ("side", (0.0, 5.0, 1.1), (90, 0, 180))):
+    cam.location = loc
+    cam.rotation_euler = tuple(math.radians(a) for a in rot)
+    scn.render.filepath = OUT.replace(".fbx", "_%s.png" % tag)
+    bpy.ops.render.render(write_still=True)
diff --git a/apps/vr/art/characters/brennic/epic/chalk_synth.py b/apps/vr/art/characters/brennic/epic/chalk_synth.py
new file mode 100644
index 0000000..769bf93
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/chalk_synth.py
@@ -0,0 +1,151 @@
+# The chalk half of bake_chalk.py (Chalk & Slate, style 30): appended after bake_epic.py's bakes and region masks by
+# make_bake_chalk.py, so the masks are exactly the epic set's. Everything here works in display (sRGB) values.
+# Inputs from the first half: RES, OUT, cover, P (object position), N (object normal), ao, masks tunic, skin, iron,
+# brooch, hair, leather, cloak, fill(), bake_emit(), new_target(), overlay_img, mesh, HEAD_CZ, HEAD_SIZE.
+import math as _math
+
+import numpy as np
+
+
+def overlay_layers():
+    """The face overlay (face_overlay.py) projected along +X onto the front of the head: colour and its weight."""
+    def build(want_alpha):
+        def wire(nt, sock):
+            g = nt.nodes.new("ShaderNodeNewGeometry")
+            sep = nt.nodes.new("ShaderNodeSeparateXYZ")
+            nt.links.new(g.outputs["Position"], sep.inputs[0])
+            u = nt.nodes.new("ShaderNodeMath"); u.operation = 'MULTIPLY_ADD'
+            u.inputs[1].default_value = 1.0 / HEAD_SIZE; u.inputs[2].default_value = 0.5
+            nt.links.new(sep.outputs["Y"], u.inputs[0])
+            v = nt.nodes.new("ShaderNodeMath"); v.operation = 'MULTIPLY_ADD'
+            v.inputs[1].default_value = 1.0 / HEAD_SIZE; v.inputs[2].default_value = 0.5 - HEAD_CZ / HEAD_SIZE
+            nt.links.new(sep.outputs["Z"], v.inputs[0])
+            comb = nt.nodes.new("ShaderNodeCombineXYZ")
+            nt.links.new(u.outputs[0], comb.inputs[0]); nt.links.new(v.outputs[0], comb.inputs[1])
+            ov = nt.nodes.new("ShaderNodeTexImage"); ov.image = overlay_img; ov.extension = 'CLIP'
+            nt.links.new(comb.outputs[0], ov.inputs[0])
+            if not want_alpha:
+                nt.links.new(ov.outputs["Color"], sock)
+                return
+            sepn = nt.nodes.new("ShaderNodeSeparateXYZ")
+            nt.links.new(g.outputs["Normal"], sepn.inputs[0])
+            face = nt.nodes.new("ShaderNodeMapRange")
+            face.inputs["From Min"].default_value = 0.15; face.inputs["From Max"].default_value = 0.45
+            nt.links.new(sepn.outputs["X"], face.inputs["Value"])
+            fac = nt.nodes.new("ShaderNodeMath"); fac.operation = 'MULTIPLY'
+            nt.links.new(ov.outputs["Alpha"], fac.inputs[0]); nt.links.new(face.outputs[0], fac.inputs[1])
+            nt.links.new(fac.outputs[0], sock)
+        return wire
+    colour = bake_emit(build(False), new_target("ovc", True))[..., :3]
+    weight = bake_emit(build(True), new_target("ova", True))[..., 0]
+    return colour, np.clip(weight, 0, 1)
+
+
+ov_lin, ov_a = overlay_layers()
+ov_srgb = np.where(ov_lin <= 0.0031308, ov_lin * 12.92, 1.055 * np.power(np.clip(ov_lin, 0, 1), 1 / 2.4) - 0.055)
+
+
+def c(r, g, b):
+    return np.array([r, g, b], np.float32) / 255.0
+
+
+# S30-VR's palette for the opponent: a strong crimson wool robe, a dark cloak, a bronze collar and buckle, warm skin,
+# a near-black beard and brows (they must read at about 40 px). Each region has a shade, a body and a lit tone; the
+# drawing picks between them by the form light (two-tone, as chalk is drawn), never a smooth gradient.
+REGIONS = [
+    ("cloak", cloak, c(40, 33, 32), c(70, 56, 50), c(112, 96, 86)),
+    ("tunic", tunic, c(96, 22, 22), c(146, 36, 32), c(188, 62, 50)),
+    ("leather", leather, c(78, 48, 30), c(122, 78, 46), c(170, 122, 78)),
+    ("skin", skin, c(150, 92, 68), c(214, 150, 112), c(240, 194, 156)),
+    ("hair", hair, c(18, 12, 10), c(40, 28, 22), c(78, 58, 44)),
+    ("iron", iron, c(110, 72, 34), c(170, 116, 58), c(230, 186, 110)),  # S30: the collar is bronze
+    ("brooch", brooch, c(110, 72, 34), c(170, 116, 58), c(236, 196, 120)),
+]
+weights = np.stack([m for _, m, *_ in REGIONS], -1)
+label = np.argmax(weights, -1)
+label = np.where(cover, label, -1)
+
+# The form light: a key from the front-left and above (his +X is forward), as S30 lights him; plus the baked AO.
+L = np.array([0.62, 0.42, 0.66]); L = L / np.linalg.norm(L)
+nl = (N * L).sum(-1)
+form = np.clip(nl * 0.75 + 0.25, 0, 1) * (0.55 + 0.45 * ao)
+tone = np.where(form > 0.55, 2, np.where(form > 0.22, 1, 0))  # lit / body / shade
+
+out = np.zeros((RES, RES, 3), np.float32)
+for i, (_, _, shade, body, lit) in enumerate(REGIONS):
+    sel = label == i
+    out[sel & (tone == 0)] = shade
+    out[sel & (tone == 1)] = body
+    out[sel & (tone == 2)] = lit
+
+rng = np.random.default_rng(3802)
+yy, xx = np.mgrid[0:RES, 0:RES].astype(np.float32)
+
+
+def box_blur(a, k):
+    for _ in range(2):
+        a = sum(np.roll(a, s, 0) for s in range(-k, k + 1)) / (2 * k + 1)
+        a = sum(np.roll(a, s, 1) for s in range(-k, k + 1)) / (2 * k + 1)
+    return a
+
+
+# Hatching drawn into the shade: parallel diagonal chalk strokes in UV space, broken by a stroke noise, denser where
+# the form is darker; lit areas get a few loose light strokes along the folds instead.
+wobble = box_blur(rng.random((RES, RES)).astype(np.float32), 3)
+phase = (xx * 0.707 + yy * 0.707) / 5.5 + wobble * 1.6
+hatch = (np.mod(phase, 1.0) < 0.42).astype(np.float32)
+breaks = box_blur(rng.random((RES, RES)).astype(np.float32), 2) > 0.42
+shade_amt = np.clip((0.42 - form) / 0.3, 0, 1)
+dark_line = hatch * breaks * shade_amt
+out = out * (1 - 0.38 * dark_line[..., None])
+phase2 = (xx * 0.6 - yy * 0.8) / 7.0 + wobble * 2.0
+light_line = (np.mod(phase2, 1.0) < 0.25) * (box_blur(rng.random((RES, RES)).astype(np.float32), 2) > 0.55) * np.clip((form - 0.62) / 0.2, 0, 1)
+out = out + (1 - out) * 0.22 * light_line[..., None]
+
+# Contours: dark chalk lines where one region meets another (robe hem, cloak edge, collar, belt, wraps, hairline, beard
+# line), two to three texels wide with a broken stroke; and along sharp creases of the form (normal turning fast).
+lab = np.where(cover, label, -1)
+edge = np.zeros((RES, RES), bool)
+for sh, ax in ((1, 0), (-1, 0), (1, 1), (-1, 1)):
+    nb = np.roll(lab, sh, ax)
+    edge |= (nb != lab) & (nb >= 0) & (lab >= 0)
+edge_f = box_blur(edge.astype(np.float32), 1) > 0.08
+gN = sum(np.abs(np.roll(N, s, a) - N).sum(-1) for s, a in ((1, 0), (1, 1)))
+crease = (gN > 0.55) & cover
+gaps = box_blur(rng.random((RES, RES)).astype(np.float32), 3) > 0.36
+contour = (edge_f | crease) & gaps
+line_col = c(26, 16, 14)
+out = np.where(contour[..., None], out * 0.25 + line_col * 0.75, out)
+
+# The face: the drawn overlay (eyes, lash lines, scowling brow, mouth, beard strands), bolder: pushed toward its own
+# darkest and lightest values so it survives at game distance.
+ov_bold = np.clip((ov_srgb - 0.5) * 1.35 + 0.5, 0, 1)
+# the beard strands over the chin patch draw in the beard's own near-black, not the overlay's browns
+ov_bold = np.where((ov_bold.max(-1, keepdims=True) < 0.42), ov_bold * 0.55, ov_bold)
+out = out * (1 - ov_a[..., None]) + ov_bold * ov_a[..., None]
+
+# Chalk grain over everything: pigment caught on a rough board, with the lightest strokes keeping the most grain.
+grain = rng.random((RES, RES)).astype(np.float32)
+grain = 0.86 + 0.24 * (0.6 * grain + 0.4 * box_blur(grain, 1))
+out = np.clip(out * grain[..., None], 0, 1)
+
+out = fill(out, cover)
+mask_ao = np.stack([np.clip(ao, 0, 1), np.full_like(ao, 0.9), np.zeros_like(ao), skin], -1)
+mask_ao = fill(mask_ao, cover)
+
+
+def save_raw(name, arr):
+    a = np.clip(arr, 0, 1)
+    if a.shape[-1] == 3:
+        a = np.concatenate([a, np.ones(a.shape[:2] + (1,), np.float32)], -1)
+    img = bpy.data.images.new(name, RES, RES, alpha=True)
+    img.colorspace_settings.name = 'Non-Color'
+    img.pixels.foreach_set(a[::-1].astype(np.float32).ravel())
+    img.filepath_raw = os.path.join(OUT, name)
+    img.file_format = 'PNG'
+    img.save()
+    print("SAVED", img.filepath_raw)
+
+
+save_raw("T_BrennicChalk_BaseColor.png", out)  # already display values
+save_raw("T_BrennicChalk_ORM.png", mask_ao)
diff --git a/apps/vr/art/characters/brennic/epic/make_bake_chalk.py b/apps/vr/art/characters/brennic/epic/make_bake_chalk.py
new file mode 100644
index 0000000..447c284
--- /dev/null
+++ b/apps/vr/art/characters/brennic/epic/make_bake_chalk.py
@@ -0,0 +1,18 @@
+"""Writes bake_chalk.py: the first half of bake_epic.py (the bakes and the region masks, unchanged) followed by
+chalk_synth.py (the Chalk & Slate albedo). Run it before Blender:
+
+    python make_bake_chalk.py
+    blender -b -P bake_chalk.py -- <Brennic.fbx> <T_Brennic_BaseColor.png> <face_overlay.png> <outdir> [res]
+
+Writes T_BrennicChalk_BaseColor.png (display values: drawn tones, hatching, contours, bold face, chalk grain) and
+T_BrennicChalk_ORM.png (R AO, A skin) into <outdir>.
+"""
+import os
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+epic = open(os.path.join(HERE, "bake_epic.py"), encoding="utf-8").read()
+cut = epic.index("def regrade(")
+chalk = open(os.path.join(HERE, "chalk_synth.py"), encoding="utf-8").read()
+header = '"""Generated by make_bake_chalk.py from bake_epic.py (bakes, masks) and chalk_synth.py. Do not edit."""\n'
+open(os.path.join(HERE, "bake_chalk.py"), "w", encoding="utf-8", newline="\n").write(header + epic[:cut] + "\n" + chalk)
+print("wrote bake_chalk.py")
-- 
