+		{
+			At[Index] = Joint(*Frame, Finger.Joints[Index]);
+		}
+		if (Finger.Joints[0] == EHandKeypoint::ThumbMetacarpal)
+		{
+			StraightenThumb(At);
+		}
 		for (int32 Segment = 0; Segment < 3; ++Segment)
