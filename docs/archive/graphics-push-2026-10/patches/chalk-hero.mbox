+void QuestLook::HideArenaForBackdrop(AActor& Arena, const FArenaLayout& Layout)
+{
+	if (ArenaStyle::Current() != EArenaStyle::Chalk)
+	{
+		return;
+	}
+	static const TCHAR* const Hidden[] = {TEXT("MI_Q_Wall"), TEXT("MI_Q_Stands"), TEXT("MI_Q_Pylon"), TEXT("MI_Q_Wood"), TEXT("M_Q_Banner"), TEXT("M_Q_EnvFire"),
+	    TEXT("M_Q_SpellHalo"), TEXT("MI_Q_ChalkCrowd"), TEXT("M_CrowdPainted"), TEXT("M_Crowd_Atlas")};
+	int32 Count = 0;
+	TInlineComponentArray<UPrimitiveComponent*> Parts(&Arena);
+	for (UPrimitiveComponent* Part : Parts)
+	{
+		UMaterialInterface* Material = Part ? Part->GetMaterial(0) : nullptr;
+		if (!Material)
+		{
+			continue;
+		}
+		const FString Own = Material->GetName();
+		const FString Root = Material->GetMaterial() ? Material->GetMaterial()->GetName() : Own;
+		bool bHide = false;
+		for (const TCHAR* Name : Hidden)
+		{
+			bHide |= Own.Contains(Name) || Root == Name;
+		}
+		// Iron is the brazier bowls (hidden) and the spawn marker posts (kept: one post a marker).
+		const UInstancedStaticMeshComponent* Instances = Cast<UInstancedStaticMeshComponent>(Part);
+		if (Own.Contains(TEXT("MI_Q_Iron")) && !(Instances && Instances->GetInstanceCount() == Layout.SpawnMarkers.Num()))
+		{
+			bHide = true;
+		}
+		if (bHide)
+		{
+			Part->SetVisibility(false);
+			Part->SetCastShadow(false);
+			++Count;
+		}
+	}
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK chalk backdrop: %d arena components hidden"), Count);
+}
