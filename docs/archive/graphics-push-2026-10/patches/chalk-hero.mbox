+			// Chalk & Slate, hero-4: the casting lunge releases from his right hand: its fire large, the other hand's a
+			// small ember, so the thrust reads at 16 m.
+			if (ArenaStyle::Current() == EArenaStyle::Chalk)
+			{
+				const FVector Thrust = RivalFigure->GetMesh()->GetBoneLocation(TEXT("hand_r"));
+				for (SpellVfx::FPuff& Puff : Puffs)
+				{
+					const bool bThrust = FVector::Dist(Puff.CentreCm, Thrust) < 30.0;
+					Puff.SizeCm *= bThrust ? 1.9 : 0.55;
+					if (bThrust)
+					{
+						Puff.CentreCm = Thrust + (Puff.CentreCm - Thrust) * 0.5;
+					}
+				}
+				static double LastLog = -10.0;
+				const double Now = FPlatformTime::Seconds();
+				if (Now - LastLog > 2.0)
+				{
+					LastLog = Now;
+					UE_LOG(LogMageArena, Log, TEXT("MAGEVR_RIVAL_HAND hand_r=%s clip=%s t=%.3f s"), *Thrust.ToString(), RivalClips::Name(RivalFigure->GetClip()),
+					    RivalFigure->GetMesh()->GetPosition());
+				}
+			}
 			GlowFrame.Add(Glow.GetValue(), Puffs);
