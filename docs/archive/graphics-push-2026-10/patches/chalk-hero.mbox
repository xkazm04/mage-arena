diff --git a/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.cpp b/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.cpp
new file mode 100644
index 0000000..f87c855
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.cpp
@@ -0,0 +1,84 @@
+#include "Look/ArenaStyle.h"
+
+#include "MageArenaVR.h"
+#include "Misc/CommandLine.h"
+#include "Misc/PackageName.h"
+#include "Misc/Parse.h"
+
+bool ArenaStyle::Parse(const FString& Value, EArenaStyle& OutStyle)
+{
+	const FString Key = Value.TrimStartAndEnd().ToLower();
+	if (Key == TEXT("painted"))
+	{
+		OutStyle = EArenaStyle::Painted;
+		return true;
+	}
+	if (Key == TEXT("chalk"))
+	{
+		OutStyle = EArenaStyle::Chalk;
+		return true;
+	}
+	OutStyle = EArenaStyle::Painted;
+	return false;
+}
+
+EArenaStyle ArenaStyle::Current()
+{
+	static const EArenaStyle Cached = []()
+	{
+		FString Value;
+		EArenaStyle Style = EArenaStyle::Painted;
+		if (FParse::Value(FCommandLine::Get(), TEXT("MageArenaStyle="), Value) && !Parse(Value, Style))
+		{
+			// T16's style-pick capture also reads -MageArenaStyle (greybox, 13, 25, 30); those values are its own.
+			UE_LOG(LogMageArena, Log, TEXT("MAGEVR_STYLE -MageArenaStyle=%s is not an art style (painted|chalk), using painted"), *Value);
+		}
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_STYLE %s"), Name(Style));
+		return Style;
+	}();
+	return Cached;
+}
+
+bool ArenaStyle::IsArtStyle(const FString& Value)
+{
+	EArenaStyle Ignored;
+	return Parse(Value, Ignored);
+}
+
+const TCHAR* ArenaStyle::Name(EArenaStyle Style)
+{
+	return Style == EArenaStyle::Chalk ? TEXT("chalk") : TEXT("painted");
+}
+
+const TCHAR* ArenaStyle::Folder(EArenaStyle Style)
+{
+	return Style == EArenaStyle::Chalk ? TEXT("Chalk") : TEXT("");
+}
+
+FString ArenaStyle::StyledFolder(const FString& LookFolder, EArenaStyle Style)
+{
+	const FString Sub = Folder(Style);
+	return Sub.IsEmpty() ? LookFolder : LookFolder / Sub;
+}
+
+FString ArenaStyle::Resolve(const FString& LookFolder, const TCHAR* Name, const TCHAR* AssetClass)
+{
+	const EArenaStyle Style = Current();
+	const FString Painted = FString::Printf(TEXT("%s/%s.%s"), *LookFolder, Name, Name);
+	if (Style == EArenaStyle::Painted)
+	{
+		return Painted;
+	}
+	const FString Styled = StyledFolder(LookFolder, Style);
+	if (FPackageName::DoesPackageExist(Styled / Name))
+	{
+		return FString::Printf(TEXT("%s/%s.%s"), *Styled, Name, Name);
+	}
+	static TSet<FString> Logged;
+	if (!Logged.Contains(AssetClass))
+	{
+		Logged.Add(AssetClass);
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_STYLE %s: %s missing, using painted (first missing: %s)"), ArenaStyle::Name(Style), AssetClass, *(Styled / Name));
+	}
+	return Painted;
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.h b/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.h
new file mode 100644
index 0000000..68d50c9
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Look/ArenaStyle.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+/**
+ * The art style axis (docs/concepts/RETARGET-CHALK-SLATE-2026-10-28.md section 6), orthogonal to -MageArenaLook:
+ * -MageArenaStyle=painted|chalk picks which asset set a non-flat look draws. Painted is the default and is everything the
+ * graphics push built (the S1-derived set), so every push capture keeps its meaning; chalk is style 30, Chalk & Slate.
+ * The flat look ignores the style. An unknown value falls back to painted with a warning. Each style's texture set,
+ * palette, STYLE BLOCK and material parameters are described by apps/vr/art/style/<id>/style.json.
+ *
+ * Asset folders: a style's assets live in <look folder>/<Folder(style)> (painted: the look folder itself, so nothing
+ * moves; chalk: the "Chalk" subfolder). Until a chalk asset exists, Resolve falls back to the painted one and logs
+ * "MAGEVR_STYLE chalk: <class> missing, using painted" once per asset class.
+ */
+enum class EArenaStyle : uint8
+{
+	Painted,
+	Chalk,
+};
+
+namespace ArenaStyle
+{
+/** The style named on the command line, parsed once per process. */
+EArenaStyle Current();
+
+/** Parses a -MageArenaStyle= value; false (and Painted) for anything else. Exposed for tests. */
+bool Parse(const FString& Value, EArenaStyle& OutStyle);
+
+const TCHAR* Name(EArenaStyle Style);
+
+/**
+ * True when Value names an art style (painted, chalk). The T16 style-pick readers of the same -MageArenaStyle flag
+ * (greybox, 13, 25, 30: ArenaLayout, ElementColour, PresentationLook) treat such a value as no T16 style.
+ */
+bool IsArtStyle(const FString& Value);
+
+/** The style's subfolder under a look's asset folder: empty for painted, "Chalk" for chalk. */
+const TCHAR* Folder(EArenaStyle Style);
+
+/** A look folder joined with a style's subfolder, e.g. /Game/Look/Quest/Chalk (painted: the look folder unchanged). */
+FString StyledFolder(const FString& LookFolder, EArenaStyle Style);
+
+/**
+ * The object path of asset Name for the current style: <LookFolder>/<style folder>/Name.Name when that package exists,
+ * else the painted <LookFolder>/Name.Name, logging the fallback once for AssetClass (a short label: "surfaces", "sky").
+ */
+FString Resolve(const FString& LookFolder, const TCHAR* Name, const TCHAR* AssetClass);
+}
