@@ -59,6 +59,13 @@ inline void Input(UMaterialExpressionCustom& Custom, const TCHAR* Name, UMateria
 inline UMaterial* NewMaterial(const FString& Folder, const FString& Name)
 {
 	UPackage* Package = CreatePackage(*(Folder / Name));
+	// A re-run: the package on disk already holds this material. Load it and move the old object aside, so the new one
+	// takes the name and the package saves with exactly one asset.
+	Package->FullyLoad();
+	if (UObject* Old = StaticFindObject(UObject::StaticClass(), Package, *Name))
+	{
+		Old->Rename(*MakeUniqueObjectName(GetTransientPackage(), Old->GetClass()).ToString(), GetTransientPackage(), REN_DontCreateRedirectors | REN_NonTransactional);
+	}
 	return NewObject<UMaterial>(Package, FName(*Name), RF_Public | RF_Standalone | RF_Transactional);
 }
 
diff --git a/apps/vr/tools/capture-epic.ps1 b/apps/vr/tools/capture-epic.ps1
new file mode 100644
index 0000000..f467f27
--- /dev/null
+++ b/apps/vr/tools/capture-epic.ps1
@@ -0,0 +1,37 @@
+# Graphics push 10-28, Tier B: an epic-look still pair (game camera + key-art framing of Brennic) with the frame time.
+# Launches the game in a normal window (not -RenderOffScreen: the sky atmosphere rendered black offscreen), with the
+# start-up settings the epic look needs on the command line (deferred, distance fields, Lumen, VSM, TSR; the project
+# itself stays forward for flat and quest), -MageArenaLook=epic and -MageArenaEpicShot=<Out> (Look/EpicLook.h).
+# -Scene creatures puts the imported creatures at opponent distance (-MageArenaCreatureImportScene: Brennic idle at 8 m);
+# -Scene none is the bare arena. -ExtraArgs passes tuning flags (-MageArenaEpicEV=, -MageArenaEpicSunPitch=, ...).
+# The first run compiles the deferred shader permutations: allow it an hour (-TimeoutMinutes).
+param([string]$Out = "runs\push\epic\r1", [string]$Scene = "creatures", [string]$ExtraArgs = "", [int]$TimeoutMinutes = 90, [int]$ResX = 1376, [int]$ResY = 768)
+
+$ErrorActionPreference = "Stop"
+$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
+$VrDir = (Resolve-Path "$ScriptDir\..").Path
+$Root = (Resolve-Path "$VrDir\..\..").Path
+$Project = Join-Path $VrDir "Game\MageArenaVR.uproject"
+$Editor = "C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor.exe"
+$OutDir = if ([System.IO.Path]::IsPathRooted($Out)) { $Out } else { Join-Path $Root $Out }
+New-Item -ItemType Directory -Force -Path $OutDir | Out-Null
+Remove-Item -Force -ErrorAction SilentlyContinue (Join-Path $OutDir "game.png"), (Join-Path $OutDir "keyart.png")
+
+$Section = "[/Script/Engine.RendererSettings]"
+$Ini = "-ini:Engine:" + ((@("r.ForwardShading=False", "r.GenerateMeshDistanceFields=True", "r.DynamicGlobalIlluminationMethod=1", "r.ReflectionMethod=1",
+	"r.Shadow.Virtual.Enable=1", "r.AntiAliasingMethod=4") | ForEach-Object { "$Section`:$_" }) -join ",")
+$Log = Join-Path $OutDir "capture.log"
+$ArgList = @("`"$Project`"", "-game", "-windowed", "-ResX=$ResX", "-ResY=$ResY", "-unattended", "-nosplash", "-nohmd", "-log", "-abslog=`"$Log`"",
+	"-MageArenaLook=epic", "-MageArenaEpicShot=`"$OutDir`"", $Ini)
+if ($Scene -eq "creatures") { $ArgList += "-MageArenaCreatureImportScene" }
+if ($ExtraArgs) { $ArgList += $ExtraArgs }
+Write-Host "capture-epic: $($ArgList -join ' ')"
+$Process = Start-Process -FilePath $Editor -ArgumentList $ArgList -PassThru
+if (-not $Process.WaitForExit($TimeoutMinutes * 60000)) {
+	Write-Host "capture-epic: $TimeoutMinutes minute timeout, stopping the editor it started"
+	& taskkill.exe /T /F /PID $Process.Id | Out-Host
+}
+Select-String -Path $Log -Pattern "MAGEVR_EPIC_|MAGEVR_LOOK" | ForEach-Object { Write-Host $_.Line }
+$Ok = (Test-Path (Join-Path $OutDir "game.png")) -and (Test-Path (Join-Path $OutDir "keyart.png"))
+if (-not $Ok) { Write-Host "capture-epic: FAIL (log: $Log)"; exit 1 }
+Write-Host "capture-epic: OK $OutDir"
-- 
