+"""Round 7: the painted right hand in each cell, for the cast fire (it floated at the hidden rig's hand).
+
+hand_r(rgb, alpha) -> (u, v, visible): the hand that casts is his right, the one on the viewer's left. Skin pixels (warm,
+light: r > g > b, r - b > 35, r > 110) inside the figure; the hand is the skin blob furthest out along the casting
+direction, scored by -x - 0.55 y (left and up), averaged over the best 60 pixels. Visible when that point lies outside the
+torso, more than 0.23 of his height left of his centre or above its shoulders, so a hand at his side reads as hidden.
+u, v in 0..1 of the cell (v down).
+"""
+import numpy as np
+
+
+def hand_r(rgb, alpha):
+    h, w = alpha.shape
+    r, g, b = rgb[..., 0], rgb[..., 1], rgb[..., 2]
+    fig = alpha > 0.5
+    skin = fig & (r > g) & (g > b) & (r - b > 35) & (r > 110)
+    ys, xs = np.nonzero(fig)
+    if len(ys) == 0 or skin.sum() < 30:
+        return 0.5, 0.5, False
+    top, bottom = ys.min(), ys.max()
+    height = bottom - top
+    cx = np.median(xs)
+    sy, sx = np.nonzero(skin)
+    # Ignore the face: skin in the top 14 % of the figure near its centre.
+    face = (sy < top + 0.14 * height) & (np.abs(sx - cx) < 0.12 * height)
+    sy, sx = sy[~face], sx[~face]
+    if len(sy) == 0:
+        return 0.5, 0.5, False
+    score = -sx - 0.55 * sy
+    best = np.argsort(score)[-60:]
+    hx, hy = float(sx[best].mean()), float(sy[best].mean())
+    shoulder = top + 0.2 * height
+    visible = (cx - hx) > 0.23 * height or hy < shoulder
+    return hx / w, hy / h, bool(visible)
-- 
