+void QuestLook::AddChalkOutline(USkinnedMeshComponent& Leader)
+{
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	if (ArenaStyle::Current() != EArenaStyle::Chalk || Leader.ComponentHasTag(TEXT("ChalkOutlined")) || !Leader.GetSkinnedAsset() || !Leader.GetOwner())
+	{
+		return;
+	}
+	UMaterialInterface* Outline = Cached.Get();
+	if (!Outline)
+	{
+		Outline = LoadObject<UMaterialInterface>(nullptr, TEXT("/Game/Look/Quest/Chalk/M_Q_ChalkOutline.M_Q_ChalkOutline"), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		Cached = Outline;
+	}
+	if (!Outline)
+	{
+		return;
+	}
+	Leader.ComponentTags.Add(TEXT("ChalkOutlined"));
+	USkeletalMeshComponent* Hull = NewObject<USkeletalMeshComponent>(Leader.GetOwner());
+	Hull->ComponentTags.Add(TEXT("ChalkHull"));
+	Hull->ComponentTags.Add(TEXT("ChalkOutlined"));
+	Hull->SetSkinnedAssetAndUpdate(Leader.GetSkinnedAsset());
+	Hull->SetupAttachment(&Leader);
+	Hull->SetCastShadow(false);
+	Hull->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	Hull->SetBoundsScale(Leader.BoundsScale);
+	// The line is about the same width on screen: thin on the hands at arm's length, thicker on Brennic at 16 m.
+	UMaterialInstanceDynamic* Line = UMaterialInstanceDynamic::Create(Outline, Hull);
+	Line->SetScalarParameterValue(TEXT("Thickness"), Leader.IsA<UPoseableMeshComponent>() ? 0.18f : 2.6f);
+	for (int32 Slot = 0; Slot < Hull->GetNumMaterials(); ++Slot)
+	{
+		Hull->SetMaterial(Slot, Line);
+	}
+	Hull->RegisterComponent();
+	Hull->SetLeaderPoseComponent(&Leader);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_QUEST_LOOK chalk outline on %s"), *Leader.GetName());
+}
