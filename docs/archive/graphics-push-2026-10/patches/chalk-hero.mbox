 	Profile->Settings.MeanFreePathDistance = 0.6f;
 	Profile->MarkPackageDirty();
 
+	// Chalk & Slate, hero-4: an inverted hull of constant screen width (about WidthPx pixels at the game camera, 1376 px
+	// across a 90 degree field: 0.00145 rad a pixel), so Brennic keeps a dark chalk contour at 16 m where the albedo's own
+	// lines fall into the low mips. Back faces only, pushed out along the normal by distance x WidthPx x PixelRad, broken
+	// like a chalk stroke. RivalFigure adds it under the chalk style.
+	{
+		UMaterial* Hull = NewMaterial(Folder, TEXT("M_BrennicHull"));
+		Hull->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
+		Hull->SetShadingModel(MSM_Unlit);
+		Hull->BlendMode = BLEND_Masked;
+		Hull->TwoSided = true;
+		UMaterialExpressionCustom* Push = Add<UMaterialExpressionCustom>(*Hull, -500, 300);
+		Push->Description = TEXT("ScreenWidthPush");
+		Push->OutputType = CMOT_Float3;
+		Push->Inputs.Reset();
+		Input(*Push, TEXT("N"), Add<UMaterialExpressionVertexNormalWS>(*Hull, -1000, 300));
+		Input(*Push, TEXT("WP"), Add<UMaterialExpressionWorldPosition>(*Hull, -1000, 360));
+		Input(*Push, TEXT("Cam"), Add<UMaterialExpressionCameraPositionWS>(*Hull, -1000, 420));
+		Input(*Push, TEXT("WidthPx"), Scalar(*Hull, TEXT("WidthPx"), 2.2, 480));
+		Input(*Push, TEXT("PixelRad"), Scalar(*Hull, TEXT("PixelRad"), 0.00145, 540));
+		Push->Code = TEXT("float d = length(Cam - WP);\nreturn normalize(N) * clamp(d * WidthPx * PixelRad, 0.25, 12.0);\n");
+		UMaterialExpressionCustom* Mask = Add<UMaterialExpressionCustom>(*Hull, -500, 100);
+		Mask->Description = TEXT("BackBroken");
+		Mask->OutputType = CMOT_Float1;
+		Mask->Inputs.Reset();
+		Input(*Mask, TEXT("S"), Add<UMaterialExpressionTwoSidedSign>(*Hull, -1000, 100));
+		Input(*Mask, TEXT("WP"), Add<UMaterialExpressionWorldPosition>(*Hull, -1000, 160));
+		Mask->Code = TEXT("float n = frac(sin(dot(floor(WP.xz / 3.0) + floor(WP.y / 5.0), float2(12.9898, 78.233))) * 43758.5453);\nreturn (S < 0.0 ? 1.0 : 0.0) * (n > 0.12 ? 1.0 : 0.0);\n");
+		Hull->GetEditorOnlyData()->EmissiveColor.Connect(0, Vector(*Hull, TEXT("Ink"), FLinearColor(0.016f, 0.012f, 0.012f), 0));
+		Hull->GetEditorOnlyData()->OpacityMask.Connect(0, Mask);
+		Hull->GetEditorOnlyData()->WorldPositionOffset.Connect(0, Push);
+		Hull->PreEditChange(nullptr);
+		Hull->PostEditChange();
+		Hull->MarkPackageDirty();
+		Hull->ForceRecompileForRendering();
+	}
+
 	UMaterial* Material = NewMaterial(Folder, TEXT("M_BrennicEpic"));
 	Material->SetUsageByFlag(MATUSAGE_SkeletalMesh, true);
 	Material->SetShadingModel(MSM_SubsurfaceProfile);
