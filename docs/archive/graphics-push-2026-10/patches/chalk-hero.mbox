 if (SRC / "wardwave-01.png").exists() and not (SRC / "wardwave-02.png").exists():
     Image.open(SRC / "wardwave-01.png").transpose(Image.FLIP_LEFT_RIGHT).save(SRC / "wardwave-02.png")
     print("wardwave-02.png = the chalk wave mirrored")
+
+# The crowd as grey chalk sketches (probe 2): Tier B's painted atlas, same slots and alpha, desaturated to grey and white
+# chalk with a white contour where the figure's value changes, a stroke grain, and a fifth of the colour kept as touches.
+from PIL import ImageFilter
+
+atlas_png = Path(__file__).resolve().parents[2] / "art" / "crowd-painted" / "T_CrowdPainted.png"
+atlas = Image.open(atlas_png).convert("RGBA")
+a = np.asarray(atlas, dtype=np.float32)
+rgb, alpha = a[..., :3], a[..., 3:]
+luma = (rgb * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1, keepdims=True)
+chalk = 70.0 + luma * 0.75
+chalk = chalk + (rgb - luma) * 0.22
+edges = np.asarray(Image.fromarray(luma[..., 0].astype(np.uint8)).filter(ImageFilter.FIND_EDGES), dtype=np.float32)[..., None]
+outline = np.clip(np.asarray(Image.fromarray(alpha[..., 0].astype(np.uint8)).filter(ImageFilter.FIND_EDGES), dtype=np.float32)[..., None] * 2.0, 0, 255)
+chalk = np.maximum(chalk, np.clip(edges * 2.5 + outline, 0, 235))
+rng = np.random.default_rng(30)
+chalk = chalk * rng.uniform(0.82, 1.0, size=luma.shape)
+out = np.concatenate([np.clip(chalk, 0, 255), alpha], axis=-1).astype(np.uint8)
+Image.fromarray(out, "RGBA").save(OUT / "T_Q_ChalkCrowd.png")
+print("T_Q_ChalkCrowd.png", atlas.size)
