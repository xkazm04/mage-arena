+AEpicLookRig::AEpicLookRig()
+{
+	PrimaryActorTick.bCanEverTick = true;
+	PrimaryActorTick.bStartWithTickEnabled = true;
+	PrimaryActorTick.bTickEvenWhenPaused = true;
+	SetRootComponent(CreateDefaultSubobject<USceneComponent>(TEXT("Root")));
+	FParse::Value(FCommandLine::Get(), TEXT("MageArenaEpicShot="), ShotDir);
+}
+
+void AEpicLookRig::AddBrazierLight(UPointLightComponent* Light, float BaseCandela)
+{
+	BrazierLights.Add(Light);
+	BrazierBase.Add(BaseCandela);
+	Light->SetIntensity(BaseCandela);
+}
+
+void AEpicLookRig::Tick(float DeltaSeconds)
+{
+	Super::Tick(DeltaSeconds);
+	const double Time = GetWorld()->GetTimeSeconds();
+	for (int32 Index = 0; Index < BrazierLights.Num(); ++Index)
+	{
+		// Three incommensurate waves per brazier, so no two flicker together (the flame puffs do the same, BrazierFire).
+		const double Phase = Index * 1.7;
+		const double Flicker = 0.82 + 0.10 * FMath::Sin(Time * 7.3 + Phase) + 0.06 * FMath::Sin(Time * 13.1 + Phase * 2.1) + 0.05 * FMath::Sin(Time * 3.1 + Phase * 0.7);
+		BrazierLights[Index]->SetIntensity(BrazierBase[Index] * static_cast<float>(Flicker));
+	}
+	TickSpellLights();
+	BrennicCheck -= DeltaSeconds;
+	if (BrennicCheck <= 0.f)
+	{
+		BrennicCheck = 0.25f;
+		BrennicEpicLook::ApplyAll(*GetWorld());
+	}
+	if (!ShotDir.IsEmpty())
+	{
+		TickShot(DeltaSeconds);
+	}
+}
+
+void AEpicLookRig::TickSpellLights()
+{
+	// The spell glow cards (M_SpellGlow, one instanced layer per colour, Session/SpellVfx.h) are unlit; under the epic
+	// look each visible layer gets a point light at its cards' centroid in its own colour, and a little more glow for
+	// the bloom. The brazier flames use the same material on the arena actor; they have their own lights.
+	const float Candela = ParamOr(TEXT("MageArenaEpicSpellCd="), 25.f);
+	const float Gain = ParamOr(TEXT("MageArenaEpicSpellGain="), 1.6f);
+	int32 Used = 0;
+	for (TObjectIterator<UInstancedStaticMeshComponent> It; It; ++It)
+	{
+		UInstancedStaticMeshComponent* Layer = *It;
+		const AActor* LayerOwner = Layer->GetOwner();
+		UMaterialInstanceDynamic* Glow = Cast<UMaterialInstanceDynamic>(Layer->GetMaterial(0));
+		if (Layer->GetWorld() != GetWorld() || !LayerOwner || LayerOwner->GetClass()->GetName() != TEXT("SessionPresentation") || !Glow || !Glow->Parent ||
+		    !Glow->Parent->GetName().Contains(TEXT("SpellGlow")) || !Layer->IsVisible() || Layer->GetInstanceCount() == 0)
+		{
+			continue;
+		}
+		FVector Sum = FVector::ZeroVector;
+		const int32 Count = Layer->GetInstanceCount();
+		for (int32 Index = 0; Index < Count; ++Index)
+		{
+			FTransform Transform;
+			Layer->GetInstanceTransform(Index, Transform, true);
+			Sum += Transform.GetLocation();
+		}
+		TArray<FMaterialParameterInfo> Infos;
+		TArray<FGuid> Ids;
+		Glow->GetAllVectorParameterInfo(Infos, Ids);
+		FLinearColor Colour = FLinearColor(1.f, 0.5f, 0.2f);
+		for (const FMaterialParameterInfo& Info : Infos)
+		{
+			FLinearColor Value;
+			if (Glow->GetVectorParameterValue(Info, Value) && Value.GetMax() > 0.05f)
+			{
+				Colour = Value;
+				break;
+			}
+		}
+		Glow->SetScalarParameterValue(TEXT("GlowGain"), Gain);
+		if (!SpellLights.IsValidIndex(Used))
+		{
+			UPointLightComponent* Light = NewObject<UPointLightComponent>(this);
+			Light->SetMobility(EComponentMobility::Movable);
+			Light->SetupAttachment(GetRootComponent());
+			Light->RegisterComponent();
+			Light->SetIntensityUnits(ELightUnits::Candelas);
+			Light->SetAttenuationRadius(900.f);
+			Light->SetSourceRadius(20.f);
+			Light->SetCastShadows(false);
+			SpellLights.Add(Light);
+		}
+		UPointLightComponent* Light = SpellLights[Used++];
+		Light->SetVisibility(true);
+		Light->SetWorldLocation(Sum / Count);
+		Light->SetLightColor(Colour.CopyWithNewOpacity(1.f));
+		Light->SetIntensity(Candela * FMath::Min(1.f, Count / 8.f));
+		if (Used >= 6)
+		{
+			break;
+		}
+	}
+	for (int32 Index = Used; Index < SpellLights.Num(); ++Index)
+	{
+		SpellLights[Index]->SetVisibility(false);
+	}
+}
+
+void AEpicLookRig::PlaceKeyArtCamera()
+{
+	APlayerController* Controller = GetWorld()->GetFirstPlayerController();
+	const APawn* Pawn = Controller ? Controller->GetPawn() : nullptr;
+	const UCameraComponent* GameCamera = Pawn ? Pawn->FindComponentByClass<UCameraComponent>() : nullptr;
+	if (!GameCamera)
+	{
+		return;
+	}
+	FVector Target = GameCamera->GetComponentLocation() + GameCamera->GetForwardVector() * 800.0;
+	for (TObjectIterator<USkeletalMeshComponent> It; It; ++It)
+	{
+		if (It->GetWorld() == GetWorld() && BrennicEpicLook::DrawsBrennic(**It))
+		{
+			Target = It->Bounds.Origin + FVector(0.0, 0.0, It->Bounds.BoxExtent.Z * 0.15);
+		}
+	}
+	FActorSpawnParameters Params;
+	Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+	const FVector Eye = GameCamera->GetComponentLocation();
+	ACameraActor* KeyArt = GetWorld()->SpawnActor<ACameraActor>(ACameraActor::StaticClass(), FTransform((Target - Eye).Rotation(), Eye), Params);
+	if (KeyArt)
+	{
+		KeyArt->GetCameraComponent()->SetFieldOfView(ParamOr(TEXT("MageArenaEpicKeyArtFov="), 34.f));
+		KeyArt->GetCameraComponent()->SetConstraintAspectRatio(false);
+		Controller->SetViewTarget(KeyArt);
+	}
+}
+
+void AEpicLookRig::TickShot(float DeltaSeconds)
+{
+	StageTime += DeltaSeconds;
+	const bool bCompiling = GShaderCompilingManager && GShaderCompilingManager->GetNumRemainingJobs() > 0;
+	switch (ShotStage)
+	{
+	case 0: // wait for the shaders, then for the light (Lumen, the sky capture, VSM caching) to settle
+		SettledTime = bCompiling ? 0.f : SettledTime + DeltaSeconds;
+		if (bCompiling && FMath::Fmod(StageTime, 10.f) < DeltaSeconds)
+		{
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_EPIC_SHOT waiting for %d shader jobs (%.0f s)"), GShaderCompilingManager->GetNumRemainingJobs(), StageTime);
+		}
+		if (SettledTime > ParamOr(TEXT("MageArenaEpicSettleS="), 8.f) && StageTime > 12.f)
+		{
+			ShotStage = 1;
+			StageTime = 0.f;
+		}
+		break;
+	case 1: // frame time over 120 frames
+		GameMsSum += DeltaSeconds * 1000.0;
+		GpuMsSum += FPlatformTime::ToMilliseconds(RHIGetGPUFrameCycles(0));
+		if (++Frames >= 120)
+		{
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_EPIC_FRAME frames=%d frame_ms=%.2f gpu_ms=%.2f res=%dx%d"), Frames, GameMsSum / Frames, GpuMsSum / Frames,
+			    GEngine && GEngine->GameViewport ? static_cast<int32>(GEngine->GameViewport->Viewport->GetSizeXY().X) : 0,
+			    GEngine && GEngine->GameViewport ? static_cast<int32>(GEngine->GameViewport->Viewport->GetSizeXY().Y) : 0);
+			PendingShot = FPaths::ConvertRelativePathToFull(ShotDir / TEXT("game.png"));
+			FScreenshotRequest::RequestScreenshot(PendingShot, false, false, false);
+			ShotStage = 2;
+			StageTime = 0.f;
+		}
+		break;
+	case 2:
+		if (!FScreenshotRequest::IsScreenshotRequested() && IFileManager::Get().FileSize(*PendingShot) > 0)
+		{
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_EPIC_SHOT wrote %s"), *PendingShot);
+			PlaceKeyArtCamera();
+			ShotStage = 3;
+			StageTime = 0.f;
+		}
+		break;
+	case 3:
+		if (StageTime > 2.5f)
+		{
+			PendingShot = FPaths::ConvertRelativePathToFull(ShotDir / TEXT("keyart.png"));
+			FScreenshotRequest::RequestScreenshot(PendingShot, false, false, false);
+			ShotStage = 4;
+			StageTime = 0.f;
+		}
+		break;
+	case 4:
+		if (!FScreenshotRequest::IsScreenshotRequested() && IFileManager::Get().FileSize(*PendingShot) > 0)
+		{
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_EPIC_SHOT wrote %s"), *PendingShot);
+			UE_LOG(LogMageArena, Display, TEXT("MAGEVR_EPIC_SHOT done"));
+			ShotStage = 5;
+			FPlatformMisc::RequestExit(false);
+		}
+		break;
+	default:
+		break;
+	}
+}
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.h b/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.h
