diff --git a/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.cpp b/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.cpp
index 4dc4cb1..45503ba 100644
--- a/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.cpp
+++ b/apps/vr/Game/Source/MageArenaVR/Look/CreateQuestLookAssetsCommandlet.cpp
@@ -369,6 +369,59 @@ UMaterial* BuildBanner(UTexture2D* Cloth)
 	return Finish(Material, Name) ? Material : nullptr;
 }
 
+// Chalk & Slate (style 30; docs/concepts/RETARGET-CHALK-SLATE-2026-10-28.md section 6): an unlit drawn surface, no post
+// pass. The chalk still is the drawing (its line work and contours are in the texture); the shade is hatched, not
+// darkened: N.L against the sun steps the surface into lit, mid and dark, and the mid and dark steps draw diagonal (then
+// crossed) slate-coloured hatch lines in the world-aligned UV over the chalk. A per-cell grain multiplies in. The contact
+// and rim shading of the painted surface (Shade) stays as a soft rub of the slate.
+const TCHAR* ChalkCode = TEXT(
+    "float ndl = dot(normalize(N), normalize(L));\n"
+    "float mid = ndl < 0.55 ? 1.0 : 0.0;\n"
+    "float dark = ndl < 0.05 ? 1.0 : 0.0;\n"
+    "float2 h = Uv * HatchFreq;\n"
+    "float l1 = smoothstep(0.55, 0.85, abs(frac(h.x + h.y) - 0.5) * 2.0);\n"
+    "float l2 = smoothstep(0.55, 0.85, abs(frac(h.x - h.y) - 0.5) * 2.0);\n"
+    "float lines = saturate(l1 * mid + l2 * dark) * Hatch;\n"
+    "float2 cell = floor(Uv * 384.0);\n"
+    "float n = frac(sin(dot(cell, float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float grain = lerp(1.0 - Grain, 1.0, n);\n"
+    "float3 chalk = Base * grain * lerp(1.0, 0.86, mid) * lerp(1.0, 0.9, dark);\n"
+    "float3 rubbed = lerp(Slate, chalk, saturate(Shade));\n"
+    "return lerp(rubbed, Slate, lines);");
+
+UMaterial* BuildChalkSurface(UTexture2D* Colour)
+{
+	const TCHAR* Name = TEXT("M_Q_ChalkSurface");
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
