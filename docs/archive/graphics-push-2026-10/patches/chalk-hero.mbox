 if R6:
     # Round 7 ("pastel on toned paper"): soft value planes, the fill's fine variation rubbed together a little.
     skin_out = skin_out * 0.55 + _blur(skin_out, 3) * 0.45
+if os.environ.get("HANDS_R8") == "1":
+    # Round 8 (judges: p11's etched, contour-hatched hands have the best line work; go back to it in the chalk palette):
+    # a mid-tone warm skin in two soft planes, and the drawing in LIGHT chalk on it: the knuckles' arcs (the upper half
+    # only, so never a ring), the extensor tendons from each knuckle toward the wrist, short creases at the joints, and
+    # form-following hatching (3D sections across the hand's long axis, so no wood grain) on the lit planes; a deeper warm
+    # pastel hatch in the shade. All lines broken by a grain.
+    chalk = np.array([0.96, 0.9, 0.8], np.float32)
+    mid = skin_col * np.array([0.84, 0.74, 0.68], np.float32)
+    mid_shade = skin_col * np.array([0.64, 0.5, 0.45], np.float32)
+    b8 = np.clip((form - 0.3) / 0.3, 0, 1)
+    # The form field is coarse (it stepped into blocks on the palm): rub the plane edge out.
+    for _ in range(3):
+        b8 = _blur(b8, 6)
+    skin_out = mid_shade + (mid - mid_shade) * (b8 * b8 * (3 - 2 * b8))[..., None]
+    lit_l = np.zeros((RES, RES), np.float32)
+    knuckle_hi = np.zeros((RES, RES), np.float32)
+    for s8 in SIDES:
+        side8 = (Pt[..., 0] > 0) if s8 == "l" else (Pt[..., 0] <= 0)
+        pn8 = _v(pn[s8])
+        back8 = np.clip(-(Nt * pn8).sum(-1) * 2.0, 0, 1)
+        W8 = _v(head[f"hand_{s8}"])
+        for f in ("index", "middle", "ring", "pinky"):
+            K8 = _v(head[f"{f}_01_{s8}"])
+            ax8 = (K8 - W8)
+            L8 = np.linalg.norm(ax8)
+            ax8 = ax8 / max(L8, 1e-6)
+            rel = Pt - W8
+            t8 = (rel * ax8).sum(-1) / L8
+            perp = np.linalg.norm(rel - (rel * ax8).sum(-1)[..., None] * ax8, axis=-1)
+            # The tendon: a line along the back from the knuckle to two thirds of the way to the wrist, tapering.
+            tend = (perp < 0.0014 * (0.6 + 0.6 * np.clip(t8, 0, 1))) & (t8 > 0.3) & (t8 < 0.97)
+            lit_l = np.maximum(lit_l, tend * back8 * side8 * 0.75)
+            # The knuckle's arc: the upper half of a ring round the knuckle head, facing the wrist side away.
+            d8 = np.linalg.norm(Pt - K8, axis=-1)
+            up8 = ((Pt - K8) * ax8).sum(-1) > -0.002
+            # Only the cap that faces straight back, so the arc stays a short curve and never closes round the finger.
+            cap8 = (-(Nt * pn8).sum(-1)) > 0.75
+            # (Arcs closed into rings in UV; a soft rubbed highlight on the knuckle head reads as the bone instead.)
+            knk8 = np.clip(1.0 - d8 / 0.007, 0, 1) ** 1.5 * np.clip(-(Nt * pn8).sum(-1), 0, 1)
+            knuckle_hi = np.maximum(knuckle_hi, knk8 * side8 * 0.45)
+        T8 = _v(head[f"thumb_02_{s8}"])
+        d8 = np.linalg.norm(Pt - T8, axis=-1)
+        knuckle_hi = np.maximum(knuckle_hi, np.clip(1.0 - d8 / 0.006, 0, 1) ** 1.5 * np.clip(-(Nt * pn8).sum(-1), 0, 1) * side8 * 0.35)
+    # Short creases at the finger joints, reused from the drawn creases but light and thin.
+    lit_l = np.maximum(lit_l, np.clip(lines, 0, 1) * 1.6 * 0.25)
+    grain8 = _blur(rng_c.random((RES, RES)).astype(np.float32), 1) > 0.42
+    lit_l = lit_l * grain8
+    if cross is not None:
+        # Light hatching only as a few short strokes where the form turns from lit to shade (dense light hatching on the
+        # lit planes read as wood grain in the first try).
+        lit_h = np.clip(hatch * np.clip(1.0 - np.abs(form - 0.45) / 0.08, 0, 1) * 0.25, 0, 0.25)
+        deep_h = np.zeros_like(form)  # the deep hatch read as wood grain on the shaded islands
+        skin_out = skin_out * (1 - lit_h[..., None]) + chalk * lit_h[..., None]
+        skin_out = skin_out * (1 - deep_h[..., None]) + (mid_shade * 0.8) * deep_h[..., None]
+    skin_out = skin_out * (1 - knuckle_hi[..., None]) + (mid * 1.18) * knuckle_hi[..., None]
+    skin_out = skin_out * (1 - lit_l[..., None] * 0.8) + chalk * (lit_l[..., None] * 0.8)
 
 # The sleeve: slate-blue cloth with lighter chalk fold lines round it and a few darker hatches.
 sl_body = np.array([0.23, 0.28, 0.36], np.float32)
