diff --git a/apps/vr/art/characters/brennic/sprite/pack_pages.py b/apps/vr/art/characters/brennic/sprite/pack_pages.py
new file mode 100644
index 0000000..c0bc5f9
--- /dev/null
+++ b/apps/vr/art/characters/brennic/sprite/pack_pages.py
@@ -0,0 +1,319 @@
+"""Round 5: Brennic's flipbook pages at 512 px cells, one matte and chalk pass for every clip, scale held to the idle.
+
+python pack_pages.py <gen_dir> <out_prefix> [--cell 512] [--clips Idle,Cast,Hit,Death@18,Ward,Strafe,Sunfall]
+
+<gen_dir> holds rig/<Clip>, v2v/<Clip> (with source.json for clips made without the rig) and matte/<Clip>, as for
+pack_atlas.py. A clip "Name@fps" packs at that rate (default 24). Every clip, from any source, goes through the same steps:
+  1. matte: BiRefNet matte (bounded by the rig silhouette where one exists), holes filled, specks removed, the edge pulled
+     in 1 px and its colour taken from just inside (no dark fringe from the slate the matte bled);
+  2. scale: standing clips are scaled about the feet so feet-to-head-top matches the idle's first frame; crouching clips
+     (Cast, Death) so the head's width does (median-smoothed over 9 frames; frames with no head hold the last scale), and
+     the feet are put on the idle's feet line: no growth mid-clip (round 4: Hit +15 %, Ward, the Death kneel);
+  3. colour: Lab mean and spread matched to the idle's first frame, with the arms and legs' deep shadow lifted so they
+     do not crush to black at 4 m;
+  4. chalk: a pastel posterize, slate grain, soft shade hatching, a charcoal contour inside the edge and a thin, broken
+     warm chalk edge (not an even cream line: at 4 m that read as a sticker edge);
+  5. depth: an inflated-silhouette depth (0 at the edge, 1 in the thickest part of the body) for the depth card.
+Pages are 4096 px: (4096 / cell)^2 cells each; a clip that does not fit the page's remaining cells starts a new page.
+Writes <out_prefix>_P<n>.png (RGBA), <out_prefix>_D<n>.png (depth, cells of cell/4), <out_prefix>.json and a contact sheet
+per clip (<out_prefix>-sheet-<Clip>.png).
+"""
+import json
+import os
+import sys
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFilter
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from pack_atlas import lab2rgb, rgb2lab, _noise  # noqa: E402
+
+PAGE = 4096
+
+
+def arg(name, default):
+    return type(default)(sys.argv[sys.argv.index(name) + 1]) if name in sys.argv else default
+
+
+def blur(a, r):
+    """A (2r+1) box along both axes (numpy; PIL's BoxBlur takes no float images)."""
+    if r < 1:
+        return a
+    for axis in (0, 1):
+        c = np.cumsum(np.pad(a, [(r + 1, r) if i == axis else (0, 0) for i in range(a.ndim)], mode="edge"), axis)
+        a = (np.take(c, range(2 * r + 1, c.shape[axis]), axis) - np.take(c, range(0, c.shape[axis] - 2 * r - 1), axis)) / (2 * r + 1)
+    return a
+
+
+def clean_matte(alpha):
+    """Fill holes, drop specks, pull the edge in 1 px; the matte's half-sure cloak (dark on dark slate) made solid."""
+    alpha = np.clip((alpha - 0.2) / 0.4, 0, 1)
+    h, w = alpha.shape
+    solid = (alpha > 0.5).astype(np.uint8) * 255
+    # Holes: everything the outside flood fill cannot reach is inside the figure.
+    pad = Image.fromarray(np.pad(solid, 1), "L").copy()  # a fresh buffer: floodfill silently skips array-backed images
+    ImageDraw.floodfill(pad, (0, 0), 128)
+    outside = np.asarray(pad, dtype=np.uint8)[1:-1, 1:-1] == 128
+    filled = ~outside
+    # Specks: an opening (min then max) of 5 px removes islands and hairs under ~5 px.
+    m = Image.fromarray((filled * 255).astype(np.uint8)).filter(ImageFilter.MinFilter(5)).filter(ImageFilter.MaxFilter(5))
+    core = np.asarray(m, dtype=np.float64) / 255.0
+    interior = np.asarray(m.filter(ImageFilter.MinFilter(5)), dtype=np.float64) / 255.0 > 0.5
+    soft = np.where(interior, 1.0, alpha * core)
+    # Pull the edge in 1 px with a soft falloff.
+    inner = np.asarray(Image.fromarray((soft * 255).astype(np.uint8)).filter(ImageFilter.MinFilter(3)), dtype=np.float64) / 255.0
+    return np.clip(inner, 0, 1)
+
+
+def decontaminate(rgb, alpha):
+    """The edge's colour from just inside the figure: the slate the matte bled into the rim goes."""
+    inner = np.asarray(Image.fromarray((alpha * 255).astype(np.uint8)).filter(ImageFilter.MinFilter(7)), dtype=np.float64) / 255.0
+    acc = rgb * inner[..., None]
+    w = inner.copy()
+    for _ in range(3):
+        acc = np.stack([blur(acc[..., c], 3) for c in range(3)], -1)
+        w = blur(w, 3)
+    fill = acc / np.maximum(w, 1e-4)[..., None]
+    edge = np.clip((1.0 - inner) * (alpha > 0.02), 0, 1)[..., None]
+    return rgb * (1 - edge) + np.where(w[..., None] > 1e-3, fill, rgb) * edge
+
+
+def head_width(alpha):
+    """Width of the head (px): the largest run in the rows 15-45 px below the figure's top run that is at least 50 px
+    wide. None when the top of the figure is not a head (raised hands are thinner; a lying figure is far wider)."""
+    m = alpha > 0.5
+    rows = np.nonzero(m.any(1))[0]
+    if len(rows) == 0:
+        return None
+    widths = []
+    for y in range(rows[0], min(rows[0] + 200, m.shape[0])):
+        r = m[y]
+        if not r.any():
+            continue
+        d = np.diff(np.concatenate([[0], r.astype(np.int8), [0]]))
+        starts, ends = np.nonzero(d == 1)[0], np.nonzero(d == -1)[0]
+        widths.append((ends - starts).max())
+    widths = np.array(widths)
+    big = np.nonzero(widths >= 50)[0]
+    if len(big) == 0:
+        return None
+    top = big[0]
+    band = widths[top + 15: top + 45]
+    if len(band) < 10:
+        return None
+    return float(np.median(band))
+
+
+def stand_height(alpha):
+    """Feet to the top of the head (the first row whose largest run is at least 50 px), so raised hands do not count."""
+    m = alpha > 0.5
+    rows = np.nonzero(m.any(1))[0]
+    if len(rows) == 0:
+        return None
+    for y in rows:
+        r = m[y]
+        d = np.diff(np.concatenate([[0], r.astype(np.int8), [0]]))
+        if (np.nonzero(d == -1)[0] - np.nonzero(d == 1)[0]).max() >= 50:
+            return float(rows[-1] - y)
+    return None
+
+
+STANDING = {"Idle", "Hit", "Ward", "Strafe", "Sunfall"}
+
+
+def feet_y(alpha):
+    rows = np.nonzero((alpha > 0.5).any(1))[0]
+    return float(rows[-1]) if len(rows) else None
+
+
+def place(rgb, alpha, scale, foot_target):
+    """Scale about the feet (bottom centre) and put the feet on foot_target."""
+    h, w = alpha.shape
+    ys, xs = np.nonzero(alpha > 0.5)
+    if len(ys) == 0:
+        return rgb, alpha
+    fy, fx = ys.max(), xs[ys > ys.max() - 40].mean()
+    m = (1.0 / scale, 0.0, fx - fx / scale, 0.0, 1.0 / scale, fy - foot_target / scale)
+    img = Image.fromarray(np.dstack([rgb, alpha * 255]).clip(0, 255).astype(np.uint8), "RGBA").transform((w, h), Image.AFFINE, m, resample=Image.BICUBIC)
+    out = np.asarray(img, dtype=np.float64)
+    return out[..., :3], out[..., 3] / 255.0
+
+
+_NOISE = {}
+
+
+def chalk(rgb, alpha, dist):
+    h, w = alpha.shape
+    if (h, w) not in _NOISE:
+        _NOISE[(h, w)] = (_noise(h, w, 9, 3901), _noise(h, w, 3, 3902), _noise(h, w, 24, 3903), _noise(h, w, 5, 3904))
+    n_width, n_grain, n_break, n_edge = _NOISE[(h, w)]
+    out = rgb.copy()
+    lum = out @ np.array([0.2126, 0.7152, 0.0722])
+    # Deep shadow lifted (round 5: the arms crushed to near-black at 4 m), then a pastel posterize (4 steps, 50 %).
+    out = out + (np.clip(85.0 - lum, 0, 85.0) * 0.45)[..., None]
+    lum = out @ np.array([0.2126, 0.7152, 0.0722])
+    q = np.round(lum / 255.0 * 4.0) / 4.0 * 255.0
+    out = out + ((q - lum) * 0.5)[..., None]
+    out = out * 0.9 + 24.0
+    out = out * np.array([1.04, 0.99, 0.94])
+    out = out * (0.9 + 0.16 * n_grain[..., None])
+    yy, xx = np.mgrid[0:h, 0:w]
+    hatch = (((xx + yy) % 14) < 4) * np.clip((105.0 - lum) / 60.0, 0, 1) * (n_grain > 0.45)
+    out = out * (1 - 0.2 * hatch[..., None])
+    a8 = Image.fromarray((alpha * 255).astype(np.uint8))
+    rim = np.clip(alpha - np.asarray(a8.filter(ImageFilter.MinFilter(5)), dtype=np.float64) / 255.0, 0, 1)
+    # Charcoal contour 3-6 px deep at 768 (2-4 px in a 512 cell), never more than a third of the local half-thickness, so
+    # an arm or a shin keeps its colour inside its line (round 5: thin limbs crushed to black under a fixed-width band).
+    local = np.asarray(Image.fromarray(np.clip(dist, 0, 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(21)), dtype=np.float64)
+    width = np.where(n_width > 0.62, 6.0, np.where(n_width > 0.3, 4.5, 3.0))
+    width = np.minimum(width, np.maximum(1.0, local / 3.0))
+    line = ((dist > 0) & (dist <= width)).astype(np.float64) * (alpha > 0.5) * (n_break > 0.12) * (0.65 + 0.35 * (n_grain > 0.3))
+    line = np.clip(line - rim, 0, 1)
+    out = out * (1 - line[..., None] * 0.85) + np.array([38.0, 30.0, 28.0]) * line[..., None] * 0.85
+    # The chalk edge: 2 px, warm chalk, broken often and grainy (dust, not a cut line).
+    edge = rim * (n_edge > 0.45) * (n_grain > 0.35) * 0.7
+    out = out * (1 - edge[..., None]) + np.array([226.0, 214.0, 190.0]) * edge[..., None]
+    return np.clip(out, 0, 255)
+
+
+def edge_distance(alpha, limit=60):
+    """Pixels from each figure pixel to the edge (counted erosions, up to limit)."""
+    cur = Image.fromarray(((alpha > 0.5) * 255).astype(np.uint8))
+    dist = np.zeros(alpha.shape)
+    for _ in range(limit):
+        cur = cur.filter(ImageFilter.MinFilter(3))
+        a = np.asarray(cur, dtype=np.float64) > 127
+        if not a.any():
+            break
+        dist += a
+    return dist
+
+
+def depth_of(alpha, dist):
+    """Inflated silhouette: sqrt of the distance to the edge, normalised to the body's thickest part (about 0.3 m)."""
+    d = np.sqrt(dist / max(dist.max(), 1.0))
+    return blur(d, 2) * (alpha > 0.02)
+
+
+def frames_of(gen, clip, fps):
+    rig_dir, v_dir, m_dir = (os.path.join(gen, k, clip) for k in ("rig", "v2v", "matte"))
+    src_meta = json.load(open(os.path.join(v_dir, "source.json"))) if os.path.exists(os.path.join(v_dir, "source.json")) else {}
+    src_fps = float(src_meta.get("fps", 30.0))
+    use_rig = bool(src_meta.get("rig", True))
+    n_v = len([f for f in os.listdir(v_dir) if f.endswith(".png") and f.startswith("f_")])
+    n_rig = len([f for f in os.listdir(rig_dir) if f.endswith(".png")]) if use_rig else 0
+    seconds = (n_rig - 1) / 30.0 if use_rig else (n_v - 1) / src_fps
+    count = round(seconds * fps) if clip == "Idle" else max(1, round(seconds * fps) + 1)
+    for k in range(count):
+        src = min(round(k * (30.0 if use_rig else src_fps) / fps), n_v - 1)
+        rgb = np.asarray(Image.open(os.path.join(v_dir, "f_%04d.png" % src)).convert("RGB"), dtype=np.float64)
+        size = rgb.shape[1], rgb.shape[0]
+        matte = np.asarray(Image.open(os.path.join(m_dir, "m_%04d.png" % src)).convert("L").resize(size), dtype=np.float64) / 255.0
+        if use_rig:
+            rig_a = Image.open(os.path.join(rig_dir, "f_%04d.png" % min(src, n_rig - 1))).getchannel("A").resize(size)
+            bound = np.asarray(rig_a.filter(ImageFilter.MaxFilter(13)).filter(ImageFilter.GaussianBlur(3)), dtype=np.float64) / 255.0
+            matte = matte * np.clip(bound * 1.5, 0, 1)
+        yield rgb, matte, count
+
+
+def main():
+    gen, prefix = sys.argv[1], sys.argv[2]
+    cell = arg("--cell", 512)
+    specs = arg("--clips", "Idle,Cast,Hit,Death@18,Ward,Strafe,Sunfall").split(",")
+    cols = PAGE // cell
+    cap = cols * cols
+    dcell = cell // 4
+    pages, dpages = [], []
+    page_i, used = -1, cap
+    meta = {"cell_px": cell, "cols": cols, "rows": cols, "page_px": PAGE, "depth_cell_px": dcell, "cell_m": 2.4, "foot_m": 0.2, "clips": {}}
+    ref = None
+    for spec in specs:
+        clip, fps = (spec.split("@") + ["24"])[:2]
+        fps = int(fps)
+        cells, dcells, scales, flick = [], [], [], []
+        raw = list(frames_of(gen, clip, fps))
+        # Scale per frame from the head width, median-smoothed; frames with no head hold the last good scale.
+        prepared = []
+        for rgb, matte, _ in raw:
+            alpha = clean_matte(matte)
+            rgb = decontaminate(rgb, alpha)
+            # Standing clips hold the idle's height (feet to head top); crouching ones (Cast, Death) hold the head's width.
+            hw = stand_height(alpha) if clip in STANDING else head_width(alpha)
+            prepared.append((rgb, alpha, hw))
+        if ref is None:
+            ref = {"height": stand_height(prepared[0][1]), "head": head_width(prepared[0][1]), "feet": feet_y(prepared[0][1])}
+            lab0 = rgb2lab(prepared[0][0])
+            fig0 = prepared[0][1] > 0.5
+            ref["lab"] = (lab0[fig0].mean(0), lab0[fig0].std(0) + 1e-3)
+        raw_s = []
+        last = 1.0
+        key = "height" if clip in STANDING else "head"
+        # Only growth is a size drift (the keys came out larger); a shorter figure is a crouch or a lunge and holds the last scale.
+        lo, hi = (0.8, 1.03) if key == "height" else (0.6, 1.6)
+        rig_true = os.path.isdir(os.path.join(gen, "rig", clip)) and len(os.listdir(os.path.join(gen, "rig", clip))) > 0
+        for _, _, hw in prepared:
+            # A clip repainted over the rig render keeps the rig's own size.
+            if not rig_true and hw is not None and lo < ref[key] / hw < hi:
+                last = ref[key] / hw
+            raw_s.append(last)
+        raw_s = np.array(raw_s)
+        smooth = np.array([np.median(raw_s[max(0, i - 4): i + 5]) for i in range(len(raw_s))])
+        prev = None
+        for (rgb, alpha, _), s in zip(prepared, smooth):
+            s = float(np.clip(s, 0.8, 1.25))
+            rgb, alpha = place(rgb, alpha, s, ref["feet"])
+            scales.append(round(s, 3))
+            fig = alpha > 0.5
+            if fig.any():
+                lab = rgb2lab(rgb)
+                mu, sd = lab[fig].mean(0), lab[fig].std(0) + 1e-3
+                lab = (lab - mu) / sd * ref["lab"][1] + ref["lab"][0]
+                rgb = lab2rgb(lab)
+            dist = edge_distance(alpha)
+            rgb = chalk(rgb, alpha, dist)
+            lo = np.asarray(Image.fromarray((rgb * alpha[..., None]).astype(np.uint8)).resize((96, 96), Image.BILINEAR), dtype=np.float64)
+            if prev is not None:
+                flick.append(float(np.abs(lo - prev).mean()))
+            prev = lo
+            cells.append(Image.fromarray(np.dstack([rgb, alpha * 255]).clip(0, 255).astype(np.uint8), "RGBA").resize((cell, cell), Image.LANCZOS))
+            dcells.append(Image.fromarray((depth_of(alpha, dist) * 255).astype(np.uint8), "L").resize((dcell, dcell), Image.BILINEAR))
+        n = len(cells)
+        if n > cap:
+            raise SystemExit(f"{clip}: {n} cells do not fit a page of {cap}")
+        if used + n > cap:
+            pages.append(Image.new("RGBA", (PAGE, PAGE), (0, 0, 0, 0)))
+            dpages.append(Image.new("L", (dcell * cols, dcell * cols), 0))
+            page_i, used = len(pages) - 1, 0
+        for k, (c, d) in enumerate(zip(cells, dcells)):
+            i = used + k
+            pages[page_i].paste(c, ((i % cols) * cell, (i // cols) * cell))
+            dpages[page_i].paste(d, ((i % cols) * dcell, (i // cols) * dcell))
+        meta["clips"][clip] = {"page": page_i, "first": used, "count": n, "fps": fps, "scale_min": min(scales), "scale_max": max(scales),
+                               "flicker_mean": round(float(np.mean(flick)) if flick else 0.0, 2)}
+        used += n
+        sc = 192
+        sheet = Image.new("RGB", (sc * 8, sc * ((n + 7) // 8)), (40, 40, 42))
+        for k, c in enumerate(cells):
+            bg = Image.new("RGBA", c.size, (40, 40, 42, 255))
+            bg.alpha_composite(c)
+            sheet.paste(bg.convert("RGB").resize((sc, sc), Image.LANCZOS), ((k % 8) * sc, (k // 8) * sc))
+        sheet.save(f"{prefix}-sheet-{clip}.png")
+        print(clip, meta["clips"][clip], flush=True)
+    for i, (pg, dp) in enumerate(zip(pages, dpages)):
+        a = np.asarray(pg, dtype=np.float64)
+        rgb, al = a[..., :3], a[..., 3:] / 255.0
+        acc, w = rgb * al, al.copy()
+        for _ in range(3):
+            acc = np.stack([blur(acc[..., c], 2) for c in range(3)], -1)
+            w = blur(w[..., 0], 2)[..., None]
+        fill = np.where(w > 1e-3, acc / np.maximum(w, 1e-3), 0)
+        outrgb = np.where(al > 0.02, rgb, np.clip(fill, 0, 255))
+        Image.fromarray(np.dstack([outrgb, a[..., 3]]).astype(np.uint8), "RGBA").save(f"{prefix}_P{i}.png")
+        dp.save(f"{prefix}_D{i}.png")
+    meta["pages"] = len(pages)
+    json.dump(meta, open(prefix + ".json", "w"), indent=1)
+    print("pages", len(pages))
+
+
+if __name__ == "__main__":
+    main()
-- 
