+    # Chalk hatching in the shade: diagonal strokes (12 px period at 768, 4 px in the cell: no aliasing) over the darker values, broken by the grain.
+    yy, xx = np.mgrid[0:h, 0:w]
+    hatch = (((xx + yy) % 12) < 4) * np.clip((110.0 - lum) / 60.0, 0, 1) * (n_grain > 0.4)
+    out = out * (1 - 0.35 * hatch[..., None])
