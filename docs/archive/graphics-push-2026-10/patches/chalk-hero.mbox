+// Wraps a material's emissive in the 2.5D projection behind the static switch Use25D (off in every shipped instance, so
+// the p11 look pays nothing for it).
+UMaterialExpression* With25D(FGraph& G, UMaterialExpression* Drawn, UMaterialExpression* Position, UMaterialExpression* Normal, float UseFacing)
+{
+	UTexture2D* Paint = LoadObject<UTexture2D>(nullptr, *FString::Printf(TEXT("%s/T_Q_25D_Paint.T_Q_25D_Paint"), *StyleFolder()), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	UTexture2D* Depth = LoadObject<UTexture2D>(nullptr, *FString::Printf(TEXT("%s/T_Q_25D_Depth.T_Q_25D_Depth"), *StyleFolder()), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	if (!Paint || !Depth)
+	{
+		return Drawn;
+	}
+	UMaterialExpressionTextureObjectParameter* PaintObject = G.Make<UMaterialExpressionTextureObjectParameter>();
+	PaintObject->ParameterName = TEXT("PaintTex");
+	PaintObject->Texture = Paint;
+	UMaterialExpressionTextureObjectParameter* DepthObject = G.Make<UMaterialExpressionTextureObjectParameter>();
+	DepthObject->ParameterName = TEXT("DepthTex");
+	DepthObject->Texture = Depth;
+	DepthObject->SamplerType = SAMPLERTYPE_LinearColor;
+	UMaterialExpressionConstant* Facing = G.Make<UMaterialExpressionConstant>();
+	Facing->R = UseFacing;
+	UMaterialExpression* Projected = G.Custom(TEXT("Project25D"), CMOT_Float3, Project25DCode,
+	    {{TEXT("Fallback"), Drawn}, {TEXT("P"), Position}, {TEXT("N"), Normal}, {TEXT("PaintTex"), PaintObject}, {TEXT("DepthTex"), DepthObject},
+	        {TEXT("CamPos"), G.Vector(TEXT("CamPos"), FLinearColor::Black)}, {TEXT("CamF"), G.Vector(TEXT("CamF"), FLinearColor(1.f, 0.f, 0.f))},
+	        {TEXT("CamR"), G.Vector(TEXT("CamR"), FLinearColor(0.f, 1.f, 0.f))}, {TEXT("CamU"), G.Vector(TEXT("CamU"), FLinearColor(0.f, 0.f, 1.f))},
+	        {TEXT("TanH"), G.Scalar(TEXT("TanH"), 1.732f)}, {TEXT("TanV"), G.Scalar(TEXT("TanV"), 0.866f)}, {TEXT("PaintGain"), G.Scalar(TEXT("PaintGain"), 1.f)}, {TEXT("PaintGamma"), G.Scalar(TEXT("PaintGamma"), 0.8f)},
+	        {TEXT("UseFacing"), Facing}});
+	UMaterialExpressionStaticSwitchParameter* Switch = G.Make<UMaterialExpressionStaticSwitchParameter>();
+	Switch->ParameterName = TEXT("Use25D");
+	Switch->DefaultValue = false;
+	Switch->A.Expression = Projected;
+	Switch->B.Expression = Drawn;
+	return Switch;
+}
+
+// The 25D variants: each an instance of the shipped instance (or material) with Use25D on and the capture camera from
+// art/look/chalk/25d-camera.json. Built only when the painting and depth were imported.
+bool Build25DVariants()
+{
+	const FString JsonPath = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::ProjectDir(), StyleArtDir(), TEXT("25d-camera.json")));
+	FString Text;
+	TSharedPtr<FJsonObject> Camera;
+	if (!FFileHelper::LoadFileToString(Text, *JsonPath) || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Text), Camera) || !Camera.IsValid())
+	{
+		UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS 25D skipped (no %s)"), *JsonPath);
+		return true;
+	}
+	const auto Vec = [&Camera](const TCHAR* Key)
+	{
+		const TArray<TSharedPtr<FJsonValue>>& A = Camera->GetArrayField(Key);
+		return FLinearColor(static_cast<float>(A[0]->AsNumber()), static_cast<float>(A[1]->AsNumber()), static_cast<float>(A[2]->AsNumber()), 0.f);
+	};
+	const double HalfH = FMath::DegreesToRadians(Camera->GetNumberField(TEXT("hfovDeg")) * 0.5);
+	const double Aspect = Camera->GetNumberField(TEXT("width")) / FMath::Max(1.0, Camera->GetNumberField(TEXT("height")));
+	const float TanH = static_cast<float>(FMath::Tan(HalfH));
+	const float TanV = static_cast<float>(FMath::Tan(HalfH) / Aspect);
+	const auto Variant = [&](UMaterialInterface* Parent, const FString& Name, float Gain)
+	{
+		if (!Parent)
+		{
+			return false;
+		}
+		UMaterialInstanceConstant* Instance = NewObject<UMaterialInstanceConstant>(CreatePackage(*PackagePath(*Name)), *Name, RF_Public | RF_Standalone | RF_Transactional);
+		Instance->SetParentEditorOnly(Parent);
+		Instance->SetStaticSwitchParameterValueEditorOnly(FMaterialParameterInfo(TEXT("Use25D")), true);
+		Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("CamPos")), Vec(TEXT("eye")));
+		Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("CamF")), Vec(TEXT("forward")));
+		Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("CamR")), Vec(TEXT("right")));
+		Instance->SetVectorParameterValueEditorOnly(FMaterialParameterInfo(TEXT("CamU")), Vec(TEXT("up")));
+		Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("TanH")), TanH);
+		Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("TanV")), TanV);
+		Instance->SetScalarParameterValueEditorOnly(FMaterialParameterInfo(TEXT("PaintGain")), Gain);
+		Instance->PostEditChange();
+		return Save(Instance, *Name);
+	};
+	const float Gain = 1.f;
+	using QuestLook::ESurface;
+	for (const ESurface Surface : {ESurface::Sand, ESurface::Dais, ESurface::Pad, ESurface::Seat, ESurface::Ledge})
+	{
+		const FString Base = QuestLook::SurfaceAsset(Surface);
+		UMaterialInterface* Parent = FindObject<UMaterialInterface>(nullptr, *FString::Printf(TEXT("%s.%s"), *PackagePath(*Base), *Base));
+		if (!Variant(Parent, Base + TEXT("25D"), Gain))
+		{
+			return false;
+		}
+	}
+	UMaterialInterface* Sky = FindObject<UMaterialInterface>(nullptr, *FString::Printf(TEXT("%s.M_Q_Sky"), *PackagePath(TEXT("M_Q_Sky"))));
+	if (!Variant(Sky, TEXT("MI_Q_Sky25D"), Gain))
+	{
+		return false;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_QUEST_ASSETS 25D variants built tanH=%.3f tanV=%.3f"), TanH, TanV);
+	return true;
+}
