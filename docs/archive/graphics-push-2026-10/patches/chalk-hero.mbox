+    "float r = length(p);\n"
+    "float n = frac(sin(dot(floor(Uv * 220.0), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float a = 1.0 - saturate(abs(r - 0.92) / 0.022);\n"
+    "a += (1.0 - saturate(abs(r - 0.78) / 0.016)) * Rings;\n"
+    "float ang = atan2(p.y, p.x) / 6.2831853 + 0.5;\n"
+    "a += (frac(ang * 16.0) < 0.07 ? 1.0 : 0.0) * (r > 0.79 && r < 0.91 ? 1.0 : 0.0) * Rings;\n"
+    "a += (1.0 - saturate(abs(r - 0.42) / 0.02)) * Inner;\n"
+    "a += (1.0 - saturate(min(abs(p.x), abs(p.y)) / 0.01)) * (r < 0.97 ? 1.0 : 0.0) * Cross * 0.5;\n"
+    "return C * saturate(a) * lerp(0.45, 1.0, n) * Gain;");
