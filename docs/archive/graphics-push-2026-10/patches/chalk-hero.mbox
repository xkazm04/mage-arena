+void QuestLook::AddChalkShadowPool(USceneComponent& Figure)
+{
+	if (ArenaStyle::Current() != EArenaStyle::Chalk || Figure.ComponentHasTag(TEXT("ChalkPool")) || !Figure.GetOwner())
+	{
+		return;
+	}
+	UMaterialInterface* Pool = LoadObject<UMaterialInterface>(nullptr, TEXT("/Game/Look/Quest/Chalk/M_Q_ChalkShadow.M_Q_ChalkShadow"), nullptr, LOAD_NoWarn | LOAD_Quiet);
+	UStaticMesh* Plane = Greybox::LoadShape(TEXT("Plane"));
+	if (!Pool || !Plane)
+	{
+		return;
+	}
+	Figure.ComponentTags.Add(TEXT("ChalkPool"));
+	UStaticMeshComponent* Disc = NewObject<UStaticMeshComponent>(Figure.GetOwner());
+	Disc->SetStaticMesh(Plane);
+	Disc->SetMaterial(0, Pool);
+	Disc->SetCastShadow(false);
+	Disc->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	Disc->SetupAttachment(&Figure);
+	Disc->SetRelativeLocation(FVector(0.0, 0.0, 1.5));
+	Disc->SetRelativeScale3D(FVector(2.2));
+	Disc->RegisterComponent();
+}
