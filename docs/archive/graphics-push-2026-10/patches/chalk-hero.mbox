@@ -24,6 +24,8 @@
 #include "Materials/MaterialExpressionCustom.h"
 #include "Materials/MaterialExpressionMultiply.h"
 #include "Materials/MaterialExpressionScalarParameter.h"
+#include "Materials/MaterialExpressionSceneTexture.h"
+#include "Materials/MaterialExpressionScreenPosition.h"
 #include "Materials/MaterialExpressionTextureCoordinate.h"
 #include "Materials/MaterialExpressionTwoSidedSign.h"
 #include "Materials/MaterialExpressionTextureSampleParameter2D.h"
@@ -489,6 +491,73 @@ UMaterial* BuildChalkRune()
 // The hero outline (Brennic, the hands): an inverted hull drawn by a second skinned component that follows the hero's
 // pose. Two-sided, masked to its back faces only (TwoSidedSign), pushed out along the normal by Thickness cm: the back
 // faces show as a dark line round the silhouette.
+// p9: one full-screen chalk pass (blendable post-process material on the camera, chalk only, needs MobileHDR): the
+// same treatment over everything the per-material chalk does not reach (hands, Brennic, VFX). Five depth taps (a cross
+// Laplacian plus the centre, no blur chains) find silhouettes and creases, drawn as broken strokes: light chalk on dark
+// slate, dark line on the light sand and skin. One shared chalk-and-paper grain, a soft luminance posterize (stepped
+// pastel banding) and a smudged slate vignette at the bottom and sides. Translucent VFX write no depth: they take the
+// grain and banding only.
+const TCHAR* ChalkPostCode = TEXT(
+    "float2 px = Uv * Size;\n"
+    "float dc = min(Dc, 8000.0);\n"
+    "float dl = min(Dl, 8000.0); float dr = min(Dr, 8000.0); float du = min(Du, 8000.0); float dd = min(Dd, 8000.0);\n"
+    "float sil = max(abs(dl - dr), abs(du - dd)) / max(dc, 1.0);\n"
+    "float lap = (abs(dl + dr - 2.0 * dc) + abs(du + dd - 2.0 * dc)) / max(dc, 1.0);\n"
+    "float edge = saturate((sil - 0.06) / 0.06) + saturate((lap - 0.012) / 0.02);\n"
+    "float cell = frac(sin(dot(floor(px / float2(6.0, 3.0)), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "edge = saturate(edge) * (cell > 0.22 ? 1.0 : 0.0) * lerp(0.6, 1.0, cell) * EdgeStrength;\n"
+    "float3 c = C.rgb;\n"
+    "float lum = dot(c, float3(0.299, 0.587, 0.114));\n"
+    "float q = (floor(lum * Steps) + 0.5) / Steps;\n"
+    "float nl = lerp(lum, q, Poster);\n"
+    "c *= nl / max(lum, 1e-3);\n"
+    "float g1 = frac(sin(dot(floor(px), float2(12.9898, 78.233))) * 43758.5453);\n"
+    "float g2 = frac(sin(dot(floor(float2(px.x / 7.0 + px.y * 0.35 / 7.0, px.y / 2.0)), float2(39.346, 11.135))) * 24634.6345);\n"
+    "c *= 1.0 + ((g1 - 0.5) * 0.6 + (g2 - 0.5) * 0.4) * Grain;\n"
+    "float3 ink = lum < 0.35 ? ChalkWhite : DarkLine;\n"
+    "c = lerp(c, ink, edge);\n"
+    "float sm = 0.5 + 0.25 * sin(Uv.x * 23.0 + sin(Uv.y * 17.0) * 2.0) + 0.15 * sin(Uv.y * 41.0 + Uv.x * 9.0);\n"
+    "float side = saturate((abs(Uv.x - 0.5) - 0.36) / 0.14 + (sm - 0.5) * 0.5);\n"
+    "float bottom = saturate((Uv.y - 0.84) / 0.16 + (sm - 0.5) * 0.5);\n"
+    "float vig = saturate(max(side, bottom) * (0.75 + 0.5 * g2)) * Vignette;\n"
+    "c = lerp(c, Slate, vig);\n"
+    "return c;");
+
+UMaterial* BuildChalkPost()
+{
+	const TCHAR* Name = TEXT("M_Q_ChalkPost");
+	UMaterial* Material = NewMaterial(Name);
+	FGraph G{Material};
+	Material->MaterialDomain = MD_PostProcess;
+	Material->BlendableLocation = BL_SceneColorAfterTonemapping;
+	UMaterialExpressionScreenPosition* Screen = G.Make<UMaterialExpressionScreenPosition>();
+	UMaterialExpressionSceneTexture* Colour = G.Make<UMaterialExpressionSceneTexture>();
+	Colour->SceneTextureId = PPI_PostProcessInput0;
+	Colour->Coordinates.Connect(0, Screen);
+	// A depth tap at the screen UV moved by (X, Y) texels of the scene colour (1.5 texels: a stroke about 2 px wide).
+	auto Depth = [&G, Screen, Colour](float X, float Y) -> UMaterialExpression*
+	{
+		UMaterialExpression* At = G.Custom(TEXT("Tap"), CMOT_Float2, *FString::Printf(TEXT("return Uv + Inv * float2(%.1f, %.1f);"), X, Y),
+		    {{TEXT("Uv"), Screen, 0}, {TEXT("Inv"), Colour, 2}});
+		UMaterialExpressionSceneTexture* Tap = G.Make<UMaterialExpressionSceneTexture>();
+		Tap->SceneTextureId = PPI_SceneDepth;
+		Tap->Coordinates.Connect(0, At);
+		return Tap;
+	};
+	UMaterialExpressionSceneTexture* Centre = G.Make<UMaterialExpressionSceneTexture>();
+	Centre->SceneTextureId = PPI_SceneDepth;
+	Centre->Coordinates.Connect(0, Screen);
+	UMaterialExpression* Out = G.Custom(TEXT("ChalkPost"), CMOT_Float3, ChalkPostCode,
