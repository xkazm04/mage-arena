+	Material->BlendMode = BLEND_Additive;
+	Material->SetShadingModel(MSM_Unlit);
+	Material->TwoSided = true;
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	UMaterialExpression* Glow = G.Custom(TEXT("Rune"), CMOT_Float3, RuneCode,
+	    {{TEXT("Uv"), G.Make<UMaterialExpressionTextureCoordinate>()}, {TEXT("C"), G.Vector(TEXT("Color"), FLinearColor(0.8f, 0.8f, 0.76f))},
+	        {TEXT("Rings"), G.Scalar(TEXT("Rings"), 1.f)}, {TEXT("Inner"), G.Scalar(TEXT("Inner"), 0.f)}, {TEXT("Cross"), G.Scalar(TEXT("Cross"), 1.f)},
+	        {TEXT("Gain"), G.Scalar(TEXT("Gain"), 0.55f)}});
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Glow;
+	return Finish(Material, Name) ? Material : nullptr;
+}
