+	Toward.Z = 0.0;
+	const FVector Ring = BrennicFeetCm + Toward.GetSafeNormal() * 260.0;
+	Card(FTransform(FQuat::Identity, FVector(Ring.X, Ring.Y, 2.0), FVector(2.2, 2.2, 1.0)), FLinearColor(1.6f, 0.25f, 0.12f), 0.f, 0.f);
+	const FRotator View(PitchDeg, (BrennicFeetCm - Eye).Rotation().Yaw, 0.f);
+	const FVector Forward = View.Vector();
+	const FVector Right = FRotationMatrix(View).GetUnitAxis(EAxis::Y);
+	const FVector Up = FRotationMatrix(View).GetUnitAxis(EAxis::Z);
+	const FVector At = Eye + Forward * 75.0 + Right * 20.0 - Up * 13.0;
+	Card(FTransform(FRotationMatrix::MakeFromZ(-Forward).ToQuat(), At, FVector(0.17, 0.17, 1.0)), FLinearColor(0.6f, 0.95f, 1.2f), 1.f, 0.f);
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_S1 s30 marks telegraph=(%.0f, %.0f) bolt=(%.0f, %.0f) sigil=(%.0f, %.0f, %.0f)"), Ring.X, Ring.Y, BoltCm.X, BoltCm.Y, At.X, At.Y, At.Z);
+}
