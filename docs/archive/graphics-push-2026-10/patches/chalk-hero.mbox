+void URivalFigureComponent::SyncSprite(const FVector& SeatCm, double Scale)
+{
+	if (!Sprite || !SpriteMid)
+	{
+		return;
+	}
+	const RivalSprite::FClipCells Cells = RivalSprite::CellsOf(State.Clip);
+	const double Seconds = (LastTick - State.StartTick) / FMath::Max(1.0, Lengths.StepHz);
+	const int32 Frame = Cells.First + RivalSprite::FrameAt(State.Clip, Cells.Count, Seconds, Lengths);
+	SpriteMid->SetScalarParameterValue(TEXT("Frame"), static_cast<float>(Frame));
+	// The cell is the rig camera's square frame: CellM across at 1x, his feet FootM above its bottom.
+	const double CellCm = RivalSprite::CellM * 100.0 * Scale;
+	const FVector Centre = SpriteFeetCm + FVector(0.0, 0.0, (RivalSprite::CellM * 0.5 - RivalSprite::FootM) * 100.0 * Scale);
+	Sprite->SetWorldTransform(QuestSpells::UprightCard(Centre, SeatCm, CellCm, CellCm, false));
+	Sprite->SetVisibility(true);
+	static double LastLog = -10.0;
+	if (FPlatformTime::Seconds() - LastLog > 2.0)
+	{
+		LastLog = FPlatformTime::Seconds();
+		UE_LOG(LogMageArena, Log, TEXT("MAGEVR_RIVAL_SPRITE clip=%s cell=%d centre=%s size=%.0f cm seat=%s"), RivalClips::Name(State.Clip), Frame, *Centre.ToString(), CellCm, *SeatCm.ToString());
+	}
+	if (Mesh)
+	{
+		Mesh->SetVisibility(false, true);
+	}
 }
 
