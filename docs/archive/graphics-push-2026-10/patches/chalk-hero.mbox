+// p11: the wardstones as 2D chalk-drawn cards in the backdrop's own idiom (the drawn obelisk still, alpha-cut), the
+// violet Tithe flame staying on top. Unlit, masked, two-sided; Bright sets its value against the drawn stands.
+UMaterial* BuildChalkCard(const TCHAR* Name, UTexture2D* Drawing, float Bright)
+{
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Masked;
+	Material->OpacityMaskClipValue = 0.5f;
+	Material->SetShadingModel(MSM_Unlit);
+	Material->TwoSided = true;
+	UMaterialExpressionTextureSampleParameter2D* Sample = G.Texture(TEXT("BaseTex"), Drawing, SAMPLERTYPE_Color, G.Make<UMaterialExpressionTextureCoordinate>());
+	UMaterialExpressionMultiply* Lit = G.Make<UMaterialExpressionMultiply>();
+	Lit->A.Connect(0, Sample);
+	Lit->B.Expression = G.Scalar(TEXT("Bright"), Bright);
+	Material->GetEditorOnlyData()->EmissiveColor.Expression = Lit;
+	Material->GetEditorOnlyData()->OpacityMask.Connect(4, Sample);
+	return Finish(Material, Name) ? Material : nullptr;
+}
