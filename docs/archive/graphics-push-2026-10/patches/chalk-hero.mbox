+
+UImportBrennicCastOpenCommandlet::UImportBrennicCastOpenCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UImportBrennicCastOpenCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	FString Fbx = FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/characters/brennic/epic/A_Brennic_CastOpen.fbx"));
+	FParse::Value(*Params, TEXT("fbx="), Fbx);
+	Fbx = FPaths::ConvertRelativePathToFull(Fbx);
+	USkeleton* Skeleton = LoadObject<USkeleton>(nullptr, TEXT("/Game/Characters/Brennic/SK_Brennic_Skeleton.SK_Brennic_Skeleton"));
+	if (!Skeleton || !FPaths::FileExists(Fbx))
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail cast-open skeleton=%d fbx=%s"), Skeleton ? 1 : 0, *Fbx);
+		return 1;
+	}
+	// As ImportCreatureMesh imported the four clips: legacy FBX factory, scale 100, no front-axis change; animation only.
+	UFbxFactory* Factory = NewObject<UFbxFactory>();
+	Factory->AddToRoot();
+	UFbxImportUI* Options = NewObject<UFbxImportUI>();
+	Options->bAutomatedImportShouldDetectType = false;
+	Options->MeshTypeToImport = FBXIT_Animation;
+	Options->OriginalImportType = FBXIT_SkeletalMesh;
+	Options->bImportAsSkeletal = true;
+	Options->bImportMesh = false;
+	Options->bImportAnimations = true;
+	Options->bImportMaterials = false;
+	Options->bImportTextures = false;
+	Options->bCreatePhysicsAsset = false;
+	Options->Skeleton = Skeleton;
+	Options->AnimSequenceImportData->ImportUniformScale = 100.f;
+	Options->AnimSequenceImportData->bConvertScene = true;
+	Options->AnimSequenceImportData->bForceFrontXAxis = false;
+	Options->AnimSequenceImportData->bConvertSceneUnit = false;
+	Options->AnimSequenceImportData->bImportBoneTracks = true;
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>("AssetTools").Get();
+	UAssetImportTask* Task = NewObject<UAssetImportTask>();
+	Task->Filename = Fbx;
+	Task->DestinationPath = BrennicEpicLook::Folder();
+	Task->DestinationName = TEXT("A_Brennic_CastOpen");
+	Task->bReplaceExisting = true;
+	Task->bReplaceExistingSettings = true;
+	Task->bAutomated = true;
+	Task->bSave = false;
+	Task->Factory = Factory;
+	Task->Options = Options;
+	AssetTools.ImportAssetTasks({Task});
+	Factory->RemoveFromRoot();
+	UAnimSequence* Clip = nullptr;
+	for (UObject* Object : Task->GetObjects())
+	{
+		Clip = Clip ? Clip : Cast<UAnimSequence>(Object);
+	}
+	if (!Clip)
+	{
+		UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS fail cast-open import %s"), *Fbx);
+		return 1;
+	}
+	if (Clip->GetName() != TEXT("A_Brennic_CastOpen"))
+	{
+		Clip->Rename(TEXT("A_Brennic_CastOpen"));
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS cast-open %s %.3f s keys=%d"), *Clip->GetPathName(), Clip->GetPlayLength(), Clip->GetNumberOfSampledKeys());
+	int32 Saved = 0;
+	if (!MaterialGraph::SaveDirtyUnder(BrennicEpicLook::Folder(), Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done cast-open saved=%d"), Saved);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
