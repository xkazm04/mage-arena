From 55976ee087a6002eb5fbddefeba3b695c2a7dd81 Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Wed, 28 Oct 2026 11:14:52 +0100
Subject: [PATCH 047/139] feat(look): capture-s1 -Mobile, the S1 shot on the
 mobile renderer proxy

-Mobile renders the S1 shot at the ES3.1 feature level (mobile forward
shaders on desktop D3D12, headless with -RenderOffScreen), with
AndroidEngine.ini's cvars and the Meta_Quest_3 device profile's scalability
(Android_Mid: post, texture, effects, AA 1; OpenXR: shadow 2). MobileHDR stays
the project's (not set anywhere, so the engine default, on); -MobileLdr turns
it off, Meta's usual Quest setting. A cold run compiles the mobile shader
cache in about 3 minutes on Lynx.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/vr/tools/capture-s1.ps1 | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/apps/vr/tools/capture-s1.ps1 b/apps/vr/tools/capture-s1.ps1
index d9290f1..c9c0a67 100644
--- a/apps/vr/tools/capture-s1.ps1
+++ b/apps/vr/tools/capture-s1.ps1
@@ -7,6 +7,12 @@
 param(
 	[ValidateSet("flat", "quest", "epic")][string]$Look = "flat",
 	[string]$Out = "",
+	[double]$RivalM = 0,
+	# The mobile renderer proxy: the ES3.1 feature level (mobile forward shaders on desktop D3D12), the project's
+	# Android cvars (AndroidEngine.ini) and the Meta_Quest_3 device profile's scalability (Android_Mid with shadow 2).
+	[switch]$Mobile,
+	# With -Mobile: MobileHDR off (Meta's usual Quest setting: no post pass at all), not the project default (on).
+	[switch]$MobileLdr,
 	[string]$ExtraArgs = "",
 	[int]$TimeoutMinutes = 15
 )
@@ -39,14 +45,16 @@ $ArgumentList = @(
 	$Project, "-game", "-RenderOffScreen", "-ResX=1376", "-ResY=768", "-unattended", "-nosplash", "-nohmd",
 	"-stdout", "-FullStdOutLogOutput", "-log", "-abslog=$LogPath",
 	"-MageArenaS1Shot", "-MageArenaLook=$Look", "-MageArenaS1Out=$OutRel",
-	"-ExecCmds=`"DisableAllScreenMessages; sg.PostProcessQuality 3`""
+	$(if ($Mobile) { "-ExecCmds=`"DisableAllScreenMessages; sg.PostProcessQuality 1; sg.TextureQuality 1; sg.EffectsQuality 1; sg.ShadowQuality 2; sg.AntiAliasingQuality 1`"" } else { "-ExecCmds=`"DisableAllScreenMessages; sg.PostProcessQuality 3`"" })
 )
 # The epic look's start-up settings (Look/EpicLook.h LaunchIniOverrides): deferred, distance fields, Lumen, VSM, TSR.
-if ($Look -eq "epic") {
+if ($Look -eq "epic" -and -not $Mobile) {
 	$Section = "[/Script/Engine.RendererSettings]"
 	$ArgumentList += "-ini:Engine:" + ((@("r.ForwardShading=False", "r.GenerateMeshDistanceFields=True", "r.DynamicGlobalIlluminationMethod=1",
 		"r.ReflectionMethod=1", "r.Shadow.Virtual.Enable=1", "r.AntiAliasingMethod=4") | ForEach-Object { "$Section`:$_" }) -join ",")
 }
+if ($Mobile) { $ArgumentList += @("-FeatureLevelES31", "-dpcvars=r.Mobile.ShadingPath=0,r.Shadow.CSM.MaxMobileCascades=2,r.Shadow.MaxCSMResolution=1024") }
+if ($Mobile -and $MobileLdr) { $ArgumentList += "-ini:Engine:[/Script/Engine.RendererSettings]:r.MobileHDR=False" }
 if ($ExtraArgs) { $ArgumentList += $ExtraArgs }
 
 Write-Host "capture-s1: look=$Look out=$OutRel"
-- 
