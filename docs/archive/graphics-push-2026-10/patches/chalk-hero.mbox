+UMaterial* BuildChalkSky(UTexture2D* SkyTexture, UTexture2D* Backdrop)
+{
+	const TCHAR* Name = TEXT("M_Q_Sky");
+	FGraph G{NewMaterial(Name)};
+	UMaterial* Material = G.Material;
+	Material->BlendMode = BLEND_Opaque;
+	Material->SetShadingModel(MSM_Unlit);
+	Material->TwoSided = true;
+	Material->bIsSky = true;
+	// Texture objects for the custom node's own SampleLevel (no mips across the u mirror seam).
+	UMaterialExpressionTextureObject* SkyObject = G.Make<UMaterialExpressionTextureObject>();
+	SkyObject->Texture = SkyTexture;
+	UMaterialExpressionTextureObject* DropObject = G.Make<UMaterialExpressionTextureObject>();
+	DropObject->Texture = Backdrop;
+	UMaterialExpression* Colour = G.Custom(TEXT("ChalkSky"), CMOT_Float3, ChalkSkyCode,
+	    {{TEXT("V"), G.Make<UMaterialExpressionCameraVectorWS>()}, {TEXT("SkyTex"), SkyObject}, {TEXT("DropTex"), DropObject},
+	        {TEXT("Low"), G.Scalar(TEXT("BackdropLowSin"), -0.3f)}, {TEXT("High"), G.Scalar(TEXT("BackdropHighSin"), 0.47f)},
+	        {TEXT("SkyLow"), G.Scalar(TEXT("LowSin"), 0.3f)}, {TEXT("SkyHigh"), G.Scalar(TEXT("HighSin"), 0.9f)},
+	        {TEXT("DropBright"), G.Scalar(TEXT("BackdropBright"), 1.15f)}, {TEXT("Slate"), G.Vector(TEXT("Slate"), FLinearColor(0.023f, 0.028f, 0.033f))}});
