+bool US1ShotCaptureDriver::Export25D()
+{
+	UWorld* World = GetWorld();
+	AMageArenaPawn* Pawn = FindPawn();
+	const UCameraComponent* Camera = Pawn ? Pawn->FindComponentByClass<UCameraComponent>() : nullptr;
+	if (!World || !Camera)
+	{
+		return false;
+	}
+	const int32 Width = FMath::Clamp(Export25DWidth, 256, 8192);
+	const int32 Height = Export25DHeight > 0 ? FMath::Clamp(Export25DHeight, 256, 8192) : Width / 2;
+	const FVector Eye = Camera->GetComponentLocation();
+	const FRotator View = Camera->GetComponentRotation();
+	ASceneCapture2D* Rig = World->SpawnActor<ASceneCapture2D>(ASceneCapture2D::StaticClass(), FTransform(View, Eye));
+	if (!Rig)
+	{
+		return false;
+	}
+	USceneCaptureComponent2D* Capture = Rig->GetCaptureComponent2D();
+	Capture->FOVAngle = Export25DFovDeg;
+	Capture->bCaptureEveryFrame = false;
+	Capture->bCaptureOnMovement = false;
+	// The camera's own exposure, bloom and vignette, but not its blendables: the beauty is the scene before the chalk pass.
+	Capture->PostProcessSettings = Camera->PostProcessSettings;
+	Capture->PostProcessSettings.WeightedBlendables.Array.Reset();
+	Capture->PostProcessSettings.bOverride_VignetteIntensity = true;
+	Capture->PostProcessSettings.VignetteIntensity = 0.f;
+	Capture->PostProcessBlendWeight = 1.f;
+	// The static scene only: the presentation (Brennic, spells, wardstones, pads' marks), the pawn (hands, cuff) and the
+	// shot's own mark cards are left out.
+	int32 Hidden = 0;
+	for (TActorIterator<AActor> It(World); It; ++It)
+	{
+		AActor* Actor = *It;
+		if (Actor == Rig)
+		{
+			continue;
+		}
+		if (Actor->IsA<ASessionPresentation>() || Actor == Pawn || Actor->IsA<AStaticMeshActor>())
+		{
+			Capture->HiddenActors.Add(Actor);
+			++Hidden;
+		}
+	}
+	const FString Dir = MageArenaCapture::RepoPath(OutDir);
+	IFileManager::Get().MakeDirectory(*Dir, true);
+	UTextureRenderTarget2D* Beauty = UKismetRenderingLibrary::CreateRenderTarget2D(World, Width, Height, RTF_RGBA8_SRGB, FLinearColor::Black, false);
+	UTextureRenderTarget2D* Depth = UKismetRenderingLibrary::CreateRenderTarget2D(World, Width, Height, RTF_R32f, FLinearColor::Black, false);
+	if (!Beauty || !Depth)
+	{
+		return false;
+	}
+	Capture->CaptureSource = SCS_FinalColorLDR;
+	Capture->TextureTarget = Beauty;
+	Capture->CaptureScene();
+	UKismetRenderingLibrary::ExportRenderTarget(World, Beauty, Dir, TEXT("25d-beauty.png"));
+	Capture->CaptureSource = SCS_SceneDepth;
+	Capture->TextureTarget = Depth;
+	Capture->CaptureScene();
+	// The scene depth (cm along the view axis) as raw little-endian float32 rows, top row first (ExportRenderTarget
+	// clamps a float target into a 16-bit PNG).
+	TArray<FLinearColor> DepthPixels;
+	if (FTextureRenderTargetResource* Resource = Depth->GameThread_GetRenderTargetResource())
+	{
+		Resource->ReadLinearColorPixels(DepthPixels);
+	}
+	if (DepthPixels.Num() != Width * Height)
+	{
+		return false;
+	}
+	TArray<uint8> Raw;
+	Raw.SetNumUninitialized(DepthPixels.Num() * 4);
+	for (int32 Index = 0; Index < DepthPixels.Num(); ++Index)
+	{
+		FMemory::Memcpy(Raw.GetData() + Index * 4, &DepthPixels[Index].R, 4);
+	}
+	FFileHelper::SaveArrayToFile(Raw, *FPaths::Combine(Dir, TEXT("25d-depth.f32")));
+	const FVector F = View.Vector();
+	const FVector Right = FRotationMatrix(View).GetUnitAxis(EAxis::Y);
+	const FVector Up = FRotationMatrix(View).GetUnitAxis(EAxis::Z);
+	const FString Json = FString::Printf(
+	    TEXT("{\n  \"eye\": [%.3f, %.3f, %.3f],\n  \"forward\": [%.6f, %.6f, %.6f],\n  \"right\": [%.6f, %.6f, %.6f],\n  \"up\": [%.6f, %.6f, %.6f],\n")
+	        TEXT("  \"pitch\": %.3f, \"yaw\": %.3f, \"hfovDeg\": %.3f, \"width\": %d, \"height\": %d, \"hiddenActors\": %d\n}\n"),
+	    Eye.X, Eye.Y, Eye.Z, F.X, F.Y, F.Z, Right.X, Right.Y, Right.Z, Up.X, Up.Y, Up.Z, View.Pitch, View.Yaw, Export25DFovDeg, Width, Height, Hidden);
+	FFileHelper::SaveStringToFile(Json, *FPaths::Combine(Dir, TEXT("25d-camera.json")));
+	UE_LOG(LogMageArena, Log, TEXT("MAGEVR_25D export %dx%d hfov=%.1f eye=(%.1f, %.1f, %.1f) pitch=%.2f yaw=%.2f hidden=%d dir=%s"), Width, Height, Export25DFovDeg, Eye.X, Eye.Y, Eye.Z,
+	    View.Pitch, View.Yaw, Hidden, *Dir);
+	Rig->Destroy();
+	return true;
+}
