+	Heart->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Heart->SetShadingModel(MSM_Unlit);
+	Heart->BlendMode = BLEND_Additive;
+	Heart->TwoSided = true;
+	{
+		UMaterialExpressionCustom* Custom = Add<UMaterialExpressionCustom>(*Heart, -500, 0);
+		Custom->Description = TEXT("FireHeart");
+		Custom->OutputType = CMOT_Float3;
+		Custom->Inputs.Reset();
+		Input(*Custom, TEXT("UV"), Add<UMaterialExpressionTextureCoordinate>(*Heart, -900, 0));
+		Input(*Custom, TEXT("Gain"), Scalar(*Heart, TEXT("Gain"), 7.0, 100));
+		Input(*Custom, TEXT("T"), Add<UMaterialExpressionTime>(*Heart, -900, 200));
+		Custom->Code = TEXT(
+		    "float d = saturate(1.0 - length(UV - 0.5) * 2.0);\n"
+		    "float pulse = 1.0 + 0.08 * sin(T * 17.0) + 0.05 * sin(T * 31.0);\n"
+		    "float3 c = lerp(float3(1.0, 0.42, 0.08), float3(1.0, 0.93, 0.72), pow(d, 2.2));\n"
+		    "return c * pow(d, 1.7) * Gain * pulse;\n");
