+		    "float u = D0 + Uv.x * D1;\n"
+		    "float a = saturate(w.a * 0.92) * saturate(min(u, 0.5 - u) / 0.05) * saturate(1.3 - Uv.y * 1.05) * Cover;\n"
+		    "return float4(rgb, a);\n");
