+	if (FParse::Value(FCommandLine::Get(), TEXT("MageArenaHandTint="), TintArg))
+	{
+		TArray<FString> Parts;
+		TintArg.ParseIntoArray(Parts, TEXT(","));
+		if (Parts.Num() == 3)
