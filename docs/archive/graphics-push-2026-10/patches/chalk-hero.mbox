 		const FSimVec ToEye = SimUnit(SimSub(Seat, Hand));
-		Shot.Pos = SimAdd(Seat, SimScale(ToEye, -FMath::Min(BoltOutM, SimDistance(Seat, Hand))));
+		// Nearer duels (-MageArenaS1RivalM=7 or 4, the coverage memo's 3.5-8 m): the bolt stays in the open between him and
+		// the seat, at most half way, never on his chest.
+		Shot.Pos = SimAdd(Seat, SimScale(ToEye, -FMath::Min(BoltOutM, 0.5 * SimDistance(Seat, Hand))));
