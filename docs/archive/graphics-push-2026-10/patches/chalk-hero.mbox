diff --git a/apps/vr/art/hands/mix_views.py b/apps/vr/art/hands/mix_views.py
new file mode 100644
index 0000000..8276d8e
--- /dev/null
+++ b/apps/vr/art/hands/mix_views.py
@@ -0,0 +1,47 @@
+"""Round 3 (judges: the painted hands read as carved wood): per view, the smooth pastel repaint gives the tone and the
+detailed repaint gives only its form band.
+
+python mix_views.py <smooth_dir> <detailed_dir> <out_dir> [form_gain]
+
+Both sets are already aligned to the same view silhouettes (align_views.py). out = smooth + form_gain x band(detailed),
+where band = blur(detailed, 2 px) - blur(detailed, 14 px) at 768 px: tendons, knuckles, nail beds and creases survive;
+the fine fibrous strokes (under 2 px) and the flat colour of the detailed set do not. Background pixels stay white.
+"""
+import os
+import sys
+
+import numpy as np
+from PIL import Image
+
+
+def blur(a, r):
+    for _ in range(3):
+        for axis in (0, 1):
+            pad = [(r + 1, r) if i == axis else (0, 0) for i in range(a.ndim)]
+            c = np.cumsum(np.pad(a, pad, mode="edge"), axis)
+            n = c.shape[axis]
+            a = (np.take(c, range(2 * r + 1, n), axis) - np.take(c, range(0, n - 2 * r - 1), axis)) / (2 * r + 1)
+    return a
+
+
+def main():
+    smooth_dir, detail_dir, out = sys.argv[1:4]
+    gain = float(sys.argv[4]) if len(sys.argv) > 4 else 0.7
+    os.makedirs(out, exist_ok=True)
+    for name in sorted(os.listdir(smooth_dir)):
+        if not name.endswith(".png") or not os.path.exists(os.path.join(detail_dir, name)):
+            continue
+        s = np.asarray(Image.open(os.path.join(smooth_dir, name)).convert("RGB"), dtype=np.float64)
+        d = np.asarray(Image.open(os.path.join(detail_dir, name)).convert("RGB"), dtype=np.float64)
+        band = blur(d, 2) - blur(d, 14)
+        # Only the band's value (luminance) carries form; its hue shifts would tint the smooth skin.
+        band_l = band @ np.array([0.2126, 0.7152, 0.0722])
+        o = s + gain * band_l[..., None]
+        background = (s.min(-1) > 235) & (s.max(-1) - s.min(-1) < 12)
+        o[background] = s[background]
+        Image.fromarray(np.clip(o, 0, 255).astype(np.uint8)).save(os.path.join(out, name))
+        print("MIX", name)
+
+
+if __name__ == "__main__":
+    main()
-- 
