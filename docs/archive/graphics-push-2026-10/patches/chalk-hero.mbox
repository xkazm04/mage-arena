@@ -0,0 +1,71 @@
+"""Chalk & Slate probe textures (docs/concepts/RETARGET-CHALK-SLATE-2026-10-28.md section 8, step 1).
+
+Reads the chalk studio stills (`studio-still.mts gen --style chalk --slot <slot>`, staged in <src>) and writes:
+  apps/vr/art/look/chalk/T_Q_{Stone,Sand,Flagstone}_D.png  1024, tileable (edge cross-fade where the still does not wrap)
+  apps/vr/art/look/chalk/T_Q_{Stone,Sand,Flagstone}_N.png  flat normals (the chalk surface is unlit; the slot keeps the
+                                                           pipeline's texture pairs)
+  apps/vr/art/look/chalk/T_Q_Sky_D.png                     2048 x 1024, the slate sky; its bottom fades into the slate
+and, for the spells (prep_spell_textures.py --style chalk reads <src>), copies the painted stills the probe does not
+regenerate (water splash, flame) beside the chalk ones, and the chalk ward wave as the second wave too.
+Run: python apps/vr/tools/look/prep_chalk_textures.py <chalk stills dir> <painted stills dir>
+"""
+import shutil
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+SRC = Path(sys.argv[1])
+PAINTED = Path(sys.argv[2])
+OUT = Path(__file__).resolve().parents[2] / "art" / "look" / "chalk"
+OUT.mkdir(parents=True, exist_ok=True)
+
+
+def load(name):
+    return np.asarray(Image.open(SRC / name).convert("RGB").resize((1024, 1024), Image.LANCZOS), dtype=np.float32)
+
+
+def seamless(img, band):
+    h, w, _ = img.shape
+    rolled = np.roll(np.roll(img, h // 2, axis=0), w // 2, axis=1)
+    y = np.arange(h)[:, None]
+    x = np.arange(w)[None, :]
+    weight = np.clip(np.minimum(np.minimum(x, w - 1 - x), np.minimum(y, h - 1 - y)) / band, 0.0, 1.0)
+    weight = weight * weight * (3 - 2 * weight)
+    return img * weight[..., None] + rolled * (1 - weight[..., None])
+
+
+def save(arr, name, size=None):
+    img = Image.fromarray(arr.clip(0, 255).astype(np.uint8))
+    if size:
+        img = img.resize(size, Image.LANCZOS)
+    img.save(OUT / name)
+    print(name, img.size)
+
+
+flat = np.zeros((64, 64, 3), dtype=np.float32)
+flat[...] = (128, 128, 255)
+for slot, name, band in (("stone", "Stone", 24), ("sand", "Sand", 64), ("flagstone", "Flagstone", 24)):
+    img = seamless(load(f"{slot}-01.png"), band)
+    if slot == "sand":
+        # S30-VR's sand is a duller, paler ochre pastel than the still's orange: pull its saturation down a third.
+        grey = (img * np.array([0.2126, 0.7152, 0.0722])).sum(axis=-1, keepdims=True)
+        img = grey + (img - grey) * 0.66
+    save(img, f"T_Q_{name}_D.png")
+    save(flat, f"T_Q_{name}_N.png")
+
+sky = np.asarray(Image.open(SRC / "sky-01.png").convert("RGB"), dtype=np.float32)
+h = sky.shape[0]
+slate = np.array([42, 47, 51], dtype=np.float32)
+rows = np.linspace(0.0, 1.0, h)[:, None, None]
+sky = sky * (1 - np.clip((rows - 0.78) / 0.2, 0.0, 1.0)) + slate * np.clip((rows - 0.78) / 0.2, 0.0, 1.0)
+save(sky, "T_Q_Sky_D.png", (2048, 1024))
+
+for name in ("watersplash-01.png", "flame-01.png"):
+    if not (SRC / name).exists():
+        shutil.copy(PAINTED / name, SRC / name)
+        print("painted fallback", name)
+if (SRC / "wardwave-01.png").exists() and not (SRC / "wardwave-02.png").exists():
+    Image.open(SRC / "wardwave-01.png").transpose(Image.FLIP_LEFT_RIGHT).save(SRC / "wardwave-02.png")
+    print("wardwave-02.png = the chalk wave mirrored")
