+    h, w = alpha.shape
+    # Output pixel (x, y) samples the painted frame at ((x - tx) / scale + ax, (y - t_feet) / scale + a_feet).
+    m = (1.0 / scale, 0.0, a[2] - t[2] / scale, 0.0, 1.0 / scale, a[1] - t[1] / scale)
+    img = Image.fromarray(np.dstack([rgb, alpha * 255]).clip(0, 255).astype(np.uint8), "RGBA").transform((w, h), Image.AFFINE, m, resample=Image.BICUBIC)
+    out = np.asarray(img, dtype=np.float64)
+    return out[..., :3], out[..., 3] / 255.0, scale
+
+
+def _noise(h, w, scale, seed):
+    """Value noise in [0, 1], fixed per seed (the same field every frame: chalk on a board, not boiling)."""
+    rng = np.random.default_rng(seed)
+    g = rng.random((h // scale + 2, w // scale + 2))
+    return np.asarray(Image.fromarray((g * 255).astype(np.uint8)).resize((w, h), Image.BICUBIC), dtype=np.float64) / 255.0
+
+
+_CHALK_CACHE = {}
+
+
+def chalkify(rgb, alpha):
+    """Round 3 (judges: "K detail inside an M outline"): the painted figure drawn into the chalk frame. A variable-width,
+    broken charcoal contour laid inside the matte edge (never outside it, so no dark halo), a thin warm-white chalk dust rim
+    just inside that, a light pastel posterize toward S30-KEY's warm palette, and slate grain. The face and costume
+    detail inside stay as painted. rgb 0..255, alpha 0..1, at the repaint's own resolution."""
+    h, w = alpha.shape
