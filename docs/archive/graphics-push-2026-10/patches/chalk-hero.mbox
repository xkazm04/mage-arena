+    # then broad, sparse, blurred hatching (16 and 19 px periods at 768, so it survives the 512 cell and the page mips
+    # without aliasing into a dot screen); then a thin variable chalk contour (1-3.5 px), broken often, at half strength.
+    rub = np.stack([blur(out[..., k], 3) for k in range(3)], -1)
+    out = out * 0.45 + rub * 0.55
+    lit = blur(np.clip((lum - 110.0) / 90.0, 0, 1), 6)[..., None]
+    out = out * (1 - lit * 0.3) + (out * 0.5 + np.array([236.0, 214.0, 190.0]) * 0.5) * lit * 0.3
