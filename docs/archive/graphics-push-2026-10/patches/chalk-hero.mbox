+// The slate sky with the arena drawn round the sand (probe 3, owner redirect: one 2D backdrop instead of the 3D wall,
+// stands and crowd under chalk). The seat never moves, so the panorama is mapped on the view direction like the sky:
+// the backdrop still fills elevations Low..High (sines), mirrored past +/-90 degrees of yaw, its own slate edges blending
+// into the sky above and the bare board below.
+const TCHAR* ChalkSkyCode = TEXT(
+    "float3 d = -V;\n"
+    "float t = atan2(d.y, d.x) / 3.14159265;\n"
+    "float u = 0.5 + sign(t) * (0.5 - abs(abs(t) - 0.5));\n"
+    "float vb = 1.0 - (d.z - Low) / max(High - Low, 0.01);\n"
+    "float inBand = saturate(min(vb, 1.0 - vb) / 0.04) * (vb > 0.0 && vb < 1.0 ? 1.0 : 0.0);\n"
+    "float vs = 1.0 - saturate((d.z - SkyLow) / max(SkyHigh - SkyLow, 0.01));\n"
+    "float3 sky = SkyTex.SampleLevel(SkyTexSampler, float2(u, vs), 0).rgb;\n"
+    "float3 drop = DropTex.SampleLevel(DropTexSampler, float2(u, saturate(vb)), 0).rgb;\n"
+    "float3 below = Slate;\n"
+    "float3 c = d.z < Low ? below : sky;\n"
+    "return lerp(c, drop * DropBright, inBand);");
