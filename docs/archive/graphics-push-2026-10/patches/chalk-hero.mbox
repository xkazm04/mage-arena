+void AEpicLookRig::TickBrennicRim()
+{
+	const APlayerController* Controller = GetWorld()->GetFirstPlayerController();
+	if (!Controller || !Controller->PlayerCameraManager)
+	{
+		return;
+	}
+	USkeletalMeshComponent* Brennic = nullptr;
+	for (TObjectIterator<USkeletalMeshComponent> It; It; ++It)
+	{
+		if (It->GetWorld() == GetWorld() && It->IsVisible() && BrennicEpicLook::DrawsBrennic(**It))
+		{
+			Brennic = *It;
+		}
+	}
+	if (!BrennicRim)
+	{
+		BrennicRim = NewObject<UPointLightComponent>(this);
+		BrennicRim->SetMobility(EComponentMobility::Movable);
+		BrennicRim->SetupAttachment(GetRootComponent());
+		BrennicRim->RegisterComponent();
+		BrennicRim->SetIntensityUnits(ELightUnits::Candelas);
+		BrennicRim->SetLightColor(FLinearColor(1.f, 0.82f, 0.62f));
+		BrennicRim->SetAttenuationRadius(400.f);
+		BrennicRim->SetSourceRadius(30.f);
+		BrennicRim->SetCastShadows(false);
+		BrennicRim->SetVolumetricScatteringIntensity(0.f);
+		// Its own lighting channel, shared only with Brennic, so it rims him and not the sand or the wall.
+		BrennicRim->LightingChannels.bChannel0 = false;
+		BrennicRim->LightingChannels.bChannel1 = true;
+	}
+	BrennicRim->SetVisibility(Brennic != nullptr);
+	if (!Brennic)
+	{
+		return;
+	}
+	if (!Brennic->LightingChannels.bChannel1)
+	{
+		Brennic->LightingChannels.bChannel1 = true;
+		Brennic->MarkRenderStateDirty();
+	}
+	const FVector Centre = Brennic->Bounds.Origin;
+	const FVector Away = (Centre - Controller->PlayerCameraManager->GetCameraLocation()).GetSafeNormal2D();
+	BrennicRim->SetWorldLocation(Centre + Away * 110.0 + FVector::RightVector.RotateAngleAxis(Away.Rotation().Yaw, FVector::UpVector) * 40.0 + FVector(0.0, 0.0, 110.0));
+	BrennicRim->SetIntensity(ParamOr(TEXT("MageArenaEpicRimCd="), 160.f));
+}
