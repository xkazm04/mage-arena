+#pragma once
+
+#include "CoreMinimal.h"
+
+class UPoseableMeshComponent;
+class UStaticMeshComponent;
+
+/**
+ * The bronze cuff on the left wrist under the Chalk & Slate style, with the wrist HUD drawn into it (S30-VR: a bronze cuff
+ * with four inlaid runes, two lit). M_ChalkCuffHud (Tools/CreateCuffStyledCommandlet) draws, on the side of the band
+ * facing the eye (the shader measures the angle round the wrist from the camera, so no rotation is posed):
+ * - four runes, the first LitRunes of them lit in coloured chalk, the rest engraved dark;
+ * - under them four slim chalk tally strips in softened versions of the old bars' hues (CuffLook::Soften): HP magenta,
+ *   mana blue, stamina green, clock gold, each filled to its fraction;
+ * - a warm-white seam across the band while the collar crack shows (the crack seam's old place was the panel).
+ * Under chalk, Session/SessionPresentation hides the floating panel and bars and feeds SetGauges and SetCrack instead;
+ * their meaning and the gameplay are unchanged.
+ */
+namespace ChalkCuffLook
+{
+/** Poses the cuff on Hands' left wrist (creating it once); false when not under chalk or the material is missing. */
+bool Pose(UPoseableMeshComponent& Hands, UStaticMeshComponent*& Cuff);
+
+/** The gauges the cuff draws, each 0..1, and how many runes are lit (1..4). */
+void SetGauges(float Hp, float Mana, float Stamina, float Clock, int32 LitRunes);
+
+/** The collar crack's seam on the cuff: on while the crack shows. */
+void SetCrack(bool bCrack);
+}
