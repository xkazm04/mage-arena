+void AEpicLookRig::SwapWardMaterial()
+{
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	UMaterialInterface* Ward = Cached.Get();
+	if (!Ward)
+	{
+		Ward = LoadObject<UMaterialInterface>(nullptr, *(EpicLook::SurfaceFolder() / TEXT("M_EpicWard.M_EpicWard")), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		Cached = Ward;
+	}
+	if (!Ward)
+	{
+		return;
+	}
+	for (TObjectIterator<UInstancedStaticMeshComponent> It; It; ++It)
+	{
+		const UMaterialInterface* Current = It->GetMaterial(0);
+		if (It->GetWorld() == GetWorld() && Current && Current->GetName() == TEXT("M_Q_Ward"))
+		{
+			It->SetMaterial(0, Ward);
+		}
+	}
+}
+
+void AEpicLookRig::TickFireHearts()
+{
+	// A white-gold heart for a warm bolt only: the core's colour must be Fire's (an orange hue, saturated, bright); steel,
+	// the cool elements and the leave class's black core never get one (the threat colour language).
+	const APlayerController* Controller = GetWorld()->GetFirstPlayerController();
+	if (!Controller || !Controller->PlayerCameraManager)
+	{
+		return;
+	}
+	const FVector Eye = Controller->PlayerCameraManager->GetCameraLocation();
+	static TWeakObjectPtr<UMaterialInterface> Cached;
+	UMaterialInterface* HeartMaterial = Cached.Get();
+	if (!HeartMaterial)
+	{
+		HeartMaterial = LoadObject<UMaterialInterface>(nullptr, *(EpicLook::SurfaceFolder() / TEXT("M_EpicFireHeart.M_EpicFireHeart")), nullptr, LOAD_NoWarn | LOAD_Quiet);
+		Cached = HeartMaterial;
+	}
+	UStaticMesh* Plane = HeartMaterial ? Greybox::LoadShape(TEXT("Plane")) : nullptr;
+	int32 Used = 0;
+	for (TObjectIterator<UStaticMeshComponent> It; Plane && It; ++It)
+	{
+		UStaticMeshComponent* Core = *It;
+		const UMaterialInstanceDynamic* Tint = Cast<UMaterialInstanceDynamic>(Core->GetMaterial(0));
+		if (Core->GetWorld() != GetWorld() || !Core->IsVisible() || !Tint || !Tint->Parent || !Tint->Parent->GetName().Contains(TEXT("BoltCore")))
+		{
+			continue;
+		}
+		TArray<FMaterialParameterInfo> Infos;
+		TArray<FGuid> Ids;
+		Tint->GetAllVectorParameterInfo(Infos, Ids);
+		FLinearColor Colour = FLinearColor::Black;
+		for (const FMaterialParameterInfo& Info : Infos)
+		{
+			FLinearColor Value;
+			if (Tint->GetVectorParameterValue(FHashedMaterialParameterInfo(Info.Name), Value) && FMath::Max3(Value.R, Value.G, Value.B) > FMath::Max3(Colour.R, Colour.G, Colour.B))
+			{
+				Colour = Value;
+			}
+		}
+		const FLinearColor Hsv = Colour.LinearRGBToHSV();
+		const bool bWarm = Hsv.R >= 12.f && Hsv.R <= 48.f && Hsv.G > 0.6f && Hsv.B > 0.3f;
+		if (!bWarm)
+		{
+			continue;
+		}
+		if (!Hearts.IsValidIndex(Used))
+		{
+			UStaticMeshComponent* Card = Greybox::MakeMesh(this, Plane, HeartMaterial);
+			Card->SetCastShadow(false);
+			Card->SetAbsolute(true, true, true);
+			Hearts.Add(Card);
+		}
+		UStaticMeshComponent* Card = Hearts[Used++];
+		const double Radius = Core->Bounds.SphereRadius;
+		const FVector ToEye = (Eye - Core->Bounds.Origin).GetSafeNormal();
+		Card->SetVisibility(true);
+		Card->SetWorldLocationAndRotation(Core->Bounds.Origin + ToEye * Radius * 1.05, FRotationMatrix::MakeFromZ(ToEye).ToQuat());
+		Card->SetWorldScale3D(FVector(Radius * 2.0 * ParamOr(TEXT("MageArenaEpicHeartScale="), 1.5f) / 100.0));
+		if (Used >= 8)
+		{
+			break;
+		}
+	}
+	for (int32 Index = Used; Index < Hearts.Num(); ++Index)
+	{
+		Hearts[Index]->SetVisibility(false);
+	}
+}
+
 void AEpicLookRig::TickBrennicRim()
 {
 	const APlayerController* Controller = GetWorld()->GetFirstPlayerController();
diff --git a/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.h b/apps/vr/Game/Source/MageArenaVR/Look/EpicLook.h
