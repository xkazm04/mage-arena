+def value_noise(shape, cell, seed):
+    """Smooth value noise with cells of `cell` pixels (bilinear between random lattice values)."""
+    rng = np.random.default_rng(seed)
+    gh, gw = shape[0] // cell + 2, shape[1] // cell + 2
+    lattice = rng.random((gh, gw))
+    y = np.arange(shape[0]) / cell
+    x = np.arange(shape[1]) / cell
+    y0, x0 = np.floor(y).astype(int), np.floor(x).astype(int)
+    fy, fx = (y - y0)[:, None], (x - x0)[None, :]
+    fy, fx = fy * fy * (3 - 2 * fy), fx * fx * (3 - 2 * fx)
+    a = lattice[y0][:, x0]
+    b = lattice[y0][:, x0 + 1]
+    c = lattice[y0 + 1][:, x0]
+    d = lattice[y0 + 1][:, x0 + 1]
+    return (a * (1 - fx) + b * fx) * (1 - fy) + (c * (1 - fx) + d * fx) * fy
+
+
+def sand_edge(rgb, sand, rows_lo=0.30):
+    """S6 (judges: a hard horizontal seam and a 'bright spotlight ellipse'): the sand's boundary is broken up by low-
+    frequency noise into an irregular rubbed-out edge, smeared pastel into the slate, with stray sand grains scattered
+    onto the slate beyond it."""
+    H, W = sand.shape
+    rows = np.linspace(0.0, 1.0, H)[:, None]
+    n1 = value_noise((H, W), 90, 11)
+    n2 = value_noise((H, W), 24, 12)
+    soft = box_blur(sand, 30)
+    edge = np.clip(soft * (1 - soft) * 4.0, 0, 1) * (rows > rows_lo)
+    slate = np.array([44.0, 49.0, 54.0])
+    # Irregular fade: where the noise is low the sand is rubbed off toward the slate.
+    erode = edge * np.clip((0.55 - n1) / 0.3, 0, 1) * (0.6 + 0.4 * n2)
+    rgb = rgb * (1 - erode[..., None]) + (rgb * 0.35 + slate * 0.65) * erode[..., None]
+    # A smeared pastel boundary: the sand colour dragged out over the slate, thin and broken.
+    smear_zone = np.clip(box_blur(sand, 60) - sand, 0, 1) * (rows > rows_lo)
+    sand_col = np.array([190.0, 162.0, 120.0])
+    smear = smear_zone * np.clip((n2 - 0.35) / 0.4, 0, 1) * 0.45
+    rgb = rgb * (1 - smear[..., None]) + sand_col * smear[..., None]
+    # Stray grains on the slate just beyond the sand.
+    rng = np.random.default_rng(13)
+    grains = (rng.random((H, W)) > 0.985).astype(np.float64)
+    grains = box_blur(grains, 1) * 3.0 * np.clip(box_blur(sand, 80) * 3.0, 0, 1) * (1 - sand) * (rows > rows_lo)
+    rgb = rgb * (1 - np.clip(grains, 0, 0.8)[..., None]) + sand_col * np.clip(grains, 0, 0.8)[..., None]
+    return rgb
+
+
+def chalk_rings(rgb, rows_lo=0.45, seed=21):
+    """S6 (judges: the rune circles read as thin vector lines): on the slate floor, the drawn lines get uneven pressure
+    (low-frequency fading and breaks), soft chalk-dust halos, and a few eraser smears."""
+    H, W = rgb.shape[:2]
+    rows = np.linspace(0.0, 1.0, H)[:, None]
+    lum = rgb @ np.array([0.2126, 0.7152, 0.0722])
+    local = box_blur(lum, 6)
+    slate = (box_blur(lum, 30) < 95.0) & (rows > rows_lo)
+    line = np.clip((lum - local - 12.0) / 40.0, 0, 1) * slate
+    pressure = 0.35 + 0.65 * np.clip((value_noise((H, W), 40, seed) - 0.2) / 0.6, 0, 1)
+    breaks = (value_noise((H, W), 9, seed + 1) > 0.22).astype(np.float64) * 0.8 + 0.2
+    keep = pressure * box_blur(breaks, 1)
+    base = box_blur(rgb, 6)
+    rgb = rgb - (rgb - base) * (line * (1 - keep))[..., None]
+    halo = np.clip(box_blur(line, 7) * 2.5, 0, 1) * slate
+    rgb = rgb + np.array([150.0, 150.0, 145.0]) * (halo * 0.12)[..., None]
+    smear_mask = np.clip((value_noise((H, W), 70, seed + 2) - 0.72) / 0.12, 0, 1) * slate
+    horiz = rgb.copy()
+    for axis_shift in (8, 16, 24):
+        horiz = horiz + np.roll(rgb, axis_shift, axis=1)
+    horiz = horiz / 4.0
+    rgb = rgb * (1 - smear_mask[..., None] * 0.6) + horiz * (smear_mask[..., None] * 0.6)
+    return rgb
+
