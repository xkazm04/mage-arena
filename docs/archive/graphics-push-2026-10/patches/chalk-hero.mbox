+def sand_marks(rgb, sand, seed=31):
+    """S7 (judges: footprints read as dark blobs): each dark blob on the sand becomes a shallow impression, its
+    interior lifted most of the way back to the sand around it and a broken pale chalk rim drawn round it; and a fine
