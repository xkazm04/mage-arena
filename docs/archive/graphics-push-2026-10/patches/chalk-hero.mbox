+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FMageArenaRivalSpriteFrameAt, "MageArena.Presentation.RivalFigure.SpriteFrameAt",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FMageArenaRivalSpriteFrameAt::RunTest(const FString& Parameters)
+{
+	RivalClips::FLengths Lengths;
+	Lengths.CastS = 1.5;
+	Lengths.HitS = 0.8;
+	bool bPass = true;
+	bPass &= TestEqual(TEXT("Idle starts on its first cell"), RivalSprite::FrameAt(ERivalClip::Idle, 49, 0.0, Lengths), 0);
+	bPass &= TestEqual(TEXT("Idle loops"), RivalSprite::FrameAt(ERivalClip::Idle, 49, 49.0 / RivalSprite::Fps, Lengths), 0);
+	bPass &= TestEqual(TEXT("Cast halfway is its middle cell"), RivalSprite::FrameAt(ERivalClip::Cast, 38, 0.75, Lengths), 19);
+	bPass &= TestEqual(TEXT("Cast past its length holds its last cell"), RivalSprite::FrameAt(ERivalClip::Cast, 38, 9.0, Lengths), 37);
+	bPass &= TestEqual(TEXT("Hit at its end is its last cell"), RivalSprite::FrameAt(ERivalClip::Hit, 20, 0.8, Lengths), 19);
+	bPass &= TestEqual(TEXT("Death holds its last cell"), RivalSprite::FrameAt(ERivalClip::Death, 49, 30.0, Lengths), 48);
+	bPass &= TestEqual(TEXT("a negative time is the first cell"), RivalSprite::FrameAt(ERivalClip::Death, 49, -1.0, Lengths), 0);
+	TArray<bool> Used;
+	Used.Init(false, RivalSprite::Cols * RivalSprite::Rows);
+	for (int32 Index = 0; Index < RivalClips::Count; ++Index)
+	{
+		const RivalSprite::FClipCells Cells = RivalSprite::CellsOf(static_cast<ERivalClip>(Index));
+		bPass &= TestTrue(TEXT("a clip fits the page"), Cells.First >= 0 && Cells.Count > 0 && Cells.First + Cells.Count <= Used.Num());
+		for (int32 Cell = Cells.First; Cell < FMath::Min(Cells.First + Cells.Count, Used.Num()); ++Cell)
+		{
+			bPass &= TestFalse(TEXT("no cell holds two clips"), Used[Cell]);
+			Used[Cell] = true;
+		}
+	}
+	return bPass;
+}
+
 #endif
diff --git a/apps/vr/Game/Source/MageArenaVR/Tools/CreateRivalSpriteCommandlet.cpp b/apps/vr/Game/Source/MageArenaVR/Tools/CreateRivalSpriteCommandlet.cpp
new file mode 100644
index 0000000..1e4e582
--- /dev/null
+++ b/apps/vr/Game/Source/MageArenaVR/Tools/CreateRivalSpriteCommandlet.cpp
@@ -0,0 +1,131 @@
+#include "Tools/CreateRivalSpriteCommandlet.h"
+
+#include "MageArenaVR.h"
+#include "Misc/Paths.h"
+#include "Session/RivalFigure.h"
+#include "Tools/MaterialGraph.h"
+
+#if WITH_EDITOR
+#include "AssetCompilingManager.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionCustom.h"
+#include "Materials/MaterialExpressionMultiply.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureSampleParameter2D.h"
+#include "Materials/MaterialExpressionTime.h"
+#include "ShaderCompiler.h"
+
+namespace
+{
+// The atlas cell's UV: cell Frame of a Cols x Rows grid, read left to right, top to bottom; a fire card may cycle its
+// cells by time (Fps above 0) from its own Phase.
+const TCHAR* CellUvCode = TEXT("float n = max(1.0, Cols * Rows);\n"
+                               "float f = Fps > 0.0 ? floor(fmod(T * Fps + Phase * n, n)) : Frame;\n"
+                               "float2 cell = float2(fmod(f, Cols), floor(f / Cols));\n"
+                               "return (cell + saturate(Uv)) / float2(Cols, Rows);\n");
+
+// A flipbook page is read cell by cell from its first frame on: it never streams (a page caught at its 32 px mip shows
+// nothing, its alpha averaged away).
+void KeepResident(UTexture2D& Page)
+{
+	Page.PreEditChange(nullptr);
+	Page.NeverStream = true;
+	Page.PostEditChange();
+	Page.MarkPackageDirty();
+}
+
+UMaterial* BuildCard(const FString& Folder, const TCHAR* Name, UTexture2D* Atlas, bool bAdditive, double Grid)
+{
+	using namespace MaterialGraph;
+	UMaterial* Material = NewMaterial(Folder, Name);
+	Material->SetUsageByFlag(MATUSAGE_StaticMesh, true);
+	Material->SetUsageByFlag(MATUSAGE_InstancedStaticMeshes, true);
+	Material->SetShadingModel(MSM_Unlit);
+	Material->BlendMode = bAdditive ? BLEND_Additive : BLEND_Translucent;
+	Material->TwoSided = true;
+	UMaterialExpressionCustom* Uv = Add<UMaterialExpressionCustom>(*Material, -900, 0);
+	Uv->Description = TEXT("CellUv");
+	Uv->OutputType = CMOT_Float2;
+	Uv->Inputs.Reset();
+	Input(*Uv, TEXT("Uv"), Add<UMaterialExpressionTextureCoordinate>(*Material, -1300, 0));
+	Input(*Uv, TEXT("Cols"), Scalar(*Material, TEXT("Cols"), Grid, 60));
+	Input(*Uv, TEXT("Rows"), Scalar(*Material, TEXT("Rows"), Grid, 120));
+	Input(*Uv, TEXT("Frame"), Scalar(*Material, TEXT("Frame"), 0.0, 180));
+	Input(*Uv, TEXT("Fps"), Scalar(*Material, TEXT("Fps"), bAdditive ? 18.0 : 0.0, 240));
+	Input(*Uv, TEXT("Phase"), Scalar(*Material, TEXT("Phase"), 0.0, 300));
+	Input(*Uv, TEXT("T"), Add<UMaterialExpressionTime>(*Material, -1300, 360));
+	Uv->Code = CellUvCode;
+	UMaterialExpressionTextureSampleParameter2D* Sample = Add<UMaterialExpressionTextureSampleParameter2D>(*Material, -500, 0);
+	Sample->ParameterName = TEXT("Atlas");
+	Sample->Texture = Atlas;
+	Sample->Coordinates.Connect(0, Uv);
+	UMaterialExpressionMultiply* Lit = Add<UMaterialExpressionMultiply>(*Material, -250, 0);
+	Lit->A.Connect(0, Sample);
+	Lit->B.Connect(0, Scalar(*Material, TEXT("Bright"), bAdditive ? 2.2 : 1.0, 420));
+	UMaterialEditorOnlyData* Editor = Material->GetEditorOnlyData();
+	Editor->EmissiveColor.Connect(0, Lit);
+	if (!bAdditive)
+	{
+		Editor->Opacity.Connect(4, Sample);
+	}
+	Material->PreEditChange(nullptr);
+	Material->PostEditChange();
+	Material->MarkPackageDirty();
+	Material->ForceRecompileForRendering();
+	return Material;
+}
+}
+#endif
+
+UCreateRivalSpriteCommandlet::UCreateRivalSpriteCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	IsServer = false;
+	LogToConsole = true;
+}
+
+int32 UCreateRivalSpriteCommandlet::Main(const FString& Params)
+{
+#if WITH_EDITOR
+	using namespace MaterialGraph;
+	FString Source = FPaths::Combine(FPaths::ProjectDir(), TEXT("../art/characters/brennic/sprite"));
+	FParse::Value(*Params, TEXT("source="), Source);
+	Source = FPaths::ConvertRelativePathToFull(Source);
+	const FString Folder = RivalSprite::Folder();
+	// The page holds every clip; mips feed the 16 m read (about 120 px tall), so the texture keeps its full chain.
+	UTexture2D* First = ImportTexture(Source / TEXT("T_RivalSprite.png"), Folder, TEXT("T_RivalSprite"), false, TC_Default);
+	if (!First)
+	{
+		return 1;
+	}
+	KeepResident(*First);
+	BuildCard(Folder, TEXT("M_RivalSprite"), First, false, RivalSprite::Cols);
+	if (FPaths::FileExists(Source / TEXT("T_FireSprite.png")))
+	{
+		UTexture2D* Fire = ImportTexture(Source / TEXT("T_FireSprite.png"), Folder, TEXT("T_FireSprite"), false, TC_Default);
+		if (!Fire)
+		{
+			return 1;
+		}
+		KeepResident(*Fire);
+		// pack_fire.py: 8 x 8 cells of 256 px on the 2048 page, a 3.5 s loop at about 18 fps.
+		BuildCard(Folder, TEXT("M_FireSprite"), Fire, true, 8.0);
+	}
+	FAssetCompilingManager::Get().FinishAllCompilation();
+	if (GShaderCompilingManager)
+	{
+		GShaderCompilingManager->FinishAllCompilation();
+	}
+	int32 Saved = 0;
+	if (!SaveDirtyUnder(Folder, Saved))
+	{
+		return 1;
+	}
+	UE_LOG(LogMageArena, Display, TEXT("MAGEVR_LOOK_ASSETS done rival-sprite saved=%d from %s"), Saved, *Source);
+	return 0;
+#else
+	UE_LOG(LogMageArena, Error, TEXT("MAGEVR_LOOK_ASSETS needs an editor build"));
+	return 1;
+#endif
+}
