--- /dev/null
+++ b/apps/vr/tools/look/gen_25d_scene.py
@@ -0,0 +1,134 @@
+"""2.5D spike S1: paint the static scene from the seat eye with Flux 2 dev on the local ComfyUI (img2img).
+
+The engine's clean beauty render (S1ShotCapture -MageArena25DExport, 25d-beauty.png) is encoded as the start latent and
+denoised from `--denoise` of the schedule, so the painting keeps our geometry (horizon, dais edge, rune circles, arena
+ring) where the projection will put it back; the S30 frames join as Flux 2 reference latents (style), admitted late so
+the composition is the render's. The graph is gravitone's lib/imaging/local/flux2.ts `fluxGraph` (same loaders,
+scheduler, sampler, guidance 4.0, ReferenceLatent chain and late admission), with VAEEncode + SplitSigmasDenoise for
+img2img. Every draw is saved with its prompt and settings next to the PNG (push-1028/gen/<asset>/).
+
+Usage: python gen_25d_scene.py --beauty runs/chalk/25d-export/25d-beauty.png --out <gen dir> --name v1
+       [--denoise 0.62] [--seed 1] [--steps 28] [--ref s30-vr.jpg ...] [--late 0.3] [--prompt-extra "..."]
+Needs the COMFY.lock held by the caller (shared GPU queue).
+"""
+import argparse
+import hashlib
+import json
+import sys
+import time
+import urllib.request
+import uuid
+from pathlib import Path
+
+BASE = "http://127.0.0.1:8188"
+STYLE = ("Chalk and soft pastel drawn on a dark slate board. Dusty chalk strokes with visible grain, smudged and rubbed fills, confident "
+         "contour lines, cross-hatching for shade, construction lines and pale geometric guides left visible. Grey and white chalk for stone, "
+         "wood and crowd; warm ochre pastel for sand.")
+SCENE = ("A first-person view from a seated duellist's stone dais into an empty Roman arena, drawn as a highly detailed chalk-and-pastel "
+         "illustration. The near ground is a dark blue-grey slate board with rubbed chalk dust, soft wipe marks and finely drawn white "
+         "chalk rune circles and construction lines. Beyond its edge a wide oval of rich warm ochre pastel sand, layered strokes, drawn "
+         "footprints, scuffs and drag marks, fading softly into slate at its rim. Around it the arena wall and tiers of a cheering crowd "
+         "and statues drawn in grey and white chalk line work with cross-hatched shade, cloth banners in red, blue and ochre chalk, an "
+         "arched gate in the far wall. Crisp, intricate, 2020s concept-art level of detail in every stroke. No people in the arena, no "
+         "characters, no hands, no fire, no magic, no text, no lettering.")
+AVOID = "no photograph, no 3D render, no glossy reflections, no oil paint, no renderer gradients, no lens effects, no text."
+
+
+def call(path, data=None, ctype="application/json", timeout=60):
+    req = urllib.request.Request(BASE + path, data=data, headers={"content-type": ctype} if data is not None else {})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return r.read()
+
+
+def upload(path):
+    b = Path(path).read_bytes()
+    sha = hashlib.sha256(b).hexdigest()[:16]
+    name = f"mage25d-{sha}{Path(path).suffix.lower()}"
+    boundary = uuid.uuid4().hex
+    parts = []
+    for key, val in (("type", "input"), ("subfolder", "mage25d"), ("overwrite", "true")):
+        parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{key}\"\r\n\r\n{val}\r\n".encode())
+    parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"image\"; filename=\"{name}\"\r\nContent-Type: application/octet-stream\r\n\r\n".encode() + b + b"\r\n")
+    parts.append(f"--{boundary}--\r\n".encode())
+    up = json.loads(call("/upload/image", b"".join(parts), f"multipart/form-data; boundary={boundary}", 120))
+    return f"{up['subfolder']}/{up['name']}" if up.get("subfolder") else up["name"]
+
+
+def graph(prompt, seed, width, height, steps, denoise, init, refs, late, prefix):
+    g = {
+        "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "flux2_dev_fp8mixed.safetensors", "weight_dtype": "default"}},
+        "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "mistral_3_small_flux2_fp8.safetensors", "type": "flux2", "device": "default"}},
+        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae.safetensors"}},
+        "4": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": prompt}},
+        "7": {"class_type": "Flux2Scheduler", "inputs": {"steps": steps, "width": width, "height": height}},
+        "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
+        "9": {"class_type": "RandomNoise", "inputs": {"noise_seed": seed}},
+        "40": {"class_type": "LoadImage", "inputs": {"image": init}},
+        "41": {"class_type": "VAEEncode", "inputs": {"pixels": ["40", 0], "vae": ["3", 0]}},
+        "42": {"class_type": "SplitSigmasDenoise", "inputs": {"sigmas": ["7", 0], "denoise": denoise}},
+    }
+    cond = ["4", 0]
+    for i, name in enumerate(refs):
+        g[f"20{i}"] = {"class_type": "LoadImage", "inputs": {"image": name}}
+        g[f"21{i}"] = {"class_type": "VAEEncode", "inputs": {"pixels": [f"20{i}", 0], "vae": ["3", 0]}}
+        g[f"22{i}"] = {"class_type": "ReferenceLatent", "inputs": {"conditioning": cond, "latent": [f"21{i}", 0]}}
+        cond = [f"22{i}", 0]
+    if refs and late > 0:
+        g["30"] = {"class_type": "ConditioningSetTimestepRange", "inputs": {"conditioning": ["4", 0], "start": 0.0, "end": late}}
+        g["31"] = {"class_type": "ConditioningSetTimestepRange", "inputs": {"conditioning": cond, "start": late, "end": 1.0}}
+        g["32"] = {"class_type": "ConditioningCombine", "inputs": {"conditioning_1": ["30", 0], "conditioning_2": ["31", 0]}}
+        cond = ["32", 0]
+    g["5"] = {"class_type": "FluxGuidance", "inputs": {"conditioning": cond, "guidance": 4.0}}
+    g["10"] = {"class_type": "BasicGuider", "inputs": {"model": ["1", 0], "conditioning": ["5", 0]}}
+    g["11"] = {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["9", 0], "guider": ["10", 0], "sampler": ["8", 0], "sigmas": ["42", 1], "latent_image": ["41", 0]}}
+    g["12"] = {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["3", 0]}}
+    g["13"] = {"class_type": "SaveImage", "inputs": {"images": ["12", 0], "filename_prefix": prefix}}
+    return g
+
+
+def main():
+    a = argparse.ArgumentParser()
+    a.add_argument("--beauty", required=True)
+    a.add_argument("--out", required=True)
+    a.add_argument("--name", required=True)
+    a.add_argument("--denoise", type=float, default=0.62)
+    a.add_argument("--seed", type=int, default=1)
+    a.add_argument("--steps", type=int, default=28)
+    a.add_argument("--ref", action="append", default=[])
+    a.add_argument("--late", type=float, default=0.3)
+    a.add_argument("--prompt-extra", default="")
+    o = a.parse_args()
+    out = Path(o.out)
+    out.mkdir(parents=True, exist_ok=True)
+    from PIL import Image
+    width, height = Image.open(o.beauty).size
+    prompt = f"{SCENE} {STYLE} {o.prompt_extra} {AVOID}".strip()
+    init = upload(o.beauty)
+    refs = [upload(r) for r in o.ref]
+    g = graph(prompt, o.seed, width, height, o.steps, o.denoise, init, refs, o.late, f"mage25d/{o.name}")
+    t0 = time.time()
+    sent = json.loads(call("/prompt", json.dumps({"prompt": g, "client_id": f"mage25d-{uuid.uuid4()}"}).encode(), timeout=60))
+    pid = sent["prompt_id"]
+    while True:
+        h = json.loads(call(f"/history/{pid}", timeout=30)).get(pid)
+        if h and (h.get("status", {}).get("completed") or h.get("status", {}).get("status_str") == "error"):
+            break
+        if time.time() - t0 > 1800:
+            sys.exit(f"timeout on {pid}")
+        time.sleep(3)
+    if h["status"].get("status_str") == "error":
+        sys.exit(f"ComfyUI error: {json.dumps(h['status'].get('messages'))[:1500]}")
+    img = h["outputs"]["13"]["images"][0]
+    q = urllib.parse.urlencode({"filename": img["filename"], "subfolder": img["subfolder"], "type": img["type"]})
+    png = call(f"/view?{q}", timeout=120)
+    (out / f"{o.name}.png").write_bytes(png)
+    meta = {"name": o.name, "model": "flux2_dev_fp8mixed", "prompt": prompt, "seed": o.seed, "steps": o.steps, "denoise": o.denoise,
+            "guidance": 4.0, "sampler": "euler", "width": width, "height": height, "init": o.beauty, "refs": o.ref, "late": o.late,
+            "promptId": pid, "wallS": round(time.time() - t0, 1), "graph": g}
+    (out / f"{o.name}.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
+    print(f"{o.name}: {out / (o.name + '.png')} in {meta['wallS']} s")
+
+
+if __name__ == "__main__":
+    import urllib.parse
+    main()
